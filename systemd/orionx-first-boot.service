# @decision DEC-SEC-003
# @title First-boot wizard runs once via systemd
# @status accepted
# @rationale Oneshot service with ConditionPathExists guard ensures the
#   wizard runs exactly once on first boot, then never again. Flag file
#   at /var/lib/orionx/.first-boot-done is both the systemd condition
#   and the script's own idempotency check.

[Unit]
Description=Orion-X First-Boot Setup Wizard
After=multi-user.target
# Before=display-manager.service: the wizard renames the host (step 1). X
# authority cookies are keyed by hostname, so a rename racing LightDM's session
# start invalidates the cookie and the autologin session dies within seconds
# (hardware attestation 2026-08-21: hostname flipped localhost.localdomain ->
# orionx-218419db at 22:38:39-42, autologin session opened 22:38:42, greeter
# fallback 22:38:45, while a later startx under the settled hostname worked).
# display-manager.service is the canonical alias every DM installs, so this
# stays correct if lightdm is ever swapped out.
Before=display-manager.service
ConditionPathExists=!/var/lib/orionx/.first-boot-done

[Service]
Type=oneshot
ExecStart=/opt/orionx/scripts/security/first-boot-wizard.sh --non-interactive
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target
