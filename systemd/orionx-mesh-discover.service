[Unit]
Description=Orion-X Mesh Peer Discovery Listener
# W11-14f offline-safe: no network-online pull; gated on mesh interface.
After=network.target
ConditionPathExists=/sys/class/net/wg0

[Service]
Type=simple
ExecStart=/opt/orionx/scripts/mesh/mesh-discover.sh listen
ExecStop=/opt/orionx/scripts/mesh/mesh-discover.sh stop
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
