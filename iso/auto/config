#!/bin/sh
#
# Orion-X Phoenix Edition — Live-build configuration script
#
# Version is read from ORIONX_VERSION (exported by scripts/build-iso.sh).
# Default: v2.0.0-rc1 (Phase 7 pre-release).
# Do NOT hardcode a version literal here — scripts/build-iso.sh is the
# single version authority (DEC-PHASE7-002).
#
# @decision DEC-PHASE7-023
# @title ISO bootloader serial console for CI testability (W7-3)
# @status accepted
# @rationale The QEMU harness (scripts/qemu-boot-test.sh) captures boot output
#   via QEMU's -serial file: option. Without console=ttyS0,115200n8 in the
#   kernel cmdline, the kernel sends all output to the VGA framebuffer and the
#   serial capture log stays empty — both BIOS and UEFI boot tests time out.
#   --bootappend-live gains "console=tty0 console=ttyS0,115200n8" so the
#   kernel writes to both VGA (console=tty0, for human users at physical
#   hardware) and serial (console=ttyS0, primary console for CI capture).
#   Linux processes console= left-to-right; the LAST entry becomes the
#   primary console (where getty/login attaches). ttyS0 is last so CI sees
#   the login prompt on serial.
#   0500-bootloader-serial.hook.binary patches isolinux.cfg and grub.cfg
#   with serial directives during the binary stage for bootloader visibility.
#   References: issue #30, W7-3 acceptance gate, DEC-PHASE7-020.
#
# @decision DEC-PHASE7-024 (supersedes DEC-PHASE7-023 wiring paragraph)
# @title Canonical hook discovery via iso/config/hooks/{live,normal,binary}/
# @status accepted
# @rationale CI run 25475860825 proved that --hook-files did NOT produce an
#   'Executing hook' line in the build log — the workaround never worked.
#   Live-build auto-discovers executables under config/hooks/{normal,live,binary}/
#   relative to the lb config root (iso/). All project hooks now live at
#   iso/config/hooks/{live,normal,binary}/ so live-build finds them without
#   explicit registration. The --hook-files argument has been REMOVED from
#   this file because canonical auto-discovery makes it redundant AND keeping
#   both would create dual-registration (live-build would attempt the hook
#   twice). References: issue #32, W7-3-enabler, DEC-PHASE7-024.
#
# This script configures the live-build system for Orion-X.

set -e

# Version authority: read from environment; scripts/build-iso.sh exports it.
ORIONX_VERSION="${ORIONX_VERSION:-v2.0.0-rc6}"

# Base distribution
DISTRIBUTION="bullseye"
MIRROR_URL="http://deb.debian.org/debian/"

# Configure live-build
lb config noauto \
    --mode debian \
    --architectures amd64 \
    --distribution "$DISTRIBUTION" \
    --mirror-bootstrap "$MIRROR_URL" \
    --mirror-binary "$MIRROR_URL" \
    --archive-areas "main contrib non-free" \
    --apt-indices false \
    --apt-recommends true \
    --debian-installer false \
    --debian-installer-distribution "$DISTRIBUTION" \
    --debian-installer-gui false \
    --bootappend-live "boot=live components splash quiet persistence console=tty0 console=ttyS0,115200n8" \
    --bootappend-install "locales=en_US.UTF-8" \
    --bootloader "syslinux,grub-efi" \
    --iso-application "Orion-X Phoenix Edition" \
    --iso-publisher "Orion-X Project" \
    --iso-volume "OrionX-${ORIONX_VERSION}" \
    --memtest none \
    --security true \
    --updates true \
    --win32-loader false \
    "${@}"
