#!/bin/sh
#
# Orion-X Phoenix Edition — Live-build configuration script
#
# Version is read from ORIONX_VERSION (exported by scripts/build-iso.sh).
# Default: v2.0.0-rc1 (Phase 7 pre-release).
# Do NOT hardcode a version literal here — scripts/build-iso.sh is the
# single version authority (DEC-PHASE7-002).
#
# @decision DEC-PHASE7-023
# @title ISO bootloader serial console for CI testability (W7-3)
# @status accepted
# @rationale The QEMU harness (scripts/qemu-boot-test.sh) captures boot output
#   via QEMU's -serial file: option. Without console=ttyS0,115200n8 in the
#   kernel cmdline, the kernel sends all output to the VGA framebuffer and the
#   serial capture log stays empty — both BIOS and UEFI boot tests time out.
#   --bootappend-live gains "console=tty0 console=ttyS0,115200n8" so the
#   kernel writes to both VGA (console=tty0, for human users at physical
#   hardware) and serial (console=ttyS0, primary console for CI capture).
#   Linux processes console= left-to-right; the LAST entry becomes the
#   primary console (where getty/login attaches). ttyS0 is last so CI sees
#   the login prompt on serial.
#   0500-bootloader-serial.hook.binary patches isolinux.cfg and grub.cfg
#   with serial directives during the binary stage for bootloader visibility.
#   References: issue #30, W7-3 acceptance gate, DEC-PHASE7-020.
#
# @decision DEC-PHASE7-024 (supersedes DEC-PHASE7-023 wiring paragraph)
# @title Canonical hook discovery via iso/config/hooks/{live,normal,binary}/
# @status accepted
# @rationale CI run 25475860825 proved that --hook-files did NOT produce an
#   'Executing hook' line in the build log — the workaround never worked.
#   Live-build auto-discovers executables under config/hooks/{normal,live,binary}/
#   relative to the lb config root (iso/). All project hooks now live at
#   iso/config/hooks/{live,normal,binary}/ so live-build finds them without
#   explicit registration. The --hook-files argument has been REMOVED from
#   this file because canonical auto-discovery makes it redundant AND keeping
#   both would create dual-registration (live-build would attempt the hook
#   twice). References: issue #32, W7-3-enabler, DEC-PHASE7-024.
#
# @decision DEC-PHASE11-044
# @title Re-enable the Plymouth orionx-phoenix boot splash (with anti-hang guards)
# @status accepted
# @rationale Operator directive 2026-09-12: "go back to doing a Plymouth OrionX
#   Phoenix boot." This REVERSES DEC-PHASE11-023 (which dropped `splash` +
#   set plymouth.enable=0) and DEC-PHASE11-025 (which masked the plymouth boot
#   units), and retires the GRUB gfxmenu theme (DEC-PHASE11-040/041) which
#   errored + rendered an unreadable font on real UEFI hardware twice (rc1-79
#   text fallback; rc1-81 error). The identity moves to the already-built
#   orionx-phoenix Plymouth theme. The original hang was plymouth-quit-wait
#   blocking boot FOREVER (no timeout) because nothing quit plymouth on the
#   DM/getty flow. Guards, shipped together so the hang cannot recur:
#     (1) TimeoutStartSec cap on plymouth-quit-wait (drop-in) → worst case a
#         few extra seconds, never a hang;
#     (2) the first-boot wizard's unit runs `plymouth quit` in ExecStartPre so
#         it can take tty1 and so plymouth-quit-wait is satisfied on first boot;
#     (3) plymouth-quit.service (Before=display-manager) still releases DRM
#         before X, and the DEC-PHASE11-023 lightdm noloop drop-in still caps
#         restarts — so `splash` cannot reintroduce the boot loop either.
#   GRUB becomes a plain, readable text menu (no gfxmenu theme to error). Both
#   boot paths stay enabled: UEFI GRUB + BIOS isolinux vesamenu (operator is on
#   UEFI but wants broad support).
#
# This script configures the live-build system for Orion-X.

set -e

# Version authority: read from environment; scripts/build-iso.sh exports it.
ORIONX_VERSION="${ORIONX_VERSION:-v2.0.0-rc9}"

# ISO9660 --iso-volume field is capped at 32 characters. Compose the desired
# label and truncate defensively so long git-describe outputs
# (e.g. v2.1.0-rc1-7-g5d52a8e-dirty on post-tag develop) don't blow the
# limit and abort xorriso at the very last build step. This is cosmetic
# (only visible in blkid/os-prober output). We use `printf '%.32s'` for the
# truncation because auto/config runs under /bin/sh (dash on Debian), which
# does not support bash's ${var:0:32} substring syntax.
ORIONX_ISO_VOLUME="$(printf '%.32s' "OrionX-${ORIONX_VERSION}")"

# Base distribution
DISTRIBUTION="bullseye"
# Mirrors are env-overridable so a build can pin snapshot.debian.org when the
# live Fastly index and pool go inconsistent (observed 2026-09-06: bullseye-
# security index stuck on gnupg deb11u3 while the pool had purged it -> 404).
# Defaults are unchanged, so normal builds are byte-identical.
MIRROR_URL="${ORIONX_MIRROR:-http://deb.debian.org/debian/}"
MIRROR_SECURITY_URL="${ORIONX_SECURITY_MIRROR:-http://security.debian.org/}"

# Configure live-build
lb config noauto \
    --mode debian \
    --architectures amd64 \
    --distribution "$DISTRIBUTION" \
    --mirror-bootstrap "$MIRROR_URL" \
    --mirror-binary "$MIRROR_URL" \
    --mirror-chroot "$MIRROR_URL" \
    --mirror-chroot-security "$MIRROR_SECURITY_URL" \
    --mirror-binary-security "$MIRROR_SECURITY_URL" \
    --archive-areas "main contrib non-free" \
    --apt-indices false \
    --apt-recommends true \
    --debian-installer false \
    --debian-installer-distribution "$DISTRIBUTION" \
    --debian-installer-gui false \
    --bootappend-live "boot=live components persistence splash console=tty0 console=ttyS0,115200n8 live-config.username=orionx-operator live-config.hostname=orionx" \
    --bootappend-install "locales=en_US.UTF-8" \
    --bootloader "syslinux,grub-efi" \
    --iso-application "Orion-X Phoenix Edition" \
    --iso-publisher "Orion-X Project" \
    --iso-volume "$ORIONX_ISO_VOLUME" \
    --memtest none \
    --security true \
    --updates true \
    --win32-loader false \
    "${@}"
