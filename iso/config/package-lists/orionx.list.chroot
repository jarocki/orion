yara

# W11-6 Layer A: Suricata IDS (DEC-PHASE11-008)
# Lazy-start: suricata.service gated on /var/lib/suricata/orionx-enabled sentinel
# (see /etc/systemd/system/suricata.service.d/orionx-lazy.conf).
# Operator enables post-boot: sudo touch /var/lib/suricata/orionx-enabled && sudo systemctl start suricata
