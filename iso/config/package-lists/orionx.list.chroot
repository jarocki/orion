# Orion-X Phoenix Edition v2.2.0 (Trixie line)
# Package list for live-build (Debian 13 "trixie"). Packages commented with
# "#85" (radare2, fonts-iosevka, nikto, bulk-extractor) are NOT in trixie and
# must not be documented as shipped until an alternative source is chosen.
#
# @decision DEC-PHASE9-004
# @title GUI networking stack: NetworkManager + nm-applet + firmware
# @status accepted
# @rationale rc3 had no GUI networking — the live user could not connect to
#   Wi-Fi via the desktop. Fix: add network-manager (daemon + CLI), network-
#   manager-gnome (nm-applet tray icon, ships /etc/xdg/autostart/nm-applet.desktop
#   so it starts with any XDG-compliant session), wpasupplicant (WPA2/WPA3
#   supplicant for Wi-Fi), iw (nl80211 wireless CLI), and non-free firmware
#   packages for the most common Wi-Fi chipsets (Intel iwlwifi, Realtek r8188eu/
#   rtl8xxxu, Atheros/QCA ath9k/ath10k, and misc-nonfree covering many others).
#   non-free is already enabled in iso/auto/config via --archive-areas
#   "main contrib non-free" — no additional apt source config is needed.
#   NM's own postinst enables NetworkManager.service; the 0615 hook does not
#   need to enable it separately (NM handles its own systemd integration).
#   nm-applet autostart: network-manager-gnome ships
#   /etc/xdg/autostart/nm-applet.desktop which live-build copies into the
#   image verbatim — no explicit staging required.
#
# Packages marked EXTERNAL are NOT in the standard Debian Bullseye repos.
# They must be installed via separate mechanisms (custom .deb, pip, or
# third-party repo) and are commented out here so apt does not fail the
# live-build.  See docs/DEVELOPMENT_CHECKLIST.md for install procedures.
#
# W11-2 debloat pass (DEC-PHASE11-003 + DEC-PHASE11-006):
#   Removed: hashcat, john, hydra, proxychains, chntpw, steghide, encfs,
#            openvpn, build-essential, gcc, make, libssl-dev, python3-dev, vim
#   Retained: aircrack-ng, neovim, screen, tmux
#   Dev toolchain (build-essential, gcc, make, python3-dev, libssl-dev) deferred
#   to W11-8 optional installer (install-devel.sh). Operators who need a
#   build environment post-boot use the optional installer.
#   Offensive kit residue removed from base ISO mission-fit profile.

# Base system
live-boot
live-config
live-tools
dbus
eject
locales
sudo
user-setup

# Desktop environment
xfce4
xfce4-terminal
lightdm
# Pin the polkit auth agent. nm-applet/nm-connection-editor depend on
# "policykit-1-gnome | polkit-1-auth-agent"; left unpinned, trixie-dev6 got
# BOTH xfce4's recommended mate-polkit AND ukui-polkit — the latter dragging
# OpenCV + GDAL + proj (~200 MB) into a live ISO for a Qt agent nothing uses.
# Naming mate-polkit satisfies the virtual dep up front (DEC-PHASE12-015).
mate-polkit

# Audio stack for R.A.I.N. (Real-time Audible Intrusion Notification, #88 /
# DEC-PHASE11-045). The forensic base has no sound stack; RAIN needs one to play
# severity-mapped alert tones for the operator's "3am self".
#   pulseaudio        — desktop-session sound server (paplay honours per-cue volume)
#   pulseaudio-utils  — provides paplay (preferred cue player)
#   alsa-utils        — provides aplay (fallback when PulseAudio is absent)
#   espeak-ng         — optional spoken voice cue (off by default), and the
#                       SHIPPED text-to-speech engine for R.A.I.N. spoken
#                       narration (DEC-PHASE12-046). Zero additional ISO
#                       bytes. Natural voice is opt-in post-boot:
#                       sudo /opt/orionx/optional/install-piper-voice.sh
#                       (63,201,294 bytes of voice model, so NOT shipped)
pulseaudio
pulseaudio-utils
alsa-utils
espeak-ng

# Forensic tools
# EXTERNAL: autopsy          — install via https://www.autopsy.com/download/
binwalk
# EXTERNAL: bulk-extractor — not in Bullseye main; available in contrib or
# via separate install. Disabled to unblock live-build. Tracked: jarocki/orion#33
# bulk-extractor
dc3dd
foremost
# EXTERNAL: ghidra           — deferred to W11-8 optional installer (install-ghidra.sh)
#                              per DEC-PHASE11-004. Run: /opt/orionx/optional/install-ghidra.sh
hexedit
sleuthkit
tcpdump
testdisk
# EXTERNAL: volatility3      — install via: pip3 install volatility3
wireshark
# tshark: the CLI capture/analysis tool. NOT pulled in by the `wireshark` package —
# in Debian, `wireshark` is the GUI and `tshark` is a separate binary package, so
# `wireshark` alone ships dumpcap but no tshark. Verified absent from the
# 2026-08-07 ISO. tshark is the interface the MCP tool-server design and the
# operator's `triage` verb actually call, so its absence is load-bearing.
tshark
# EXTERNAL: zeek — NOT in Debian 13 main. Two install paths, one package:
#   build-time: iso/config/hooks/live/0500-install-external-tools.hook.chroot
#     installs zeek-core from the OBS security:zeek/Debian_13 repo. SOFT-FAIL,
#     so an ISO can legitimately ship without it (the 2026-09-27 image did).
#   post-boot:  sudo /opt/orionx/optional/install-zeek.sh  (DEC-PHASE12-028)
#     same package, same repo, plus a pinned signing-key fingerprint.
# Either way orionx-postured DETECTS Zeek at runtime and starts ingesting its
# logs with no rebuild (DEC-PHASE12-028), so absence here is not a dead end.
# (The old pointer at zeek.org/get-zeek was never the path this deck uses.)

# GUI Networking (rc4: Wi-Fi and wired connectivity via NetworkManager)
# NM daemon + CLI; postinst enables NetworkManager.service automatically.
network-manager
# nm-applet tray icon; ships /etc/xdg/autostart/nm-applet.desktop for
# automatic startup in XFCE and any other XDG-compliant desktop session.
network-manager-gnome
# gnome-keyring: a Secret Service for the live session (DEC-PHASE12-061). Without
# it Element (Electron) opens with "No encryption support … keyring
# gnome_libsecret" and NetworkManager cannot keep Wi-Fi secrets per user.
# ~4.7 MB + gcr/pinentry. The autologin session has no password to unlock a
# keyring with, so the first secret may still prompt — documented in the Guide.
gnome-keyring
# WPA2/WPA3 supplicant (Debian package name is wpasupplicant, not wpa_supplicant)
wpasupplicant
# nl80211 wireless configuration CLI (iw, not wireless-tools/iwconfig)
iw
# Non-free Wi-Fi firmware for common chipsets:
#   firmware-iwlwifi   — Intel Wireless (iwlwifi driver, most Intel laptops)
#   firmware-realtek   — Realtek Wi-Fi (r8188eu, rtl8xxxu, rtw88, etc.)
#   firmware-atheros   — Atheros/QCA (ath9k, ath10k)
#   firmware-misc-nonfree — Broadcom, MediaTek, and many other chipsets
# These require --archive-areas "main contrib non-free" in iso/auto/config
# (already set, see DEC-PHASE9-004).
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-misc-nonfree

# Networking tools
curl
dnsutils
ethtool
fping
