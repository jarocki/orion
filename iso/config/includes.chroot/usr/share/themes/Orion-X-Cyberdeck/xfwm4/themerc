# Orion-X-Cyberdeck XFWM4 window manager theme
#
# @decision DEC-PHASE11-010
# @title W11-9b: xfwm4/themerc — dark titlebar, Phoenix accent for focused window
# @status accepted
# @rationale XFWM4 reads xfwm4/themerc from the active GTK theme directory to
#   apply window decoration colors. This file provides:
#   - Dark titlebar background matching the cyberdeck aesthetic
#   - Phoenix red-orange (#FF5722) for the focused window titlebar text/border
#   - Unfocused windows use a muted grey to distinguish from focused
#   The button layout and decoration metrics follow Adwaita-dark's geometry
#   to maintain visual consistency with the GTK theme. No custom button images
#   are shipped — xfwm4 uses its built-in rendering with the color overrides.
#   License: This file is original work (Orion-X project). No upstream copy.

# Active (focused) window titlebar
active_color_1=#2d2d2d
active_color_2=#3a3a3a
active_hilight_1=#FF5722
active_hilight_2=#E64A19
active_shadow_1=#1a1a1a
active_shadow_2=#222222
active_mid_1=#2d2d2d
active_mid_2=#2d2d2d
active_text_color=#FF5722
active_border_color=#FF5722

# Inactive (unfocused) window titlebar
inactive_color_1=#242424
inactive_color_2=#2a2a2a
inactive_hilight_1=#3a3a3a
inactive_hilight_2=#3a3a3a
inactive_shadow_1=#1a1a1a
inactive_shadow_2=#1a1a1a
inactive_mid_1=#242424
inactive_mid_2=#242424
inactive_text_color=#888888
inactive_border_color=#383838

# Button rendering (no custom images — use xfwm4 built-in)
button_offset=2
button_spacing=2

# Font (inherits from xsettings MonospaceFontName or XFCE default)
title_font=Sans Bold 9

# Title alignment
title_horizontal_offset=0
title_shadow_active=true
title_shadow_inactive=false

# Shadow
shadow_delta_height=-1
shadow_delta_width=-1
shadow_delta_x=1
shadow_delta_y=1
shadow_opacity=50
