# Orion-X-Cyberdeck GTK2 theme
#
# @decision DEC-PHASE11-010
# @title W11-9b: gtk-2.0/gtkrc derives from Adwaita-dark GTK2 base
# @status accepted
# @rationale GTK2 applications (e.g., older wireshark builds, some auxiliary
#   system tools) use gtkrc. The Adwaita-dark GTK2 variant is provided by
#   gtk2-engines-adwaita (shipped as part of gtk2-engines-murrine dep chain
#   on Debian Bullseye). This gtkrc pulls the dark Adwaita base and applies
#   the Phoenix red-orange accent via fg[SELECTED] and bg[SELECTED] tokens.
#   gtk2-engines-murrine package is required (see orionx.list.chroot T1 entry).
#   Upstream license: LGPL-2.1+. Modifications: palette accent tokens only.

include "/usr/share/themes/Adwaita-dark/gtk-2.0/gtkrc"

gtk-color-scheme =
"base_color:#1a1a1a
bg_color:#2d2d2d
fg_color:#eeeeec
text_color:#eeeeec
selected_bg_color:#FF5722
selected_fg_color:#ffffff
tooltip_bg_color:#232323
tooltip_fg_color:#eeeeec
link_color:#FF5722"

style "orionx-cyberdeck-default" {
    bg[SELECTED]   = "#FF5722"
    fg[SELECTED]   = "#ffffff"
    bg[ACTIVE]     = "#3a3a3a"
    bg[PRELIGHT]   = "#444444"
    base[SELECTED] = "#FF5722"
    text[SELECTED] = "#ffffff"
}

class "GtkWidget" style "orionx-cyberdeck-default"
