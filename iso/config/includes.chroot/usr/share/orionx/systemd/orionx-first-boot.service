# @decision DEC-SEC-003 (updated by DEC-PHASE11-037)
# @title First-boot wizard runs INTERACTIVELY on the console (tty1) before the DM
# @status accepted
# @rationale Operator directive 2026-09-12: first boot should prompt the operator
#   for hostname, primary username+password, and Wi-Fi (when there is no wired
#   link), THEN bring up the desktop. The prior unit ran the wizard
#   --non-interactive (auto MAC hostname) which gave no onboarding, and a fresh
#   boot could land on a bare console. This unit takes tty1 from getty, runs the
#   wizard interactively before display-manager.service, and lets the desktop
#   start only after onboarding completes. Running before the DM also keeps the
#   original DEC-SEC-003 invariant: the hostname is settled before X starts, so
#   the autologin session's X-authority cookie is not invalidated by a late
#   rename. Every wizard prompt has an input timeout (falls back to defaults),
#   and this unit is oneshot ordered-before (not required-by) the DM, so it can
#   never permanently block boot. Runs once, guarded by the flag file.
#
# @decision DEC-PHASE13-030 (supersedes the ExecStartPre part of DEC-PHASE11-044
#   and the `timeout 10` part of DEC-PHASE13-028)
# @title The wizard never touches tty1 while plymouth owns it (#141)
# @rationale This unit used to run `plymouth quit` itself, as ExecStartPre. That
#   command runs in this unit's exec context — StandardInput=tty on tty1 with
#   TTYReset=yes — so before it could exec, systemd's child acquired tty1, took
#   the /dev/console lock and reset the terminal while plymouthd still owned
#   tty1 (nothing else quits the splash on first boot: lightdm replaces
#   plymouth-quit.service and runs after us). Some of the time that reset
#   blocked, the child never execed, the console lock was never released, and
#   serial-getty@ttyS0 blocked on the same lock: the QEMU flake (#141). The
#   `timeout 10` wrapper could not help, because the block is before exec. The
#   quit now lives in orionx-plymouth-quit.service, a unit with no TTY, and this
#   unit orders after it and after plymouth-quit-wait.service — the same rule
#   the stock getty@.service follows — so plymouthd is gone before systemd
#   prepares tty1 for the wizard. Evidence: run 41272254094, the
#   ORIONX-PLYMOUTH-DIAG block ("(timeout)" holding tty1 + /dev/console,
#   "(agetty)" in locks_lock_inode_wait, plymouthd idle in epoll_wait).

[Unit]
Description=Orion-X First-Boot Setup Wizard (interactive console)
# Take the console from getty and run before the graphical login. NetworkManager
# is ordered before us so the Wi-Fi step's nmcli calls work.
# DEC-PHASE13-030: the splash must be gone before systemd prepares tty1 for
# us. orionx-plymouth-quit.service quits it (no TTY of its own, so nothing to
# deadlock on) and plymouth-quit-wait.service confirms plymouthd has exited
# (bounded by its 25 s cap, DEC-PHASE11-044).
Wants=orionx-plymouth-quit.service
After=systemd-user-sessions.service getty@tty1.service NetworkManager.service
After=orionx-plymouth-quit.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
Before=display-manager.service
ConditionPathExists=!/var/lib/orionx/.first-boot-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/orionx/scripts/security/first-boot-wizard.sh
# Interactive on the primary virtual console. Safe only because of the
# ordering above: systemd resets tty1 (TTYReset/TTYVHangup) before exec, and
# that must not happen while plymouthd holds the VT (DEC-PHASE13-030).
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# Absolute worst-case bound; per-prompt read timeouts in the wizard mean it
# self-completes with defaults long before this if left unattended.
TimeoutStartSec=1200

[Install]
# Pulled into the graphical boot, ordered before the display manager.
WantedBy=graphical.target
