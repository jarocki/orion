# @decision DEC-MATRIX-005
# @title systemd unit validated statically, runtime testing in Phase 7
# @status accepted
# @rationale Docker doesn't naturally run systemd. Unit file correctness
#   validated via systemd-analyze verify (or structural checks). Full
#   runtime testing deferred to Phase 7 where QEMU provides real init.

# @decision DEC-PHASE9-006
# @title Downgrade wg-quick dependency from Requires= to Wants=/After=
# @status accepted
# @rationale scripts/mesh/mesh-join.sh brings up wg0 using raw ip/wg commands
#   via mesh_interface_up() — it does NOT use wg-quick. As a result
#   wg-quick@wg0.service never runs, and the hard Requires= caused Matrix to
#   refuse to start (systemd propagates failure from a required unit that
#   never activates). Downgrading to Wants= makes the dependency soft: systemd
#   will attempt wg-quick@wg0.service but will not block or fail Matrix if it
#   does not activate. After= is retained so that if wg-quick IS used in a
#   future deployment, Matrix still waits for it. Operators who use wg-quick
#   instead of mesh-join.sh retain correct ordering without a hard dependency.
#   The canonical consumed copy is this file
#   (iso/config/includes.chroot/usr/share/orionx/systemd/); the repo-root
#   systemd/matrix-synapse-orionx.service is a reference copy kept in sync.

[Unit]
Description=Orion-X Matrix Synapse Homeserver
Documentation=https://matrix-org.github.io/synapse/latest/
# W11-14f offline-safe: opt-in (not in AUTOSTART); no network-online pull that
# would block an offline boot; only start when configured; bounded restart.
ConditionPathExists=/etc/matrix-synapse/homeserver.yaml
StartLimitIntervalSec=300
StartLimitBurst=3
After=wg-quick@wg0.service
# Soft dependency on wg-quick@wg0 (DEC-PHASE9-006): mesh-join.sh uses raw
# ip/wg to bring up wg0, not wg-quick, so wg-quick@wg0.service never activates.
# Wants= + After= gives correct ordering when wg-quick IS used, without
# blocking Matrix startup when the mesh is managed by mesh-join.sh instead.
Wants=wg-quick@wg0.service

[Service]
Type=notify
NotifyAccess=main
User=matrix-synapse
Group=matrix-synapse
WorkingDirectory=/var/lib/matrix-synapse
# DEC-PHASE12-060: Synapse lives in the dh-virtualenv at /opt/venvs/matrix-synapse;
# the system python3 has no `synapse` module. The former ExecStartPre looked for
# /etc/wireguard/wg0.conf, a file this image never creates (DEC-PHASE12-041).
ExecStart=/opt/venvs/matrix-synapse/bin/python -m synapse.app.homeserver --config-path /etc/matrix-synapse/homeserver.yaml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=matrix-synapse

# Security hardening
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/matrix-synapse /var/log/matrix-synapse

[Install]
WantedBy=multi-user.target
