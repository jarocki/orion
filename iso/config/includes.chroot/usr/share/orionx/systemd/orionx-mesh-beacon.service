# Orion-X Mesh Beacon Send — confined (DEC-PHASE12-041)
#
# @decision DEC-PHASE12-041
# @title Confinement for the outbound beacon, justified per directive
# @status accepted
# @rationale `mesh-discover.sh send` is the least privileged of the three
#   mesh units, and its bounding set says so. What it does:
#
#     wg pubkey < /etc/wireguard/mesh-private.key (0600) -> CAP_DAC_OVERRIDE,
#       and pure computation: no netlink, no device
#     mesh_state_read /var/run/orionx-mesh.state         -> read only
#     ip -o -4 addr show                                 -> READ of addresses;
#       no CAP_NET_ADMIN, which is why it is absent here and present in the
#       other two
#     hostname -s                                        -> no privilege
#     socat UDP-DATAGRAM:<bcast>:55555,broadcast         -> SO_BROADCAST needs
#       no capability on Linux; the port is above 1024
#     mesh.log                                           -> LogsDirectory=orionx
#
#   It writes nothing under /run, so it gets no ReadWritePaths at all.
#
#   NOT CURRENTLY INSTALLED: this unit is absent from UNIT_FILES in
#   0615-install-systemd-units.hook.chroot, while the installed
#   orionx-mesh-discover.timer has Unit=orionx-mesh-beacon.service. The
#   timer therefore fires at a unit that does not exist, every 10 seconds,
#   and because the timer names the beacon explicitly the listener is never
#   triggered either. mesh-health.sh detects this at runtime and says so
#   once per boot (health_check_discovery); the fix itself belongs in 0615.

[Unit]
Description=Orion-X Mesh Beacon Send (oneshot)
# W11-14f offline-safe: order after basic net; skip cleanly when no mesh
# interface (wg0 absent = not joined) so timer firings are no-ops, not fails.
After=network.target
ConditionPathExists=/sys/class/net/wg0

[Service]
Type=oneshot
ExecStart=/opt/orionx/scripts/mesh/mesh-discover.sh send
StandardOutput=journal
StandardError=journal

# --- filesystem: reads everything it needs; writes only its log -------------
ProtectSystem=strict
ProtectHome=yes
LogsDirectory=orionx

# --- privilege: no network ADMINISTRATION happens here ----------------------
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
