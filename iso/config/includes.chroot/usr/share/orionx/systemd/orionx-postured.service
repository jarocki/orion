# @decision DEC-PHASE12-024
# @title Threat-posture enforcement daemon (tier -> Suricata -> R.A.I.N.)
# @status accepted
# @rationale The Control Center's tier selector wrote a file nothing consumed:
#   raising the tier started no service, never created the DEC-PHASE11-008
#   ConditionPathExists gate, and left an IDS with no threat rules reporting
#   nothing. This unit runs the daemon that enforces the tier, ingests
#   eve.json, and announces a rules-less IDS loudly instead of failing silent.
#
#   Sandboxing notes, each one load-bearing:
#     ProtectHome=read-only  — the posture file is written by the DESKTOP user
#       under /home/orionx-operator/.config/orionx/. ProtectHome=yes would hide
#       it and the daemon would enforce Tier 0 forever.
#     ReadWritePaths — /var/lib/suricata for the gate file, /var/lib/orionx for
#       Tier 2 canaries, /run/orionx for the bus and the status file.
#     AF_INET/AF_INET6 — Tier 2 decoy listeners and the 127.0.0.1 Nebula call.
#       AF_NETLINK — nft, for the runtime decoy firewall opening.
#     CAP_NET_ADMIN/CAP_NET_BIND_SERVICE — the nft rule and tcp/23.
#   Suricata is Wants=, not Requires=: at Tier 0 it must stay stopped, and the
#   daemon starting it is the point, so a hard dependency would invert control.

[Unit]
Description=Orion-X Threat Posture Enforcement (tiers, Suricata IDS, deception)
Documentation=file:/var/lib/suricata/orionx-README.md
# Deliberately NOT ordered on nebula-runtime.service (DEC-PHASE12-032).
#
# The Nebula contextualiser is best-effort by design: an absent, slow or dead
# model must never gate an alert. Ordering the whole daemon behind the model
# runtime inverted that guarantee — detection could not start until the
# optional enrichment was up. Observed on v2.2.0-rc3: orionx-postured sat
# "inactive (dead)" with a pending job, so Shields Up enforcement and Zeek
# ingest were both dormant on the first image that actually shipped Zeek.
#
# Detection starts as early as it can; the model joins when it is ready.
After=network.target orionx-firewall.service
Wants=orionx-firewall.service

[Service]
Type=simple
ExecStart=/opt/orionx/scripts/awareness/orionx-postured
Restart=on-failure
RestartSec=5s
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/run/orionx /var/lib/suricata /var/lib/orionx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_BIND_SERVICE
MemoryMax=128M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
