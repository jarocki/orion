# Nebula AI — ollama Runtime Service (auto-started; ollama loads model lazily)
#
# @decision DEC-PHASE11-033
# @title nebula-runtime: run ollama serve directly; socket activation removed
# @status accepted
# @rationale The former nebula-runtime.socket (DEC-PHASE10-010) is DELETED. ollama
#   serve binds 127.0.0.1:11434 itself and does NOT accept a systemd socket fd, so
#   the socket and ollama raced for the port: ollama got EADDRINUSE and exited 1,
#   and Restart=on-failure looped it hundreds of times (observed 824 restarts on
#   rc1-57). Fix: this service is auto-started at boot (0615 AUTOSTART_UNITS). The
#   DEC-PHASE10-010 budget still holds because ollama loads NOTHING into RAM until
#   the first /api/chat — `ollama serve` with no model resident is cheap; the 1.9GB
#   model streams in on the first inference (warm-up or chat), not at boot.
#   Requires nebula-integrity-check.service so the model is verified before serving.
#   References: DEC-PHASE10-009 (integrity gate), DEC-PHASE10-011 (AppArmor).

[Unit]
Description=Nebula AI Runtime (ollama LLM server)
Documentation=https://ollama.com
# Integrity check MUST succeed before ollama starts.
# Requires= means: if nebula-integrity-check fails, this unit fails too.
# After= means: do not start ollama until integrity-check has completed.
Requires=nebula-integrity-check.service
After=nebula-integrity-check.service
# ollama is localhost-only (DEC-006) and needs no network; do not order on
# network.target so it is never delayed on an offline boot.
# StartLimit hardening: if ollama truly fails, give up after 5 tries in 120s
# instead of looping forever (the socket bug previously caused 824 restarts).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# W11-14j: ollama needs $HOME for its key store, and does not sd_notify;
# without these it exits 1 ($HOME undefined) or Type=notify times out.
Environment=HOME=/root
Type=simple
# ollama listens only on localhost — DEC-006 LOCAL-ONLY + DEC-PHASE10-011 AppArmor.
Environment=OLLAMA_HOST=127.0.0.1:11434
# Model storage location — must match where stage_nebula_model() staged the GGUF.
Environment=OLLAMA_MODELS=/opt/orionx/nebula/models
ExecStart=/usr/local/bin/ollama serve
# Ensure log directory exists before starting.
# LogsDirectory= makes systemd create /var/log/orionx BEFORE it opens the
# StandardOutput=append: target. ExecStartPre= alone is NOT sufficient: systemd
# opens stdout/stderr for the unit before running ExecStartPre, so a missing
# directory yields 209/STDOUT and the mkdir never executes. Same root cause and
# same fix as nebula-integrity-check.service (W11-13 T2, DEC-PHASE11-017); that
# slice fixed only one of the three units that needed it.
LogsDirectory=orionx
ExecStartPre=/bin/mkdir -p /var/log/orionx
StandardOutput=append:/var/log/orionx/nebula-runtime.log
StandardError=append:/var/log/orionx/nebula-runtime.log
# Restart on failure but NOT on clean stop (avoids restart loops when operator
# manually stops nebula for maintenance).
Restart=on-failure
RestartSec=5
# Give ollama time to initialise (it may need to load the model on first request).
TimeoutStartSec=120

[Install]
# Auto-started at boot via 0615 AUTOSTART_UNITS (DEC-PHASE11-033). ollama loads
# the model lazily on the first request, so this stays within the idle-RAM budget.
WantedBy=multi-user.target
