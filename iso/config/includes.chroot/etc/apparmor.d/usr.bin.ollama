#include <tunables/global>

# @decision DEC-PHASE10-011
# @title AppArmor profile: ollama daemon file/exec confinement, model read-only
# @status accepted (amended by DEC-PHASE12-101)
# @rationale DEC-007 (MCP tool server sandboxed) + DEC-006 (ALL AI processing LOCAL).
#   - Model files: read-only access to /opt/orionx/nebula/models/** only.
#   - No access to /home/**.
#   - Exec: only ollama itself (its model runner) and its vendored libraries.
#   Style follows usr.bin.tshark (Phase 7 AppArmor convention).
#
# @decision DEC-PHASE12-101
# @title ollama may exec its own runner; egress is enforced by systemd, not
#   claimed by AppArmor
# @status accepted
# @rationale Two false claims in the old profile (system P1-4, security F8):
#   1. It granted no `x` permission at all, while ollama launches its model
#      runner by re-executing itself (os.Executable(); `strings` on the rc9
#      binary shows "starting mlx runner", "llama-server startup failed",
#      the `runner` subcommand). Under enforcement that exec is EACCES and
#      the first /api/chat fails "llama runner process has terminated".
#      Now: `/usr/local/bin/ollama mrix` (the runner stays in this profile)
#      and `ix` on the vendored /usr/local/lib/ollama tree. It also named
#      /usr/bin/ollama (does not exist) and denied all writes under /root
#      while ollama runs with HOME=/root and keeps its keypair and cache in
#      /root/.ollama (baked into the image); that one directory is allowed.
#   2. It said ollama "cannot make outbound network calls" while granting
#      `network inet stream`. AppArmor network rules cannot match a peer
#      address, so "loopback only" is NOT expressible here. The property is
#      made true by nebula-runtime.service instead (IPAddressDeny=any +
#      IPAddressAllow=localhost, a cgroup BPF filter the kernel enforces on
#      every socket of the unit). This profile keeps inet (it must, to serve
#      127.0.0.1:11434) and denies inet6/raw/packet.
#   Not verified on a deck: run `curl -s localhost:11434/api/generate -d
#   '{"model":"<model>","prompt":"hi"}'; journalctl -k | grep DENIED` and
#   expect a reply and no ollama denials.
profile ollama /usr/local/bin/ollama {
  #include <abstractions/base>

  # Model files: read-only — ollama may read GGUF files but must not modify them.
  # Integrity is verified at boot by nebula-integrity-check; we enforce read-only
  # here so a compromised ollama process cannot overwrite the model.
  /opt/orionx/nebula/models/** r,

  # Runtime logs (rw: ollama writes inference/error logs here)
  /var/log/orionx/ rw,
  /var/log/orionx/** rw,

  # ollama itself: the server re-executes this binary as its model runner.
  /usr/local/bin/ollama mrix,
  # Vendored runtime libraries and helper binaries shipped in the tarball.
  /usr/local/lib/ollama/ r,
  /usr/local/lib/ollama/** mrix,
  /usr/lib/** rm,
  /usr/local/lib/** rm,
  /lib/** rm,

  # HOME=/root (nebula-runtime.service): keypair, cache, history.
  owner /root/.ollama/ rw,
  owner /root/.ollama/** rwk,

  # ollama runtime state (PID file, socket path, etc.)
  /tmp/ollama** rw,
  /tmp/ r,
  /run/ollama/ rw,
  /run/ollama/** rw,
  /run/orionx/ rw,
  /run/orionx/** rw,

  # Proc and sys reads needed for system info / hardware detection
  /proc/cpuinfo r,
  /proc/meminfo r,
  /proc/*/status r,
  @{PROC}/@{pid}/{stat,maps,mountinfo,cgroup,cmdline} r,
  @{PROC}/sys/kernel/** r,
  /sys/fs/cgroup/** r,
  /sys/class/dma/** r,
  /sys/devices/** r,
  /etc/os-release r,
  /usr/lib/os-release r,

  # llama.cpp GPU detection (Metal/CUDA/Vulkan probes; may soft-fail on CPU-only)
  /dev/dri/** rw,
  /dev/kfd rw,

  # Network: inet is needed to serve 127.0.0.1:11434. WHICH peers it may talk
  # to is enforced by nebula-runtime.service (IPAddressAllow=localhost), not
  # here — see DEC-PHASE12-101.
  network inet stream,
  network inet dgram,
  network netlink raw,
  deny network inet6,
  deny network raw,
  deny network packet,

  # No access to user home directories
  deny /home/** w,
  deny /home/** r,

  # No execution of system binaries (intent made explicit for audit clarity)
  deny /bin/** x,
  deny /sbin/** x,
  deny /usr/sbin/** x,
}
