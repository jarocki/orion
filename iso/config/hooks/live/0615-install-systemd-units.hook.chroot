#!/bin/bash
# shellcheck shell=bash
set -euo pipefail
#
# Orion-X Phoenix Edition — Systemd Unit Installation Hook
#
# Installs all Orion-X systemd unit files into /lib/systemd/system/ and
# enables the documented autostart set. This hook MUST run before
# 0620-service-hardening.hook.chroot so that the ProtectSystem injection
# in 0620 finds the installed unit files (lexical prefix 0615 < 0620
# guarantees ordering).
#
# Source: /usr/share/orionx/systemd/ (staged via includes.chroot)
# Target: /lib/systemd/system/
#
# @decision DEC-PHASE7-SYSTEMD-INSTALL-001
# @title Chroot hook is single authority for installing orionx systemd units into squashfs
# @status accepted
# @rationale Phases 4, 3, and 6 created unit files but no hook installed them
#   into the squashfs. As a result 0620-service-hardening.hook.chroot's
#   ProtectSystem injection silently no-op'd because the units were missing.
#   A dedicated chroot hook with lexical prefix 0615 is the only correct place
#   to perform this installation: live-build runs chroot hooks in lexical order
#   inside the chroot before sealing the squashfs, and systemctl enable inside
#   the chroot creates the correct /etc/systemd/system/ symlinks that persist
#   into the final image. No other mechanism (binary hook, Makefile target,
#   scripts/build-iso.sh, Dockerfile) can replicate this behaviour. This hook
#   is therefore THE SINGLE AUTHORITY for orionx systemd unit installation.

SOURCE_DIR="/usr/share/orionx/systemd"
TARGET_DIR="/lib/systemd/system"

# ---------------------------------------------------------------------------
# Unit files to install
# ---------------------------------------------------------------------------
UNIT_FILES=(
    "orionx-mesh-health.service"
    "orionx-mesh-health.timer"
    "orionx-mesh-discover.service"
    "orionx-mesh-discover.timer"
    "orionx-firewall.service"
    "orionx-first-boot.service"
    # DEC-PHASE12-022: consumes the firewall's own drop log and emits scan
    # events onto the R.A.I.N. bus. Pairs with orionx-firewall.service, which
    # produces the log it reads.
    "orionx-scanwatch.service"
    # W10-1: Nebula AI runtime units (DEC-PHASE10-009, DEC-PHASE11-033)
    # nebula-integrity-check: oneshot, runs at boot before nebula-runtime
    # nebula-runtime: ollama daemon, auto-started (ollama loads the 1.9GB model
    #   LAZILY on first inference; socket activation removed — DEC-PHASE11-033)
    # nebula-warmup: staged here but NOT in AUTOSTART_UNITS (opt-in; DEC-PHASE10-010)
    # NOTE: nebula-runtime.socket deliberately NOT installed — ollama serve binds
    #   :11434 itself and cannot accept a systemd socket fd (EADDRINUSE loop).
    "nebula-integrity-check.service"
    "nebula-runtime.service"
    "nebula-warmup.service"
    # ---- W10-3/5/6 completion (DEC-PHASE12-023/024/025) --------------------
    # orionx-heald: consumes the R.A.I.N. bus and the operator's autonomy grid
    #   and executes the six healing playbooks. Sits in front of
    #   orionx-firewall's table (its own table, priority -10).
    # orionx-postured: enforces the threat-posture tier. Before this, the tier
    #   selector persisted a value nothing consumed — elevating to Deception
    #   changed a Cockpit label and started nothing.
    # nebula-mcp: the confined MCP tool server (own uid, PrivateNetwork,
    #   AppArmor). Serves a unix socket; never talks to ollama, so it is
    #   deliberately NOT ordered on nebula-runtime.service.
    "orionx-heald.service"
    "orionx-postured.service"
    "nebula-mcp.service"
)

# ---------------------------------------------------------------------------
# Autostart set — enable these units at boot.
# This array is THE SINGLE AUTHORITY for which orionx units are enabled.
# Enable .timer (not the underlying .service) for periodic units.
# ---------------------------------------------------------------------------
AUTOSTART_UNITS=(
    "orionx-mesh-discover.timer"
    "orionx-mesh-health.timer"
    "orionx-firewall.service"
    "orionx-first-boot.service"
    "orionx-scanwatch.service"
    # W10-1 Nebula: enable integrity-check (boot gate) + nebula-runtime.service.
    # DEC-PHASE10-009: integrity-check must be autoenabled — it is the boot gate.
    # DEC-PHASE11-033: nebula-runtime.service is auto-started DIRECTLY. Socket
    #   activation (the former nebula-runtime.socket) is removed because ollama
    #   serve binds 127.0.0.1:11434 itself and cannot accept a systemd socket fd —
    #   the two raced for the port and ollama exited 1 in a tight restart loop
    #   (observed: 824 restarts). ollama's own lazy MODEL loading (nothing loads
    #   until the first /api/chat) preserves the DEC-PHASE10-010 idle-RAM budget.
    # nebula-warmup.service is deliberately NOT listed here (DEC-PHASE10-010 opt-in).
    "nebula-integrity-check.service"
    "nebula-runtime.service"
    # All three fail closed, so autostarting them costs nothing on a deck whose
    # operator never opens the relevant tab:
    #   orionx-heald   — an absent or corrupt autonomy.json resolves to "off"
    #                    for every action class, so it acts on nothing.
    #   orionx-postured— an absent or corrupt threat-posture file resolves to
    #                    Tier 0, which starts no services and sends no packets.
    #   nebula-mcp     — loads no model; idle cost is negligible (unlike
    #                    nebula-warmup, which stays opt-in per DEC-PHASE10-010).
    "orionx-heald.service"
    "orionx-postured.service"
    "nebula-mcp.service"
)

echo "[install-systemd-units] Installing Orion-X systemd units from $SOURCE_DIR to $TARGET_DIR"

# ---------------------------------------------------------------------------
# Install unit files
# ---------------------------------------------------------------------------
for unit in "${UNIT_FILES[@]}"; do
    src="$SOURCE_DIR/$unit"
    dst="$TARGET_DIR/$unit"
    if [[ ! -f "$src" ]]; then
        echo "[install-systemd-units] ERROR: source unit not found: $src" >&2
        exit 1
    fi
    cp "$src" "$dst"
    echo "[install-systemd-units] installed: $unit"
done

# ---------------------------------------------------------------------------
# Enable autostart units
# ---------------------------------------------------------------------------
for unit in "${AUTOSTART_UNITS[@]}"; do
    systemctl enable "$unit"
    echo "[install-systemd-units] enabled: $unit"
done

# ---------------------------------------------------------------------------
# DEC-PHASE11-044: Plymouth orionx-phoenix boot splash is RE-ENABLED.
# This REVERSES DEC-PHASE11-025 (which masked these units to kill the splash).
# The original 21-min hang (hardware 2026-09-07) was plymouth-quit-wait.service
# blocking boot FOREVER because it has no timeout and nothing quit plymouth on
# the DM/getty flow. That is now bounded two ways, shipped together:
#   (1) a TimeoutStartSec cap drop-in for plymouth-quit-wait.service
#       (includes.chroot/etc/systemd/system/plymouth-quit-wait.service.d/
#        10-orionx-timeout.conf) — worst case a few extra seconds, never a hang;
#   (2) the first-boot wizard unit runs `plymouth quit` in ExecStartPre, which
#       both frees tty1 for the interactive wizard and satisfies quit-wait.
# `splash` is back on the cmdline (DEC-PHASE11-044) and plymouth.enable=0 is
# gone. Unmask the units (idempotent) so the splash paints; plymouth-quit.service
# (Before=display-manager) still releases DRM before X starts.
for punit in plymouth-start.service plymouth-quit.service plymouth-quit-wait.service plymouth-read-write.service; do
    systemctl unmask "$punit" 2>/dev/null && echo "[install-systemd-units] unmasked: $punit"
done

echo "[install-systemd-units] systemd unit installation complete"
