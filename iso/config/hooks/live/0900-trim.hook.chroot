#!/bin/bash
# shellcheck shell=bash
# 0900-trim.hook.chroot — zero-regret image trim (runs last, before squashfs).
#
# @decision DEC-PHASE12-015
# @title Zero-regret trim: purge bloat that no supported deck can use
# @status accepted
# @rationale Size budget measured on trixie-dev6 (6.63 GB ISO; squashfs already
#   xz + dedup, so compression is NOT a lever). The bloat is concentrated in
#   things that cost the operator nothing to lose:
#     - ollama GPU backends (cuda_v12 1.25 GB, cuda_v13 0.85 GB, vulkan 58 MB):
#       no NVIDIA/Vulkan on the Bay Trail deck, ollama runs CPU-only (handled in
#       0500 right after extraction; listed here for the budget).
#     - `zeek` metapackage → zeek-zkg → zeek-spicy-dev (194 MB) + btest-data
#       (40 MB) + gcc/g++/*-dev/git: a package-manager + compiler toolchain for
#       building Zeek plugins on an air-gapped live deck. 0500 now installs
#       zeek-core; the leftovers are purged here.
#     - binwalk (Rust, needs no Python) + python3-scapy Recommends dragging
#       python3-scipy/-matplotlib/-pyqtgraph/-fonttools + unicode-data.
#     - ukui-polkit: an unrelated desktop's polkit agent that apt chose for the
#       polkit-1-auth-agent virtual dep, dragging OpenCV + GDAL + proj (~200 MB).
#       The package list now pins mate-polkit; the stray is purged if present.
#     - firmware-nvidia-graphics (63 MB; GSP firmware for accel on new NVIDIA —
#       nouveau boots without it), mesa-vulkan-drivers (79 MB; no Vulkan use),
#       unhide.rb + ruby (30 MB; rkhunter Recommends).
#     - 219 non-English locale dirs (258 MB) and non-copyright /usr/share/doc
#       (108 MB). Copyright files stay (redistribution), man pages stay (3am
#       operator), /usr/share/doc/orionx stays (the User Guide lives there).
#   Purge lists are filtered to what is actually installed so a renamed package
#   can never abort the build, and the hook never touches /opt/orionx.
#
# @decision DEC-PHASE12-017
# @title Purges are simulated first and may never remove a manual/critical package
# @status accepted
# @rationale trixie-dev8 booted to a bare X terminal with no window manager.
#   Cause: the dev7/dev8 purge list contained `cpp`, and on trixie
#   x11-xserver-utils (xrdb) hard-depends on cpp → apt removed x11-xserver-utils
#   → xfce4-session → the xfce4 metapackage and xorg → --autoremove then swept
#   thunar, xfwm4, xfce4-panel, xfdesktop4, light-locker… 160 packages in one
#   silent step. The blanket `*-dev` sweep did the same to python3-numpy
#   (python3-numpy hard-depends on python3-numpy-dev on trixie). The build was
#   green: nothing checked the OUTCOME. Rules now enforced by this hook:
#     1. PROTECTED = every package apt marks manual (= the package lists + hook
#        installs) ∪ a hardcoded desktop-critical set. Critical packages are
#        re-marked manual so autoremove can never orphan them.
#     2. Every purge is SIMULATED (`apt-get -s purge --autoremove`). If the plan
#        removes any protected package that is not itself an explicit target,
#        the offending targets are dropped one at a time (each logged with the
#        protected package it would have taken) and only the safe remainder is
#        purged. If the safe remainder's own plan is still blocked, nothing is
#        purged at all.
#     3. After the purge, every critical package must still be installed —
#        otherwise the BUILD FAILS. A missing desktop is a defect, not a warning
#        (same principle as DEC-PHASE11-018: never ship a green build with a
#        dead feature).
#   Functions are defined first and exposed for unit tests via
#   ORIONX_TRIM_LIB_ONLY=1 (tests/unit/test_trim.sh feeds canned `apt-get -s`
#   output through them).
set -euo pipefail

# ---------------------------------------------------------------------------
# Library functions (testable)
# ---------------------------------------------------------------------------
# stdin: `apt-get -s ...` output → stdout: every package the plan would remove.
trim_plan_removals() {
    awk '($1=="Remv" || $1=="Purg") {print $2}' | sort -u
}
# $1 planned-removals file, $2 protected-set file, $3 explicit-targets file
# → stdout: protected packages the plan would remove that were not asked for.
trim_blocked() {
    comm -12 <(sort -u "$1") <(sort -u "$2") | comm -23 - <(sort -u "$3")
}
# stdin: newline-separated package names → stdout: those currently installed.
trim_installed_only() {
    local p
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        if dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed"; then
            printf '%s\n' "$p"
        fi
    done
}

# Desktop/session/runtime packages that must survive any trim (DEC-PHASE12-017).
CRITICAL=(
    xorg xserver-xorg xserver-xorg-core xinit x11-xserver-utils x11-utils xauth
    lightdm lightdm-gtk-greeter
    xfce4 xfce4-session xfce4-settings xfce4-panel xfwm4 xfdesktop4 xfconf
    thunar xfce4-terminal mate-polkit
    network-manager network-manager-gnome wpasupplicant
    python3 python3-gi python3-gi-cairo python3-numpy python3-scapy python3-yaml
    plymouth plymouth-themes
)

if [ "${ORIONX_TRIM_LIB_ONLY:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

echo "=== 0900 trim: zero-regret debloat (DEC-PHASE12-015 / DEC-PHASE12-017) ==="
export DEBIAN_FRONTEND=noninteractive
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

_before=$(df -m / | awk 'NR==2{print $3}')

# ---------------------------------------------------------------------------
# 1. Package purges — simulated, protected, verified
# ---------------------------------------------------------------------------
PURGE_WANTED=(
    # zeek plugin-dev toolchain (0500 installs zeek-core now)
    zeek-zkg zeek-spicy-dev zeek-btest-data zeek-core-dev libbroker-dev
    # compilers + dev headers. NOT cpp: x11-xserver-utils (xrdb) needs it.
    gcc g++ gcc-14 g++-14 gcc-x86-64-linux-gnu g++-x86-64-linux-gnu
    gcc-14-x86-64-linux-gnu g++-14-x86-64-linux-gnu
    libc6-dev linux-libc-dev libstdc++-14-dev libgcc-14-dev libssl-dev
    libsystemd-dev manpages-dev
    # binwalk/scapy Recommends bloat (binwalk 3 is Rust; scapy runs without these)
    python3-scipy python3-matplotlib python3-matplotlib-inline python3-pyqtgraph
    python3-fonttools unicode-data
    # stray polkit agent + its OpenCV/GDAL tail
    ukui-polkit
    # @decision DEC-PHASE12-048 — no screen-lock mechanism on the live deck.
    # light-locker arrives as a Recommends of xfce4-session/task-xfce-desktop
    # on trixie and, after idle, hands the display to the LightDM greeter with
    # a password box over the Phoenix wallpaper — indistinguishable from a
    # failed autologin (reference deck, 2026-10-05). W11-2f (#76) disables
    # xfce4-screensaver only. Purging the locker means no mechanism exists;
    # xflock4 then finds no backend and locks nothing.
    light-locker
    # misc
    unhide.rb ruby3.3 libruby3.3 ruby
    mesa-vulkan-drivers firmware-nvidia-graphics
)
printf '%s\n' "${PURGE_WANTED[@]}" | trim_installed_only > "$WORK/targets"
# Remaining *-dev packages — each still has to pass the simulation guard
# (python3-numpy-dev is a hard dep of python3-numpy on trixie and will be kept).
dpkg-query -W -f='${Package}\n' 2>/dev/null | grep -E -- '-dev$' >> "$WORK/targets" || true
sort -u -o "$WORK/targets" "$WORK/targets"

# Protected set: everything apt considers manually installed + the critical set.
printf '%s\n' "${CRITICAL[@]}" | trim_installed_only > "$WORK/critical"
if [ -s "$WORK/critical" ]; then
    xargs -r apt-mark manual < "$WORK/critical" >/dev/null 2>&1 || true
fi
{ apt-mark showmanual 2>/dev/null || true; cat "$WORK/critical"; } | sort -u > "$WORK/protected"
echo "[trim] $(wc -l < "$WORK/targets") purge targets, $(wc -l < "$WORK/protected") protected packages"

simulate() {  # args: packages → writes $WORK/plan; prints removals
    apt-get -s -q purge --autoremove "$@" > "$WORK/plan" 2>/dev/null || true
    trim_plan_removals < "$WORK/plan" > "$WORK/removals"
    trim_blocked "$WORK/removals" "$WORK/protected" "$WORK/targets"
}

mapfile -t TARGETS < "$WORK/targets"
FINAL=()
if [ "${#TARGETS[@]}" -gt 0 ]; then
    blocked=$(simulate "${TARGETS[@]}")
    if [ -z "$blocked" ]; then
        FINAL=("${TARGETS[@]}")
    else
        echo "[trim] combined plan would remove protected packages: $(echo "$blocked" | tr '\n' ' ')"
        echo "[trim] falling back to per-target simulation..."
        for t in "${TARGETS[@]}"; do
            b=$(simulate "$t")
            if [ -n "$b" ]; then
                echo "[trim] SKIP $t — would remove protected: $(echo "$b" | tr '\n' ' ')"
            else
                FINAL+=("$t")
            fi
        done
        if [ "${#FINAL[@]}" -gt 0 ]; then
            b=$(simulate "${FINAL[@]}")
            if [ -n "$b" ]; then
                echo "WARNING: [trim] safe remainder still blocked in combination ($(echo "$b" | tr '\n' ' ')) — purging NOTHING" >&2
                FINAL=()
            fi
        fi
    fi
fi

if [ "${#FINAL[@]}" -gt 0 ]; then
    echo "[trim] purging ${#FINAL[@]} packages: ${FINAL[*]}"
    apt-get purge -y -q --autoremove "${FINAL[@]}" \
        || echo "WARNING: [trim] apt purge reported a problem — continuing (best-effort)" >&2
else
    echo "[trim] nothing to purge"
fi
apt-get autoremove -y -q --purge >/dev/null 2>&1 || true
apt-get clean
# Build-time caches that leaked into the dev7 squashfs: pip's wheel cache from
# the --break-system-packages installs (49 MB) and the throwaway ollama server
# log from 0510. Neither has any meaning on the booted deck.
rm -rf /root/.cache/pip /tmp/ollama-build-serve.log

# Outcome gate (DEC-PHASE12-017): every critical package that was installed
# before the purge must still be installed. A missing desktop fails the build.
MISSING=()
while IFS= read -r p; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed" || MISSING+=("$p")
done < "$WORK/critical"
if [ "${#MISSING[@]}" -gt 0 ]; then
    echo "FATAL: [trim] critical packages missing after purge: ${MISSING[*]}" >&2
    echo "FATAL: [trim] refusing to build an ISO without its desktop (DEC-PHASE12-017)" >&2
    exit 1
fi
echo "[trim] ✓ all $(wc -l < "$WORK/critical") critical packages still installed"
dpkg-query -W binwalk >/dev/null 2>&1 && echo "[trim] ✓ binwalk still installed" || echo "WARNING: [trim] binwalk missing after purge" >&2
[ -x /opt/zeek/bin/zeek ] && echo "[trim] ✓ zeek-core still present" || echo "WARNING: [trim] zeek binary missing after purge" >&2
[ -x /usr/local/bin/ollama ] && echo "[trim] ✓ ollama still present" || echo "WARNING: [trim] ollama missing" >&2
ls /usr/local/lib/ollama/libggml-cpu-*.so >/dev/null 2>&1 && echo "[trim] ✓ ollama CPU backends present" || echo "WARNING: [trim] ollama CPU backends missing" >&2

# ---------------------------------------------------------------------------
# 2. Locales: keep English only (the deck is en_US.UTF-8; i18n sources stay)
# ---------------------------------------------------------------------------
if [ -d /usr/share/locale ]; then
    _n=0
    for d in /usr/share/locale/*/; do
        b=$(basename "$d")
        case "$b" in en|en_*|en@*|locale.alias) ;; *) rm -rf "$d"; _n=$((_n+1)) ;;
        esac
    done
    echo "[trim] removed $_n non-English locale dirs"
fi

# ---------------------------------------------------------------------------
# 3. /usr/share/doc: keep every copyright file (licence compliance) and ALL of
#    /usr/share/doc/orionx (User Guide + images). Drop the rest.
# ---------------------------------------------------------------------------
if [ -d /usr/share/doc ]; then
    find /usr/share/doc -mindepth 1 \
        -not -path '/usr/share/doc/orionx' -not -path '/usr/share/doc/orionx/*' \
        -type f -not -name copyright -delete 2>/dev/null || true
    find /usr/share/doc -mindepth 1 -type d -empty -delete 2>/dev/null || true
    echo "[trim] /usr/share/doc pruned to copyright files + orionx docs ($(du -sh /usr/share/doc | cut -f1))"
fi

_after=$(df -m / | awk 'NR==2{print $3}')
echo "[trim] chroot usage: ${_before} MB -> ${_after} MB (freed $((_before - _after)) MB uncompressed)"
echo "=== 0900 trim complete ==="
