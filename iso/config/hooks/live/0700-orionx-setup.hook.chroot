#!/bin/bash
# shellcheck shell=bash
set -euo pipefail
#
# Orion-X Phoenix Edition — Application Layer Setup Hook
#
# @decision DEC-PHASE8-005
# @title Chroot hook: PATH symlinks, XDG desktop entries, MOTD, permissions
# @status accepted
# @rationale This hook is the single authority for wiring the staged
#   /opt/orionx/scripts/ content into the live system. It runs after
#   stage_application_content() has placed content into includes.chroot
#   (which live-build copies into the chroot before hooks execute).
#   Responsibilities:
#     1. PATH symlinks in /usr/bin/ so scripts are available system-wide.
#     2. XDG .desktop entries so the XFCE launcher shows Orion-X apps.
#     3. MOTD / welcome message referencing the orionx-help function.
#     4. Permissions: 755 on scripts, 644 on data/docs.
#   No other hook creates symlinks in /usr/bin/ for Orion-X tools (single
#   authority). Lexical position 0700 ensures this runs after all service
#   hooks (0500–0620) and after the application content is in place.
#   Idempotent: ln -sf overwrites existing symlinks safely.
#
# @decision DEC-PHASE9-001
# @title Terminal emulator: xfce4-terminal replaces lxterminal
# @status accepted
# @rationale rc3 post-boot analysis showed all .desktop Exec lines used
#   lxterminal which is NOT installed in the ISO. The ISO includes xfce4-terminal
#   (already in the package list). Switching to xfce4-terminal with
#   `xfce4-terminal --hold -e "bash -c '<cmd>; exec bash'"` keeps the window
#   open after the tool exits so the user can read output. The --hold flag
#   prevents the terminal window from closing immediately; exec bash gives
#   a live shell when the command finishes. lxterminal is removed from ALL
#   .desktop Exec lines and all associated stale comments. Single authority:
#   0700 is the only hook that creates /usr/share/applications/ .desktop entries
#   for Orion-X tools.
#
# Production sequence:
#   1. stage_application_content (build host) rsyncs source into includes.chroot/
#   2. live-build copies includes.chroot/ into the chroot filesystem
#   3. live-build runs hooks 0500–0620 (external tools, hardening, systemd)
#   4. THIS HOOK (0700) runs: wires scripts into PATH, creates .desktop entries
#   5. live-build compresses the chroot into filesystem.squashfs

echo "[orionx-setup] Starting application layer setup..."

# ---------------------------------------------------------------------------
# 1. PATH symlinks in /usr/bin/
#    Each Orion-X script gets a symlink in /usr/bin/ for zero-prefix access.
#    The mesh CLI lives in scripts/mesh/orionx-mesh; all others are at the
#    scripts/ root.
# ---------------------------------------------------------------------------
echo "[orionx-setup] Creating PATH symlinks..."

declare -A SCRIPT_MAP=(
    ["orionx-mesh"]="/opt/orionx/scripts/mesh/orionx-mesh"
    ["setup-wireguard.sh"]="/opt/orionx/scripts/setup-wireguard.sh"
    ["setup-matrix.sh"]="/opt/orionx/scripts/setup-matrix.sh"
    ["artifact-analyzer.py"]="/opt/orionx/scripts/artifact-analyzer.py"
    ["storyboard-gen.py"]="/opt/orionx/scripts/storyboard-gen.py"
    ["toggle-theme.sh"]="/opt/orionx/scripts/toggle-theme.sh"
    ["run-lynis.sh"]="/opt/orionx/scripts/run-lynis.sh"
    ["download-samples.sh"]="/opt/orionx/scripts/download-samples.sh"
    # W9-2a: pcap-analyzer.py — modernized STA PCAP analysis tool (DEC-PHASE9-017)
    # Replaces gecko/bin/analyze-pcap.sh with a clean Python 3 tool wrapping
    # tshark (already installed) + optional tcpdump. CLI-only; no .desktop
    # launcher here — that is deferred to the W9-2 Control Center slice.
    ["pcap-analyzer.py"]="/opt/orionx/scripts/pcap-analyzer.py"
    # W9-2: GTK Orion-X Control Center — one-click cyberdeck control surface.
    # Launches directly as a GTK window (no xfce4-terminal wrapper needed).
    # Phase 10 slices (W10-1 through W10-6) plug into its placeholder sections.
    # @decision DEC-PHASE10-005: Control Center ships ahead of Nebula AI runtime.
    ["orionx-control-center"]="/opt/orionx/scripts/control_center/orionx-control-center"
    # W10-1: Nebula AI CLI dispatcher — single PATH entry for the nebula tool.
    # @decision DEC-PHASE10-008: scripts/nebula/ is the single source tree for
    # Nebula control-plane Python; the nebula dispatcher is the operator entrypoint.
    # nebula-mcp and other W10-3+ tools get their own PATH entries in later slices.
    ["nebula"]="/opt/orionx/scripts/nebula/nebula"
    # W11-4 Layer A: YARA ruleset freshen script (DEC-PHASE11-005).
    # Operators run `sudo orionx-freshen-yara` post-boot to populate rules-*/
    # directories under /opt/orionx/yara/. Layer B (W11-4b) will automate this
    # at build time via git clone. Single PATH entry; no .desktop launcher needed
    # (this is a root-only maintenance command, not an end-user GUI tool).
    ["orionx-freshen-yara"]="/opt/orionx/scripts/orionx-freshen-yara.sh"
    # W11-6 Layer A: Suricata IDS freshen script (DEC-PHASE11-008).
    # Operators run `sudo orionx-freshen-suricata` post-boot to fetch ET-Open
    # rules (BSD-2-Clause) from emergingthreats.net. Layer B (W11-6b) will
    # automate this at build time and wire the Nebula tier selector. Single
    # PATH entry; no .desktop launcher needed (root-only maintenance command).
    ["orionx-freshen-suricata"]="/opt/orionx/scripts/orionx-freshen-suricata.sh"
    # W11-11 Layer A: In-ISO diagnostic tool (DEC-PHASE11-015).
    # Operators run `sudo orionx-diag` post-boot to verify that the running
    # system matches the build manifest and all Phase 11 slice tools are present
    # and functional. Supports --json (Control Center Awareness pane, W11-11b)
    # and --category <name> for iterative debugging. No .desktop launcher
    # (root-only diagnostic command). Source at /opt/orionx/scripts/ — no .sh
    # suffix per the orionx-mesh precedent.
    ["orionx-diag"]="/opt/orionx/scripts/orionx-diag"
    ["orionx-scanwatch"]="/opt/orionx/scripts/rain/orionx-scanwatch"
    # W10-6 (DEC-PHASE12-023): orionx-heal is the operator control surface
    # (status/confirm/undo/verify/log); orionx-heald is the daemon, symlinked
    # so `orionx-heald --dry-run` is runnable by hand.
    ["orionx-heal"]="/opt/orionx/scripts/healing/orionx-heal"
    ["orionx-heald"]="/opt/orionx/scripts/healing/orionx-heald"
    # W10-5 (DEC-PHASE12-024): posture enforcement daemon.
    ["orionx-postured"]="/opt/orionx/scripts/awareness/orionx-postured"
    # DEC-PHASE12-050: operator squelch/tune of IDS alerts (no root needed).
    ["orionx-tune"]="/opt/orionx/scripts/awareness/orionx-tune"
    # DEC-PHASE12-028: bounded on-demand PCAP capture control surface.
    ["orionx-capture"]="/opt/orionx/scripts/awareness/orionx-capture"
    # DEC-PHASE12-027: forensic log correlation + its intel refresh. The
    # refresh is a script on PATH, not a timer, deliberately — when the deck
    # reaches out to the network is a Shields Up decision that stays with the
    # operator, same as orionx-freshen-yara/suricata.
    ["orionx-logquery"]="/opt/orionx/scripts/logquery/orionx-logquery"
    ["orionx-freshen-intel"]="/opt/orionx/scripts/logquery/orionx-freshen-intel"
    # NOTE: the confined MCP server deliberately gets NO SCRIPT_MAP entry here.
    # test_orionx_setup_hook_unit.sh asserts one is absent, and the entrypoint
    # ships directly at /usr/bin/nebula-mcp via includes.chroot so its AppArmor
    # attachment path is honest. (Spelling the map key literally in this
    # comment would itself trip that grep-based assertion.)
    # First-boot wizard — was only reachable by full path (/opt/orionx/scripts/
    # security/first-boot-wizard.sh), painful on a console with no copy-paste
    # (operator report 2026-09-12). Give it a short PATH name so it is runnable
    # as `sudo orionx-wizard` (DEC-PHASE11-037).
    ["orionx-wizard"]="/opt/orionx/scripts/security/first-boot-wizard.sh"
    # R.A.I.N. — event-bus emitter + audible-alert daemon (#88, DEC-PHASE11-045)
    ["orionx-event"]="/opt/orionx/scripts/rain/orionx-event"
    ["orionx-rain"]="/opt/orionx/scripts/rain/orionx-rain"
    # Orion Cockpit — live visualisation dashboard (DEC-PHASE12-007)
    ["orionx-cockpit"]="/opt/orionx/scripts/cockpit/orionx-cockpit"
    # zeek installs under /opt/zeek (OpenSUSE Debian_13 repo, DEC-PHASE12-003),
    # which is not on PATH. The loop below skips absent sources, so this stays
    # safe when the zeek repo soft-fails. Verified present in trixie-dev4.
    ["zeek"]="/opt/zeek/bin/zeek"
    ["zeek-cut"]="/opt/zeek/bin/zeek-cut"
    # nucleotide — Nuclei-scan attribution/fingerprinting (roadmap #89, DEC-PHASE12-012)
    ["nucleotide"]="/opt/orionx/scripts/nucleotide/nucleotide-cli"
    ["orionx-nucleotide-watch"]="/opt/orionx/scripts/nucleotide/orionx-nucleotide-watch"
    # Pivotglass — AI-augmented adversary-infrastructure hunting (roadmap #90, DEC-PHASE12-013)
    ["ap"]="/opt/orionx/scripts/pivotglass/ap"
    ["pivotglass"]="/opt/orionx/scripts/pivotglass/ap"
)

for name in "${!SCRIPT_MAP[@]}"; do
    src="${SCRIPT_MAP[$name]}"
    if [[ -f "$src" ]]; then
        chmod +x "$src"
        ln -sf "$src" "/usr/bin/${name}"
        echo "  [orionx-setup] symlinked: /usr/bin/${name} -> $src"
    else
        echo "  [orionx-setup] WARNING: source not found, skipping symlink for ${name}: $src"
    fi
done

# ---------------------------------------------------------------------------
# 2. XDG Desktop entries in /usr/share/applications/
#    Each major Orion-X tool gets a .desktop entry so it appears in the XFCE
#    application menu. Terminal emulator: xfce4-terminal (installed in ISO).
#    Syntax: xfce4-terminal --hold -e "bash -c '<cmd>; exec bash'"
#    --hold: keeps window open after the command exits.
#    exec bash: provides a live shell on completion so the user can read output.
#    No lxterminal — it is NOT installed in the Orion-X ISO.
# ---------------------------------------------------------------------------
echo "[orionx-setup] Creating XDG desktop entries..."
mkdir -p /usr/share/applications

cat > /usr/share/applications/orionx-mesh.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Orion-X Mesh
Comment=WireGuard P2P mesh management
Exec=xfce4-terminal --hold -e "bash -c 'orionx-mesh; exec bash'"
Icon=network-workgroup
Categories=X-Orion;
DESKTOP_EOF

cat > /usr/share/applications/orionx-setup-matrix.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Orion-X Matrix Setup
Comment=Set up Matrix/Synapse communication server
Exec=xfce4-terminal --hold -e "bash -c 'setup-matrix.sh; exec bash'"
Icon=internet-chat
Categories=X-Orion;
DESKTOP_EOF

cat > /usr/share/applications/orionx-artifact-analyzer.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Orion-X Artifact Analyzer
Comment=Forensic artifact analysis tool
Exec=xfce4-terminal --hold -e "bash -c 'artifact-analyzer.py; exec bash'"
Icon=utilities-file-archiver
Categories=X-Orion;
DESKTOP_EOF

cat > /usr/share/applications/orionx-storyboard-gen.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Orion-X Storyboard Generator
Comment=Generate intelligence storyboards from forensic data
Exec=xfce4-terminal --hold -e "bash -c 'storyboard-gen.py; exec bash'"
Icon=text-editor
Categories=X-Orion;
DESKTOP_EOF

# One-click mesh launcher — invokes the existing orionx-mesh entrypoint with sudo.
# orionx user is in the sudo group (passwordless), so sudo works without a prompt.
# The 'join' subcommand is the primary production use-case: bring up the mesh.
cat > /usr/share/applications/orionx-start-mesh.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Orion-X — Start Mesh
Comment=Start Orion-X WireGuard mesh (one-click)
Exec=xfce4-terminal --hold -e "bash -c 'sudo orionx-mesh join; exec bash'"
Icon=network-wireless
Categories=X-Orion;
DESKTOP_EOF

# GTK Control Center — launches directly as a GTK window, NOT via xfce4-terminal.
# DEC-PHASE9-006: no lxterminal in any Exec line (lxterminal is NOT installed).
# DEC-PHASE10-005: Control Center ships ahead of Phase 10 Nebula AI; Nebula
# and Auto-Healing sections are placeholders that W10-1..W10-6 populate.
# DEC-PHASE12-053: the tabs live in the Orion Cockpit; this entry opens it on a
# tab. This hook is the ONLY writer of this file — rc7 shipped the old entry
# because a static copy in includes.chroot was edited while this heredoc
# silently overwrote it at build time (two authorities). The static copy is gone.
cat > /usr/share/applications/orionx-control-center.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Orion Cockpit — Tabs
Comment=Mesh, Comms, Awareness, Orion Tools, Nebula AI and Auto-Healing — the Cockpit's tabs (the former Control Center)
Exec=/usr/bin/orionx-cockpit --tab network
Icon=/usr/share/pixmaps/orionx.png
Categories=X-Orion;
DESKTOP_EOF

# Orion Cockpit — live "see and hear" visualisation of cyber activity (event
# stream, threat gauge, network sparkline, mesh/system status). GTK+Cairo app,
# launches directly (DEC-PHASE12-007). Grouped under the Orion menu.
cat > /usr/share/applications/orionx-cockpit.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Orion Cockpit
Comment=Live cockpit — see and hear the cyber activity around you
Exec=/usr/bin/orionx-cockpit
Icon=/usr/share/pixmaps/orionx.png
Categories=X-Orion;
DESKTOP_EOF

# Pivotglass — adversary-infrastructure hunting; `ap web` serves its local
# browser cockpit on 127.0.0.1:8765 and opens it (DEC-PHASE12-013). Grouped
# under the Orion menu.
cat > /usr/share/applications/orionx-pivotglass.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=Pivotglass
Comment=AI-augmented hunting of adversary infrastructure, indicators and TTPs
Exec=/usr/bin/ap web
Icon=/usr/share/pixmaps/orionx.png
Categories=X-Orion;
DESKTOP_EOF

# ---------------------------------------------------------------------------
# 3. MOTD / welcome message
#    References orionx-help so users know the entry point.
#    Mirrors the Dockerfile ENV/RUN pattern for the dev container.
# ---------------------------------------------------------------------------
echo "[orionx-setup] Installing MOTD..."
mkdir -p /etc/update-motd.d/

# Write /etc/orionx-version as a KEY=VALUE manifest so MOTD and orionx-diag
# can read structured build metadata without adding jq/python dependencies.
# Schema extended by W11-11 (DEC-PHASE11-015): ISO_VERSION is the first line
# (backward-compat: MOTD grep-reads it; old `cat` readers see a multi-line file
# and use fallback value per the grep reader change in T2c below).
# Authority: 0700 hook is the ONLY writer of /etc/orionx-version; MOTD and
# orionx-diag are readers. No second manifest file is created (DEC-PHASE11-015
# single-authority discipline — rejected alternatives: /etc/orionx-manifest,
# /etc/orionx-version.json).
# Build metadata arrives as a STAGED FILE, not as environment variables
# (DEC-PHASE11-020). Chroot hooks do not inherit the invoking shell's environment,
# so the previous env-only path always produced ISO_VERSION=v2.0.0-rc8 and
# GIT_HEAD_SHA=unknown regardless of what build-iso.sh exported. The fragment is
# written by stage_build_env() and consumed (then deleted) here, so this hook
# remains the single writer of /etc/orionx-version per DEC-PHASE11-015.
if [ -r /etc/orionx-build-env ]; then
    # shellcheck disable=SC1091  # generated at build time; not present in the repo
    . /etc/orionx-build-env
    echo "[0700] build env loaded: ORIONX_VERSION=${ORIONX_VERSION:-unset} GIT_SHA=${ORIONX_GIT_SHA:-unset}"
else
    echo "[0700] WARNING: /etc/orionx-build-env absent — /etc/orionx-version will report defaults" >&2
fi
cat > /etc/orionx-version << VERSION_EOF
ISO_VERSION=${ORIONX_VERSION:-v2.0.0-rc8}
BUILD_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
GIT_HEAD_SHA=${ORIONX_GIT_SHA:-unknown}
GIT_HEAD_TITLE=${ORIONX_GIT_TITLE:-unknown}
PHASE_11_SLICES=${ORIONX_PHASE_11_SLICES:-unknown}
VERSION_EOF
chmod 644 /etc/orionx-version
# The fragment is a build-time input, not shipped state — remove it so the ISO
# carries exactly one metadata surface (DEC-PHASE11-015 single-authority).
rm -f /etc/orionx-build-env

cat > /etc/update-motd.d/10-orionx-welcome << 'MOTD_EOF'
#!/bin/bash
# W11-11 T2c: grep-reads the ISO_VERSION key from the KEY=VALUE manifest written
# by the 0700 hook. Backward-compat: if /etc/orionx-version is the legacy
# single-line format (pre-W11-11), grep returns nothing and fallback 'v2.0.0'
# is used — MOTD continues to render (acceptable degrade on legacy image).
ORIONX_VER="$(grep '^ISO_VERSION=' /etc/orionx-version 2>/dev/null | cut -d= -f2 || echo v2.0.0)"
cat << EOF
  ___      _               __  __
 / _ \ _ _(_)___ _ _      \ \/ /
| (_) | '_| / _ \ ' \      >  <
 \___/|_| |_\___/_||_|    /_/\_\
Orion-X Phoenix Edition ${ORIONX_VER}

Quick start:
  orionx-mesh       — WireGuard P2P mesh management
  setup-matrix.sh   — Matrix/Synapse setup
  artifact-analyzer.py — Forensic artifact analysis
  pcap-analyzer.py  — Structured PCAP traffic analysis (STA)
  storyboard-gen.py — Generate storyboards

Type 'orionx-help' for the full command reference.
Docs: /usr/share/doc/orionx/User_Guide.md
EOF
MOTD_EOF
chmod 755 /etc/update-motd.d/10-orionx-welcome

# Provide the orionx-help bashrc function (matches Dockerfile pattern)
cat > /etc/profile.d/orionx-help.sh << 'HELP_EOF'
# Orion-X help function — available in all interactive shells
orionx-help() {
    echo ""
    echo "Orion-X Phoenix Edition — Command Reference"
    echo "==========================================="
    echo "  orionx-mesh          WireGuard P2P mesh (join/leave/status/discover)"
    echo "  setup-wireguard.sh   WireGuard interface setup"
    echo "  setup-matrix.sh      Matrix/Synapse server setup"
    echo "  artifact-analyzer.py Forensic artifact analysis"
    echo "  pcap-analyzer.py     Structured PCAP traffic analysis (STA, Bejtlich method)"
    echo "  storyboard-gen.py    Intelligence storyboard generation"
    echo "  toggle-theme.sh      Toggle light/dark desktop theme"
    echo "  run-lynis.sh         Run Lynis security audit"
    echo "  download-samples.sh  Download forensic sample datasets"
    echo ""
    echo "Docs:   /usr/share/doc/orionx/User_Guide.md"
    echo "Data:   /opt/orionx/data/samples/"
    echo "Theme:  /opt/orionx/theme/"
    echo ""
}
export -f orionx-help 2>/dev/null || true
HELP_EOF
chmod 644 /etc/profile.d/orionx-help.sh

# ---------------------------------------------------------------------------
# 4. Set permissions
#    Scripts: 755 (executable), data and docs: 644
#    If the orionx user exists (created by 0100-create-user), set ownership.
# ---------------------------------------------------------------------------
echo "[orionx-setup] Setting permissions..."

if [[ -d /opt/orionx/scripts ]]; then
    find /opt/orionx/scripts -type f -exec chmod 755 {} \;
fi

if [[ -d /opt/orionx/data ]]; then
    find /opt/orionx/data -type f -exec chmod 644 {} \;
fi

if [[ -d /usr/share/doc/orionx ]]; then
    find /usr/share/doc/orionx -type f -exec chmod 644 {} \;
fi

if [[ -d /opt/orionx/theme ]]; then
    find /opt/orionx/theme -type f -exec chmod 644 {} \;
fi

# DEC-PHASE12-108 (security F20): a latent `chown -R orionx:orionx /opt/orionx`
# (guarded on a user named "orionx", which does not exist) stood here. Had
# anyone "fixed" the name, every script root units execute (postured, heald,
# the wizard) would have become operator-writable: a local privilege
# escalation. /opt/orionx stays root-owned. Removed, not disabled.

# ---------------------------------------------------------------------------
# Completion marker (greppable from CI log)
# ---------------------------------------------------------------------------
echo "[orionx-setup] application layer setup complete"
