#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail
#
# Orion-X Phoenix Edition — Service Hardening Hook
#
# @decision DEC-SEC-SVC-001
# @title Disable unnecessary services, harden SSH and sysctl
# @status accepted
# @rationale Minimize attack surface. Only WireGuard, Matrix, and
#   forensic tools should be active. SSH hardened for key-only auth.

echo "[*] Applying service hardening..."

# 1. Disable unnecessary services
for svc in avahi-daemon cups bluetooth ModemManager; do
    if systemctl list-unit-files "$svc.service" &>/dev/null 2>&1; then
        systemctl disable "$svc.service" 2>/dev/null || true
        systemctl mask "$svc.service" 2>/dev/null || true
        echo "  Disabled: $svc"
    fi
done

# 2. Harden SSH configuration
SSHD_CONFIG="/etc/ssh/sshd_config"
if [ -f "$SSHD_CONFIG" ]; then
    cat > /etc/ssh/sshd_config.d/orionx-hardening.conf << 'EOF'
# Orion-X SSH Hardening
PermitRootLogin no
PasswordAuthentication no
MaxAuthTries 3
X11Forwarding no
AllowAgentForwarding no
ClientAliveInterval 300
ClientAliveCountMax 2
LoginGraceTime 30
EOF
    echo "  SSH hardened: key-only, no root, MaxAuthTries=3"
fi

# 3. Kernel sysctl hardening
cat > /etc/sysctl.d/60-orionx-hardening.conf << 'EOF'
# Orion-X kernel hardening
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.tcp_syncookies = 1
kernel.randomize_va_space = 2
kernel.kptr_restrict = 2
kernel.yama.ptrace_scope = 1
EOF
    echo "  Sysctl hardening applied"

# 4. Systemd unit hardening — REMOVED. It never ran, and could not have.
#
# @decision DEC-PHASE12-039
# @title Unit hardening belongs in the unit file, not in a build-time injector
# @status accepted
# @rationale This hook used to append ProtectSystem=strict / NoNewPrivileges /
#   ProtectHome to `/etc/systemd/system/orionx-mesh-*.service`. That glob has
#   never matched anything. 0615-install-systemd-units.hook.chroot installs
#   units to /lib/systemd/system (its TARGET_DIR), and `systemctl enable` only
#   creates symlinks under /etc/systemd/system/<target>.wants/ — never
#   /etc/systemd/system/<unit>.service. The loop body was dead on every build
#   since the hook was written.
#
#   tests/unit/test_service_hardening.sh asserted the string
#   "ProtectSystem=strict" appeared in THIS FILE's text, so it stayed green for
#   the life of the project while the mesh units ran entirely unconfined. That
#   is the AppArmor defect shape exactly (RESILIENCE.md rule 1).
#
#   Had it ever fired it would also have been wrong: ProtectSystem=strict
#   makes the whole hierarchy read-only bar /dev, /proc and /sys, which breaks
#   mesh-discover.sh's PID file, mesh-health.sh's counters, and wg-quick.
#   A blind append could not have known that.
#
#   Two authorities decided one fact; this was the broken one. The unit files
#   are the surviving authority, 0615 copies them verbatim, and the test
#   asserts the directives in the units themselves.
#
# @decision DEC-PHASE12-041
# @title The mesh-unit hardening gap recorded above is now CLOSED
# @status accepted
# @rationale orionx-mesh-health.service, orionx-mesh-discover.service and
#   orionx-mesh-beacon.service now each carry a confinement block justified
#   line by line against the script it confines (ProtectSystem=strict with a
#   RuntimeDirectory and LogsDirectory for exactly what they write, and a
#   CapabilityBoundingSet that differs per unit: CAP_NET_ADMIN+CAP_NET_RAW for
#   health, CAP_NET_ADMIN for the listener, neither for the beacon, which only
#   reads addresses and sends a datagram).
#
#   What made that possible was removing wg-quick from mesh-health.sh. wg-quick
#   runs sysctl, iptables/nft and resolvconf, which is not boundable without a
#   live wg0; `ip link set wg0 down/up` is, and it preserves the peers.
#   ProtectKernelModules is deliberately NOT set, because interface restore
#   relies on the kernel autoloading the wireguard module.
#
#   Still nothing is injected from here. The units remain the single authority.

echo "[*] Service hardening complete (unit directives live in the unit files)"
