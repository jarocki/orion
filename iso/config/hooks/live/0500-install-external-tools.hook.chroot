#!/bin/bash
# shellcheck shell=bash
# Install tools the Debian 13 (trixie) archive does not provide, or provides
# unusably, from upstream sources during the ISO build.
#
# @decision DEC-PHASE10-007
# @title ollama .deb staging: fail-LOUD on fetch/verify failure
# @status accepted
# @rationale Debian does not ship ollama via apt (true of bullseye and trixie). The binary .deb is
#   downloaded and installed here during the chroot phase so ollama ends up in
#   the squashfs image. Unlike zeek (soft-fail, warn-and-continue), ollama is
#   LOAD-BEARING for the v2.0.0 Nebula AI headline feature: if ollama is absent,
#   nebula-runtime.service will never start and the Control Center will show
#   "Runtime: down" indefinitely. Therefore: install failure = LOUD (build aborts
#   with non-zero exit), not soft. References: DEC-PHASE10-007.
#
# @decision DEC-PHASE11-004
# @title Ghidra bulk staging deferred from base ISO to W11-8 optional installer
# @status accepted
# @rationale W11-2 debloat pass removes Ghidra from the base ISO to reduce size
#   per DEC-PHASE11-003. Ghidra (~500 MB download + JRE) is an optional reverse-
#   engineering tool that does not serve the core forensic/network mission without
#   prior operator context. Post-boot operators who need Ghidra run:
#     /opt/orionx/optional/install-ghidra.sh
#   That script (W11-8) follows the optional-installer framework convention:
#   preflight banner + network check + sentinel drop. References: DEC-PHASE11-004.

set -euo pipefail

# --- Library (sourceable: ORIONX_0500_LIB_ONLY=1 stops after the definitions,
# so tests/unit/test_external_tools_hook.sh can exercise them with stubs) ---
PIP_LOCKS="${PIP_LOCKS:-/usr/share/orionx/pip}"
pip_locked() {  # <pip executable> <set> [extra pip args...]
    local pip="$1" set="$2"; shift 2
    if [[ ! -f "$PIP_LOCKS/$set.txt" ]]; then
        echo "FATAL: pip lock $PIP_LOCKS/$set.txt missing (DEC-PHASE12-116)" >&2
        return 1
    fi
    "$pip" install --no-input --require-hashes --no-deps "$@" -r "$PIP_LOCKS/$set.txt"
}
make_venv() {  # <dir>
    python3 -m venv "$1" || { echo "FATAL: venv creation failed for $1" >&2; return 1; }
    [[ -x "$1/bin/pip" ]] || { echo "FATAL: venv $1 has no pip (python3-venv missing?)" >&2; return 1; }
}
ZEEK_INSTALLER="${ZEEK_INSTALLER:-/opt/orionx/optional/install-zeek.sh}"
zeek_pin() { sed -n "s/^$1=\"\\(.*\\)\"\$/\\1/p" "$ZEEK_INSTALLER" | head -1; }
install_zeek() {
    local fpr_pin key_url base keyring source_list key actual
    fpr_pin="$(zeek_pin ZEEK_REPO_KEY_FPR)"; key_url="$(zeek_pin ZEEK_REPO_KEY_URL)"
    base="$(zeek_pin ZEEK_REPO_BASE)"; keyring="$(zeek_pin ZEEK_KEYRING)"
    source_list="$(zeek_pin ZEEK_SOURCE_LIST)"
    [[ -n "$fpr_pin" && -n "$key_url" && -n "$base" && -n "$keyring" && -n "$source_list" ]] || {
        echo "[zeek] pins not readable from $ZEEK_INSTALLER" >&2; return 1; }
    key="$(mktemp)"
    wget -qO "$key" "$key_url" || { echo "[zeek] key fetch failed: $key_url" >&2; rm -f "$key"; return 1; }
    actual="$(gpg --show-keys --with-colons "$key" 2>/dev/null | awk -F: '$1=="fpr" {print $10; exit}')"
    if [[ "$actual" != "$fpr_pin" ]]; then
        echo "[zeek] KEY FINGERPRINT MISMATCH: expected $fpr_pin, got ${actual:-none}" >&2
        rm -f "$key"; return 1
    fi
    gpg --dearmor < "$key" > "$keyring" || { rm -f "$key"; return 1; }
    rm -f "$key"
    chmod 0644 "$keyring" || return 1
    printf '# Written by 0500 at build time; managed by %s.\ndeb [signed-by=%s] %s/ /\n' \
        "$ZEEK_INSTALLER" "$keyring" "$base" > "$source_list" || return 1
    apt-get update || return 1
    # zeek-core, NOT the `zeek` metapackage: the latter pulls zeek-zkg (plugin
    # package manager) → zeek-spicy-dev (194 MB) + btest-data (40 MB) + a full
    # gcc/g++ toolchain + git — plugin-building kit that an air-gapped live deck
    # never uses. zeek-core is the analyzer itself (/opt/zeek/bin/zeek, zeek-cut).
    # (DEC-PHASE12-015; leftovers are purged by 0900-trim as belt-and-suspenders.)
    apt-get install -y --no-install-recommends zeek-core || return 1
    /opt/zeek/bin/zeek --version || return 1
}
zeek_rollback() {  # leave no dangling apt source or keyring (incl. the pre-117 paths)
    rm -f "$(zeek_pin ZEEK_SOURCE_LIST)" "$(zeek_pin ZEEK_KEYRING)" \
          /etc/apt/sources.list.d/zeek.list /etc/apt/trusted.gpg.d/zeek.gpg
    apt-get update >/dev/null 2>&1 || true
}

if [[ "${ORIONX_0500_LIB_ONLY:-}" == "1" ]]; then
    # shellcheck disable=SC2317  # reachable when sourced
    return 0 2>/dev/null || exit 0
fi

echo "=== Installing external tools ==="

# ---------------------------------------------------------------------------
# @decision DEC-PHASE12-116
# @title Hash-locked pip installs, hard-fail, and volatility3 out of system Python
# @status accepted
# @rationale Every pip install in this hook was unpinned (packages-build P2-4,
#   security F13), and volatility3 + stix2/pyfiglet were SOFT-fail: one WARNING
#   line among 11k and the build stayed green without a tool the README lists
#   (P1-3). Now each install reads a committed lock from
#   /usr/share/orionx/pip/<set>.txt (generated by scripts/release/pip-lock.py
#   from the exact versions v2.2.0-rc9 resolved; it ships in the image as the
#   record of what was installed) with --require-hashes --no-deps, and each is
#   hard-fail with a run-the-tool check afterwards (the DEC-PHASE11-018 rule
#   for capa applies to every README-promised tool):
#     forensics  -> /opt/orionx/venv/forensics, vol/volshell symlinked into
#                   /usr/local/bin (the User Guide and Cockpit call `vol`)
#     pivotglass -> system Python, the one deliberate exception: `ap` runs
#                   `python3 -m pivotglass` on apt-provided deps
#                   (DEC-PHASE12-013); --no-deps keeps pip to these 4 packages
#     re, comms  -> the capa and matrix-commander venvs, as before
#   A PyPI outage now fails the build; that is the intended trade (an image
#   without its forensics tools is not a release). Verified 2026-10-07 in
#   debian:trixie-slim amd64: all four locks install, `vol -h`, `capa
#   --version`, `matrix-commander --version` and the Pivotglass import + font
#   probe pass, and no stdlib-shadowing module is left in the comms venv.
# ---------------------------------------------------------------------------

# Volatility3 -> its own venv; `vol` stays on PATH at /usr/local/bin/vol.
echo "=== volatility3 -> /opt/orionx/venv/forensics (DEC-PHASE12-116) ==="
make_venv /opt/orionx/venv/forensics || exit 1
pip_locked /opt/orionx/venv/forensics/bin/pip forensics || {
    echo "FATAL: volatility3 install failed — the README promises vol (DEC-PHASE12-116)" >&2; exit 1; }
for b in vol volshell; do
    [[ -x "/opt/orionx/venv/forensics/bin/$b" ]] || { echo "FATAL: venv has no $b" >&2; exit 1; }
    ln -sf "/opt/orionx/venv/forensics/bin/$b" "/usr/local/bin/$b"
done
/usr/local/bin/vol -h >/dev/null || { echo "FATAL: vol -h does not run" >&2; exit 1; }
echo "[volatility3] installed: $(/opt/orionx/venv/forensics/bin/python -c 'import volatility3.framework as f; print(f.constants.PACKAGE_VERSION)' 2>/dev/null || echo 'version unknown')"

# Pivotglass deps that trixie apt cannot provide correctly (roadmap #90,
# DEC-PHASE12-013):
#   stix2     — absent from trixie (+ stix2-patterns, antlr4 runtime); its other
#               transitive deps (requests, pytz, simplejson) come from apt.
#   pyfiglet  — PRESENT in trixie but as a +dfsg repack that strips the
#               contributed fonts; `ap tui`/`ap chat` load "ansi_shadow" at import
#               and die with pyfiglet.FontNotFound. Upstream pip ships all fonts.
# System Python by design (see DEC-PHASE12-116); hard-fail: without these `ap`
# cannot start.
echo "=== Pivotglass deps (stix2, pyfiglet) -> system Python, hash-locked ==="
pip_locked pip3 pivotglass --break-system-packages || {
    echo "FATAL: stix2/pyfiglet install failed — Pivotglass (ap) would be broken (DEC-PHASE12-116)" >&2; exit 1; }
python3 -c "import stix2, stix2patterns, pyfiglet; pyfiglet.Figlet(font='ansi_shadow')" || {
    echo "FATAL: stix2/pyfiglet installed but the import + ansi_shadow probe fails" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Zeek (OpenSUSE Build Service repo).
#
# @decision DEC-PHASE12-117
# @title Zeek at build time: pinned key fingerprint, signed-by scope, and a
#   soft-fail that actually rolls back
# @status accepted
# @rationale The old block piped the OBS key into /etc/apt/trusted.gpg.d/,
#   which trusts it for EVERY repo, with no fingerprint check (security F11),
#   and ran as `{ A; B; C; } || { cleanup; }`: errexit is suspended on the left,
#   so a failed key fetch still wrote zeek.list and ran apt-get update, and the
#   cleanup ran only if the LAST command failed (shell P2-2). Now the steps are
#   a function where every step returns on failure; the key is accepted only if
#   its fingerprint equals the pin, dearmored into its own keyring, and the
#   source line is scoped with signed-by=. The pins (fingerprint, URLs, keyring
#   and source paths) are READ from /opt/orionx/optional/install-zeek.sh, the
#   one authority for them, so build time and the post-boot installer cannot
#   drift. Still soft-fail (DEC-PHASE12-003: a third-party repo outage must not
#   block the ISO), but loudly, and the content-presence gate fails a release
#   image without /opt/zeek/bin/zeek.
# ---------------------------------------------------------------------------
if install_zeek; then
    echo "[zeek] installed from the fingerprint-pinned OBS repo (DEC-PHASE12-117)"
else
    echo "SOFT-FAIL: zeek NOT installed — OBS Debian_13 repo or key unavailable or untrusted (DEC-PHASE12-117)." >&2
    echo "           The release content-presence gate will fail this image; /opt/orionx/optional/install-zeek.sh installs it post-boot." >&2
    zeek_rollback
fi

# Autopsy (requires Java, complex install — placeholder)
echo "NOTE: Autopsy requires manual installation. See docs/INSTALL_AUTOPSY.md"

# ---------------------------------------------------------------------------
# Ollama — Nebula AI runtime daemon (DEC-PHASE10-007)
#
# ollama is NOT in the Debian apt archive; we download the official
# .tar.zst release archive from the ollama GitHub releases channel and
# extract the binary to /usr/local/bin. This is a LOUD-FAILURE block: if
# ollama cannot be installed, the build ABORTS (exit non-zero). This is an
# intentional divergence from the soft-fail zeek block above — see
# file header.
#
# NOTE: ollama never shipped a .deb for any release. The 0.3.x → 0.30.x
# version jump (Nov 2025) also changed the distribution archive from .tgz
# to .tar.zst. The correct asset name is ollama-linux-amd64.tar.zst for
# v0.24.0+. This hook was updated from the non-existent .deb URL in iter-7
# (W10-1) after CI reported a 404 on every build (closes #61 follow-up).
#
# Pinned version: 0.30.7 (2026-06 release; SHA-256 pinned below, and shipped
#                 on every trixie rc build since)
# URL: https://github.com/ollama/ollama/releases/download/v0.30.7/ollama-linux-amd64.tar.zst
# SHA-256: pinned in OLLAMA_TGZ_SHA256 below (the TBD sentinel path remains
#          only for a deliberate version bump).
#
# Network requirement: this hook runs inside the live-build chroot which has
# internet access during the binary build stage. ca-certificates must be
# installed (it is in orionx.list.chroot) for HTTPS to succeed. zstd must
# also be installed (it is in orionx.list.chroot) for .tar.zst decompression.
# ---------------------------------------------------------------------------
echo "=== Installing ollama (Nebula AI runtime daemon — DEC-PHASE10-007) ==="

OLLAMA_VERSION="0.30.7"
OLLAMA_TGZ_URL="https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-amd64.tar.zst"
OLLAMA_TMP="/tmp/ollama-${OLLAMA_VERSION}.tar.zst"

echo "[ollama] Downloading ollama v${OLLAMA_VERSION} .tar.zst from GitHub releases..."
echo "[ollama] URL: ${OLLAMA_TGZ_URL}"

# wget must succeed; follows redirects automatically.
# Retry 3 times with 5-second delay between attempts, 120s connection timeout.
# wget, not curl: curl is not in the build chroot when this hook executes.
if ! wget -O "${OLLAMA_TMP}" \
          --tries=3 --waitretry=5 --timeout=120 \
          --no-verbose \
          "${OLLAMA_TGZ_URL}"; then
    echo "ERROR: ollama .tar.zst download FAILED — ${OLLAMA_TGZ_URL}" >&2
    echo "ERROR: Nebula AI runtime cannot be installed without ollama (DEC-PHASE10-007)." >&2
    echo "ERROR: Build aborted. Check network connectivity and URL validity." >&2
    exit 1
fi

echo "[ollama] Download complete: $(du -sh "${OLLAMA_TMP}" | cut -f1)"

# ---------------------------------------------------------------------------
# SHA-256 verification of the downloaded .tar.zst (DEC-PHASE10-007 fail-loud)
#
# @decision DEC-PHASE10-007
# @title Trust-on-first-use SHA-256 sentinel for ollama .tar.zst
# @status accepted
# @rationale The canonical SHA-256 cannot be pinned until the first successful
#   CI build produces a verified download. The sentinel value
#   "TBD-PIN-AT-FIRST-CI-BUILD" skips the check on that first run (equivalent
#   to the model manifest's TBD-VERIFY-AT-DOWNLOAD pattern — DEC-PHASE10-008).
#   Once the real SHA-256 is known (from ollama's sha256sum.txt release
#   asset), replace the sentinel with the 64-char lowercase hex string and
#   the gate becomes a hard enforcement on every subsequent build. An
#   unexpected hash is a supply-chain signal and must abort the build loudly
#   — never soft-fail a binary integrity check. Updated from .deb to
#   .tar.zst in W10-1 iter-7 (ollama dropped .deb entirely; .tar.zst is the
#   canonical Linux amd64 release format for v0.24.0+).
# ---------------------------------------------------------------------------
OLLAMA_TGZ_SHA256="88c110a6c9a9130e5ed0aa90f47e8ddb013cb638d834e11ddf1517615704d34c"

if [[ "${OLLAMA_TGZ_SHA256}" != "TBD-PIN-AT-FIRST-CI-BUILD" ]]; then
    echo "[ollama] Verifying SHA-256 of downloaded .tar.zst..."
    if ! echo "${OLLAMA_TGZ_SHA256}  ${OLLAMA_TMP}" | sha256sum -c -; then
        echo "FATAL: ollama .tar.zst SHA-256 mismatch — refusing to install" >&2
        echo "FATAL: Expected: ${OLLAMA_TGZ_SHA256}" >&2
        echo "FATAL: Got:      $(sha256sum "${OLLAMA_TMP}" | cut -d' ' -f1)" >&2
        echo "FATAL: This may indicate a supply-chain tampering event (DEC-PHASE10-007)." >&2
        rm -f "${OLLAMA_TMP}"
        exit 1
    fi
    echo "[ollama] SHA-256 verified OK."
else
    echo "WARN: ollama .tar.zst SHA-256 = TBD-PIN-AT-FIRST-CI-BUILD (trust-on-first-use — DEC-PHASE10-007)"
    echo "WARN: Pin the real SHA-256 after first successful build before rc cut."
fi

# Extract the .tar.zst archive to /usr/local/
# The archive contains:
#   bin/ollama           — the main ollama binary (→ /usr/local/bin/ollama)
#   lib/ollama/...       — CUDA and other GPU libraries (→ /usr/local/lib/ollama/)
# zstd decompresses the .zst stream; tar -xf - unpacks the tar archive from stdin.
# This is equivalent to what the official ollama install.sh does.
echo "[ollama] Extracting .tar.zst to /usr/local/ ..."
if ! zstd -d "${OLLAMA_TMP}" --stdout | tar -xf - -C /usr/local/; then
    echo "ERROR: ollama .tar.zst extraction failed." >&2
    echo "ERROR: This is a LOUD failure per DEC-PHASE10-007 — build aborted." >&2
    rm -f "${OLLAMA_TMP}"
    exit 1
fi

# Clean up the downloaded archive (free up space in the chroot)
rm -f "${OLLAMA_TMP}"

# DEC-PHASE12-015: drop ollama's GPU backends. The archive ships CUDA 12/13 and
# Vulkan runtimes (measured in trixie-dev6: cuda_v12 1.25 GB + cuda_v13 0.85 GB
# + vulkan 58 MB uncompressed — the single largest non-model item in the image).
# The Bay Trail deck has no NVIDIA GPU and no Vulkan; Nebula runs on the CPU
# backends (libggml-cpu-*.so), which stay. ollama probes backends at runtime, so
# an absent directory simply means "no GPU" — exactly the state on the hardware.
for gpu in cuda_v12 cuda_v13 vulkan rocm rocm_v6 rocm_v7; do
    [ -d "/usr/local/lib/ollama/$gpu" ] && rm -rf "/usr/local/lib/ollama/$gpu" \
        && echo "[ollama] removed GPU backend lib/ollama/$gpu (no GPU on the deck; DEC-PHASE12-015)"
done
ls /usr/local/lib/ollama/libggml-cpu-*.so >/dev/null 2>&1 \
    && echo "[ollama] CPU backends retained: $(ls /usr/local/lib/ollama/libggml-cpu-*.so | wc -l) variants" \
    || echo "WARNING: [ollama] no CPU backend libs found after GPU prune" >&2

# Verify the binary is present and executable
if ! command -v ollama >/dev/null 2>&1; then
    echo "ERROR: ollama installed but binary not found in PATH." >&2
    echo "       Expected /usr/local/bin/ollama after tar extraction." >&2
    exit 1
fi

echo "[ollama] Installation complete: $(ollama --version 2>/dev/null || echo 'version unavailable')"
echo "[ollama] Binary: $(command -v ollama)"
echo "=== Ollama installation complete ==="

# ---------------------------------------------------------------------------
# W11-2c debloat-purge: remove gcc/g++ transitive Recommends that survive
# list-driven removal because iso/auto/config runs --apt-recommends true.
# DEC-PHASE11-003 policy is enforced list-side (gcc not in orionx.list.chroot)
# AND chroot-side (this purge). Chroot-side debloat has two ordered steps, not
# two authorities: THIS hook purges the build toolchain at the points where the
# pip/venv ordering demands it (here and at the tail), and 0900-trim.hook.chroot
# (DEC-PHASE12-015) is the single FINAL sweep — package purges, locales, docs —
# after every other hook has finished installing. Add new size cuts to 0900.
# ---------------------------------------------------------------------------
echo "[0500] W11-2c: purging gcc/g++ Recommends residue (DEC-PHASE11-003 enforcement)"
DEBIAN_FRONTEND=noninteractive apt-get purge -y --autoremove \
    gcc gcc-14 g++ g++-14 || true

# W11-14 debloat repair: python3-pip Recommends build-essential + python3-dev, and
# iso/auto/config runs --apt-recommends true, so adding python3-pip in W11-13 (T6)
# silently reinstated the toolchain DEC-PHASE11-003 purges. Measured against the
# 2026-08-03 baseline, the 2026-08-07 ISO regressed exactly two debloat assertions:
# `make` and `python3-dev` were present again. The gcc/g++ purge above did not cover
# them. This purge runs AFTER the list-driven install and BEFORE the venv pip
# installs below — capa and matrix-commander install from wheels and do not need a
# compiler (proven by the 2026-08-07 build, which completed with gcc already purged).
# ---------------------------------------------------------------------------
# W11-3 Layer A: capa + python-magic venv (DEC-PHASE11-004)
#
# capa (Apache-2.0) and python-magic are installed into a dedicated virtual
# environment at /opt/orionx/venv/re/ to avoid system-Python conflicts.
# The pip install is HARD-FAIL per DEC-PHASE11-018: capa is load-bearing for
# the operator's `triage` verb, and a silently-empty venv shipping to
# production is a worse failure mode than a build the developer must fix.
# Accepted risk R2: an air-gapped build (no PyPI reachability) now breaks the
# whole build. That is intended — air-gapped builds are not in the supported
# build matrix; adding them is a separate slice with its own DEC.
#
# The venv-CREATE step above remains soft (diagnostic warning, block skipped).
# The venv-CREATE step is ALSO hard-fail as of 2026-08-12. It was previously soft,
# guarded by `if [ -f .../bin/pip ]`, on the assumption that python3-pip pulls
# python3-venv transitively. It does not (see orionx.list.chroot). The result: venv
# creation half-succeeded (bin/python* but no pip), the guard evaluated false, the
# whole install block was SKIPPED, and the build exited 0 shipping empty venvs —
# defeating DEC-PHASE11-018 entirely. A guard that can silently skip a hard-fail is
# not a hard-fail. Every step below now fails loudly.
#
# After a successful install, /usr/bin/capa is symlinked for convenience.
# ---------------------------------------------------------------------------
echo "=== W11-3: Installing capa + python-magic to /opt/orionx/venv/re/ ==="
python3 -m venv /opt/orionx/venv/re/ 2>&1 || {
    echo "[W11-3] FATAL: venv creation failed for /opt/orionx/venv/re — hard-failing per DEC-PHASE11-018" >&2
    echo "[W11-3]        python3-venv must be installed for ensurepip to succeed." >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/re/bin/pip ]]; then
    echo "[W11-3] FATAL: venv created but has no pip — hard-failing per DEC-PHASE11-018" >&2
    echo "[W11-3]        This is the silent-empty-venv defect: python3-venv is missing" >&2
    echo "[W11-3]        from the base package list, so ensurepip could not run." >&2
    exit 1
fi
pip_locked /opt/orionx/venv/re/bin/pip re 2>&1 || {  # DEC-PHASE12-116 lock
    echo "[W11-3] FATAL: capa pip install failed — hard-failing build per DEC-PHASE11-018" >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/re/bin/capa ]]; then
    echo "[W11-3] FATAL: pip reported success but /opt/orionx/venv/re/bin/capa is absent" >&2
    exit 1
fi
/opt/orionx/venv/re/bin/capa --version >/dev/null 2>&1 || {
    echo "[W11-3] FATAL: capa is installed but 'capa --version' does not run" >&2; exit 1; }
echo "[W11-3] capa installed: $(/opt/orionx/venv/re/bin/capa --version 2>&1 | head -1)"
# Symlink for user convenience
ln -sf /opt/orionx/venv/re/bin/capa /usr/bin/capa
echo "=== W11-3 capa venv install complete ==="

# ---------------------------------------------------------------------------
# W11-5 Layer A: matrix-commander pip venv (DEC-PHASE11-006)
#
# matrix-commander is a CLI Matrix client installed into a dedicated virtual
# environment at /opt/orionx/venv/comms/ to avoid system-Python conflicts.
# The pip install is HARD-FAIL per DEC-PHASE11-018: matrix-commander is
# load-bearing for the operator's `defend` verb (scripted coordinated-IR
# comms), and a silently-empty venv shipping to production is a worse failure
# mode than a build the developer must fix. Accepted risk R2 applies here as
# it does to capa above: air-gapped builds break, intentionally.
#
# The venv-CREATE step is hard-fail for the same reason as the capa block above:
# a guard that silently skips the install defeats DEC-PHASE11-018.
#
# After a successful install, /usr/local/bin/matrix-commander is symlinked
# for convenience. Layer B (gomuks static binary) is deferred to W11-5b.
# ---------------------------------------------------------------------------
echo "=== W11-5: Installing matrix-commander to /opt/orionx/venv/comms/ ==="
python3 -m venv /opt/orionx/venv/comms/ 2>&1 || {
    echo "[W11-5] FATAL: venv creation failed for /opt/orionx/venv/comms — hard-failing per DEC-PHASE11-018" >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/comms/bin/pip ]]; then
    echo "[W11-5] FATAL: venv created but has no pip — hard-failing per DEC-PHASE11-018" >&2
    echo "[W11-5]        python3-venv missing from base package list (ensurepip could not run)." >&2
    exit 1
fi
pip_locked /opt/orionx/venv/comms/bin/pip comms 2>&1 || {  # DEC-PHASE12-116 lock
    echo "[W11-5] FATAL: matrix-commander pip install failed — hard-failing build per DEC-PHASE11-018" >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/comms/bin/matrix-commander ]]; then
    echo "[W11-5] FATAL: pip reported success but matrix-commander binary is absent" >&2
    exit 1
fi
/opt/orionx/venv/comms/bin/matrix-commander --version >/dev/null 2>&1 || {
    echo "[W11-5] FATAL: matrix-commander is installed but '--version' does not run" >&2; exit 1; }
ln -sf /opt/orionx/venv/comms/bin/matrix-commander /usr/local/bin/matrix-commander
echo "[W11-5] matrix-commander installed: $(/opt/orionx/venv/comms/bin/matrix-commander --version 2>&1 | tail -1)"
echo "=== W11-5 matrix-commander install complete ==="

# ---------------------------------------------------------------------------
# W11-14c: re-anchor the diverted hostname binary (DEC-PHASE11-022).
#
# live-build's chroot_hostname stage diverts /bin/hostname to
# /bin/hostname.distrib for the whole build (a stub that echoes
# localhost.localdomain sits in its place — including RIGHT NOW, while this
# hook runs) and renames the real binary back at teardown. Across
# interrupted/resumed builds that dance lost the .distrib: rc1-25 AND rc1-31
# both shipped with NO /bin/hostname at all while dpkg recorded the package
# as installed. On hardware that broke live-config's own hostname setup
# (0020-hostname: hostname: not found) and killed the first-boot wizard with
# status=127. Reinstalling here writes the real binary THROUGH the active
# diversion into /bin/hostname.distrib, guaranteeing teardown has a real file
# to restore no matter what earlier build states did. Hard-fail per
# DEC-PHASE10-007: a build without a restorable hostname binary ships a
# broken image.
# ---------------------------------------------------------------------------
echo "[0500] W11-14c: re-anchoring diverted /bin/hostname (DEC-PHASE11-022)"
DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y hostname || {
    echo "[0500] FATAL: hostname package reinstall failed — image would ship without /bin/hostname" >&2
    exit 1
}
# Accept either valid post-reinstall state: diversion active (real binary at
# .distrib, stub at /bin/hostname) or no diversion (real binary in place).
# "Real" = non-empty and not a #! script (the live-build stub is a script).
_real() { [[ -s "$1" ]] && ! head -c2 "$1" | grep -q '#!'; }
if _real /bin/hostname.distrib || _real /bin/hostname; then
    echo "[0500] hostname binary re-anchored OK"
    stat -c '[0500]   %n: %s bytes' /bin/hostname.distrib /bin/hostname 2>/dev/null || true
else
    echo "[0500] FATAL: no real hostname binary at /bin/hostname or /bin/hostname.distrib after reinstall." >&2
    echo "[0500]        Refusing to ship an image whose hostname binary cannot be restored at teardown." >&2
    ls -la /bin/hostname* >&2 || true
    exit 1
fi

# ---------------------------------------------------------------------------
# W11-14 debloat repair — MUST BE LAST IN THIS HOOK.
#
# python3-pip Recommends build-essential + python3-dev, and iso/auto/config runs
# --apt-recommends true, so adding python3-pip in W11-13 (T6) silently reinstated
# the toolchain DEC-PHASE11-003 purges. Measured against the 2026-08-03 baseline,
# the 2026-08-07 ISO regressed exactly two debloat assertions: `make` and
# `python3-dev` were present again. The W11-2c gcc/g++ purge above did not cover them.
#
# Ordering is deliberate: this runs AFTER the capa and matrix-commander venv
# installs, never before. Those installs are hard-fail (DEC-PHASE11-018), so
# removing the toolchain ahead of them would couple a debloat step to a
# build-breaking failure if any wheel ever needed to compile. Install everything
# first, then strip. No --allow-remove-essential is passed here (the APT_OPTIONS
# env var used by live-build is deliberately not referenced), so apt will refuse
# to remove essential packages rather than cascade.
# ---------------------------------------------------------------------------
echo "[0500] W11-14: purging python3-pip build-toolchain Recommends (DEC-PHASE11-003 repair)"
DEBIAN_FRONTEND=noninteractive apt-get purge -y --autoremove \
    build-essential dpkg-dev make python3-dev || true

echo "=== External tools installation complete ==="
