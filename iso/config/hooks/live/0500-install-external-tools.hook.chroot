#!/bin/bash
# shellcheck shell=bash
# Install tools not available in Debian Bullseye standard repos
# These are installed from upstream sources during ISO build
#
# @decision DEC-PHASE10-007
# @title ollama .deb staging: fail-LOUD on fetch/verify failure
# @status accepted
# @rationale Debian Bullseye does not ship ollama via apt. The binary .deb is
#   downloaded and installed here during the chroot phase so ollama ends up in
#   the squashfs image. Unlike zeek (soft-fail, warn-and-continue), ollama is
#   LOAD-BEARING for the v2.0.0 Nebula AI headline feature: if ollama is absent,
#   nebula-runtime.service will never start and the Control Center will show
#   "Runtime: down" indefinitely. Therefore: install failure = LOUD (build aborts
#   with non-zero exit), not soft. References: DEC-PHASE10-007.
#
# @decision DEC-PHASE11-004
# @title Ghidra bulk staging deferred from base ISO to W11-8 optional installer
# @status accepted
# @rationale W11-2 debloat pass removes Ghidra from the base ISO to reduce size
#   per DEC-PHASE11-003. Ghidra (~500 MB download + JRE) is an optional reverse-
#   engineering tool that does not serve the core forensic/network mission without
#   prior operator context. Post-boot operators who need Ghidra run:
#     /opt/orionx/optional/install-ghidra.sh
#   That script (W11-8) follows the optional-installer framework convention:
#   preflight banner + network check + sentinel drop. References: DEC-PHASE11-004.

set -euo pipefail

echo "=== Installing external tools ==="

# Volatility3 (Python package)
pip3 install volatility3 || echo "WARNING: volatility3 install failed"

# Zeek (OpenSUSE Build Service repo).
# 2026-05: Bullseye Zeek repo retired; soft-fail and clean up if 404.
# Critical: must not leave a dangling sources.list.d entry — subsequent
# apt-get update would fail and abort the binary stage (#30 cascade).
{
    # Try to fetch the key first. If this fails, abort before touching
    # apt sources at all.  wget replaces curl (curl not in build container).
    wget -qO- https://download.opensuse.org/repositories/security:zeek/Debian_11/Release.key \
        | gpg --dearmor > /etc/apt/trusted.gpg.d/zeek.gpg
    # Key fetch succeeded; now safe to add the source list and install.
    echo 'deb http://download.opensuse.org/repositories/security:/zeek/Debian_11/ /' \
        > /etc/apt/sources.list.d/zeek.list
    apt-get update
    apt-get install -y zeek
} || {
    echo "WARNING: zeek install failed — upstream Bullseye repo unavailable (#33 cascade)"
    # Belt + suspenders: remove any partial config so later apt-get update
    # doesn't fail on a dangling source list.
    rm -f /etc/apt/sources.list.d/zeek.list /etc/apt/trusted.gpg.d/zeek.gpg
    # Refresh apt cache to clear any error state from the failed source
    apt-get update >/dev/null 2>&1 || true
}

# Autopsy (requires Java, complex install — placeholder)
echo "NOTE: Autopsy requires manual installation. See docs/INSTALL_AUTOPSY.md"

# ---------------------------------------------------------------------------
# Ollama — Nebula AI runtime daemon (DEC-PHASE10-007)
#
# ollama is NOT in Debian Bullseye apt repos; we download the official
# .tar.zst release archive from the ollama GitHub releases channel and
# extract the binary to /usr/local/bin. This is a LOUD-FAILURE block: if
# ollama cannot be installed, the build ABORTS (exit non-zero). This is an
# intentional divergence from the soft-fail zeek/ghidra blocks above — see
# file header.
#
# NOTE: ollama never shipped a .deb for any release. The 0.3.x → 0.30.x
# version jump (Nov 2025) also changed the distribution archive from .tgz
# to .tar.zst. The correct asset name is ollama-linux-amd64.tar.zst for
# v0.24.0+. This hook was updated from the non-existent .deb URL in iter-7
# (W10-1) after CI reported a 404 on every build (closes #61 follow-up).
#
# Pinned version: 0.30.7 (2026-06 release; latest validated against
#                 Bullseye amd64 at W10-1 iter-7 cut)
# URL: https://github.com/ollama/ollama/releases/download/v0.30.7/ollama-linux-amd64.tar.zst
# SHA-256: TBD-PIN-AT-FIRST-CI-BUILD (trust-on-first-use; re-applies #57
#          commitment — pin the real hash after first successful build)
#
# Network requirement: this hook runs inside the live-build chroot which has
# internet access during the binary build stage. ca-certificates must be
# installed (it is in orionx.list.chroot) for HTTPS to succeed. zstd must
# also be installed (it is in orionx.list.chroot) for .tar.zst decompression.
# ---------------------------------------------------------------------------
echo "=== Installing ollama (Nebula AI runtime daemon — DEC-PHASE10-007) ==="

OLLAMA_VERSION="0.30.7"
OLLAMA_TGZ_URL="https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-amd64.tar.zst"
OLLAMA_TMP="/tmp/ollama-${OLLAMA_VERSION}.tar.zst"

echo "[ollama] Downloading ollama v${OLLAMA_VERSION} .tar.zst from GitHub releases..."
echo "[ollama] URL: ${OLLAMA_TGZ_URL}"

# wget must succeed; follows redirects automatically.
# Retry 3 times with 5-second delay between attempts, 120s connection timeout.
# wget replaces curl (curl is not available in the debian:bullseye-slim
# build container at the time this hook executes).
if ! wget -O "${OLLAMA_TMP}" \
          --tries=3 --waitretry=5 --timeout=120 \
          --no-verbose \
          "${OLLAMA_TGZ_URL}"; then
    echo "ERROR: ollama .tar.zst download FAILED — ${OLLAMA_TGZ_URL}" >&2
    echo "ERROR: Nebula AI runtime cannot be installed without ollama (DEC-PHASE10-007)." >&2
    echo "ERROR: Build aborted. Check network connectivity and URL validity." >&2
    exit 1
fi

echo "[ollama] Download complete: $(du -sh "${OLLAMA_TMP}" | cut -f1)"

# ---------------------------------------------------------------------------
# SHA-256 verification of the downloaded .tar.zst (DEC-PHASE10-007 fail-loud)
#
# @decision DEC-PHASE10-007
# @title Trust-on-first-use SHA-256 sentinel for ollama .tar.zst
# @status accepted
# @rationale The canonical SHA-256 cannot be pinned until the first successful
#   CI build produces a verified download. The sentinel value
#   "TBD-PIN-AT-FIRST-CI-BUILD" skips the check on that first run (equivalent
#   to the model manifest's TBD-VERIFY-AT-DOWNLOAD pattern — DEC-PHASE10-008).
#   Once the real SHA-256 is known (from ollama's sha256sum.txt release
#   asset), replace the sentinel with the 64-char lowercase hex string and
#   the gate becomes a hard enforcement on every subsequent build. An
#   unexpected hash is a supply-chain signal and must abort the build loudly
#   — never soft-fail a binary integrity check. Updated from .deb to
#   .tar.zst in W10-1 iter-7 (ollama dropped .deb entirely; .tar.zst is the
#   canonical Linux amd64 release format for v0.24.0+).
# ---------------------------------------------------------------------------
OLLAMA_TGZ_SHA256="88c110a6c9a9130e5ed0aa90f47e8ddb013cb638d834e11ddf1517615704d34c"

if [[ "${OLLAMA_TGZ_SHA256}" != "TBD-PIN-AT-FIRST-CI-BUILD" ]]; then
    echo "[ollama] Verifying SHA-256 of downloaded .tar.zst..."
    if ! echo "${OLLAMA_TGZ_SHA256}  ${OLLAMA_TMP}" | sha256sum -c -; then
        echo "FATAL: ollama .tar.zst SHA-256 mismatch — refusing to install" >&2
        echo "FATAL: Expected: ${OLLAMA_TGZ_SHA256}" >&2
        echo "FATAL: Got:      $(sha256sum "${OLLAMA_TMP}" | cut -d' ' -f1)" >&2
        echo "FATAL: This may indicate a supply-chain tampering event (DEC-PHASE10-007)." >&2
        rm -f "${OLLAMA_TMP}"
        exit 1
    fi
    echo "[ollama] SHA-256 verified OK."
else
    echo "WARN: ollama .tar.zst SHA-256 = TBD-PIN-AT-FIRST-CI-BUILD (trust-on-first-use — DEC-PHASE10-007)"
    echo "WARN: Pin the real SHA-256 after first successful build before rc cut."
fi

# Extract the .tar.zst archive to /usr/local/
# The archive contains:
#   bin/ollama           — the main ollama binary (→ /usr/local/bin/ollama)
#   lib/ollama/...       — CUDA and other GPU libraries (→ /usr/local/lib/ollama/)
# zstd decompresses the .zst stream; tar -xf - unpacks the tar archive from stdin.
# This is equivalent to what the official ollama install.sh does.
echo "[ollama] Extracting .tar.zst to /usr/local/ ..."
if ! zstd -d "${OLLAMA_TMP}" --stdout | tar -xf - -C /usr/local/; then
    echo "ERROR: ollama .tar.zst extraction failed." >&2
    echo "ERROR: This is a LOUD failure per DEC-PHASE10-007 — build aborted." >&2
    rm -f "${OLLAMA_TMP}"
    exit 1
fi

# Clean up the downloaded archive (free up space in the chroot)
rm -f "${OLLAMA_TMP}"

# Verify the binary is present and executable
if ! command -v ollama >/dev/null 2>&1; then
    echo "ERROR: ollama installed but binary not found in PATH." >&2
    echo "       Expected /usr/local/bin/ollama after tar extraction." >&2
    exit 1
fi

echo "[ollama] Installation complete: $(ollama --version 2>/dev/null || echo 'version unavailable')"
echo "[ollama] Binary: $(command -v ollama)"
echo "=== Ollama installation complete ==="

# ---------------------------------------------------------------------------
# W11-2c debloat-purge: remove gcc/g++ transitive Recommends that survive
# list-driven removal because iso/auto/config runs --apt-recommends true.
# DEC-PHASE11-003 policy is enforced list-side (gcc not in orionx.list.chroot)
# AND chroot-side (this purge). Single debloat-in-chroot authority: this hook.
# ---------------------------------------------------------------------------
echo "[0500] W11-2c: purging gcc/g++ Recommends residue (DEC-PHASE11-003 enforcement)"
DEBIAN_FRONTEND=noninteractive apt-get purge -y --autoremove \
    gcc gcc-10 g++ g++-10 || true

# W11-14 debloat repair: python3-pip Recommends build-essential + python3-dev, and
# iso/auto/config runs --apt-recommends true, so adding python3-pip in W11-13 (T6)
# silently reinstated the toolchain DEC-PHASE11-003 purges. Measured against the
# 2026-08-03 baseline, the 2026-08-07 ISO regressed exactly two debloat assertions:
# `make` and `python3-dev` were present again. The gcc/g++ purge above did not cover
# them. This purge runs AFTER the list-driven install and BEFORE the venv pip
# installs below — capa and matrix-commander install from wheels and do not need a
# compiler (proven by the 2026-08-07 build, which completed with gcc already purged).
echo "[0500] W11-14: purging python3-pip build-toolchain Recommends (DEC-PHASE11-003 repair)"
DEBIAN_FRONTEND=noninteractive apt-get purge -y --autoremove \
    build-essential dpkg-dev make python3-dev || true

# ---------------------------------------------------------------------------
# W11-3 Layer A: capa + python-magic venv (DEC-PHASE11-004)
#
# capa (Apache-2.0) and python-magic are installed into a dedicated virtual
# environment at /opt/orionx/venv/re/ to avoid system-Python conflicts.
# The pip install is HARD-FAIL per DEC-PHASE11-018: capa is load-bearing for
# the operator's `triage` verb, and a silently-empty venv shipping to
# production is a worse failure mode than a build the developer must fix.
# Accepted risk R2: an air-gapped build (no PyPI reachability) now breaks the
# whole build. That is intended — air-gapped builds are not in the supported
# build matrix; adding them is a separate slice with its own DEC.
#
# The venv-CREATE step above remains soft (diagnostic warning, block skipped).
# The venv-CREATE step is ALSO hard-fail as of 2026-08-12. It was previously soft,
# guarded by `if [ -f .../bin/pip ]`, on the assumption that python3-pip pulls
# python3-venv transitively. It does not (see orionx.list.chroot). The result: venv
# creation half-succeeded (bin/python* but no pip), the guard evaluated false, the
# whole install block was SKIPPED, and the build exited 0 shipping empty venvs —
# defeating DEC-PHASE11-018 entirely. A guard that can silently skip a hard-fail is
# not a hard-fail. Every step below now fails loudly.
#
# After a successful install, /usr/bin/capa is symlinked for convenience.
# ---------------------------------------------------------------------------
echo "=== W11-3: Installing capa + python-magic to /opt/orionx/venv/re/ ==="
python3 -m venv /opt/orionx/venv/re/ 2>&1 || {
    echo "[W11-3] FATAL: venv creation failed for /opt/orionx/venv/re — hard-failing per DEC-PHASE11-018" >&2
    echo "[W11-3]        python3-venv must be installed for ensurepip to succeed." >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/re/bin/pip ]]; then
    echo "[W11-3] FATAL: venv created but has no pip — hard-failing per DEC-PHASE11-018" >&2
    echo "[W11-3]        This is the silent-empty-venv defect: python3-venv is missing" >&2
    echo "[W11-3]        from the base package list, so ensurepip could not run." >&2
    exit 1
fi
/opt/orionx/venv/re/bin/pip install --no-input flare-capa python-magic 2>&1 || {
    echo "[W11-3] FATAL: capa pip install failed — hard-failing build per DEC-PHASE11-018" >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/re/bin/capa ]]; then
    echo "[W11-3] FATAL: pip reported success but /opt/orionx/venv/re/bin/capa is absent" >&2
    exit 1
fi
echo "[W11-3] capa installed: $(/opt/orionx/venv/re/bin/capa --version 2>&1 | head -1)"
# Symlink for user convenience
ln -sf /opt/orionx/venv/re/bin/capa /usr/bin/capa
echo "=== W11-3 capa venv install complete ==="

# ---------------------------------------------------------------------------
# W11-5 Layer A: matrix-commander pip venv (DEC-PHASE11-006)
#
# matrix-commander is a CLI Matrix client installed into a dedicated virtual
# environment at /opt/orionx/venv/comms/ to avoid system-Python conflicts.
# The pip install is HARD-FAIL per DEC-PHASE11-018: matrix-commander is
# load-bearing for the operator's `defend` verb (scripted coordinated-IR
# comms), and a silently-empty venv shipping to production is a worse failure
# mode than a build the developer must fix. Accepted risk R2 applies here as
# it does to capa above: air-gapped builds break, intentionally.
#
# The venv-CREATE step is hard-fail for the same reason as the capa block above:
# a guard that silently skips the install defeats DEC-PHASE11-018.
#
# After a successful install, /usr/local/bin/matrix-commander is symlinked
# for convenience. Layer B (gomuks static binary) is deferred to W11-5b.
# ---------------------------------------------------------------------------
echo "=== W11-5: Installing matrix-commander to /opt/orionx/venv/comms/ ==="
python3 -m venv /opt/orionx/venv/comms/ 2>&1 || {
    echo "[W11-5] FATAL: venv creation failed for /opt/orionx/venv/comms — hard-failing per DEC-PHASE11-018" >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/comms/bin/pip ]]; then
    echo "[W11-5] FATAL: venv created but has no pip — hard-failing per DEC-PHASE11-018" >&2
    echo "[W11-5]        python3-venv missing from base package list (ensurepip could not run)." >&2
    exit 1
fi
/opt/orionx/venv/comms/bin/pip install --no-input matrix-commander 2>&1 || {
    echo "[W11-5] FATAL: matrix-commander pip install failed — hard-failing build per DEC-PHASE11-018" >&2
    exit 1
}
if [[ ! -x /opt/orionx/venv/comms/bin/matrix-commander ]]; then
    echo "[W11-5] FATAL: pip reported success but matrix-commander binary is absent" >&2
    exit 1
fi
ln -sf /opt/orionx/venv/comms/bin/matrix-commander /usr/local/bin/matrix-commander
echo "[W11-5] matrix-commander installed"
echo "=== W11-5 matrix-commander install complete ==="

echo "=== External tools installation complete ==="
