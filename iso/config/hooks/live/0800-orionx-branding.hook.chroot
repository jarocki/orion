#!/bin/bash
# shellcheck shell=bash
# Orion-X Phoenix Edition — W11-9a boot-chain branding hook
#
# @decision DEC-PHASE11-010
# @title W11-9a: 0800-orionx-branding activates Plymouth theme + primes font cache
# @status accepted
# @rationale This hook is the SINGLE authority for boot-chain branding activation
#   within the live-build chroot. Responsibilities (in order):
#     (i)  Activate orionx-phoenix Plymouth theme and regenerate initramfs so
#          the theme is embedded in the initrd — required for the splash to
#          appear before the root filesystem is mounted.
#          `plymouth-set-default-theme -R orionx-phoenix` writes
#          /etc/plymouth/plymouthd.conf AND triggers update-initramfs -u.
#          The explicit plymouthd.conf in includes.chroot (also shipped by
#          W11-9a) provides belt-and-suspenders for inspection without
#          re-running the hook.
#     (ii) Run `fc-cache -f` to prime the font cache for W11-9b fonts.
#          In W11-9a this is a safe no-op (no fonts staged yet); W11-9b
#          will stage Iosevka + Hack fonts and this call will populate their
#          cache entries. Ordering: font-cache before any session that reads
#          fonts, which in this hook chain means before initramfs regen.
#          However, since font cache is irrelevant to initramfs content, the
#          order within this hook does not create a dependency.
#    (iii) Belt-and-suspenders: write /etc/plymouth/plymouthd.conf directly
#          (plymouth-set-default-theme -R already does this, but explicit
#          file write is more inspectable in CI audit logs and guarantees
#          correct state even if plymouth-set-default-theme path changes).
#
# ORDERING: This hook is numbered 0800 so it runs AFTER:
#   0500-install-external-tools.hook.chroot  (external tool download)
#   0600-filesystem-hardening.hook.chroot     (filesystem permissions baseline)
#   0610-apparmor-setup.hook.chroot           (AppArmor profiles)
#   0615-install-systemd-units.hook.chroot    (systemd unit staging)
#   0620-service-hardening.hook.chroot        (service hardening)
#   0700-orionx-setup.hook.chroot             (Orion-X application setup)
#
# Branding activation runs last in the live hook chain so all system
# packages (including plymouth and initramfs-tools) are fully installed
# and their postinst scripts have completed before we invoke
# update-initramfs.
#
# ROLLBACK: If this hook fails, the build fails loudly (set -eux). The
# rollback boundary from MASTER_PLAN W11-9a: if Plymouth theme wedges boot
# (blank screen, kernel panic in initramfs), Guardian does NOT land.
# Implementer returns to planner with failure diagnosis.
# Rollback path: `git revert` the branch merge; pre-W11-9a develop boots
# cleanly without this hook.
#
# FORBIDDEN: Do NOT add GRUB_THEME= or any grub-update invocation here.
# GRUB_THEME activation requires a one-line generator edit in
# scripts/build-iso.sh::generate_bootloader_configs() which is a
# forbidden W11-9a scope surface. Escalate to planner as a rider sub-slice.
# Tracked in W11-9a Evaluation Contract item 4 / CHANGELOG note.
#
# W11-9b extension point: When W11-9b stages fonts under
# /usr/share/fonts/opentype/orionx/, the fc-cache -f call below will
# automatically populate their entries without any hook change needed.

set -eux

HOOK_NAME="0800-orionx-branding"
LOG_PREFIX="[${HOOK_NAME}]"

echo "${LOG_PREFIX} Starting W11-9a boot-chain branding hook"

# ---------------------------------------------------------------------------
# Step 1: Activate Plymouth orionx-phoenix theme + regenerate initramfs
# ---------------------------------------------------------------------------
echo "${LOG_PREFIX} Activating Plymouth theme: orionx-phoenix"

# Verify the theme directory is present before activation — fail loud if missing.
THEME_DIR="/usr/share/plymouth/themes/orionx-phoenix"
if [[ ! -d "${THEME_DIR}" ]]; then
    echo "${LOG_PREFIX} ERROR: Plymouth theme directory missing: ${THEME_DIR}" >&2
    echo "${LOG_PREFIX} Check that includes.chroot staged the theme correctly." >&2
    exit 1
fi

THEME_SCRIPT="${THEME_DIR}/orionx-phoenix.script"
THEME_PLYMOUTH="${THEME_DIR}/orionx-phoenix.plymouth"
THEME_BG="${THEME_DIR}/background.png"

for asset in "${THEME_SCRIPT}" "${THEME_PLYMOUTH}" "${THEME_BG}"; do
    if [[ ! -f "${asset}" ]]; then
        echo "${LOG_PREFIX} ERROR: Required Plymouth theme asset missing: ${asset}" >&2
        exit 1
    fi
done

echo "${LOG_PREFIX} Theme assets verified: .plymouth, .script, background.png"

# plymouth-set-default-theme -R:
#   - Writes Theme=orionx-phoenix to /etc/plymouth/plymouthd.conf
#   - Runs update-initramfs -u to embed the theme in the initrd
# This is the canonical activation path per the Debian plymouth packaging.
plymouth-set-default-theme -R orionx-phoenix
echo "${LOG_PREFIX} Plymouth theme activated and initramfs regenerated"

# ---------------------------------------------------------------------------
# Step 2: Prime font cache (W11-9b extension point — no-op in W11-9a)
# ---------------------------------------------------------------------------
echo "${LOG_PREFIX} Running fc-cache -f (font cache primer — no-op in W11-9a, active in W11-9b)"
fc-cache -f
echo "${LOG_PREFIX} fc-cache complete"

# ---------------------------------------------------------------------------
# Step 3: Belt-and-suspenders plymouthd.conf write
# ---------------------------------------------------------------------------
# plymouth-set-default-theme -R already writes /etc/plymouth/plymouthd.conf.
# This explicit write ensures the Theme= line survives even if the plymouth
# packaging ever changes its write path. Also makes the configuration
# auditable in the build log.
echo "${LOG_PREFIX} Writing /etc/plymouth/plymouthd.conf (belt-and-suspenders)"
mkdir -p /etc/plymouth
cat > /etc/plymouth/plymouthd.conf << 'PLYMOUTHCONF'
# /etc/plymouth/plymouthd.conf — managed by 0800-orionx-branding.hook.chroot
# @decision DEC-PHASE11-010 — DO NOT HAND-EDIT; re-run hook to regenerate
[Daemon]
Theme=orionx-phoenix
ShowDelay=0
DeviceTimeout=8
PLYMOUTHCONF

echo "${LOG_PREFIX} /etc/plymouth/plymouthd.conf written with Theme=orionx-phoenix"

# ---------------------------------------------------------------------------
# Final: Verify activation
# ---------------------------------------------------------------------------
ACTIVE_THEME=$(plymouth-set-default-theme 2>/dev/null || true)
if [[ "${ACTIVE_THEME}" == "orionx-phoenix" ]]; then
    echo "${LOG_PREFIX} Verified: active Plymouth theme = orionx-phoenix"
else
    echo "${LOG_PREFIX} WARNING: plymouth-set-default-theme reports '${ACTIVE_THEME}'" \
         "instead of 'orionx-phoenix' — config written but query inconsistent" >&2
    # Non-fatal: plymouthd.conf is correct; the theme will still activate at boot.
    # The -R flag already embedded orionx-phoenix in the initramfs.
fi

# ---------------------------------------------------------------------------
# Final+1: Verify Plymouth theme is embedded in the initramfs
#
# @decision DEC-PHASE11-018
# @title verify Plymouth theme in initramfs, not just config
# @status accepted
# @rationale The plymouthd.conf check confirms configuration; this check
#   confirms the theme was actually embedded into the initrd via
#   update-initramfs. Silent initramfs regeneration failure was the likely
#   cause of "splash did not paint" on the 2026-07-21 hardware test.
#   plymouth-set-default-theme -R should trigger update-initramfs -u, but
#   if it exits early (missing initramfs-tools, chroot environment quirks,
#   or plymouth packaging changes) the config is written but the initrd is
#   stale. This check catches that failure class and aborts the build loudly
#   rather than shipping an ISO that silently fails to display the splash.
# ---------------------------------------------------------------------------
if command -v lsinitramfs >/dev/null 2>&1; then
    # Try each initrd — there may be multiple kernel versions
    _INITRD_MATCHED=0
    for _INITRD in /boot/initrd.img-*; do
        [ -f "${_INITRD}" ] || continue
        if lsinitramfs "${_INITRD}" 2>/dev/null | grep -q "plymouth/themes/orionx-phoenix"; then
            _INITRD_MATCHED=1
            echo "${LOG_PREFIX} Plymouth theme verified in ${_INITRD}"
        fi
    done
    if [ "${_INITRD_MATCHED}" -eq 0 ]; then
        echo "${LOG_PREFIX} ERROR: Plymouth theme NOT found in any initrd — splash will not paint on boot" >&2
        exit 1
    fi
else
    echo "${LOG_PREFIX} WARNING: lsinitramfs not available; cannot verify Plymouth theme embedding" >&2
fi

# ---------------------------------------------------------------------------
# W11-14j: populate the Orion-X-Cyberdeck xfwm4 theme with decoration assets.
# The theme ships only a themerc (custom colors/offsets) but no titlebar/button/
# border pixmaps, so xfwm4 loads it and renders NO window decorations (confirmed
# on hardware 2026-09-09: xfwm4 running, valid theme set, but borderless windows).
# xfwm4 always needs the pixmap set; seed it from the stock Default theme while
# keeping the custom themerc. (DEC-PHASE11-026)
# ---------------------------------------------------------------------------
#
# DEC-PHASE12-042 widens this from the single Orion-X-Cyberdeck directory to
# EVERY /usr/share/themes/Orion-X-*/xfwm4 that carries a themerc. The green
# decoration variant (Orion-X-Cyberdeck-Green) that scripts/toggle-theme.sh
# switches to needs exactly the same pixmap set, and hardcoding one theme name
# here is how the second theme would have shipped borderless -- the same defect
# this block exists to fix, one theme later.
#
# This also stops being silent. The original emitted nothing when the pixmaps
# were already present AND nothing when no Orion-X theme existed; a build with
# zero themed directories looked identical in the log to a correct one.
# ---------------------------------------------------------------------------
_XFWM_SEEDED=0
_XFWM_CANDIDATES=0
for _XFWM_THEME in /usr/share/themes/Orion-X-*/xfwm4; do
    [ -f "${_XFWM_THEME}/themerc" ] || continue
    _XFWM_CANDIDATES=$((_XFWM_CANDIDATES + 1))
    if [ "$(ls "${_XFWM_THEME}"/*.xpm 2>/dev/null | wc -l)" -eq 0 ]; then
        if [ -d /usr/share/themes/Default/xfwm4 ]; then
            cp -n /usr/share/themes/Default/xfwm4/*.xpm "${_XFWM_THEME}/" 2>/dev/null || true
        else
            echo "${LOG_PREFIX} WARNING: Default xfwm4 theme absent; ${_XFWM_THEME} decorations will be missing" >&2
            continue
        fi
    fi
    # Check, do not trust (rule 3): count what is actually on disk now. A theme
    # with no pixmaps renders NO window decorations at all (hardware 2026-09-09).
    _XFWM_N="$(ls "${_XFWM_THEME}"/*.xpm 2>/dev/null | wc -l)"
    if [ "${_XFWM_N}" -gt 0 ]; then
        _XFWM_SEEDED=$((_XFWM_SEEDED + 1))
        echo "${LOG_PREFIX} xfwm4 decorations present: ${_XFWM_THEME} (${_XFWM_N} pixmaps, DEC-PHASE11-026/12-042)"
    else
        echo "${LOG_PREFIX} ERROR: ${_XFWM_THEME} still has 0 pixmaps after seeding" >&2
        echo "${LOG_PREFIX}   Consequence: windows under that theme have no titlebar or border." >&2
        echo "${LOG_PREFIX}   Fix: install a stock xfwm4 theme (xfwm4 package) in the chroot." >&2
        exit 1
    fi
done
if [ "${_XFWM_CANDIDATES}" -eq 0 ]; then
    echo "${LOG_PREFIX} ERROR: no /usr/share/themes/Orion-X-*/xfwm4/themerc found" >&2
    echo "${LOG_PREFIX}   Consequence: the window decorations are stock XFCE, not Orion-X." >&2
    echo "${LOG_PREFIX}   Fix: check includes.chroot staging of usr/share/themes/Orion-X-*." >&2
    exit 1
fi
echo "${LOG_PREFIX} xfwm4 themes with decorations: ${_XFWM_SEEDED}/${_XFWM_CANDIDATES}"

# ---------------------------------------------------------------------------
# DEC-PHASE12-004: make XFCE 4.20's compiled-in DEFAULT backdrop the Phoenix
# wallpaper. xfdesktop 4.20.1 hardcodes /usr/share/backgrounds/xfce/xfce-x.svg
# (the blue diamond-X + mouse) as the fallback for any monitor with no configured
# backdrop. XFCE 4.20 names backdrops by connector (monitoreDP-1 etc.), so the
# /etc/skel monitor0 seed never matches the real display and the default kept
# showing on the trixie-dev1/dev2 hardware boots. Replacing the default file
# means Phoenix renders even before set-wallpaper.sh's xfconf pass lands — the
# two layers together make the wallpaper independent of monitor naming AND of
# session-start timing. The PNG is base64-EMBEDDED in an SVG wrapper (data: URI)
# so librsvg's external-file restrictions cannot blank it. Tracing is suspended
# around the heredoc so `set -x` does not dump the ~3.8 MB payload into the log.
# ---------------------------------------------------------------------------
_PHX_WP="/opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png"
_XFCE_DEFAULT="/usr/share/backgrounds/xfce/xfce-x.svg"
if [ -f "${_PHX_WP}" ] && [ -d "$(dirname "${_XFCE_DEFAULT}")" ]; then
    set +x
    _PHX_B64="$(base64 -w0 "${_PHX_WP}")"
    cat > "${_XFCE_DEFAULT}" <<PHX_SVG
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="1920" height="1080" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice"><image width="1920" height="1080" xlink:href="data:image/png;base64,${_PHX_B64}"/></svg>
PHX_SVG
    unset _PHX_B64
    set -x
    echo "${LOG_PREFIX} XFCE default backdrop ${_XFCE_DEFAULT} replaced with Phoenix ($(stat -c %s "${_XFCE_DEFAULT}") bytes, DEC-PHASE12-004)"
else
    echo "${LOG_PREFIX} WARNING: Phoenix wallpaper or XFCE backgrounds dir missing; default backdrop not replaced" >&2
fi

echo "${LOG_PREFIX} W11-9a boot-chain branding hook complete"
