#!/bin/sh
#
# Orion-X Phoenix Edition — /etc/skel/ home-dir seed hook for live-build
# (Version label removed per DEC-PHASE7-002 single-version-authority;
#  iso/auto/config and scripts/build-iso.sh are the sole ORIONX_VERSION owners.)
#
# This script seeds /etc/skel/ with the default home-directory state that
# live-config's 0080-user-setup will copy into /home/orionx-operator/ at boot.
#
# @decision DEC-PHASE9-002 (superseded by DEC-PHASE11-014 — see below)
# @title XFCE wallpaper authority: 0100-create-user direct /home/orionx build
# @status SUPERSEDED — retained for historical reference only
# @rationale The original pattern (writing directly to /home/orionx/ at chroot
#   time) was the single authority for the live user's default backdrop. This
#   was broken by DEC-PHASE11-012 (W11-2, 2026-07-05) which changed the live
#   username from 'orionx' to 'orionx-operator'. Live-config creates
#   'orionx-operator' at boot from /etc/skel/; it never reads /home/orionx/.
#   The /home/orionx/ writes became dead-authority — nothing in the running
#   session ever saw them (R6 root cause identified 2026-07-13).
#   See DEC-PHASE11-014 for the fix.
#
# @decision DEC-PHASE11-014
# @title R6 fix: /etc/skel/ authority replaces DEC-PHASE9-002 /home/orionx/ build
# @status accepted
# @rationale R6 root-cause (2026-07-13 hardware boot): DEC-PHASE11-012 (W11-2)
#   changed live-config.username from 'orionx' to 'orionx-operator'. Live-config's
#   0080-user-setup creates 'orionx-operator' at boot by copying /etc/skel/ into
#   a fresh /home/orionx-operator/. The chroot hook was still writing to /home/orionx/
#   which is a dead path — 'orionx' never gets created, so the xfconf XML,
#   screensaver disable, terminal profile, wallpaper backdrop, and all other
#   config files were never seen by the running session. The correct Debian
#   live-config pattern: seed /etc/skel/ in the chroot; live-config copies it
#   at boot. DEC-PHASE9-002's /etc/skel/ prohibition was the LOAD-BEARING BUG.
#   This fix:
#     (a) REMOVES chroot-time 'orionx' user creation (live-config creates
#         'orionx-operator' at boot with sudo group + empty password by default
#         per Debian live-config 0080-user-setup specification).
#     (b) REDIRECTS all home-dir writes to /etc/skel/ (copied to
#         /home/orionx-operator/ at boot by live-config).
#     (c) EXTENDS the xfconf XML to include xsettings.xml with GTK theme,
#         icon theme, cursor theme, and monospace font defaults.
#     (d) UPDATES xfce4-terminal profile: Iosevka 11 font, Phoenix accent.
#     (e) PRESERVES DEC-PHASE9-002 Phoenix wallpaper last-image value verbatim
#         (same path, now in the correct authority path).
#     (f) PRESERVES W11-2f #76 screensaver disable XML (also previously landing
#         in dead-authority /home/orionx/; now correctly in /etc/skel/).
#   Authority: this hook (single-authority for /etc/skel/ default home state).
#   Consumer: live-config 0080-user-setup (copies /etc/skel/* to /home/orionx-operator/).
#   Reference: /usr/lib/live/config/0080-user-setup bullseye package v5.20210204.
#   DEC-PHASE11-012: identity value 'orionx-operator' is derived from
#     live-config.username=orionx-operator in iso/auto/config --bootappend-live.

set -e

# ---------------------------------------------------------------------------
# NOTE: No chroot-time user creation.
# live-config's 0080-user-setup creates 'orionx-operator' at boot from
# /etc/skel/. The old 'adduser --system ... orionx' block was removed as part
# of DEC-PHASE11-014 (R6 fix). The 'id orionx' guard in 0700-orionx-setup
# becomes a graceful no-op (its chown /usr/share/doc/orionx branch is inert;
# docs remain root-owned which is Debian default). See MASTER_PLAN.md T5 note.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Seed /etc/skel/ — live-config copies this to /home/orionx-operator/ at boot
# ---------------------------------------------------------------------------

# Standard skeleton directories
mkdir -p /etc/skel/Desktop
mkdir -p /etc/skel/Documents
mkdir -p /etc/skel/Analysis

# ---------------------------------------------------------------------------
# Desktop shortcuts (path: /etc/skel/Desktop/ → /home/orionx-operator/Desktop/)
# ---------------------------------------------------------------------------
cat > /etc/skel/Desktop/terminal.desktop << EOF
[Desktop Entry]
Name=Terminal
Comment=Terminal for Orion-X
Exec=xfce4-terminal
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
EOF

cat > /etc/skel/Desktop/wireshark.desktop << EOF
[Desktop Entry]
Name=Wireshark
Comment=Network Protocol Analyzer
Exec=wireshark
Icon=wireshark
Terminal=false
Type=Application
Categories=Network;Analysis;
EOF

cat > /etc/skel/Desktop/orionx-guide.desktop << EOF
[Desktop Entry]
Name=Orion-X User Guide
Comment=Documentation for Orion-X Phoenix Edition
Exec=xdg-open /usr/share/doc/orionx/User_Guide.md
Icon=help-browser
Terminal=false
Type=Application
Categories=Documentation;
EOF

chmod +x /etc/skel/Desktop/*.desktop

# ---------------------------------------------------------------------------
# bash configuration
# NOTE: welcome message → /etc/update-motd.d/10-orionx-welcome (MOTD authority)
# NOTE: orionx-help() → /etc/profile.d/orionx-help.sh (function authority)
# ---------------------------------------------------------------------------
cat > /etc/skel/.bashrc << EOF
# Orion-X Phoenix Edition — interactive shell config
# NOTE: welcome message comes from /etc/update-motd.d/10-orionx-welcome
# NOTE: orionx-help function comes from /etc/profile.d/orionx-help.sh
# Do NOT redefine either here — single-authority rule (CLAUDE.md Sacred Practice #12).

# If not running interactively, don't do anything
case \$- in
    *i*) ;;
      *) return;;
esac

# History
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s histappend
shopt -s checkwinsize

# Prompt
PS1='\[\033[38;5;214m\][Orion-X]\[\033[00m\] \[\033[01;34m\]\w\[\033[00m\]\\$ '

# Aliases
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias update='sudo apt-get update && sudo apt-get upgrade'
alias cls='clear'

# Source bash_completion if present (XFCE Terminal sets PS1; completion is nice-to-have)
[ -f /etc/bash_completion ] && . /etc/bash_completion
EOF

echo "dark" > /etc/skel/.orionx_theme

# ---------------------------------------------------------------------------
# xfce4 xfconf XML configuration
# (DEC-PHASE11-014 authority: /etc/skel/ — live-config copies at boot)
#
# All three XML files land under:
#   /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/
# and are copied to:
#   /home/orionx-operator/.config/xfce4/xfconf/xfce-perchannel-xml/
# by live-config's 0080-user-setup before xfce4 starts.
# ---------------------------------------------------------------------------
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml

# ---
# xfce4-desktop.xml — XFCE wallpaper backdrop (DEC-PHASE9-002 preserved verbatim;
# only the write target shifts from /home/orionx/ to /etc/skel/ per DEC-PHASE11-014).
# Property: /backdrop/screen0/monitor0/workspace0/last-image
# Asset staged by stage_application_content() to:
#   /opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

# ---
# xfce4-screensaver.xml — W11-2f (#76) screen-lock disable.
# Previously landing in dead-authority /home/orionx/; now correctly in /etc/skel/
# so it actually reaches the running orionx-operator session (DEC-PHASE11-014 fix).
# DEC-PHASE9-002 single-authority preserved: this is the only writer of screensaver
# XML. /etc/xdg/autostart/orionx-disable-screen-lock.desktop is Layer 2 belt-and-
# suspenders (remains unchanged by this hook rewrite).
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-screensaver.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-screensaver" version="1.0">
  <property name="lock" type="empty">
    <property name="enabled" type="bool" value="false"/>
  </property>
  <property name="saver" type="empty">
    <property name="enabled" type="bool" value="false"/>
    <property name="idle-activation" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
  </property>
</channel>
EOF

# ---
# xsettings.xml — GTK theme, icon theme, cursor theme, font defaults.
# NEW in W11-9b (DEC-PHASE11-014 + DEC-PHASE11-010):
#   ThemeName=Orion-X-Cyberdeck (GTK3 dark theme with Phoenix accent)
#   IconThemeName=Orion-X-Icons (Papirus-Dark inheritance + orionx-* overlays)
#   CursorThemeName=Orion-X-Cursor (Adwaita inheritance placeholder)
#   MonospaceFontName=Iosevka 11 (OFL-1.1, fonts-iosevka Debian package)
#   FontName=Sans 10 (general UI font; Iosevka reserved for terminal/monospace)
# xfce4's xsettings channel is the single authority for these XFCE-wide defaults.
# Reference: xfconf-query -c xsettings -l -v on a live XFCE session.
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Orion-X-Cyberdeck"/>
    <property name="IconThemeName" type="string" value="Orion-X-Icons"/>
    <property name="SoundThemeName" type="string" value="default"/>
    <property name="EnableEventSounds" type="bool" value="false"/>
    <property name="EnableInputFeedbackSounds" type="bool" value="false"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="CursorThemeName" type="string" value="Orion-X-Cursor"/>
    <property name="CursorThemeSize" type="int" value="24"/>
    <property name="MonospaceFontName" type="string" value="Iosevka 11"/>
    <property name="FontName" type="string" value="Sans 10"/>
    <property name="DecorationLayout" type="string" value="close,minimize,maximize:"/>
  </property>
</channel>
EOF

# ---------------------------------------------------------------------------
# xfce4-terminal configuration
# DEC-PHASE11-014 + DEC-PHASE11-013: Iosevka 11 primary font (OFL-1.1),
# community-developed fonts only per operator directive (DEC-PHASE11-013).
# Phoenix accent (#FF5722) as ColorForeground to match Orion-X-Cyberdeck.
# Previously landing in dead-authority /home/orionx/; now /etc/skel/ (R6 fix).
# ---------------------------------------------------------------------------
mkdir -p /etc/skel/.config/xfce4/terminal
cat > /etc/skel/.config/xfce4/terminal/terminalrc << EOF
[Configuration]
FontName=Iosevka 11
MiscAlwaysShowTabs=FALSE
MiscBell=FALSE
MiscBellUrgent=FALSE
MiscBordersDefault=TRUE
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscDefaultGeometry=80x24
MiscInheritGeometry=FALSE
MiscMenubarDefault=FALSE
MiscMouseAutohide=FALSE
MiscMouseWheelZoom=TRUE
MiscToolbarDefault=FALSE
MiscConfirmClose=TRUE
MiscCycleTabs=TRUE
MiscTabCloseButtons=TRUE
MiscTabCloseMiddleClick=TRUE
MiscTabPosition=GTK_POS_TOP
MiscHighlightUrls=TRUE
MiscMiddleClickOpensUri=FALSE
MiscCopyOnSelect=FALSE
MiscShowRelaunchDialog=TRUE
MiscRewrapOnResize=TRUE
MiscUseShiftArrowsToScroll=FALSE
MiscSlimTabs=FALSE
MiscNewTabAdjacent=FALSE
ColorForeground=#FF5722
ColorBackground=#1a1a1a
ColorCursor=#aaaaaa
ColorPalette=#2e3436;#cc0000;#4e9a06;#c4a000;#3465a4;#75507b;#06989a;#d3d7cf;#555753;#ef2929;#8ae234;#fce94f;#729fcf;#ad7fa8;#34e2e2;#eeeeec
EOF

# MOTD authority: /etc/update-motd.d/10-orionx-welcome is written by
# iso/config/hooks/live/0700-orionx-setup.hook.chroot (single authority).
# Do NOT write it here.

exit 0
