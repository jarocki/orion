#!/bin/sh
#
# Orion-X Phoenix Edition — User creation hook for live-build
# (Version label removed per DEC-PHASE7-002 single-version-authority;
#  iso/auto/config and scripts/build-iso.sh are the sole ORIONX_VERSION owners.)
#
# This script creates the default live user and sets up the home directory.
#
# @decision DEC-PHASE9-002
# @title XFCE wallpaper authority: 0100-create-user direct /home/orionx build
# @status accepted
# @rationale The established pattern in this hook is to build /home/orionx
#   directly at ISO build time (not via /etc/skel). The XFCE backdrop is set
#   by writing the xfconf XML config into /home/orionx/.config/xfce4/xfconf/
#   xfce-perchannel-xml/xfce4-desktop.xml in this hook. This is the SINGLE
#   authority for the live user's default backdrop. /etc/skel is NOT used
#   (it would duplicate the authority). toggle-theme.sh uses xfconf-query at
#   runtime to change the live value; this static XML is the default that
#   xfce4-desktop reads on first login. The xfconf property path pattern is
#   taken from toggle-theme.sh: /backdrop/screen0/monitor0/workspace0/last-image.
#   The wallpaper asset is staged by stage_application_content() in build-iso.sh
#   to /opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png.

set -e

# Create the orionx user and group
if ! getent group orionx > /dev/null; then
    addgroup --system orionx
fi

if ! getent passwd orionx > /dev/null; then
    adduser --system --shell /bin/bash --ingroup orionx --home /home/orionx orionx
    adduser orionx sudo
    passwd -d orionx
fi

# Create home directory if it doesn't exist
if [ ! -d /home/orionx ]; then
    mkdir -p /home/orionx
    chown orionx:orionx /home/orionx
fi

# Set up skeleton directories
mkdir -p /home/orionx/Desktop
mkdir -p /home/orionx/Documents
mkdir -p /home/orionx/Analysis

# Create desktop shortcuts
cat > /home/orionx/Desktop/terminal.desktop << EOF
[Desktop Entry]
Name=Terminal
Comment=Terminal for Orion-X
Exec=xfce4-terminal
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
EOF

cat > /home/orionx/Desktop/wireshark.desktop << EOF
[Desktop Entry]
Name=Wireshark
Comment=Network Protocol Analyzer
Exec=wireshark
Icon=wireshark
Terminal=false
Type=Application
Categories=Network;Analysis;
EOF

cat > /home/orionx/Desktop/orionx-guide.desktop << EOF
[Desktop Entry]
Name=Orion-X User Guide
Comment=Documentation for Orion-X Phoenix Edition
Exec=xdg-open /usr/share/doc/orionx/User_Guide.md
Icon=help-browser
Terminal=false
Type=Application
Categories=Documentation;
EOF

# Set correct permissions for desktop shortcuts
chmod +x /home/orionx/Desktop/*.desktop
chown -R orionx:orionx /home/orionx/Desktop

# Copy documentation to user's Documents folder
if [ -d /usr/share/doc/orionx ]; then
    cp -r /usr/share/doc/orionx/* /home/orionx/Documents/
    chown -R orionx:orionx /home/orionx/Documents
fi

# Set up bash configuration
# NOTE: welcome message → /etc/update-motd.d/10-orionx-welcome (MOTD authority)
# NOTE: orionx-help() → /etc/profile.d/orionx-help.sh (function authority)
# The .bashrc is intentionally limited to interactive-shell hygiene + prompt +
# aliases. Redefining the welcome echo or orionx-help() here creates a dual
# authority and the .bashrc definition WINS (bash sources ~/.bashrc after
# /etc/profile.d/*.sh), silently overriding the correct v2.0 content with
# stale v1.5.5 content. Single-authority rule: CLAUDE.md Sacred Practice #12.
# (rc8 fix for stale v1.5.5 dual-authority bug, DEC-PHASE10-017)
cat > /home/orionx/.bashrc << EOF
# Orion-X Phoenix Edition — interactive shell config
# NOTE: welcome message comes from /etc/update-motd.d/10-orionx-welcome
# NOTE: orionx-help function comes from /etc/profile.d/orionx-help.sh
# Do NOT redefine either here — single-authority rule (CLAUDE.md Sacred Practice #12).

# If not running interactively, don't do anything
case \$- in
    *i*) ;;
      *) return;;
esac

# History
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s histappend
shopt -s checkwinsize

# Prompt
PS1='\[\033[38;5;214m\][Orion-X]\[\033[00m\] \[\033[01;34m\]\w\[\033[00m\]\\$ '

# Aliases
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias update='sudo apt-get update && sudo apt-get upgrade'
alias cls='clear'

# Source bash_completion if present (XFCE Terminal sets PS1; completion is nice-to-have)
[ -f /etc/bash_completion ] && . /etc/bash_completion
EOF

# Set up XFCE4 desktop wallpaper via xfconf XML (default backdrop authority).
# The xfce4-desktop daemon reads this XML on session start to set the wallpaper.
# Property: /backdrop/screen0/monitor0/workspace0/last-image (same path used
# by toggle-theme.sh's xfconf-query calls at runtime).
# Asset staged by stage_application_content() to:
#   /opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png
mkdir -p /home/orionx/.config/xfce4/xfconf/xfce-perchannel-xml
cat > /home/orionx/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

# Set up Xfce4 terminal configuration
mkdir -p /home/orionx/.config/xfce4/terminal
cat > /home/orionx/.config/xfce4/terminal/terminalrc << EOF
[Configuration]
FontName=Monospace 12
MiscAlwaysShowTabs=FALSE
MiscBell=FALSE
MiscBellUrgent=FALSE
MiscBordersDefault=TRUE
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscDefaultGeometry=80x24
MiscInheritGeometry=FALSE
MiscMenubarDefault=FALSE
MiscMouseAutohide=FALSE
MiscMouseWheelZoom=TRUE
MiscToolbarDefault=FALSE
MiscConfirmClose=TRUE
MiscCycleTabs=TRUE
MiscTabCloseButtons=TRUE
MiscTabCloseMiddleClick=TRUE
MiscTabPosition=GTK_POS_TOP
MiscHighlightUrls=TRUE
MiscMiddleClickOpensUri=FALSE
MiscCopyOnSelect=FALSE
MiscShowRelaunchDialog=TRUE
MiscRewrapOnResize=TRUE
MiscUseShiftArrowsToScroll=FALSE
MiscSlimTabs=FALSE
MiscNewTabAdjacent=FALSE
ColorForeground=#ff9900
ColorBackground=#1a1a1a
ColorCursor=#aaaaaa
ColorPalette=#2e3436;#cc0000;#4e9a06;#c4a000;#3465a4;#75507b;#06989a;#d3d7cf;#555753;#ef2929;#8ae234;#fce94f;#729fcf;#ad7fa8;#34e2e2;#eeeeec
EOF

# Set file permissions
chown -R orionx:orionx /home/orionx/.config

# Set default theme preference
echo "dark" > /home/orionx/.orionx_theme
chown orionx:orionx /home/orionx/.orionx_theme

# MOTD authority: /etc/update-motd.d/10-orionx-welcome is written by
# iso/config/hooks/live/0700-orionx-setup.hook.chroot (single authority).
# Do NOT write it here — this hook ran first and the 0700 hook runs later
# and overwrites it anyway, but having a stale v1.5.5 definition here is
# confusing and violated single-authority rule. (rc8 fix, DEC-PHASE10-017)

# Ensure proper permissions
chown -R orionx:orionx /home/orionx

exit 0
