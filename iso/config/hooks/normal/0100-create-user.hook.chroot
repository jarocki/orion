#!/bin/sh
#
# Orion-X Phoenix Edition — /etc/skel/ home-dir seed hook for live-build
# (Version label removed per DEC-PHASE7-002 single-version-authority;
#  iso/auto/config and scripts/build-iso.sh are the sole ORIONX_VERSION owners.)
#
# This script seeds /etc/skel/ with the default home-directory state that
# live-config's 0080-user-setup will copy into /home/orionx-operator/ at boot.
#
# @decision DEC-PHASE9-002 (superseded by DEC-PHASE11-014 — see below)
# @title XFCE wallpaper authority: 0100-create-user direct /home/orionx build
# @status SUPERSEDED — retained for historical reference only
# @rationale The original pattern (writing directly to /home/orionx/ at chroot
#   time) was the single authority for the live user's default backdrop. This
#   was broken by DEC-PHASE11-012 (W11-2, 2026-07-05) which changed the live
#   username from 'orionx' to 'orionx-operator'. Live-config creates
#   'orionx-operator' at boot from /etc/skel/; it never reads /home/orionx/.
#   The /home/orionx/ writes became dead-authority — nothing in the running
#   session ever saw them (R6 root cause identified 2026-07-13).
#   See DEC-PHASE11-014 for the fix.
#
# @decision DEC-PHASE11-014
# @title R6 fix: /etc/skel/ authority replaces DEC-PHASE9-002 /home/orionx/ build
# @status accepted
# @rationale R6 root-cause (2026-07-13 hardware boot): DEC-PHASE11-012 (W11-2)
#   changed live-config.username from 'orionx' to 'orionx-operator'. Live-config's
#   0080-user-setup creates 'orionx-operator' at boot by copying /etc/skel/ into
#   a fresh /home/orionx-operator/. The chroot hook was still writing to /home/orionx/
#   which is a dead path — 'orionx' never gets created, so the xfconf XML,
#   screensaver disable, terminal profile, wallpaper backdrop, and all other
#   config files were never seen by the running session. The correct Debian
#   live-config pattern: seed /etc/skel/ in the chroot; live-config copies it
#   at boot. DEC-PHASE9-002's /etc/skel/ prohibition was the LOAD-BEARING BUG.
#   This fix:
#     (a) REMOVES chroot-time 'orionx' user creation (live-config creates
#         'orionx-operator' at boot with sudo group and live-config's default
#         password `live` — not empty; see 10-orionx-autologin.conf — per
#         Debian live-config 0030-user-setup on trixie, 0080 on older releases).
#     (b) REDIRECTS all home-dir writes to /etc/skel/ (copied to
#         /home/orionx-operator/ at boot by live-config).
#     (c) EXTENDS the xfconf XML to include xsettings.xml with GTK theme,
#         icon theme, cursor theme, and monospace font defaults.
#     (d) UPDATES xfce4-terminal profile: Iosevka 11 font, Phoenix accent.
#     (e) PRESERVES DEC-PHASE9-002 Phoenix wallpaper last-image value verbatim
#         (same path, now in the correct authority path).
#     (f) PRESERVES W11-2f #76 screensaver disable XML (also previously landing
#         in dead-authority /home/orionx/; now correctly in /etc/skel/).
#   Authority: this hook (single-authority for /etc/skel/ default home state).
#   Consumer: live-config 0080-user-setup (copies /etc/skel/* to /home/orionx-operator/).
#   Reference: /usr/lib/live/config/0080-user-setup bullseye package v5.20210204.
#   DEC-PHASE11-012: identity value 'orionx-operator' is derived from
#     live-config.username=orionx-operator in iso/auto/config --bootappend-live.

set -e

# ---------------------------------------------------------------------------
# NOTE: No chroot-time user creation.
# live-config's 0080-user-setup creates 'orionx-operator' at boot from
# /etc/skel/. The old 'adduser --system ... orionx' block was removed as part
# of DEC-PHASE11-014 (R6 fix). The 'id orionx' guard in 0700-orionx-setup
# becomes a graceful no-op (its chown /usr/share/doc/orionx branch is inert;
# docs remain root-owned which is Debian default). See MASTER_PLAN.md T5 note.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Seed /etc/skel/ — live-config copies this to /home/orionx-operator/ at boot
# ---------------------------------------------------------------------------

# Standard skeleton directories
mkdir -p /etc/skel/Desktop
mkdir -p /etc/skel/Documents
mkdir -p /etc/skel/Analysis

# ---------------------------------------------------------------------------
# Desktop shortcuts (path: /etc/skel/Desktop/ → /home/orionx-operator/Desktop/)
# ---------------------------------------------------------------------------
cat > /etc/skel/Desktop/terminal.desktop << EOF
[Desktop Entry]
Name=Terminal
Comment=Terminal for Orion-X
Exec=xfce4-terminal
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
EOF

cat > /etc/skel/Desktop/wireshark.desktop << EOF
[Desktop Entry]
Name=Wireshark
Comment=Network Protocol Analyzer
Exec=wireshark
Icon=wireshark
Terminal=false
Type=Application
Categories=Network;Analysis;
EOF

cat > /etc/skel/Desktop/orionx-guide.desktop << EOF
[Desktop Entry]
Name=Orion-X User Guide
Comment=Documentation for Orion-X Phoenix Edition
Exec=sh -c 'xdg-open /usr/share/doc/orionx/User_Guide.html 2>/dev/null || xdg-open /usr/share/doc/orionx/User_Guide.md'
Icon=help-browser
Terminal=false
Type=Application
Categories=Documentation;
EOF

chmod +x /etc/skel/Desktop/*.desktop

# ---------------------------------------------------------------------------
# bash configuration
# NOTE: welcome message → /etc/update-motd.d/10-orionx-welcome (MOTD authority)
# NOTE: orionx-help() → /etc/profile.d/orionx-help.sh (function authority)
# ---------------------------------------------------------------------------
cat > /etc/skel/.bashrc << EOF
# Orion-X Phoenix Edition — interactive shell config
# NOTE: welcome message comes from /etc/update-motd.d/10-orionx-welcome
# NOTE: orionx-help function comes from /etc/profile.d/orionx-help.sh
# Do NOT redefine either here — single-authority rule (CLAUDE.md Sacred Practice #12).

# If not running interactively, don't do anything
case \$- in
    *i*) ;;
      *) return;;
esac

# History
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s histappend
shopt -s checkwinsize

# Prompt
PS1='\[\033[38;5;214m\][Orion-X]\[\033[00m\] \[\033[01;34m\]\w\[\033[00m\]\\$ '

# Aliases
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias update='sudo apt-get update && sudo apt-get upgrade'
alias cls='clear'

# Source bash_completion if present (XFCE Terminal sets PS1; completion is nice-to-have)
[ -f /etc/bash_completion ] && . /etc/bash_completion
EOF

echo "dark" > /etc/skel/.orionx_theme

# ---------------------------------------------------------------------------
# xfce4 xfconf XML configuration
# (DEC-PHASE11-014 authority: /etc/skel/ — live-config copies at boot)
#
# All three XML files land under:
#   /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/
# and are copied to:
#   /home/orionx-operator/.config/xfce4/xfconf/xfce-perchannel-xml/
# by live-config's 0080-user-setup before xfce4 starts.
# ---------------------------------------------------------------------------
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml

# ---
# xfce4-desktop.xml — XFCE wallpaper backdrop (DEC-PHASE9-002 preserved verbatim;
# only the write target shifts from /home/orionx/ to /etc/skel/ per DEC-PHASE11-014).
# Property: /backdrop/screen0/monitor0/workspace0/last-image
# Asset staged by stage_application_content() to:
#   /opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/opt/orionx/theme/wallpapers/orionx-phoenix-wallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

# ---
# xfce4-screensaver.xml — W11-2f (#76) screen-lock disable.
# Previously landing in dead-authority /home/orionx/; now correctly in /etc/skel/
# so it actually reaches the running orionx-operator session (DEC-PHASE11-014 fix).
# DEC-PHASE9-002 single-authority preserved: this is the only writer of screensaver
# XML. /etc/xdg/autostart/orionx-disable-screen-lock.desktop is Layer 2 belt-and-
# suspenders (remains unchanged by this hook rewrite).
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-screensaver.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-screensaver" version="1.0">
  <property name="lock" type="empty">
    <property name="enabled" type="bool" value="false"/>
  </property>
  <property name="saver" type="empty">
    <property name="enabled" type="bool" value="false"/>
    <property name="idle-activation" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
  </property>
</channel>
EOF

# ---
# xsettings.xml — GTK theme, icon theme, cursor theme, font defaults.
# NEW in W11-9b (DEC-PHASE11-014 + DEC-PHASE11-010):
#   ThemeName=Orion-X-Cyberdeck (GTK3 dark theme with Phoenix accent)
#   IconThemeName=Orion-X-Icons (Papirus-Dark inheritance + orionx-* overlays)
#   CursorThemeName=Orion-X-Cursor (Adwaita inheritance placeholder)
#   MonospaceFontName=Iosevka 11 (OFL-1.1, fonts-iosevka Debian package)
#   FontName=Sans 10 (general UI font; Iosevka reserved for terminal/monospace)
# xfce4's xsettings channel is the single authority for these XFCE-wide defaults.
# Reference: xfconf-query -c xsettings -l -v on a live XFCE session.
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Orion-X-Cyberdeck"/>
    <property name="IconThemeName" type="string" value="Orion-X-Icons"/>
    <property name="SoundThemeName" type="string" value="default"/>
    <property name="EnableEventSounds" type="bool" value="false"/>
    <property name="EnableInputFeedbackSounds" type="bool" value="false"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="CursorThemeName" type="string" value="Orion-X-Cursor"/>
    <property name="CursorThemeSize" type="int" value="24"/>
    <property name="MonospaceFontName" type="string" value="Hack 11"/>
    <property name="FontName" type="string" value="Sans 10"/>
    <property name="DecorationLayout" type="string" value="close,minimize,maximize:"/>
  </property>
</channel>
EOF

# ---------------------------------------------------------------------------
# xfce4-terminal configuration
# DEC-PHASE11-031 (operator directive 2026-09-10): the previous "Iosevka 11"
# never rendered — fonts-iosevka is NOT in Bullseye and is not installed, so
# xfce4-terminal fell back to an unreadable substitute. Switch to Hack
# (fonts-hack-otf, the only purpose-built mono font on the ISO). Also replace
# the eye-strain Phoenix-orange ColorForeground (#FF5722 body text) with a
# readable light grey; Phoenix orange is retained as the CURSOR accent and in
# the PS1 prompt. Community-developed fonts only per DEC-PHASE11-013 (Hack is
# Apache-2.0). /etc/skel/ is the single authority (R6 fix).
#
# DEC-PHASE12-042: the palette is no longer inlined here. It is a data asset at
#   theme/terminal/dark.terminalrc (staged to /opt/orionx/theme/terminal/ by
#   stage_application_content), and scripts/toggle-theme.sh copies the same
#   assets at runtime. Before this change the palette existed three times --
#   here, and twice in toggle-theme.sh -- and the copies had already diverged:
#   toggle-theme.sh wrote an 11-key file that dropped 26 of this file's keys and
#   reverted the DEC-PHASE11-031 readable foreground. Toggling the theme made
#   the terminal worse. That is RESILIENCE rule 7 with a visible consequence.
#   /etc/skel/ remains the authority for the SEEDED home dir; the asset is the
#   authority for the PALETTE. Those are different facts.
# ---------------------------------------------------------------------------
mkdir -p /etc/skel/.config/xfce4/terminal
_ORIONX_TERM_SRC=/opt/orionx/theme/terminal/dark.terminalrc
if [ ! -f "$_ORIONX_TERM_SRC" ]; then
    echo "[0100-create-user] ERROR: $_ORIONX_TERM_SRC missing." >&2
    echo "[0100-create-user]   What breaks: the operator's terminal comes up as stock" >&2
    echo "[0100-create-user]   white-on-black with no transparency and no Phoenix palette." >&2
    echo "[0100-create-user]   Fix: ensure theme/terminal/dark.terminalrc is present in the" >&2
    echo "[0100-create-user]        repo and that stage_application_content() ran before lb build." >&2
    exit 1
fi
cp "$_ORIONX_TERM_SRC" /etc/skel/.config/xfce4/terminal/terminalrc

# Check, do not trust (RESILIENCE rule 3). FontName=Hack 12 is pinned by
# DEC-PHASE11-031 and by test-iso-content-presence 23b-j; BackgroundMode is what
# makes the terminal a cyberdeck surface rather than a grey box.
for _k in 'FontName=Hack 12' 'BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT'; do
    if ! grep -qxF "$_k" /etc/skel/.config/xfce4/terminal/terminalrc; then
        echo "[0100-create-user] ERROR: seeded terminalrc lacks '$_k'" >&2
        echo "[0100-create-user]   Fix: restore the key in theme/terminal/dark.terminalrc." >&2
        exit 1
    fi
done
echo "[0100-create-user] terminalrc seeded from $_ORIONX_TERM_SRC (keys verified)"

# ---
# xfwm4.xml — window decoration theme (Fix 2, W11-9b iter-2).
# Sets xfwm4 theme to Orion-X-Cyberdeck; title font "Sans Bold 10" (DejaVu Sans,
# always present). Was "Iosevka Bold 10" — Iosevka is not installed (DEC-PHASE11-031).
# DEC-PHASE11-010: Orion-X-Cyberdeck is the single GTK + window decoration theme.
# xfwm4's xfconf channel is the single authority for window manager theme selection.
# Without this XML, xfwm4 falls back to the XFCE default (Adwaita/Default) even
# when xsettings.xml correctly sets GTK ThemeName=Orion-X-Cyberdeck.
# ---
#
# DEC-PHASE12-042 adds the COMPOSITOR block. xfce4-terminal's
# BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT (theme/terminal/*.terminalrc)
# is inert without a running compositor -- VTE simply paints ColorBackground
# opaque. xfwm4 has a built-in compositor and /general/use_compositing is the
# single switch for it, so the transparency the terminal asks for and the
# compositor that grants it are wired together here rather than left to the
# operator to discover. frame_opacity/inactive_opacity give the window frames
# themselves the same glassy treatment.
#   If the GPU/driver cannot composite, xfwm4 logs and runs uncomposited: the
#   terminal is then opaque and everything still works (degrade loudly, not
#   fatally -- rule 8).
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Orion-X-Cyberdeck"/>
    <property name="title_font" type="string" value="Sans Bold 10"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="frame_opacity" type="int" value="88"/>
    <property name="inactive_opacity" type="int" value="92"/>
    <property name="popup_opacity" type="int" value="95"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="show_popup_shadow" type="bool" value="true"/>
    <property name="show_dock_shadow" type="bool" value="true"/>
    <property name="title_shadow_active" type="string" value="true"/>
  </property>
</channel>
EOF

# ---
# xfce4-panel.xml — custom Orion-X bottom panel (DEC-PHASE11-036).
# The stock XFCE default panel made the desktop feel generic; this seeds a
# branded dark panel that WIRES IN the four genmon widgets that already shipped
# but were displayed nowhere (net / mesh / scans / clients). Seeded in /etc/skel
# so it only applies to fresh sessions — it cannot disturb an already-running
# desktop. Widgets are invoked as `python3 <path>` so no +x bit is required.
# ---
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="dark-mode" type="bool" value="true"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <property name="mode" type="uint" value="0"/>
      <property name="size" type="uint" value="30"/>
      <property name="length" type="uint" value="100"/>
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.078"/>
        <value type="double" value="0.067"/>
        <value type="double" value="0.055"/>
        <value type="double" value="0.94"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
        <value type="int" value="10"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="applicationsmenu">
      <property name="button-title" type="string" value="Orion-X"/>
      <property name="show-button-title" type="bool" value="true"/>
    </property>
    <property name="plugin-2" type="string" value="tasklist"/>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-4" type="string" value="genmon">
      <property name="command" type="string" value="python3 /opt/orionx/scripts/control_center/widgets/net-status.py"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="update-period" type="uint" value="5000"/>
    </property>
    <property name="plugin-5" type="string" value="genmon">
      <property name="command" type="string" value="python3 /opt/orionx/scripts/control_center/widgets/mesh-status.py"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="update-period" type="uint" value="5000"/>
    </property>
    <property name="plugin-6" type="string" value="genmon">
      <property name="command" type="string" value="python3 /opt/orionx/scripts/control_center/widgets/scans-count.py"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="update-period" type="uint" value="30000"/>
    </property>
    <property name="plugin-7" type="string" value="genmon">
      <property name="command" type="string" value="python3 /opt/orionx/scripts/control_center/widgets/clients-count.py"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="update-period" type="uint" value="10000"/>
    </property>
    <property name="plugin-8" type="string" value="separator">
      <property name="style" type="uint" value="1"/>
    </property>
    <property name="plugin-9" type="string" value="clock">
      <property name="digital-format" type="string" value="%a %d %b  %H:%M"/>
    </property>
    <property name="plugin-10" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
    </property>
  </property>
</channel>
EOF

# ---
# genmon per-plugin config files (DEC-PHASE12-005).
# xfce4-genmon-plugin does NOT read its command from the panel XML above — it
# reads Command= from ~/.config/xfce4/panel/genmon-<plugin-id>.rc. Without these
# the four widgets are unconfigured and each shows the "(genmon)" placeholder
# (observed on the trixie-dev1 hardware boot). Seed them in /etc/skel alongside
# the panel XML. The <id> matches plugin-4..7. Widget scripts emit <txt> markup.
# ---
mkdir -p /etc/skel/.config/xfce4/panel
_orionx_genmon_rc() {  # $1=plugin-id  $2=widget-basename  $3=update-period-ms
    cat > "/etc/skel/.config/xfce4/panel/genmon-$1.rc" <<GENMON_RC
Command=python3 /opt/orionx/scripts/control_center/widgets/$2.py
UpdatePeriod=$3
UseLabel=0
GENMON_RC
}
_orionx_genmon_rc 4 net-status     5000
_orionx_genmon_rc 5 mesh-status    5000
_orionx_genmon_rc 6 scans-count    30000
_orionx_genmon_rc 7 clients-count  10000

# MOTD authority: /etc/update-motd.d/10-orionx-welcome is written by
# iso/config/hooks/live/0700-orionx-setup.hook.chroot (single authority).
# Do NOT write it here.

exit 0
