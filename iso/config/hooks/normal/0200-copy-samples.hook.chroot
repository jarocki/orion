#!/bin/sh
#
# Orion-X Phoenix Edition v1.5.5
# Sample data copying hook for live-build
#
# This script copies the sample data into the ISO image.

set -e

# Create target directory
SAMPLES_DIR="/opt/orionx/samples"
mkdir -p "$SAMPLES_DIR"

# If samples are available in the build directory, copy them
if [ -d "/usr/share/orionx-samples" ]; then
    cp -r "/usr/share/orionx-samples"/* "$SAMPLES_DIR/"
elif [ -d "/samples" ]; then
    cp -r "/samples"/* "$SAMPLES_DIR/"
fi

# Create README if samples directory exists but is empty
if [ -d "$SAMPLES_DIR" ] && [ -z "$(ls -A "$SAMPLES_DIR")" ]; then
    cat > "$SAMPLES_DIR/README.txt" << EOF
Orion-X Phoenix Edition v1.5.5 Sample Data

This directory is intended to hold forensic sample data for training and testing.
Sample data is not included in this build, but can be added manually or
downloaded from the Orion-X project website.

Common sample data includes:
- PCAP files (network traffic captures)
- Memory dumps
- Disk images
- Log files
- Malware samples (password protected)

To add sample data, copy files to this directory or add them at build time
using the live-build hooks.
EOF
fi

# Create symbolic links to sample data in common locations
if [ -d "$SAMPLES_DIR/pcaps" ]; then
    mkdir -p "/home/orionx/Analysis/pcaps"
    ln -sf "$SAMPLES_DIR/pcaps"/* "/home/orionx/Analysis/pcaps/"
fi

if [ -d "$SAMPLES_DIR/memory" ]; then
    mkdir -p "/home/orionx/Analysis/memory"
    ln -sf "$SAMPLES_DIR/memory"/* "/home/orionx/Analysis/memory/"
fi

if [ -d "$SAMPLES_DIR/logs" ]; then
    mkdir -p "/home/orionx/Analysis/logs"
    ln -sf "$SAMPLES_DIR/logs"/* "/home/orionx/Analysis/logs/"
fi

if [ -d "$SAMPLES_DIR/firmware" ]; then
    mkdir -p "/home/orionx/Analysis/firmware"
    ln -sf "$SAMPLES_DIR/firmware"/* "/home/orionx/Analysis/firmware/"
fi

# Set proper permissions
chown -R root:root "$SAMPLES_DIR"
chmod -R 755 "$SAMPLES_DIR"

# Set correct ownership for user directory symbolic links
if [ -d "/home/orionx/Analysis" ]; then
    chown -R orionx:orionx "/home/orionx/Analysis"
fi

exit 0
