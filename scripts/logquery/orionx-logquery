_COLOR = {"dim": "\033[2m", "red": "\033[31m", "grn": "\033[32m",
          "yel": "\033[33m", "cyn": "\033[36m", "rst": "\033[0m"}
if not sys.stderr.isatty() or os.environ.get("NO_COLOR"):
    _COLOR = dict.fromkeys(_COLOR, "")


def info(message: str) -> None:
    print(f"{_COLOR['cyn']}·{_COLOR['rst']} {message}", file=sys.stderr)


def warn(message: str) -> None:
    print(f"{_COLOR['yel']}!{_COLOR['rst']} {message}", file=sys.stderr)


def fail(message: str, hint: str = "") -> int:
    print(f"{_COLOR['red']}x{_COLOR['rst']} {message}", file=sys.stderr)
    if hint:
        for line in hint.splitlines():
            print(f"  {_COLOR['dim']}{line}{_COLOR['rst']}", file=sys.stderr)
    return 1


