def render_table(columns, rows, out=sys.stdout) -> None:
    if not rows:
        print("  (no rows)", file=out)
        return
    text = [[("" if v is None else str(v)) for v in row] for row in rows]
    widths = [max(len(str(columns[i])), max(len(r[i]) for r in text))
              for i in range(len(columns))]
    widths = [min(w, 60) for w in widths]
    header = "  ".join(str(c)[:widths[i]].ljust(widths[i])
                       for i, c in enumerate(columns))
    print("  " + header, file=out)
    print("  " + "  ".join("-" * w for w in widths), file=out)
    for row in text:
        print("  " + "  ".join(row[i][:widths[i]].ljust(widths[i])
                               for i in range(len(columns))), file=out)


def render_rows(columns, rows, fmt: str, out=sys.stdout) -> None:
    if fmt == "table":
        render_table(columns, rows, out)
    elif fmt == "csv":
        writer = csv.writer(out)
        writer.writerow(columns)
        writer.writerows(rows)
    elif fmt in ("json", "ndjson"):
        for row in rows:
            print(json.dumps(dict(zip(columns, row)), default=str), file=out)


def render_targeted(result: dict, freshness: dict, fmt: str,
                    out=sys.stdout) -> None:
    if fmt in ("json", "ndjson"):
        payload = dict(result)
        payload["intel"] = freshness
        print(json.dumps(payload, default=str,
                         indent=2 if fmt == "json" else None), file=out)
        return
    if fmt == "csv":
        columns = ["ip", "verdict", "signal", "hits", "active_days",
                   "browsed_real", "local_rare", "intel_uncommon", "spoofed",
                   "first_seen", "last_seen", "reasons"]
        writer = csv.writer(out)
        writer.writerow(columns)
        for row in result["rows"]:
            writer.writerow([row.get(c) if c != "reasons" else " | ".join(row["reasons"])
                             for c in columns])
        return

    counts = result["verdict_counts"]
    print(file=out)
    print(f"  {result['records']} record(s) from {result['sources']} source(s), "
          f"{result['distinct_paths']} distinct path(s)", file=out)
    print(f"  {_COLOR['dim']}a path is 'locally rare' when at most "
          f"{result['rare_threshold']} source(s) here ever asked for it"
          f"{_COLOR['rst']}", file=out)
    summary = ", ".join(f"{n} {v}" for v, n in sorted(counts.items()))
    print(f"  verdicts: {summary or 'none'}", file=out)
    print(file=out)
    for row in result["rows"]:
        if row["verdict"] == correlate.VERDICT_TARGETED:
            colour = _COLOR["red"]
        elif row["verdict"] == correlate.VERDICT_ATTENTION:
            colour = _COLOR["yel"]
        else:
            colour = _COLOR["dim"]
        org = f" ({row['org']})" if row.get("org") else ""
        print(f"  {colour}{row['verdict']:<18}{_COLOR['rst']} {row['ip']}{org}"
              f"  signal {row['signal']}, {row['hits']} record(s), "
              f"{row['active_days']} day(s)", file=out)
        for reason in row["reasons"]:
            print(f"      · {reason}", file=out)
        print(file=out)
    print(f"  {_COLOR['dim']}'widespread' means nothing matched the patterns "
          f"this tool looks for — not that you are safe.{_COLOR['rst']}", file=out)
    print(f"  {_COLOR['dim']}{intel_mod.freshness_banner(freshness)}"
          f"{_COLOR['rst']}", file=out)
    print(file=out)


def render_similarity(result: dict, fmt: str, out=sys.stdout) -> None:
    if fmt in ("json", "ndjson"):
        print(json.dumps(result, default=str, indent=2), file=out)
        return
    if not result["found"]:
        print(f"\n  seed {result['seed']} does not appear in this evidence — "
              f"widen the window or check the address.\n", file=out)
        return
    print(f"\n  Similarity to {result['seed']} "
          f"({result['seed_hits']} record(s))\n", file=out)
    for axis in result["inactive_axes"]:
        print(f"  {_COLOR['dim']}inactive axis: {axis}{_COLOR['rst']}", file=out)
    print(file=out)
    if not result["matches"]:
        print("  No other source shares 2+ behavioural features with this one.",
              file=out)
        print(f"  {_COLOR['dim']}That is a weak 'probably not a cluster' — "
              f"not a guarantee.{_COLOR['rst']}\n", file=out)
        return
    for match in result["matches"]:
        org = f" ({match['org']})" if match.get("org") else ""
        print(f"  {_COLOR['grn']}{match['ip']}{_COLOR['rst']}{org}  "
              f"{match['hits']} record(s)", file=out)
        for feature in match["features"]:
            print(f"      · {feature}", file=out)
        print(file=out)


