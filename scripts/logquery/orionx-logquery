def check_mode(path: Path) -> None:
    """Warn on a group/world-readable credential or key file."""
    try:
        mode = path.stat().st_mode
    except OSError:
        return
    if mode & (stat.S_IRWXG | stat.S_IRWXO):
        warn(f"{path} is group/world accessible — run: chmod 600 {path}")


def make_unsealer(key_path: Path):
    """Build a decrypt callable from an offline private key, or raise.

    The key is loaded once, held in memory for the run, and never written
    anywhere. KEY_PASSPHRASE is read from the environment exactly as upstream.
    """
    try:
        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.asymmetric import padding
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        from cryptography.hazmat.primitives.serialization import load_pem_private_key
    except ImportError as exc:
        raise sources.SourceError(
            "sealed archives need python3-cryptography, which is not installed",
            "install it (sudo apt-get install python3-cryptography), or work "
            "from local evidence: --path <file>") from exc
    if not key_path.exists():
        raise sources.SourceError(f"private key not found: {key_path}",
                                  "pass --key, or restore it from offline backup")
    check_mode(key_path)
    passphrase = os.environ.get("KEY_PASSPHRASE")
    with open(key_path, "rb") as handle:
        private_key = load_pem_private_key(
            handle.read(),
            password=passphrase.encode() if passphrase else None)

    import base64

    def unseal(envelope: dict) -> dict:
        iv = base64.b64decode(envelope["iv"])
        wrapped = base64.b64decode(envelope["wrappedKey"])
        ciphertext = base64.b64decode(envelope["ciphertext"])
        aes_key = private_key.decrypt(
            wrapped,
            padding.OAEP(mgf=padding.MGF1(algorithm=hashes.SHA256()),
                         algorithm=hashes.SHA256(), label=None))
        return json.loads(AESGCM(aes_key).decrypt(iv, ciphertext, None))

    return unseal


def acquire(args, window) -> tuple[list[dict], list[str]]:
    """Fetch records from the selected source. Returns (records, notes)."""
    if args.source == "local":
        return sources.read_local(args.path)

    if args.source == "api":
        token = None
        if args.api_token_file:
            token_path = Path(args.api_token_file).expanduser()
            check_mode(token_path)
            try:
                token = token_path.read_text().strip()
            except OSError as exc:
                raise sources.SourceError(
                    f"could not read the API token file: {token_path}",
                    exc.strerror or "") from exc
        if not args.api_url:
            raise sources.SourceError("--source api needs --api-url",
                                      "e.g. --api-url https://host/logs.ndjson")
        return sources.read_api(args.api_url, token, timeout=args.timeout)

    env_file = Path(args.env or sources.DEFAULT_ENV_FILE).expanduser()
    if env_file and env_file.exists():
        check_mode(env_file)
    creds = sources.credentials_for(args.source, env_file)
    unseal = None
    if not args.no_decrypt:
        try:
            unseal = make_unsealer(Path(args.key).expanduser())
        except sources.SourceError as exc:
            if Path(args.key).expanduser().exists():
                raise
            warn(f"{exc} — reading objects as plaintext")
    prefixes = sources.day_prefixes(window, args.prefix or "raw")
    return sources.read_object_store(
        args.source, creds, prefixes, unseal=unseal, limit=args.limit,
        endpoint=args.endpoint_url)


# ---------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Query and correlate forensic logs. New here? "
                    f"run: {PROG} --guide",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Reports: " + ", ".join(engine.ALL_REPORTS)
               + f"\nPlain-language list: {PROG} --list-reports\n")

    src = parser.add_argument_group("source")
    src.add_argument("--source", choices=sources.SOURCES, default="local",
                     help="where the evidence comes from (default: local)")
    src.add_argument("--path", default="-",
                     help="local file, directory, or - for stdin (default: -)")
    src.add_argument("--api-url", help="HTTP(S) endpoint serving NDJSON or JSON")
    src.add_argument("--api-token-file",
                     help="file holding a bearer token (mode-checked, never logged)")
    src.add_argument("--endpoint-url", help="S3-compatible endpoint URL")
    src.add_argument("--env",
                     help="credentials file for r2/s3 (KEY=value, chmod 600; "
                          f"default: {sources.DEFAULT_ENV_FILE})")
    src.add_argument("--key", default="~/.config/orionx/logquery/priv.pem",
                     help="offline private key for sealed archives")
    src.add_argument("--no-decrypt", action="store_true",
                     help="treat fetched objects as plaintext JSON")
    src.add_argument("--prefix", help="object-store key prefix (default: raw)")
    src.add_argument("--limit", type=int, help="stop after N objects")
    src.add_argument("--timeout", type=int, default=30, help="network timeout (s)")

    win = parser.add_argument_group("time range")
    win.add_argument("--last", metavar="24h|7d|4w", help="relative window")
    win.add_argument("--since", metavar="YYYY-MM-DD", help="absolute start")

    qry = parser.add_argument_group("query")
    qry.add_argument("--report", choices=engine.ALL_REPORTS, metavar="NAME",
                     help="preset report (see --list-reports)")
    qry.add_argument("--focus", metavar="IOC",
                     help="narrow to address/CIDR/range/ASN/country/path/port")
    qry.add_argument("--sql", help="arbitrary SQL over table r")
    qry.add_argument("--engine", choices=engine.ENGINES,
                     default=engine.DEFAULT_ENGINE,
                     help="SQL engine (default: %(default)s, stdlib)")
    qry.add_argument("--format", choices=("table", "csv", "json", "ndjson"),
                     default="table", help="output format (default: table)")

    itl = parser.add_argument_group("intel")
    itl.add_argument("--intel-dir", help="intel cache directory")
    itl.add_argument("--no-enrich", action="store_true",
                     help="skip enrichment entirely")
    itl.add_argument("--intel-status", action="store_true",
                     help="report what intel is cached and how old it is, then exit")

    out = parser.add_argument_group("output")
    out.add_argument("--publish", action="store_true",
                     help="emit findings onto the R.A.I.N. event bus")
    out.add_argument("--dry-run", action="store_true",
                     help="print would-be bus events instead of publishing")
    out.add_argument("--keep", help="write the normalized corpus to this file (0600)")

    doc = parser.add_argument_group("help")
    doc.add_argument("--guide", action="store_true",
                     help="plain-language walkthrough, then exit")
    doc.add_argument("--list-reports", action="store_true",
                     help="describe every report, then exit")
    return parser


def cmd_intel_status(args) -> int:
    intel = intel_mod.load_intel(args.intel_dir)
    freshness = intel["freshness"]
    payload = {
        "cache_dir": intel["cache_dir"],
        "base_version": intel["base_version"],
        "signatures": len(intel["signatures"]),
        "research_scanners": len(intel["research_scanners"]),
        "notable_paths": len(intel["paths"]),
        "kev_entries": intel["catalog_count"],
        "freshness": freshness,
        "metadata": intel["metadata"],
    }
    if args.format in ("json", "ndjson"):
        print(json.dumps(payload, default=str, indent=2))
    else:
        print()
        print(f"  intel cache      {intel['cache_dir']}")
        print(f"  curated base     version {intel['base_version']} "
              f"({len(intel['signatures'])} signatures, "
              f"{len(intel['research_scanners'])} research scanners, "
              f"{len(intel['paths'])} notable paths)")
        print(f"  fetched catalog  {intel['catalog_count']} KEV entries")
        print(f"  state            {freshness['state'].upper()}")
        print(f"  {intel_mod.freshness_banner(freshness, intel['catalog_count'])}")
        print()
    return 1 if freshness["warn"] else 0


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.guide:
        print(GUIDE)
        return 0
    if args.list_reports:
        print("\n  Reports (use with --report):\n")
        for name in engine.ALL_REPORTS:
            marker = " *" if name in engine.PYTHON_REPORTS else "  "
            print(f"  {_COLOR['cyn']}{name:<12}{_COLOR['rst']}{marker} "
                  f"{engine.REPORT_HELP.get(name, '')}")
        print(f"\n  {_COLOR['dim']}* computed in pure Python — needs no SQL "
              f"engine and no intel.{_COLOR['rst']}")
        print("  Every report accepts --focus. Example:")
        print(f"  {PROG} --path /var/log --report targeted --focus AS14061\n")
        return 0
    if args.intel_status:
        return cmd_intel_status(args)

    # --- window -----------------------------------------------------------
    try:
        window = sources.parse_window(args.last, args.since)
    except sources.SourceError as exc:
        return fail(str(exc), exc.hint)

    # --- acquire ----------------------------------------------------------
    try:
        records, notes = acquire(args, window)
    except sources.SourceError as exc:
        return fail(str(exc), exc.hint)
    except KeyboardInterrupt:
        return 130

    for note in notes:
        info(note)
    before = len(records)
    records = sources.apply_window(records, window)
    if window is not None and len(records) != before:
        info(f"window kept {len(records)} of {before} record(s)")
    undated = sum(1 for r in records if not r.get("ts"))
    if undated:
        warn(f"{undated} record(s) carry no parseable timestamp — kept, but "
             "they cannot contribute to recurrence or timeline")

    # The corpus before --focus narrows it. similarity() needs this: it
    # compares a seed against everything else, so running it on the focused
    # set would leave it comparing the seed with itself. Kept rather than
    # re-fetched, because a second acquire() would re-read a stdin that is
    # already consumed and would hit the network twice for --source api.
    unfocused = list(records)

    # --- focus ------------------------------------------------------------
    predicate, described, skipped = sources.focus_predicate(args.focus)
    for token in skipped:
        warn(f"unrecognized --focus token, ignoring: {token}")
    if described:
        records = [r for r in records if predicate(r)]
        info(f"focus: {described} — {len(records)} record(s)")

    # --- intel ------------------------------------------------------------
    intel = None
    freshness = {"state": intel_mod.STATE_MISSING, "age_days": None,
                 "warn": False, "label": "enrichment disabled (--no-enrich)"}
    if not args.no_enrich:
        intel = intel_mod.load_intel(args.intel_dir)
        freshness = intel["freshness"]
        banner = intel_mod.freshness_banner(freshness, intel["catalog_count"])
        # Always stated, on every run, whatever the state. This is the whole
        # point: stale intel is never presented as current.
        (warn if freshness["warn"] else info)(banner)
        intel_mod.enrich_all(records, intel)
    else:
        intel_mod.enrich_all(records, None)
        warn("enrichment disabled — tool/CVE/KEV columns will be empty")

    if not records:
        warn("no records matched — widen --last/--since, or check --path/--focus")
        return 0

    if args.keep:
        keep_path = Path(args.keep).expanduser()
        keep_path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(keep_path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as handle:
            for rec in records:
                handle.write(json.dumps(rec, default=str) + "\n")
        warn(f"normalized corpus retained at {keep_path} (0600) — "
             "delete it when the case closes")

    report = args.report or ("summary" if not args.sql else None)

    # --- python-side correlation reports ---------------------------------
    if report == "targeted":
        result = correlate.correlate(records)
        render_targeted(result, freshness, args.format)
        if args.publish or args.dry_run:
            count = publish_findings(result, freshness, dry_run=args.dry_run)
            info(f"{count} event(s) {'would be ' if args.dry_run else ''}published")
        return 0

    if report == "similarity":
        if not args.focus:
            return fail("the 'similarity' report needs a seed address",
                        "add: --focus <IP>")
        seed = args.focus.split(",")[0].strip()
        intel_mod.enrich_all(unfocused, intel if not args.no_enrich else None)
        render_similarity(correlate.similarity(unfocused, seed), args.format)
        return 0

    if report == "cadence":
        rows = correlate.cadence(records)
        columns = ["ip", "requests", "mean_gap_s", "cv", "machine_regular", "org"]
        render_rows(columns, [[r[c] for c in columns] for r in rows],
                    args.format)
        if args.format == "table":
            print(f"\n  {_COLOR['dim']}Low variation (cv < 0.25) with steady "
                  f"spacing suggests a script, not a person.{_COLOR['rst']}\n")
        return 0

    # --- SQL reports -------------------------------------------------------
    if report in engine.INTEL_DEPENDENT and freshness["state"] in (
            intel_mod.STATE_MISSING, intel_mod.STATE_STALE,
            intel_mod.STATE_UNDATED):
        warn(f"report '{report}' reads enrichment columns, and "
             f"{freshness['label']}. Read its CVE/KEV columns accordingly.")

    try:
        connection = engine.make_engine(args.engine, records)
    except engine.EngineUnavailable as exc:
        return fail(str(exc), exc.hint)

    if report in engine.SQL_NEEDS_REGEX and not connection.regex_available:
        connection.close()
        return fail(f"report '{report}' needs regex matching, which this "
                    f"engine could not provide", connection.regex_note)

    sql = args.sql or engine.SQL_REPORTS[report]
    info(f"engine: {connection.name}, {len(records)} record(s)")
    try:
        columns, rows = connection.query(sql)
    except Exception as exc:
        connection.close()
        return fail(f"query failed: {exc}",
                    f"columns available on table r: {', '.join(engine.TABLE_COLUMNS)}")
    render_rows(columns, rows, args.format)
    connection.close()

    if args.publish or args.dry_run:
        result = correlate.correlate(records)
        count = publish_findings(result, freshness, dry_run=args.dry_run)
        info(f"{count} event(s) {'would be ' if args.dry_run else ''}published")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        raise SystemExit(0)
    except KeyboardInterrupt:
        raise SystemExit(130)
