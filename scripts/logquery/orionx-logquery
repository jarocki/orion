# ---------------------------------------------------------------------------
# bus publishing (same fire-and-forget shape as scanwatch / nucleotide-watch)
# ---------------------------------------------------------------------------
def bus_severity(row: dict) -> str:
    """Map a correlation verdict to a bus severity."""
    if row["verdict"] == correlate.VERDICT_TARGETED:
        return "critical" if row["signal"] >= 7 else "warning"
    if row["verdict"] == correlate.VERDICT_ATTENTION:
        return "notice"
    return "info"


def finding_message(row: dict) -> str:
    """One line an operator can act on, with the reason attached."""
    return (f"{row['verdict']}: {row['ip']} — signal {row['signal']}, "
            f"{row['hits']} record(s) across {row['active_days']} day(s); "
            f"{row['reasons'][0]}")


def finding_detail(row: dict) -> dict:
    """The evidence behind a verdict, for the Cockpit drill-down.

    The message says what was concluded; this says what it was concluded
    from, so an operator can judge the verdict instead of trusting it. Sent
    whole: emit_event() budgets the line and spills the remainder to a
    sidecar, so pre-truncating here would throw away evidence the bus was
    prepared to keep.
    """
    return {
        "ip": row["ip"],
        "verdict": row["verdict"],
        "signal": row["signal"],
        "hits": row["hits"],
        "active_days": row["active_days"],
        "recurring": row["active_days"] > 1,
        "browsed_real": bool(row["browsed_real"]),
        "probed": bool(row["probed"]),
        "locally_uncommon_probe": bool(row["local_rare"]),
        "rare_paths": row["rare_paths"],
        "intel_uncommon": bool(row["intel_uncommon"]),
        "spoofed": bool(row["spoofed"]),
        "distinct_paths": row["distinct_paths"],
        "distinct_ports": row["ports"],
        "tools": row["tools"],
        "research_org": row["research_org"],
        "first_seen": row["first_seen"],
        "last_seen": row["last_seen"],
        "reasons": row["reasons"],
    }


def publish(severity: str, category: str, message: str,
            detail: dict | None = None, dry_run: bool = False) -> None:
    if dry_run:
        suffix = f" detail={json.dumps(detail, default=str)}" if detail else ""
        print(f"[bus:{severity}/{category}] {message}{suffix}", file=sys.stderr)
        return
    argv = ["orionx-event", "--severity", severity, "--source", "logquery",
            "--category", category]
    if detail:
        argv += ["--detail", json.dumps(detail, default=str)]
    argv.append(message)
    try:
        subprocess.Popen(argv, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError:
        pass


def publish_findings(result: dict, freshness: dict, dry_run: bool = False) -> int:
    """Emit stale-intel first, then each targeted/worth-a-look verdict.

    Staleness goes first on purpose: if the findings that follow were judged
    with month-old intel, the operator learns that before reading them.
    """
    published = 0
    if freshness.get("warn"):
        publish("warning", "intel",
                f"logquery ran with degraded threat intel — {freshness['label']}",
                detail={"state": freshness["state"],
                        "age_days": freshness.get("age_days"),
                        "remedy": "sudo orionx-freshen-intel"},
                dry_run=dry_run)
        published += 1
    for row in result["rows"]:
        if row["verdict"] in (correlate.VERDICT_TARGETED,
                              correlate.VERDICT_ATTENTION):
            publish(bus_severity(row), "forensics", finding_message(row),
                    detail=finding_detail(row), dry_run=dry_run)
            published += 1
    return published


