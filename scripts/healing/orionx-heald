#!/usr/bin/env python3
"""orionx-heald — the Orion-X auto-healing daemon.

Tails the R.A.I.N. event bus, maps events to playbooks through a static
registry, and acts only as far as the operator's standing consent in
~/.config/orionx/autonomy.json permits. Everything it does is reversible, has a
rollback timer, and is sealed into a hash-chained audit ledger.

    orionx-heald                 # normal operation (systemd)
    orionx-heald --dry-run -v    # decide out loud, change nothing
    orionx-heald --stdin         # feed it JSONL events for testing
    orionx-heald --once          # one pass over the bus, then exit

@decision DEC-PHASE12-023
@title Auto-healing daemon consuming the existing event bus
@status accepted
@rationale The Control Center has offered the operator an autonomy grid since
  W10-6's first slice, and nothing consumed it: an operator could set block_ip
  to "autonomous" and be wrong about it during an incident. This daemon is the
  consumer that makes the control real.

  It reads /run/orionx/events.jsonl — the same bus R.A.I.N. hears and the
  Cockpit shows (DEC-PHASE11-045) — rather than opening a second detection
  path. Every detector already publishes there, so the engine inherits
  scanwatch, nucleotide, YARA and Suricata without coupling to any of them,
  and the three channels (hear, see, act) can never disagree about what
  happened. It publishes its own actions back onto the same bus, which is why
  match_event() refuses events whose source is "healing": on a shared bus, an
  action that announces itself into its own trigger is a feedback loop.

  Tailing follows cockpit_lib.EventTail: start at EOF (a daemon restart must
  not re-act on an hour of history), and reopen on inode change or truncation
  because the bus lives on tmpfs.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
from pathlib import Path

_HERE = Path(__file__).resolve().parent
if str(_HERE) not in sys.path:
    sys.path.insert(0, str(_HERE))

import engine as eng  # noqa: E402
import healing_lib as hl  # noqa: E402

POLL_SECONDS = 1.0
SWEEP_SECONDS = 30.0


class BusTail:
    """Incremental tail of the JSONL event bus, starting at EOF.

    Deliberately unlike cockpit_lib.EventTail in one respect: no backfill. The
    Cockpit backfills so its panel is not empty at launch; a responder that
    backfilled would re-act on every event since boot each time systemd
    restarted it. Handles the file not existing yet, and tmpfs rotation
    (inode change) or truncation.
    """

    def __init__(self, path: Path) -> None:
        self.path = Path(path)
        self._fh = None
        self._inode = -1
        self._pos = 0

    def _open(self, from_start: bool = False) -> bool:
        try:
            st = self.path.stat()
            fh = self.path.open("r", encoding="utf-8", errors="replace")
        except OSError:
            return False
        self._fh = fh
        self._inode = st.st_ino
        if not from_start:
            fh.seek(0, 2)
        self._pos = fh.tell()
        return True

    def rewind(self) -> None:
        """Re-read from the start of the bus (one-shot mode only)."""
        if self._fh is not None:
            self._fh.close()
            self._fh = None
        self._open(from_start=True)

    def poll(self) -> list[dict]:
        if self._fh is None and not self._open():
            return []
        try:
            st = self.path.stat()
            if st.st_ino != self._inode or st.st_size < self._pos:
                self._fh.close()
                self._fh = None
                if not self._open(from_start=True):
                    return []
        except OSError:
            return []
        out = []
        for line in self._fh:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if isinstance(obj, dict):
                out.append(obj)
        self._pos = self._fh.tell()
        return out


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="orionx-heald",
        description="Auto-healing engine: act on R.A.I.N. events within the "
                    "operator's pre-approved autonomy.",
    )
    ap.add_argument("--dry-run", action="store_true",
                    help="decide and print; perform no action, write no ledger")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="narrate every decision")
    ap.add_argument("--stdin", action="store_true",
                    help="read JSONL events from stdin instead of the bus")
    ap.add_argument("--once", action="store_true",
                    help="process the bus from the START, then exit (one-shot; "
                         "unlike the daemon loop this DOES replay history)")
    ap.add_argument("--bus", default=str(hl.EVENT_LOG),
                    help="event bus path (default: %(default)s)")
    ap.add_argument("--state-dir", default=str(hl.STATE_DIR),
                    help="ledger + vault directory (default: %(default)s)")
    ap.add_argument("--no-reconcile", action="store_true",
                    help="skip re-asserting active blocks into nftables at start")
    args = ap.parse_args(argv)

    e = eng.Engine(dry_run=args.dry_run, verbose=args.verbose,
                   state_dir=Path(args.state_dir))

    if args.stdin:
        # Test/feed mode: no host probing surprises, no nftables reconcile.
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if isinstance(event, dict):
                e.handle_event(event)
        return 0

    if not args.no_reconcile and not args.dry_run:
        e.reconcile()
    e.sweep()

    tail = BusTail(Path(args.bus))
    if args.once:
        # One-shot mode reads from the beginning: "process what is already on
        # the bus" is the whole point of it, and seeking to EOF first (which is
        # right for the daemon, so a restart does not re-act on history) would
        # make it silently process nothing at all.
        tail.rewind()
        for event in tail.poll():
            e.handle_event(event)
        return 0

    e.publish("info", "auto-healing engine online; acting within "
                      "~/.config/orionx/autonomy.json")
    last_sweep = time.time()
    try:
        while True:
            for event in tail.poll():
                e.handle_event(event)
            now = time.time()
            if now - last_sweep >= SWEEP_SECONDS:
                e.sweep(now)
                last_sweep = now
            time.sleep(POLL_SECONDS)
    except KeyboardInterrupt:
        return 0
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
