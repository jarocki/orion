#!/bin/sh
# ap — launcher for the vendored Pivotglass package (roadmap #90).
#
# @decision DEC-PHASE12-013
# @title Pivotglass vendored as a plain package + launcher (apt deps, one pip dep)
# @status accepted
# @rationale Pivotglass (github.com/jarocki/pivotglass, distribution and command
#   "pivotglass"; `ap` is kept as an Orion-X alias) needs Python >= 3.12 — trixie's system
#   3.13 — and nine runtime deps, eight of which are trixie apt packages
#   (python3-cmd2 rich sqlalchemy httpx pydantic pyfiglet tomli-w yaml). Only
#   stix2 (+ stix2-patterns, antlr4 runtime; all pure Python) is pip-installed
#   at ISO-build time. So, like nucleotide: vendor the package verbatim under
#   /opt/orionx/scripts/pivotglass/pivotglass/, run it with python3 -m,
#   no venv, no uv. The committed Next.js static export is placed at
#   pivotglass/web/static/ — the PACKAGED layout server.py already
#   supports — so the repo skeleton is not shipped. State lives in ~/.ap.
#
# Usage: ap [web|tui|chat|basic|repl|--version|--help]
#   `ap` / `ap web`  → local browser cockpit at http://127.0.0.1:8765 (opens
#                      firefox-esr); `ap tui` → terminal deck.
#   First investigation, fully offline:  workspace learn first-case

_SOURCE="$0"
while [ -h "$_SOURCE" ]; do
    _dir="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd)"
    _SOURCE="$(readlink "$_SOURCE")"
    case "$_SOURCE" in /*) ;; *) _SOURCE="$_dir/$_SOURCE" ;; esac
done
HERE="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd)"

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m pivotglass "$@"
