#!/usr/bin/env python3
"""orionx-rain — R.A.I.N. daemon: turn event-bus events into audible alerts.

Tails the Orion-X event bus (/run/orionx/events.jsonl) and, for each event at or
above the operator's configured minimum severity, plays a distinct severity-mapped
tone so an intrusion is HEARD, not watched (issue #88, DEC-PHASE11-045). This is
the operator's "3am self" ears.

Runs as a per-session background process (started from /etc/xdg/autostart in the
XFCE session, where it has audio access). Config lives at ~/.config/orionx/rain.json
and is re-read live, so Control Center toggles take effect without a restart.

Throttling guarantees an event STORM never becomes an audio storm: each severity
has a cooldown, and no two cues ever play closer than a global minimum gap.

Spoken narration (DEC-PHASE12-046) is layered strictly AFTER the cue: the tone
is the safety-critical signal and fires synchronously, exactly as before; the
narrator is a bounded, non-blocking, drop-don't-queue worker. Off by default.

Modes:
    orionx-rain                 run the daemon (default)
    orionx-rain --test WARNING  play one cue for a severity and exit (CC "Test")
    orionx-rain --oneshot       drain current backlog, play the most urgent, exit
    orionx-rain --speech on|off turn spoken narration on or off
    orionx-rain --speech-status report the speech subsystem and how to fix it
    orionx-rain --speech-test   narrate one synthetic alert end to end
"""

from __future__ import annotations

import argparse
import json
import signal
import sys
import time
from pathlib import Path

_here = Path(__file__).resolve()
sys.path.insert(0, str(_here.parent))

import rain_lib  # noqa: E402

# Poll cadence for new lines + config mtime (seconds).
_POLL = 0.5
_running = True


def _speech_module():
    """Import rain_speech, or None. DEC-PHASE12-046.

    Deliberately not a module-level import: a broken, half-installed or
    syntactically damaged rain_speech.py must cost the operator nothing but
    speech. Tones are what this daemon exists for and they must survive
    anything that happens to the narration layer.
    """
    try:
        import rain_speech  # noqa: PLC0415
        return rain_speech
    except Exception:  # noqa: BLE001
        return None


def _stop(_signum, _frame):
    global _running
    _running = False


def _should_play(event: dict, cfg: dict) -> bool:
    """Gate an event against the live config (enabled + min severity)."""
    if not cfg.get("enabled", True):
        return False
    sev = rain_lib.normalize_severity(event.get("severity", "notice"))
    return rain_lib.severity_rank(sev) >= rain_lib.severity_rank(cfg["min_severity"])


class _Throttle:
    """Per-severity cooldown + a global minimum gap between any two cues."""

    def __init__(self) -> None:
        self._last_by_sev: dict[str, float] = {}
        self._last_any = 0.0

    def allow(self, severity: str, now: float) -> bool:
        if now - self._last_any < rain_lib.GLOBAL_MIN_GAP_SECONDS:
            return False
        cooldown = rain_lib.COOLDOWN_SECONDS.get(severity, 10.0)
        if now - self._last_by_sev.get(severity, 0.0) < cooldown:
            return False
        return True

    def record(self, severity: str, now: float) -> None:
        self._last_by_sev[severity] = now
        self._last_any = now


def _open_at_end(path: Path):
    """Open the spool for reading, positioned at EOF. None if not present yet."""
    try:
        fh = path.open("r", encoding="utf-8", errors="replace")
        fh.seek(0, 2)  # SEEK_END — only react to events after we start
        return fh
    except OSError:
        return None


def run_daemon() -> int:
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    throttle = _Throttle()
    cfg = rain_lib.load_config()
    cfg_mtime = _config_mtime()
    narrator = _sync_narrator(None, cfg)   # DEC-PHASE12-046

    path = rain_lib.EVENT_LOG
    fh = _open_at_end(path)
    inode = _inode(path)

    while _running:
        # Live-reload config when rain.json changes (CC toggle).
        m = _config_mtime()
        if m != cfg_mtime:
            cfg = rain_lib.load_config()
            cfg_mtime = m
            narrator = _sync_narrator(narrator, cfg)

        # Wait for the spool to appear if it does not exist yet.
        if fh is None:
            fh = _open_at_end(path)
            inode = _inode(path)
            if fh is None:
                time.sleep(_POLL)
                continue

        # Detect truncation/rotation (tmpfs recreated): reopen from the top so
        # we don't miss a fresh session's events.
        cur_inode = _inode(path)
        if cur_inode != inode:
            try:
                fh.close()
            except OSError:
                pass
            fh = path.open("r", encoding="utf-8", errors="replace")
            inode = cur_inode

        line = fh.readline()
        if not line:
            time.sleep(_POLL)
            continue

        event = _parse(line)
        if event is None:
            continue
        if not _should_play(event, cfg):
            continue

        sev = rain_lib.normalize_severity(event.get("severity", "notice"))
        now = time.time()
        if throttle.allow(sev, now):
            # The cue. Unchanged, first, synchronous. Nothing below may move,
            # delay or condition this line (DEC-PHASE12-046 requirement 1).
            rain_lib.play_cue(sev, cfg)
            throttle.record(sev, now)
            # Narration is offered only for events whose cue actually played,
            # so the tone throttle is already the first rate limit and a storm
            # cannot even reach the queue at full rate. offer() is one
            # non-blocking put; it cannot raise and cannot block.
            if narrator is not None:
                try:
                    narrator.offer(event)
                except Exception:  # noqa: BLE001 - speech may never break tones
                    narrator = None

    if narrator is not None:
        narrator.stop()
    if fh is not None:
        try:
            fh.close()
        except OSError:
            pass
    return 0


def _parse(line: str):
    line = line.strip()
    if not line:
        return None
    try:
        obj = json.loads(line)
        return obj if isinstance(obj, dict) else None
    except ValueError:
        return None


def _config_mtime() -> float:
    try:
        return rain_lib.CONFIG_FILE.stat().st_mtime
    except OSError:
        return 0.0


def _inode(path: Path) -> int:
    try:
        return path.stat().st_ino
    except OSError:
        return -1


def run_oneshot() -> int:
    """Drain the whole spool and play only the single most urgent event, if any.

    Useful for a login-time 'what happened while I was away' summary cue.
    """
    cfg = rain_lib.load_config()
    top = -1
    top_sev = None
    try:
        with rain_lib.EVENT_LOG.open(encoding="utf-8", errors="replace") as fh:
            for line in fh:
                ev = _parse(line)
                if ev is None or not _should_play(ev, cfg):
                    continue
                r = rain_lib.severity_rank(ev.get("severity", "notice"))
                if r > top:
                    top = r
                    top_sev = rain_lib.normalize_severity(ev.get("severity"))
    except OSError:
        return 0
    if top_sev is not None:
        rain_lib.play_cue(top_sev, cfg)
    return 0


# ---------------------------------------------------------------------------
# Spoken narration lifecycle + operator surface (DEC-PHASE12-046)
# ---------------------------------------------------------------------------

def _sync_narrator(narrator, cfg):
    """Start/stop the narrator to match cfg['speech']. Never raises.

    Called at startup and on every live config reload, so the Control Center
    toggle takes effect without a restart — same contract as every other
    rain.json key. A deck with speech off never starts a thread at all.
    """
    want = bool(cfg.get("speech", False))
    try:
        if want and narrator is None:
            mod = _speech_module()
            if mod is None:
                return None
            n = mod.Narrator()
            n.start()
            return n
        if not want and narrator is not None:
            narrator.stop()
            return None
    except Exception:  # noqa: BLE001 - speech may never break the daemon
        return None
    return narrator


def set_speech(state: bool) -> int:
    cfg = rain_lib.load_config()
    cfg["speech"] = bool(state)
    if not rain_lib.save_config(cfg):
        print(f"could not write {rain_lib.CONFIG_FILE}", file=sys.stderr)
        return 1
    print(f"R.A.I.N. speech: {'on' if state else 'off'}  "
          f"({rain_lib.CONFIG_FILE})")
    if state:
        return speech_status()
    return 0


def speech_status() -> int:
    """Report the whole speech subsystem and name the remedy for each gap.

    Rule 8 of docs/RESILIENCE.md in one command: what is not working, what the
    consequence is, what still works, and the exact command that fixes it.
    """
    cfg = rain_lib.load_config()
    mod = _speech_module()
    print("R.A.I.N. speech (DEC-PHASE12-046)")
    print(f"  config file   : {rain_lib.CONFIG_FILE}")
    print(f"  speech        : {'on' if cfg.get('speech') else 'off'}"
          f"   (orionx-rain --speech on|off)")
    print(f"  min severity  : {cfg['min_severity']}  (narration follows the cue)")
    if mod is None:
        print("  engine        : UNAVAILABLE — rain_speech.py failed to import.")
        print("                  Consequence: TONE-ONLY. Cues are unaffected.")
        print("                  Fix: python3 -c 'import sys;"
              "sys.path.insert(0,\"/opt/orionx/scripts/rain\");import rain_speech'")
        return 1
    backend = mod.tts_backend()
    voice = mod.piper_voice()
    print(f"  tts engine    : {backend or 'NONE'}")
    if backend is None:
        print("                  Consequence: nothing can be spoken; the deck")
        print("                  is TONE-ONLY. Detection and cues unaffected.")
        print("                  Fix: sudo apt-get install -y espeak-ng")
    elif backend == "espeak-ng":
        print("                  (robotic but zero-cost; shipped on the image)")
        print("                  Natural voice: sudo /opt/orionx/optional/"
              "install-piper-voice.sh")
    else:
        print(f"                  piper voice: {voice}")
    reachable = mod.ollama_generate("Reply with the single word: ok") is not None
    print(f"  nebula        : {'reachable' if reachable else 'not answering'}"
          f"  ({mod.NEBULA_URL})")
    if not reachable:
        print("                  Consequence: narration uses built-in phrasing")
        print("                  from the event's own fields. Still spoken.")
        print("                  Fix: orionx-nebula status")
    print(f"  bounds        : timeout {mod.SPEECH_TIMEOUT}s, queue "
          f"{mod.SPEECH_QUEUE_MAX}, min gap {mod.SPEECH_MIN_GAP_SECONDS}s, "
          f"max age {mod.SPEECH_MAX_AGE_SECONDS}s")
    return 0


_DEMO_EVENT = {
    "severity": "critical", "source": "firewall", "category": "scan",
    "message": "port scan from 192.168.4.77 \u2014 900 distinct ports in 11.0s",
    "detail": {"src_ip": "192.168.4.77", "distinct_ports": 900,
               "window_seconds": 11.0, "scan_kind": "port scan",
               "protocols": ["tcp"], "detector": "orionx-scanwatch"},
}


def speech_test() -> int:
    """Narrate one synthetic port scan end to end, printing every decision."""
    mod = _speech_module()
    if mod is None:
        print("rain_speech unavailable", file=sys.stderr)
        return 1
    ev = dict(_DEMO_EVENT, ts=time.time())
    print(f"template : {mod.speakable(mod.template_line(ev))}")
    t0 = time.time()
    text, provenance, reason = mod.narration_for(ev, mod.ollama_generate)
    print(f"spoken   : {text}")
    print(f"source   : {provenance} ({reason}) in {time.time() - t0:.2f}s")
    backend = mod.tts_backend()
    print(f"engine   : {backend or 'NONE'}")
    ok = mod.speak(text, rain_lib.load_config()) if backend else False
    print(f"played   : {ok}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="orionx-rain",
        description="R.A.I.N. — Real-time Audible Intrusion Notification daemon.",
    )
    parser.add_argument(
        "--test", metavar="SEVERITY", choices=rain_lib.SEVERITIES,
        help="play one cue for SEVERITY and exit (ignores enabled/min-severity)",
    )
    parser.add_argument(
        "--oneshot", action="store_true",
        help="play the most urgent pending event once, then exit",
    )
    # DEC-PHASE12-046 — spoken narration controls.
    parser.add_argument(
        "--speech", metavar="STATE", choices=("on", "off"),
        help="turn spoken narration on or off (persists to rain.json)",
    )
    parser.add_argument(
        "--speech-status", action="store_true",
        help="report speech config, TTS engine, Nebula reachability and bounds",
    )
    parser.add_argument(
        "--speech-test", action="store_true",
        help="narrate one synthetic port-scan alert end to end and exit",
    )
    args = parser.parse_args(argv)

    if args.speech:
        return set_speech(args.speech == "on")
    if args.speech_status:
        return speech_status()
    if args.speech_test:
        return speech_test()
    if args.test:
        # Test button: always audible, honour volume/voice but not enable/min.
        cfg = rain_lib.load_config()
        rain_lib.play_cue(args.test, cfg)
        return 0
    if args.oneshot:
        return run_oneshot()
    return run_daemon()


if __name__ == "__main__":
    raise SystemExit(main())
