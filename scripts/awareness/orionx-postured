def systemctl(verb: str, unit: str, dry_run: bool = False,
              runner=subprocess.run) -> bool:
    if dry_run:
        print(f"[dry-run] systemctl {verb} {unit}", flush=True)
        return True
    try:
        res = runner(["systemctl", verb, unit], capture_output=True,
                     text=True, timeout=30, check=False)
        return res.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def service_active(unit: str, runner=subprocess.run) -> bool:
    try:
        res = runner(["systemctl", "is-active", unit], capture_output=True,
                     text=True, timeout=5, check=False)
        return (res.stdout or "").strip() == "active"
    except (OSError, subprocess.SubprocessError):
        return False


def set_gate(present: bool, path: Path = SURICATA_GATE,
             dry_run: bool = False) -> bool:
    """Create or remove the DEC-PHASE11-008 ConditionPathExists sentinel."""
    if dry_run:
        print(f"[dry-run] gate {'create' if present else 'remove'} {path}",
              flush=True)
        return True
    try:
        if present:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.touch()
        elif path.exists():
            path.unlink()
        return True
    except OSError:
        return False


