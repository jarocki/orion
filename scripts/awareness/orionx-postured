# EFFECTS: Zeek ingest (DEC-PHASE12-028)
# ===========================================================================

class ZeekIngest:
    """Tails the Zeek logs that carry signal, and re-checks whether Zeek exists.

    SUBORDINATE BY CONSTRUCTION. It holds no tier, makes no posture decision,
    and publishes nothing itself: it hands callbacks back to PostureDaemon,
    which owns the bus voice and the de-duplication ledger. It can be started
    and stopped, and the daemon is what decides when.

    It owns exactly one piece of state the daemon does not: which Zeek log
    directory is currently being read, and the tailers attached to it. When
    Zeek appears, moves, or goes away, `sync()` reattaches — so a deck that
    gains Zeek at 03:00 is ingesting it at 03:00 without a restart.
    """

    def __init__(self, on_notice=None, on_weird=None, on_conn=None,
                 bin_candidates=ZEEK_BIN_CANDIDATES,
                 log_dirs=ZEEK_LOG_DIRS, poll: float = 1.0,
                 use_path: bool = True):
        self.on_notice = on_notice
        self.on_weird = on_weird
        self.on_conn = on_conn
        self.bin_candidates = bin_candidates
        self.log_dirs = log_dirs
        self.poll = poll
        self.use_path = use_path
        self.state = detect_zeek(bin_candidates, log_dirs, use_path)
        self.active_dir: str = ""
        self.running = False
        self.conn_records = 0
        self.notices_read = 0
        self.weird_read = 0
        self.watch_started = 0.0
        self._tailers: list[LogTailer] = []
        # Per-log TSV column names, refreshed on every (re)open.
        self._fields: dict[str, list[str] | None] = {}

    # --- detection ---
    def refresh(self) -> dict:
        """Re-ask whether Zeek is here. Cheap: a few stat() calls."""
        self.state = detect_zeek(self.bin_candidates, self.log_dirs,
                                 self.use_path)
        return self.state

    def state_fingerprint(self) -> tuple:
        """What must change before the operator is told again."""
        return (self.state["installed"], self.state["log_state"],
                self.state["log_dir"])

    # --- tailing ---
    def _prime_fields(self, path) -> None:
        self._fields[Path(path).name] = zeek_fields_from_file(path)

    def _handle(self, name: str, line: str) -> None:
        rec = zeek_record(line, self._fields.get(name))
        if rec is None:
            return
        if name == ZEEK_NOTICE_LOG:
            alert = parse_zeek_notice(rec)
            if alert is not None:
                self.notices_read += 1
                if self.on_notice is not None:
                    self.on_notice(alert)
        elif name == ZEEK_WEIRD_LOG:
            self.weird_read += 1
            if self.on_weird is not None:
                self.on_weird(
                    str(rec.get("name") or ""),
                    str(rec.get("id.orig_h") or rec.get("src") or ""))
        elif name == ZEEK_CONN_LOG:
            # Counted, never alerted on. This is the liveness signal that
            # separates "Zeek sees a calm network" from "Zeek sees nothing".
            self.conn_records += 1
            if self.on_conn is not None:
                self.on_conn(rec)

    def sync(self) -> bool:
        """Attach, reattach, or detach to match reality. True if attached.

        Returns whether ingest is running afterwards, so the caller can
        announce a transition without having to infer it.
        """
        self.refresh()
        if not self.state["usable"]:
            if self.running:
                self.stop()
            return False
        if self.running and self.active_dir == self.state["log_dir"]:
            return True
        if self.running:
            self.stop()
        self.start()
        return self.running

    def start(self) -> bool:
        if self.running or not self.state["usable"]:
            return False
        log_dir = Path(self.state["log_dir"])
        for name in (ZEEK_NOTICE_LOG, ZEEK_WEIRD_LOG, ZEEK_CONN_LOG):
            path = log_dir / name
            if not path.is_file():
                continue
            self._prime_fields(path)
            tailer = LogTailer(
                path, poll=self.poll,
                on_line=lambda line, n=name: self._handle(n, line),
                on_open=self._prime_fields,
            )
            tailer.start()
            self._tailers.append(tailer)
        if not self._tailers:
            return False
        self.active_dir = str(log_dir)
        self.watch_started = time.time()
        self.running = True
        return True

    def stop(self) -> None:
        for tailer in self._tailers:
            tailer.stop()
        self._tailers = []
        self.running = False
        self.active_dir = ""
        self.watch_started = 0.0

    def status(self) -> dict:
        return {
            "installed": self.state["installed"],
            "binary": self.state["binary"],
            "log_state": self.state["log_state"],
            "log_dir": self.active_dir or self.state["log_dir"],
            "ingesting": self.running,
            "notices": self.notices_read,
            "weird": self.weird_read,
            "conn_records": self.conn_records,
        }


def capture_status(state_dir: Path = CAPTURE_STATE_DIR) -> list[dict]:
    """Active PCAP captures, read from orionx-capture's runtime state.

    Folded into this daemon's status file so the Cockpit reads ONE status
    authority. orionx-capture owns the capture; this is a read.
    """
    out: list[dict] = []
    try:
        entries = sorted(Path(state_dir).glob("*.json"))
    except OSError:
        return out
    for entry in entries:
        if entry.name.endswith(".request.json"):
            continue
        try:
            rec = json.loads(entry.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(rec, dict):
            out.append({"iface": rec.get("iface"),
                        "budget_mb": rec.get("budget_mb"),
                        "duration": rec.get("duration"),
                        "started": rec.get("started"),
                        "out_path": rec.get("out_path")})
    return out


# ===========================================================================
# The enforcer — ties the pure plan to the effects
# ===========================================================================

class PostureDaemon:
    def __init__(self, args):
        # DEC-PHASE12-034: bounded Suricata restart state.
        self._suricata_recovery = {"attempts": 0, "last_attempt": 0.0, "given_up": False}
        self.args = args
        self.dry_run = bool(args.dry_run)
        self.posture_path = pick_posture_file(
            posture_candidates(args.posture_file))
        self.rules_dirs = [Path(d) for d in (args.rules_dir or RULES_DIRS)]
        self.eve_path = Path(args.eve)
        self.state: dict | None = None
        self.rules = assess_rules(scan_rule_dirs(self.rules_dirs))
        self.deduper = AlertDeduper()
        self.scan_sources: set[str] = set()
        self._scan_refreshed = 0.0
        # One ledger for "who already reported this scan source", shared by
        # the Suricata and Zeek paths (DEC-PHASE12-028).
        self.scan_ledger = ScanLedger()
        self.zeek = ZeekIngest(on_notice=self._on_zeek_notice,
                               on_weird=self._on_zeek_weird,
                               bin_candidates=[Path(d) for d in args.zeek_bin]
                               if args.zeek_bin else ZEEK_BIN_CANDIDATES,
                               log_dirs=[Path(d) for d in args.zeek_log_dir]
                               if args.zeek_log_dir else ZEEK_LOG_DIRS,
                               # An explicit --zeek-bin is authoritative.
                               use_path=not args.zeek_bin)
        self.weird = WeirdAggregator()
        self._zeek_fingerprint: tuple | None = None
        self._zeek_last_announce = 0.0
        self._zeek_blind_announced = False
        self.zeek_published = 0
        self.zeek_suppressed = 0
        self.last_no_rules_warn = 0.0
        self.no_rules_announced = False
        self.tailer = LogTailer(self.eve_path, on_line=self._on_eve_line)
        self.deception = DeceptionField(Path(args.canary_dir),
                                        dry_run=self.dry_run)
        self.nebula = Contextualizer(dry_run=self.dry_run)
        if args.no_nebula:
            self.nebula = None
        self.alerts_published = 0
        self.alerts_suppressed = 0

        # --- capture (DEC-PHASE12-038) ---
        self.sysfs = Path(args.sysfs)
        self.capture_yaml = Path(args.interfaces_yaml)
        self.suricata_config = Path(args.suricata_config)
        self.heartbeat = capture.InterfaceHeartbeat(
            window=args.live_window, min_packets=args.live_packets,
            quiet_demote=args.quiet_demote, max_ifaces=args.max_ifaces,
            pinned=tuple(args.capture_iface or ()))
        self.brake = capture.ReconfigureBrake(cooldown=args.reconfig_cooldown)
        self._last_heartbeat = 0.0
        self._verify_due = 0.0
        self._verify: dict = {"verified": None, "attached": [],
                              "reason": "not yet checked"}
        self._capture_announced: dict[str, float] = {}
        self._attached_since = 0.0
        self._blind_announced = False
        self._config_verdict: dict | None = None
        self._brake_decision: dict = {"act": False, "reason": "no-sample"}
        # One synchronous sample before anything is applied, so the very
        # first plan is made against measured interfaces rather than a guess.
        self.heartbeat_tick(time.time())

    # --- bus helper ---
    def emit(self, severity: str, category: str, message: str,
             source: str = "postured", detail: dict | None = None) -> None:
        publish(severity, source, category, message, dry_run=self.dry_run,
                detail=detail)

    # --- suricata recovery (DEC-PHASE12-034) -------------------------------
    #
    # This used to re-emit a warning and re-issue `systemctl start` on every
    # 30s reassert, unconditionally. Observed on hardware: Suricata 7.0.10
    # exits 1 immediately (no interface configured on a stock image), systemd
    # hits "start request repeated too quickly", and the deck settles into a
    # loop that did two kinds of damage.
    #
    # It flooded the bus. Every entry in the operator's event stream was this
    # one message, so the Cockpit showed nothing else — the stream stopped
    # being a record of what happened to the deck.
    #
    # Worse, it drove THREAT PRESSURE to "ELEVATED" on an idle machine with
    # nothing attacking it, because the gauge weights by severity and these
    # were warnings. A threat gauge inflated by the deck's own self-diagnosis
    # teaches the operator to ignore it, which is the one thing it cannot
    # afford.
    #
    # So: bounded attempts, exponential-ish backoff, one escalation, and a
    # self-status category that is not a detection.
    SURICATA_MAX_ATTEMPTS = 3
    SURICATA_RETRY_BACKOFF = 300.0     # seconds between attempts after the first

    def _suricata_recover(self, now: float) -> None:
        st = self._suricata_recovery
        if st["given_up"]:
            return                      # already said it; silence beats a loop
        if st["attempts"] and (now - st["last_attempt"]) < self.SURICATA_RETRY_BACKOFF:
            return
        st["attempts"] += 1
        st["last_attempt"] = now
        if st["attempts"] > self.SURICATA_MAX_ATTEMPTS:
            st["given_up"] = True
            self.emit("critical", "health",
                      f"Suricata will not stay running after "
                      f"{self.SURICATA_MAX_ATTEMPTS} attempts — IDS coverage is "
                      f"OFF while {self.state['label']} is selected. Not retrying. "
                      "Check: systemctl status suricata; journalctl -u suricata -n 50; "
                      f"suricata -T -v -c {self.suricata_config}. "
                      "Port-scan detection via orionx-scanwatch is unaffected.",
                      detail={"reason": "suricata-gave-up",
                              "attempts": self.SURICATA_MAX_ATTEMPTS,
                              "capture_ifaces": list(
                                  self.state.get("capture_ifaces") or ()),
                              "config": str(self.suricata_config),
                              "config_verdict": self._config_verdict})
            return
        ifaces = tuple(self.state.get("capture_ifaces") or ())
        self.emit("warning", "health",
                  f"Suricata is not running while {self.state['label']} is "
                  f"selected — restart attempt {st['attempts']} of "
                  f"{self.SURICATA_MAX_ATTEMPTS} "
                  f"(capture: {', '.join(ifaces) or 'none'}).",
                  detail={"reason": "suricata-restart",
                          "attempt": st["attempts"],
                          "max_attempts": self.SURICATA_MAX_ATTEMPTS,
                          "capture_ifaces": list(ifaces)})
        set_gate(True, dry_run=self.dry_run)
        # Re-assert the interface list before retrying. A recovery that
        # starts the engine against a stale config is a recovery that
        # succeeds into the wrong state (DEC-PHASE12-038).
        self.write_capture_config(ifaces, now)
        systemctl("start", SURICATA_UNIT, dry_run=self.dry_run)
        self._verify_due = now + capture.VERIFY_GRACE_SECONDS

    def _suricata_recovery_reset(self) -> None:
        """Called when the tier changes: a new posture earns a fresh attempt."""
        self._suricata_recovery = {"attempts": 0, "last_attempt": 0.0,
                                   "given_up": False}

    # --- capture: heartbeat, config, verification (DEC-PHASE12-038) --------

    def heartbeat_tick(self, now: float) -> tuple:
        """Sample the kernel's interface counters. Cheap enough to do often.

        Four sysfs reads per interface per tick, no subprocess, no netlink,
        no network. This is the Loop stage for capture: an interface that
        appears, disappears, wakes up or goes quiet changes the answer here
        and nowhere else.
        """
        self._last_heartbeat = now
        self.heartbeat.observe(capture.sample_interfaces(self.sysfs), now)
        return self.heartbeat.selected(now)

    def capture_target(self, now: float) -> tuple:
        """What Suricata should capture on, after the anti-thrash brake.

        The brake, not the heartbeat, has the last word: the heartbeat says
        what is true, the brake says whether now is an acceptable moment to
        restart a running IDS over it. When the brake says no, the plan keeps
        describing the set already applied, so plan_actions() diffs to
        nothing and no restart happens.
        """
        desired = self.heartbeat.selected(now)
        decision = self.brake.decide(desired, now,
                                     present=self.heartbeat.present)
        self._brake_decision = decision
        if decision["act"]:
            return desired
        return tuple(self.brake.applied or ())

    def announce_capture(self, key: str, severity: str, message: str,
                         detail: dict, now: float,
                         repeat: float = CAPTURE_REANNOUNCE) -> None:
        """Say it once per condition, then only on a timer or on a change.

        Keyed by CONDITION rather than by message text, so a rate that
        changes by one packet does not re-announce the same problem. Any
        other key clears this one: moving from "no live interface" to
        "capturing" is a change the operator must hear immediately, not at
        the next repeat interval.
        """
        last = self._capture_announced.get(key)
        if last is not None and (now - last) < repeat:
            return
        self._capture_announced = {key: now}
        self.emit(severity, "health", message, source="suricata",
                  detail=detail)

    def capture_preflight(self, now: float) -> bool:
        """Would Suricata accept this configuration? Ask it, do not assume.

        Runs before the first start of a tier, not on every reassert: it
        loads the full ruleset and costs seconds. Returns False only when the
        engine positively rejected the config — "no rules" is a valid config
        with nothing to match on, which DEC-PHASE12-024's own warning owns,
        and refusing to start on it would mean a deck that has not fetched
        ET-Open yet gets no protocol-anomaly detection either.
        """
        verdict = capture.check_config(self.suricata_config,
                                       binary=capture.SURICATA_BIN)
        self._config_verdict = verdict
        if verdict["verdict"] == "absent":
            sev, msg, detail = capture.absent_message(self.state["label"])
            self.announce_capture("suricata-absent", sev, msg, detail, now)
            return False
        if verdict["verdict"] == "invalid":
            sev, msg, detail = capture.invalid_config_message(
                verdict, self.suricata_config)
            self.announce_capture("config-rejected", sev, msg, detail, now)
            return False
        return True

    def write_capture_config(self, ifaces, now: float) -> bool:
        """Generate the af-packet include. Idempotent by content."""
        res = capture.write_interfaces_yaml(ifaces, self.capture_yaml,
                                            dry_run=self.dry_run)
        if not res["ok"]:
            self.announce_capture(
                "config-unwritable", "critical",
                f"Could not write the Suricata interface list "
                f"{self.capture_yaml}: {res['error']}. Consequence: the IDS "
                "will capture on the PREVIOUS interface set, or not start at "
                "all. " + capture.SCANWATCH_NOTE + " Remedy: check that "
                "/var/lib/suricata is writable and that orionx-postured.service "
                "still lists it in ReadWritePaths (`systemctl cat "
                "orionx-postured`).",
                {"reason": "config-unwritable", "path": res["path"],
                 "error": res["error"]}, now)
            return False
        return True

    def verify_capture(self, now: float) -> dict:
        """Ask the RUNNING engine what it attached to, and say so honestly.

        This is the Check stage, and the reason this work exists. `systemctl
        start suricata` exiting 0 means systemd forked a process. The engine's
        own iface-list is the only thing that can say a capture socket was
        opened on the interface Orion-X asked for.
        """
        desired = tuple(self.state.get("capture_ifaces") or ())
        if not service_active(SURICATA_UNIT):
            self._verify = {"verified": False, "attached": [],
                            "reason": "suricata.service is not active"}
            self._attached_since = 0.0
            return self._verify

        res = capture.verify_capture(desired)
        self._verify = res

        # Checked FIRST, and at critical: the engine is up, it answers, it
        # lists the interface, and its capture socket never opened. Nothing
        # else on the deck can see this failure.
        if res.get("socket_errors"):
            sev, msg, detail = capture.socket_error_message(res)
            self.announce_capture("capture-socket-error", sev, msg, detail,
                                  now)
            self._attached_since = 0.0
            return res

        if res["verified"] is None:
            sev, msg, detail = capture.unverified_message(res, desired)
            self.announce_capture("capture-unverified", sev, msg, detail, now)
            self._attached_since = 0.0
            return res

        if not res["verified"]:
            sev, msg, detail = capture.capture_mismatch_message(
                res, desired, self.state["label"])
            self.announce_capture("iface-mismatch", sev, msg, detail, now)
            self._attached_since = 0.0
            return res

        if not self._attached_since:
            self._attached_since = now
        if res["total_packets"] > 0:
            self._blind_announced = False
            sev, msg, detail = capture.capture_ok_message(
                res, self.state["label"])
            # Healthy state is announced on CHANGE, not on a timer: a working
            # IDS that says so every fifteen minutes is noise that buries the
            # one time it stops working.
            self.announce_capture("capture-verified", sev, msg, detail, now,
                                  repeat=float("inf"))
        elif (not self._blind_announced
              and (now - self._attached_since) >= capture.CAPTURE_BLIND_SECONDS):
            self._blind_announced = True
            sev, msg, detail = capture.capture_blind_message(
                res, now - self._attached_since)
            self.announce_capture("capture-blind", sev, msg, detail, now)
        return res

    def warn_no_capture(self, now: float) -> None:
        """No interface is carrying traffic, so Suricata was not started."""
        if self.heartbeat.warming_up(now):
            # Not measured yet. Saying "no interface is carrying traffic" one
            # second after start, on a deck whose NIC is fine, is a false
            # alarm the operator pays for in trust.
            return
        status = self.heartbeat.status(now)
        sev, msg, detail = capture.no_live_message(status,
                                                   self.state["label"])
        detail["tier"] = self.state["tier"]
        self.announce_capture("no-live-interface", sev, msg, detail, now)

    # --- rules ---
    def refresh_rules(self) -> None:
        self.rules = assess_rules(scan_rule_dirs(self.rules_dirs))

    def warn_no_rules(self, tier: str, now: float) -> None:
        """Say it loudly, say it first, and keep saying it.

        Escalation is inverted on purpose: the FIRST announcement is critical
        because the operator has just armed a tier believing they gained
        coverage they do not have — that is the moment the truth matters most.
        Repeats drop to warning so a permanently air-gapped deck nags rather
        than screams, but it never stops nagging and never goes silent.
        """
        first = not self.no_rules_announced
        if not first and (now - self.last_no_rules_warn) < NO_RULES_REANNOUNCE:
            return
        self.no_rules_announced = True
        self.last_no_rules_warn = now
        # Category `health`, NOT `ids`. A blind IDS is genuinely critical, so
        # the severity policy above is unchanged — but it is a fact about this
        # deck, not a detection. pressure() in cockpit_lib weights `ids` by
        # severity and does not exclude it, so publishing this as `ids` drove
        # THREAT PRESSURE to ELEVATED on an idle machine and re-spiked every
        # NO_RULES_REANNOUNCE seconds, flashing the screen red and ticking the
        # scan counter. That is byte-for-byte the incident DEC-PHASE12-034 was
        # written to stop, thirty lines from its own fix. RESILIENCE.md rule 5:
        # self-diagnosis is not a threat.
        self.emit(NO_RULES_FIRST if first else NO_RULES_REPEAT, "health",
                  no_rules_message(tier, self.rules))

    # --- eve ingest ---
    def _refresh_scan_sources(self, now: float) -> None:
        if (now - self._scan_refreshed) < 10.0:
            return
        self._scan_refreshed = now
        self.scan_sources = scan_sources_from_bus(tail_bus_lines(), now,
                                                  sources=("firewall",))
        # orionx-scanwatch is a separate process, so the bus is how we learn
        # what it has said. Suricata and Zeek are this process, and record
        # themselves directly.
        self.scan_ledger.merge_bus("firewall", self.scan_sources, now)

    def _on_eve_line(self, line: str) -> None:
        alert = parse_eve_line(line)
        if alert is None:
            return
        now = time.time()
        self._refresh_scan_sources(now)
        if should_suppress(alert, self.scan_sources):
            # orionx-scanwatch already reported this source from the firewall
            # drop log. One scan is one story.
            self.alerts_suppressed += 1
            return
        if not self.deduper.should_publish(dedup_key(alert), now):
            return
        if is_scan_alert(alert):
            # Claim this scan source for Suricata, so the Zeek path below does
            # not tell the same story a third time.
            self.scan_ledger.record("suricata", alert.get("src_ip", ""), now)
        technique = attack_technique(alert.get("classtype"),
                                     alert.get("signature"))
        # Publish FIRST. The model is never in the path of a detection.
        self.emit(bus_severity(alert), "ids",
                  format_alert_message(alert, technique), source="suricata")
        self.alerts_published += 1
        if self.nebula is not None and bus_severity(alert) in ("warning",
                                                               "critical"):
            self.nebula.offer(alert, technique)

    # --- zeek callbacks (DEC-PHASE12-028) ---
    def _on_zeek_notice(self, alert: dict) -> None:
        """One Zeek notice -> at most one bus event.

        The suppression check is what stops an nmap sweep being announced
        three times: orionx-scanwatch owns it from the firewall drop log,
        Suricata owns it next, and Zeek defers to both. The suppression is
        COUNTED rather than merely skipped, because a suppression nobody can
        account for looks exactly like a detector that quietly died.
        """
        now = time.time()
        self._refresh_scan_sources(now)
        note = alert.get("note", "")
        if is_zeek_scan_notice(note):
            owner = should_suppress_scan("zeek", alert.get("src_ip", ""),
                                         self.scan_ledger, now)
            if owner is not None:
                self.zeek_suppressed += 1
                return
            self.scan_ledger.record("zeek", alert.get("src_ip", ""), now)
        if not self.deduper.should_publish(zeek_dedup_key(alert), now):
            return
        technique = zeek_attack_technique(note)
        severity = zeek_notice_severity(alert)
        self.emit(severity, "ids", format_zeek_message(alert, technique),
                  source="zeek")
        self.zeek_published += 1
        if note in ZEEK_BLINDNESS_NOTES:
            # Zeek just said it is missing traffic. Do not let that be
            # mistaken for a quiet network on the next liveness check.
            self._zeek_blind_announced = True
        if self.nebula is not None and severity in ("warning", "critical"):
            self.nebula.offer(
                {"signature": note, "src_ip": alert.get("src_ip"),
                 "dest_ip": alert.get("dest_ip"),
                 "dest_port": alert.get("dest_port"),
                 "proto": alert.get("proto"), "classtype": "zeek-notice",
                 "signature_id": 0}, technique)

    def _on_zeek_weird(self, name: str, src: str) -> None:
        burst = self.weird.observe(name, src, time.time())
        if burst is None:
            return
        self.emit("notice", "ids", format_weird_message(burst), source="zeek")
        self.zeek_published += 1

    def _sync_zeek(self, now: float) -> None:
        """Re-ask whether Zeek exists, and say so whenever the answer changes.

        This is the whole "no rebuild, no restart" promise in one method: it
        runs on every reassert cycle, so Zeek installed at any point after
        boot is ingested from the next cycle, and the operator is TOLD, rather
        than having to notice new event types appearing.
        """
        was_running = self.zeek.running
        self.zeek.sync()
        fingerprint = self.zeek.state_fingerprint()
        changed = fingerprint != self._zeek_fingerprint
        due = (now - self._zeek_last_announce) >= ZEEK_STATE_REANNOUNCE
        severity, message = zeek_state_message(self.zeek.state)

        # A degraded state repeats; a healthy one is announced on change only.
        # An unreadable log directory must nag: that is active blindness.
        repeat = due and self.zeek.state["log_state"] == "unreadable"
        if changed or repeat:
            self._zeek_fingerprint = fingerprint
            self._zeek_last_announce = now
            if self.zeek.running and not was_running and changed:
                self._zeek_blind_announced = False
            # `health`, not `ids`. zeek_state_message() describes THIS DECK's
            # Zeek capability — installed, absent, logs unreadable — and not
            # anything Zeek detected. Zeek's actual notices below are `ids`,
            # because those are detections. RESILIENCE.md rule 5.
            self.emit(severity, "health", message, source="zeek")

        # Zeek attached to a live log directory that has produced no
        # connection at all is the Suricata-with-no-rules failure again.
        if (self.zeek.running and not self._zeek_blind_announced
                and zeek_blind(self.zeek.conn_records,
                               self.zeek.watch_started, now)):
            self._zeek_blind_announced = True
            # Self-diagnosis: a sensor reporting on itself, not a detection.
            self.emit("warning", "health",
                      f"Zeek has been reading {self.zeek.active_dir} for "
                      f"{ZEEK_LIVENESS_SECONDS / 60:.0f} minutes and conn.log "
                      "has produced ZERO connection records. That is not a "
                      "quiet network, it is a sensor that is probably not "
                      "attached to any traffic — check that Zeek is running "
                      "against a live interface (`zeek -i <iface>`) and that "
                      "the interface sees packets.", source="zeek")

    # --- deception callbacks ---
    def _on_decoy_hit(self, port: int, peer: str) -> None:
        self.emit("critical", "deception", decoy_alert_message(port, peer))

    def _check_canaries(self) -> None:
        if not self.deception.armed:
            return
        for path in self.deception.check_canaries():
            self.emit("critical", "deception", canary_alert_message(path))

    # --- apply ---
    def execute(self, actions: list[tuple], tier: str) -> list[str]:
        done: list[str] = []
        now = time.time()
        for action in actions:
            kind = action[0]
            if kind == "gate":
                set_gate(action[1] == "create", dry_run=self.dry_run)
            elif kind == "capture":
                self.write_capture_config(action[2], now)
            elif kind == "service":
                if action[1] in ("start", "restart"):
                    # Check before Do: a config the engine will reject is
                    # worth one clear message, not three silent exit-1s and
                    # an exhausted attempt budget.
                    if not self.capture_preflight(now):
                        done.append("service:refused:" + action[2])
                        continue
                    self._attached_since = 0.0
                    self._blind_announced = False
                    self._verify_due = now + capture.VERIFY_GRACE_SECONDS
                systemctl(action[1], action[2], dry_run=self.dry_run)
            elif kind == "zeek":
                if action[1] == "start":
                    self._sync_zeek(now)
                else:
                    self.zeek.stop()
            elif kind == "eve":
                if action[1] == "start":
                    self.tailer.start()
                    if self.nebula is not None:
                        self.nebula.start()
                else:
                    self.tailer.stop()
                    if self.nebula is not None:
                        self.nebula.stop()
            elif kind == "deception":
                if action[1] == "arm":
                    info = self.deception.arm(self._on_decoy_hit)
                    ports = ", ".join(f"tcp/{p}" for p in info["ports"])
                    self.emit("warning", "deception",
                              f"Tier 2 deception ARMED — decoys on {ports or 'none'}, "
                              f"{len(info['canaries'])} canary file(s) in "
                              f"{self.deception.canary_dir}. Local and "
                              "non-destructive: nothing is sent to any other host.")
                    if not info["firewall_open"]:
                        self.emit("warning", "deception",
                                  "Deception decoys are listening but the firewall "
                                  "opening FAILED — the base DROP policy will absorb "
                                  "probes before they reach a decoy. Canary files "
                                  "are unaffected. Check `nft list ruleset`.")
                else:
                    self.deception.disarm()
                    self.emit("notice", "deception",
                              "Tier 2 deception disarmed — decoys closed, canaries "
                              "removed, runtime firewall opening deleted.")
            elif kind == "warn":
                if action[1] == "no-capture":
                    self.warn_no_capture(now)
                else:
                    self.warn_no_rules(tier, now)
            done.append(":".join(str(a) for a in action))
        return done

    def write_status(self) -> None:
        """Runtime truth for the Cockpit: what is actually enforced, right now."""
        if self.dry_run or self.state is None:
            return
        payload = {
            "ts": time.time(),
            "tier": self.state["tier"],
            "label": self.state["label"],
            "ids_expected": self.state["suricata"],
            "ids_active": (service_active(SURICATA_UNIT)
                           if self.state["suricata"] else False),
            "rules_usable": self.rules["usable"],
            "threat_rule_files": self.rules["threat_files"],
            "anomaly_rule_files": self.rules["anomaly_files"],
            "deception_armed": self.deception.armed,
            "alerts_published": self.alerts_published,
            "alerts_suppressed": self.alerts_suppressed,
            "posture_file": str(self.posture_path or ""),
            # DEC-PHASE12-028. Zeek ingest and PCAP capture are folded in here
            # rather than given status files of their own, so the Cockpit has
            # one runtime-truth authority to read instead of three.
            "zeek": self.zeek.status(),
            "zeek_published": self.zeek_published,
            "zeek_suppressed": self.zeek_suppressed,
            "capture": capture_status(),
            # DEC-PHASE12-038. ids_capture is runtime truth about the IDS's
            # own capture, kept separate from `capture`, which is
            # orionx-capture's operator-requested PCAP state. Two different
            # facts; one status file, two keys, no ambiguity.
            "ids_capture": {
                "desired": list(self.state.get("capture_ifaces") or ()),
                "verified": self._verify.get("verified"),
                "configured": self._verify.get("configured"),
                "capturing": self._verify.get("capturing"),
                "socket_errors": self._verify.get("socket_errors") or {},
                "attached": self._verify.get("attached") or [],
                "packets": self._verify.get("packets") or {},
                "reason": self._verify.get("reason"),
                "config": str(self.suricata_config),
                "interfaces_file": str(self.capture_yaml),
                "heartbeat": self.heartbeat.status(time.time()),
                "brake": self.brake.status(),
            },
        }
        try:
            STATUS_FILE.parent.mkdir(parents=True, exist_ok=True)
            tmp = STATUS_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(payload), encoding="utf-8")
            os.replace(tmp, STATUS_FILE)
        except OSError:
            pass

    def apply_tier(self, tier: str) -> list[str]:
        now = time.time()
        self.refresh_rules()
        target = self.capture_target(now)
        plan = tier_plan(tier, self.rules["usable"], live_ifaces=target)
        actions = plan_actions(self.state, plan)
        prev_ifaces = tuple((self.state or {}).get("capture_ifaces") or ())
        tier_changed = self.state is None or self.state["tier"] != plan["tier"]
        if tier_changed or prev_ifaces != tuple(plan["capture_ifaces"]):
            # A deliberate posture change earns Suricata a fresh set of
            # attempts, and so does a new interface set: "it would not start
            # on eth0" is not evidence about wlan0, and refusing to try the
            # NIC the operator just plugged in would be the daemon giving up
            # on a situation it has never actually attempted.
            self._suricata_recovery_reset()
        if tier_changed:
            self.emit("notice", "posture",
                      f"Posture enforcement: {plan['label']} — "
                      f"suricata={'on' if plan['suricata'] else 'off'}, "
                      f"eve-ingest={'on' if plan['eve_ingest'] else 'off'}, "
                      f"deception={'armed' if plan['deception'] else 'off'}",
                      detail={"tier": plan["tier"],
                              "capture_ifaces": list(plan["capture_ifaces"])})
        # self.state is the plan being applied before execute() runs, so the
        # messages execute() emits describe the state being entered rather
        # than the one being left.
        self.state = plan
        done = self.execute(actions, plan["tier"])
        if plan["suricata"]:
            self.brake.note_applied(tuple(plan["capture_ifaces"]), now)
        elif not plan["gate_file"]:
            # Torn down. The next Tier 1 must be a first apply, not a diff
            # against a set belonging to an engine that is no longer running.
            self.brake.reset()
        self.write_status()
        return done

    def run(self) -> int:
        last_reassert = 0.0
        last_canary = 0.0
        tier = "0"
        try:
            while True:
                self.posture_path = pick_posture_file(
                    posture_candidates(self.args.posture_file))
                new_tier = read_tier(self.posture_path)
                now = time.time()
                if (now - self._last_heartbeat) >= self.args.heartbeat:
                    # DEC-PHASE12-038. The interface heartbeat runs on its own
                    # cadence, faster than the 30s reassert, because a USB NIC
                    # plugged in mid-incident should be watched in seconds and
                    # a yanked one must leave the config before the engine is
                    # next started against a device that no longer exists.
                    self.heartbeat_tick(now)
                    if self.state is not None and self.state["tier"] in ("1",
                                                                         "2"):
                        target = self.capture_target(now)
                        if (tuple(self.state.get("capture_ifaces") or ())
                                != target):
                            self.apply_tier(self.state["tier"])
                            last_reassert = now

                if self.state is None or new_tier != self.state["tier"]:
                    tier = new_tier
                    self.apply_tier(tier)
                    last_reassert = now
                elif (now - last_reassert) >= REASSERT_SECONDS:
                    last_reassert = now
                    # Drift check: enforcement is continuous, not one-shot. If
                    # something stopped Suricata behind our back, the tier is a
                    # lie until we put it back — and we say so.
                    self.refresh_rules()
                    if self.state["suricata"] and not service_active(SURICATA_UNIT):
                        self._suricata_recover(now)
                    if self.state["suricata"] and not self.rules["usable"]:
                        self.warn_no_rules(self.state["tier"], now)
                    # DEC-PHASE12-038, the Check stage. Being "active" is not
                    # being attached: ask the engine itself, on a cycle,
                    # because an interface can go away under a running
                    # process and nothing else would notice.
                    if self.state["suricata"] and now >= self._verify_due:
                        self._verify_due = now + CAPTURE_VERIFY_EVERY
                        self.verify_capture(now)
                    # A measured no-capture state keeps nagging. It is not a
                    # transient: without an interface there is no IDS, and
                    # the operator planning around one must hear that.
                    if self.state.get("warn_no_capture"):
                        self.warn_no_capture(now)
                    # Zeek may have been installed since the last cycle, or
                    # its log directory may have appeared, moved or become
                    # unreadable. All three are runtime facts (DEC-PHASE12-028).
                    self._sync_zeek(now)
                    self.write_status()
                if (now - last_canary) >= CANARY_POLL_SECONDS:
                    last_canary = now
                    self._check_canaries()
                time.sleep(self.args.poll)
        except KeyboardInterrupt:
            pass
        finally:
            if self.deception.armed:
                self.deception.disarm()
            self.zeek.stop()
            self.tailer.stop()
            if self.nebula is not None:
                self.nebula.stop()
        return 0


def build_parser() -> argparse.ArgumentParser:
    """The CLI, separated from main() so tests can construct a real args
    object and drive the daemon in-process instead of reimplementing
    defaults that would then drift from the ones that ship."""
    ap = argparse.ArgumentParser(
        prog="orionx-postured",
        description="Enforce the Orion-X threat-posture tier and publish "
                    "AI-contextualised IDS detections onto the R.A.I.N. bus.",
    )
    ap.add_argument("--posture-file", default=None,
                    help="explicit threat-posture file (default: auto-discover)")
    ap.add_argument("--eve", default=str(EVE_JSON),
                    help="Suricata eve.json path (default: %(default)s)")
    ap.add_argument("--rules-dir", action="append", default=None,
                    help="rules directory to assess (repeatable)")
    ap.add_argument("--canary-dir", default=str(CANARY_DIR),
                    help="Tier 2 canary directory (default: %(default)s)")
    ap.add_argument("--zeek-log-dir", action="append", default=None,
                    help="Zeek log directory to watch (repeatable; default: "
                         "auto-discover)")
    ap.add_argument("--zeek-bin", action="append", default=None,
                    help="candidate Zeek binary path (repeatable; default: "
                         "auto-discover)")
    ap.add_argument("--poll", type=float, default=POLL_SECONDS,
                    help="posture poll interval in seconds (default: %(default)s)")
    # --- capture (DEC-PHASE12-038) ---
    ap.add_argument("--capture-iface", action="append", default=None,
                    metavar="IFACE",
                    help="always capture on this interface, live or not "
                         "(repeatable). For a SPAN/monitor port that is "
                         "deliberately silent between probes. It must still "
                         "exist: one unopenable device fails the whole engine.")
    ap.add_argument("--sysfs", default=str(capture.SYSFS_NET),
                    help="interface counter root (default: %(default)s)")
    ap.add_argument("--interfaces-yaml", default=str(capture.INTERFACES_YAML),
                    help="generated af-packet include (default: %(default)s)")
    ap.add_argument("--suricata-config", default=str(capture.ORIONX_YAML),
                    help="Suricata config to validate (default: %(default)s)")
    ap.add_argument("--heartbeat", type=float,
                    default=capture.HEARTBEAT_SECONDS,
                    help="interface sampling interval (default: %(default)s)")
    ap.add_argument("--live-window", type=float, default=capture.LIVE_WINDOW,
                    help="seconds a packet delta is measured over "
                         "(default: %(default)s)")
    ap.add_argument("--live-packets", type=int,
                    default=capture.LIVE_MIN_PACKETS,
                    help="packets within the window that mean 'live' "
                         "(default: %(default)s)")
    ap.add_argument("--quiet-demote", type=float,
                    default=capture.QUIET_DEMOTE_SECONDS,
                    help="seconds a captured interface may be quiet before "
                         "it is dropped (default: %(default)s)")
    ap.add_argument("--reconfig-cooldown", type=float,
                    default=capture.RECONFIG_COOLDOWN,
                    help="minimum seconds between Suricata reconfigures "
                         "(default: %(default)s)")
    ap.add_argument("--max-ifaces", type=int, default=capture.MAX_CAPTURE_IFACES,
                    help="most interfaces captured at once (default: %(default)s)")
    ap.add_argument("--no-nebula", action="store_true",
                    help="disable the Nebula contextualizer entirely")
    ap.add_argument("--dry-run", action="store_true",
                    help="print actions and events instead of performing them")
    ap.add_argument("--once", action="store_true",
                    help="apply the current tier once and exit")
    ap.add_argument("--print-plan", action="store_true",
                    help="print the JSON plan for the current tier and exit")
    return ap


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    daemon = PostureDaemon(args)
    tier = read_tier(daemon.posture_path)

    if args.print_plan:
        now = time.time()
        target = daemon.capture_target(now)
        plan = tier_plan(tier, daemon.rules["usable"], live_ifaces=target)
        print(json.dumps({"posture_file": str(daemon.posture_path or ""),
                          "rules": daemon.rules,
                          "zeek": daemon.zeek.state,
                          "capture": capture_status(),
                          "ids_capture": daemon.heartbeat.status(now),
                          "suricata_config": capture.check_config(
                              daemon.suricata_config),
                          "plan": plan}, indent=2))
        return 0

    if args.once:
        done = daemon.apply_tier(tier)
        print(f"tier={tier} actions={done or ['none']}", flush=True)
        return 0

    return daemon.run()


if __name__ == "__main__":
    sys.exit(main())
