# ===========================================================================

def tier_plan(tier: str, rules_usable: bool, live_ifaces=None) -> dict:
    """The desired system state for a tier. No side effects, fully testable.

    Tier 0 — passive. Nothing is started, no gate file, no packets, no
      listeners, no canaries. The deck observes only what it is already being
      handed: orionx-scanwatch keeps reading the firewall's own drop log
      (DEC-PHASE12-022), which costs nothing and sends nothing.

    Tier 1 — active monitoring. Create the DEC-PHASE11-008 gate file, start
      Suricata, ingest eve.json, publish alerts with ATT&CK context.

    Tier 2 — everything in Tier 1, plus local deception: listening decoys and
      canary files on this host, and only this host (DEC-PHASE9-008 opt-in).

    Note Suricata is started at Tier 1/2 even with no threat rules. Refusing
    to start would trade one silence for another; the protocol-anomaly rules
    and flow records still have value. What must never happen is starting it
    quietly — hence warn_no_rules, which the caller is required to announce.

    zeek_ingest is True at EVERY tier, including Tier 0, and is stated here
    rather than left implicit so `--print-plan` answers the question honestly
    (DEC-PHASE12-028). Reading a log file Zeek has already written costs
    nothing, opens nothing and sends nothing — the same reasoning that puts
    orionx-scanwatch at Tier 0. A Tier 0 deck with Zeek running would
    otherwise throw away detections it already has, which is not what "passive"
    is supposed to mean. Whether anything is actually ingested still depends on
    Zeek being installed and its logs being readable, which is a RUNTIME
    question re-asked every cycle, not a tier decision.
    """
    tier = tier if tier in TIERS else "0"
    ids = tier in ("1", "2")

    # DEC-PHASE12-038. `live_ifaces` is the measured set of interfaces
    # carrying packets. Three states, not two:
    #
    #   None  — the heartbeat has not reported yet. Only reachable through
    #           --print-plan before the first sample and through callers that
    #           predate this parameter; the plan then describes the tier's
    #           INTENT, exactly as it did before, and says capture is unknown.
    #   ()    — measured, and nothing is carrying traffic. Suricata is NOT
    #           started: with an empty af-packet list it exits 1 immediately
    #           ("No interface found in config for af-packet", measured on
    #           7.0.10), so starting it would buy a restart storm and a lie.
    #   (...) — start, capturing on exactly these.
    #
    # The daemon always passes a measured value, so the None branch never
    # decides anything on real hardware. It exists so the pure function has
    # one honest answer for "nobody has measured yet" instead of guessing.
    known = live_ifaces is not None
    chosen = tuple(sorted(set(live_ifaces))) if known else ()
    capture_ok = (not known) or bool(chosen)

    return {
        "tier": tier,
        "label": TIER_LABEL[tier],
        "gate_file": ids,
        "suricata": ids and capture_ok,
        "eve_ingest": ids,
        "zeek_ingest": True,
        "nebula_context": ids,
        "deception": tier == "2",
        "warn_no_rules": ids and not rules_usable,
        # Interfaces Suricata should capture on. Empty at Tier 0 because Tier
        # 0 starts nothing and sends nothing.
        "capture_ifaces": chosen if ids else (),
        # True only when we have MEASURED that there is nothing to capture.
        "warn_no_capture": bool(ids and known and not chosen),
    }


def plan_actions(prev: dict | None, new: dict) -> list[tuple]:
    """Ordered actions to move from `prev` state to `new`.

    Ordering is load-bearing in both directions: on the way up the gate file
    must exist before systemd is asked to start the unit (ConditionPathExists
    is evaluated at start, and a start attempted first is a silent no-op — the
    exact trap that made Tier 2 do nothing). On the way down the unit is
    stopped before the gate is removed, so the gate never disappears from
    under a running service.
    """
    prev = prev or {"gate_file": False, "suricata": False, "eve_ingest": False,
                    "zeek_ingest": False, "deception": False,
                    "warn_no_rules": False, "tier": None,
                    "capture_ifaces": ()}
    up: list[tuple] = []
    down: list[tuple] = []

    # Zeek ingest is tier-independent, so in practice this fires once on the
    # first plan and never again. It goes through the action machinery anyway
    # rather than being started off to the side, so there is one place that
    # starts and stops ingestion and `--print-plan` shows it.
    if new.get("zeek_ingest") and not prev.get("zeek_ingest"):
        up.append(("zeek", "start"))
    if prev.get("zeek_ingest") and not new.get("zeek_ingest"):
        down.append(("zeek", "stop"))

    if new["gate_file"] and not prev.get("gate_file"):
        up.append(("gate", "create"))

    # DEC-PHASE12-038. The interface list must be on disk BEFORE systemd is
    # asked to start the unit, for the same reason the gate file must: the
    # engine reads its config once, at start. Writing it afterwards would
    # mean the first start captured the previous set and nobody noticed
    # until the next restart.
    prev_ifaces = tuple(prev.get("capture_ifaces") or ())
    new_ifaces = tuple(new.get("capture_ifaces") or ())
    starting = new["suricata"] and not prev.get("suricata")
    changed = (new["suricata"] and prev.get("suricata")
               and new_ifaces != prev_ifaces)
    if new_ifaces and (starting or changed):
        up.append(("capture", "write", new_ifaces))
    if starting:
        up.append(("service", "start", SURICATA_UNIT))
    elif changed:
        # Not stop+start: a restart is one systemd transaction, so there is
        # no window in which the unit is enabled with no process and the
        # reassert loop sees it as crashed and spends a recovery attempt.
        up.append(("service", "restart", SURICATA_UNIT))
    if new["eve_ingest"] and not prev.get("eve_ingest"):
        up.append(("eve", "start"))
    if new["deception"] and not prev.get("deception"):
        up.append(("deception", "arm"))

    if prev.get("deception") and not new["deception"]:
        down.append(("deception", "disarm"))
    if prev.get("eve_ingest") and not new["eve_ingest"]:
        down.append(("eve", "stop"))
    if prev.get("suricata") and not new["suricata"]:
        down.append(("service", "stop", SURICATA_UNIT))
    if prev.get("gate_file") and not new["gate_file"]:
        down.append(("gate", "remove"))

    actions = down + up
    if new["warn_no_rules"]:
        actions.append(("warn", "no-rules"))
    if new.get("warn_no_capture"):
        actions.append(("warn", "no-capture"))
    return actions


