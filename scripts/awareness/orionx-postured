NEBULA_SYSTEM = (
    "You are a concise SOC analyst on an offline incident-response laptop. "
    "Explain one IDS alert in at most two plain-English sentences for a tired "
    "operator at 3am: what the alert means and what to check first. "
    "No preamble, no markdown, no speculation beyond the data given."
)


def build_context_prompt(alert: dict, technique: tuple[str, str]) -> str:
    tech = f"{technique[0]} ({technique[1]})" if technique[0] else "unmapped"
    return (
        f"Suricata alert: {alert.get('signature', '')}\n"
        f"Classification: {alert.get('classtype', 'unknown')}\n"
        f"MITRE ATT&CK: {tech}\n"
        f"Source: {alert.get('src_ip', '?')}:{alert.get('src_port', '?')}\n"
        f"Destination: {alert.get('dest_ip', '?')}:{alert.get('dest_port', '?')}\n"
        f"Protocol: {alert.get('proto', '?')}\n"
        f"Suricata severity: {alert.get('eve_severity', '?')} (1 = highest)\n"
    )


def parse_nebula_response(body: str | bytes | None) -> str | None:
    """Pull the text out of an ollama /api/generate response; None if absent."""
    if not body:
        return None
    if isinstance(body, bytes):
        try:
            body = body.decode("utf-8", errors="replace")
        except (UnicodeError, AttributeError):
            return None
    try:
        obj = json.loads(body)
    except ValueError:
        return None
    if not isinstance(obj, dict):
        return None
    text = obj.get("response")
    if not isinstance(text, str):
        return None
    text = text.strip()
    return text or None


def condense(text: str | None, limit: int = 240) -> str | None:
    """One tidy line; the bus caps messages at 512 chars and R.A.I.N. speaks them."""
    if not text:
        return None
    flat = " ".join(str(text).split())
    if not flat:
        return None
    return flat if len(flat) <= limit else flat[: limit - 1].rstrip() + "…"


