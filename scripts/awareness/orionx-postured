def attack_technique(classtype: str | None,
                     signature: str | None) -> tuple[str, str]:
    """Map an alert to (technique_id, technique_name); ('','') if unmapped.

    Classtype first (it is the rule author's own taxonomy), signature prefix
    second (covers ET rules whose classtype is generic or absent).
    """
    ct = (classtype or "").strip().lower()
    hit = ATTACK_BY_CLASSTYPE.get(ct)
    if hit and hit[0]:
        return hit
    sig = (signature or "").strip()
    best: tuple[str, str] = ("", "")
    best_len = 0
    for prefix, tech in ATTACK_BY_SIGNATURE_PREFIX.items():
        if sig.upper().startswith(prefix) and len(prefix) > best_len:
            best, best_len = tech, len(prefix)
    return best


def is_scan_alert(alert: dict) -> bool:
    ct = (alert.get("classtype") or "").strip().lower()
    if ct in SCAN_CLASSTYPES:
        return True
    sig = (alert.get("signature") or "").upper()
    return any(sig.startswith(p) for p in SCAN_SIGNATURE_PREFIXES)


# ===========================================================================
# PURE: eve.json alert parsing
# ===========================================================================

def parse_eve_line(line: str) -> dict | None:
    """Extract one Suricata alert from a line of eve.json.

    eve.json is newline-delimited JSON carrying many event_types (flow, dns,
    http, stats, ...). Only `alert` records are detections; everything else is
    telemetry and is ignored here. Returns None for anything unparseable, so a
    truncated final line during log rotation is a skip, not a crash.
    """
    line = (line or "").strip()
    if not line or line[0] != "{":
        return None
    try:
        rec = json.loads(line)
    except ValueError:
        return None
    if not isinstance(rec, dict) or rec.get("event_type") != "alert":
        return None
    alert = rec.get("alert")
    if not isinstance(alert, dict):
        return None
    try:
        sev = int(alert.get("severity", 3))
    except (TypeError, ValueError):
        sev = 3
    try:
        sid = int(alert.get("signature_id", 0))
    except (TypeError, ValueError):
        sid = 0
    return {
        "timestamp": str(rec.get("timestamp", "")),
        "signature": str(alert.get("signature", "")).strip(),
        "signature_id": sid,
        "classtype": str(alert.get("category", "")).strip(),
        "eve_severity": sev,
        "src_ip": str(rec.get("src_ip", "")),
        "src_port": rec.get("src_port"),
        "dest_ip": str(rec.get("dest_ip", "")),
        "dest_port": rec.get("dest_port"),
        "proto": str(rec.get("proto", "")).lower(),
    }


def bus_severity(alert: dict) -> str:
    """Suricata severity -> Orion-X bus severity (1 critical .. 4+ info)."""
    return EVE_SEVERITY.get(int(alert.get("eve_severity", 3) or 3), "info")


def dedup_key(alert: dict) -> tuple:
    """One ongoing attack is one story. Key on what makes it distinct."""
    return (alert.get("signature_id", 0), alert.get("src_ip", ""),
            alert.get("dest_port"))


def format_alert_message(alert: dict, technique: tuple[str, str]) -> str:
    sig = alert.get("signature") or "unnamed signature"
    src = alert.get("src_ip") or "?"
    dst = alert.get("dest_ip") or "?"
    sport = alert.get("src_port")
    dport = alert.get("dest_port")
    src_s = f"{src}:{sport}" if sport else src
    dst_s = f"{dst}:{dport}" if dport else dst
    tech = f" [{technique[0]} {technique[1]}]" if technique[0] else ""
    proto = alert.get("proto") or "ip"
    return f"{sig}{tech} — {src_s} → {dst_s} ({proto}) sid:{alert.get('signature_id', 0)}"


class AlertDeduper:
    """Bounded re-announce throttle keyed by dedup_key().

    Bounded because a spoofed-source flood must not turn the detector into a
    memory exhaustion attack against the deck it protects (same reasoning as
    orionx-scanwatch's MAX_SOURCES).
    """

    def __init__(self, reannounce: float = ALERT_REANNOUNCE,
                 max_keys: int = MAX_ALERT_KEYS):
        self.reannounce = reannounce
        self.max_keys = max_keys
        self._seen: OrderedDict[tuple, float] = OrderedDict()

    def should_publish(self, key: tuple, now: float) -> bool:
        last = self._seen.get(key)
        if last is not None and (now - last) < self.reannounce:
            self._seen.move_to_end(key)
            return False
        if key not in self._seen and len(self._seen) >= self.max_keys:
            self._seen.popitem(last=False)
        self._seen[key] = now
        self._seen.move_to_end(key)
        return True

    def tracked(self) -> int:
        return len(self._seen)


# --- Not reporting the same scan twice --------------------------------------

_BUS_SCAN_SRC = re.compile(r"\bfrom\s+(\d{1,3}(?:\.\d{1,3}){3}|[0-9a-fA-F:]{3,})")


def upstream_scan_reporters(reporter: str) -> tuple[str, ...]:
    """The reporters that outrank `reporter` for scan attribution.

    A detector suppresses a scan only when something AHEAD of it in
    SCAN_REPORTER_PRECEDENCE already published that source. Deriving this from
    one ordered tuple is what keeps the rule symmetric: adding a fourth
    detector means adding one name, not editing three suppression checks.

    An unknown reporter outranks nothing, so a detector that is not in the
    precedence list publishes rather than falling silent. Failing open is
    correct here — a duplicate event is noise, a suppressed event is a missed
    detection, and this project's recurring bug is the second one.
    """
    try:
        idx = SCAN_REPORTER_PRECEDENCE.index(reporter)
    except ValueError:
        return ()
    return SCAN_REPORTER_PRECEDENCE[:idx]


def scan_sources_from_bus(lines, now: float,
                          window: float = SCAN_DEDUP_WINDOW,
                          sources: tuple[str, ...] = ("firewall",)) -> set[str]:
    """Scan sources the named reporters have already published, recently.

    Reads the shared bus rather than duplicating each detector's state: the bus
    is the existing single authority for what has been reported, so there is no
    second place for the detectors to disagree.

    `sources` defaults to ("firewall",) — orionx-scanwatch alone — which is the
    Suricata behaviour this has always had. Zeek passes the wider tuple from
    upstream_scan_reporters("zeek"), so it defers to both.
    """
    out: set[str] = set()
    wanted = set(sources)
    for line in lines:
        line = (line or "").strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if not isinstance(rec, dict):
            continue
        if rec.get("category") != "scan" or rec.get("source") not in wanted:
            continue
        try:
            ts = float(rec.get("ts", 0.0))
        except (TypeError, ValueError):
            continue
        if ts and (now - ts) > window:
            continue
        m = _BUS_SCAN_SRC.search(str(rec.get("message", "")))
        if m:
            out.add(m.group(1))
    return out


def should_suppress(alert: dict, scan_sources: set[str]) -> bool:
    """True if scanwatch already told this story for this source."""
    return is_scan_alert(alert) and alert.get("src_ip", "") in scan_sources


class ScanLedger:
    """Who has already reported a scan from a given source, and when.

    Three detectors can now see one sweep: orionx-scanwatch (a separate
    process, reading the firewall drop log), Suricata (this daemon, via
    eve.json) and Zeek (this daemon, via notice.log). Without a shared answer
    to "has this already been said", one nmap run produces three stories.

    Two inputs, one answer:

      - Other processes are learned from the BUS, which is the existing
        cross-process authority for what has been published.
      - This daemon's OWN publications are recorded directly. That is not a
        shortcut around the bus, it is strictly more reliable: recognising our
        own Suricata alert by regexing its message back off the bus would make
        dedup depend on message prose, and Suricata alert text does not even
        contain the word "from". Reading our own memory for our own actions
        cannot disagree with itself.

    Bounded, for the same reason AlertDeduper is: a spoofed-source flood must
    not turn de-duplication into a memory exhaustion attack on the deck.
    """

    def __init__(self, window: float = SCAN_DEDUP_WINDOW,
                 max_keys: int = MAX_ALERT_KEYS):
        self.window = window
        self.max_keys = max_keys
        # (reporter, src) -> last report time
        self._seen: OrderedDict[tuple[str, str], float] = OrderedDict()

    def record(self, reporter: str, src: str, now: float) -> None:
        if not src:
            return
        key = (reporter, src)
        if key not in self._seen and len(self._seen) >= self.max_keys:
            self._seen.popitem(last=False)
        self._seen[key] = now
        self._seen.move_to_end(key)

    def merge_bus(self, reporter: str, sources: set[str], now: float) -> None:
        for src in sources:
            self.record(reporter, src, now)

    def reported_by(self, reporters, src: str, now: float) -> str | None:
        """Which of `reporters` reported `src` inside the window, if any."""
        for reporter in reporters:
            ts = self._seen.get((reporter, src))
            if ts is not None and (now - ts) <= self.window:
                return reporter
        return None

    def tracked(self) -> int:
        return len(self._seen)


def should_suppress_scan(reporter: str, src: str, ledger: ScanLedger,
                         now: float) -> str | None:
    """Name of the detector that already owns this scan source, or None.

    Returns the owner rather than a bool so the suppression can be explained
    in the status file and in a log line. A suppression nobody can account for
    is indistinguishable from a detector that stopped working.
    """
    if not src:
        return None
    return ledger.reported_by(upstream_scan_reporters(reporter), src, now)


# ===========================================================================
# PURE: Zeek — is it here, and what is it saying? (DEC-PHASE12-028)
# ===========================================================================

def find_zeek_binary(candidates=ZEEK_BIN_CANDIDATES,
                     use_path: bool = True) -> Path | None:
    """The Zeek binary, or None. Re-asked every cycle, never cached at boot.

    `use_path` controls the PATH fallback. It is on by default, because a deck
    where someone built Zeek into an unusual prefix and symlinked it should
    still be ingested. It is OFF when the operator passed --zeek-bin: an
    explicit override is authoritative, and silently searching PATH anyway
    would mean the flag does not actually control what is used.
    """
    for cand in candidates:
        cand = Path(cand)
        if cand.is_file() and os.access(cand, os.X_OK):
            return cand
    if not use_path:
        return None
    found = shutil.which("zeek")
    return Path(found) if found else None


def assess_zeek_logs(dirs=ZEEK_LOG_DIRS, logs=(ZEEK_NOTICE_LOG,
                                               ZEEK_WEIRD_LOG,
                                               ZEEK_CONN_LOG)) -> dict:
    """Which Zeek log directory to read, and why not, when there is none.

    The three failure states are kept DISTINCT because they call for three
    different things from the operator, and collapsing them into "no Zeek
    logs" is how a permissions bug gets mistaken for a quiet network:

      absent     — no candidate directory exists. Zeek has not been run.
      unreadable — a directory exists but this daemon cannot read it. THIS IS
                   THE DANGEROUS ONE: Zeek may be detecting plenty and we are
                   blind to all of it. Reported at warning, repeatedly.
      empty      — readable, but holds none of the logs we consume.
      ok         — readable and holding at least one log.
    """
    considered: list[str] = []
    unreadable: list[str] = []
    empty: list[str] = []
    for d in dirs:
        d = Path(d)
        considered.append(str(d))
        if not d.is_dir():
            continue
        if not os.access(d, os.R_OK | os.X_OK):
            unreadable.append(str(d))
            continue
        present = [name for name in logs if (d / name).is_file()]
        if not present:
            empty.append(str(d))
            continue
        return {"state": "ok", "dir": str(d), "logs": present,
                "considered": considered, "unreadable": unreadable}
    if unreadable:
        return {"state": "unreadable", "dir": unreadable[0], "logs": [],
                "considered": considered, "unreadable": unreadable}
    if empty:
        return {"state": "empty", "dir": empty[0], "logs": [],
                "considered": considered, "unreadable": []}
    return {"state": "absent", "dir": "", "logs": [],
            "considered": considered, "unreadable": []}


def detect_zeek(bin_candidates=ZEEK_BIN_CANDIDATES,
                log_dirs=ZEEK_LOG_DIRS, use_path: bool = True) -> dict:
    """Runtime Zeek status: installed?, logs where?, usable?

    `usable` is the only field the ingest acts on, and it means exactly
    "there is a readable log directory to tail". Note it does NOT require the
    binary: a deck handed a Zeek log directory from elsewhere can still be
    given the analysis, and refusing to read logs because the binary that
    produced them is not installed locally would be pedantry with a cost.
    """
    binary = find_zeek_binary(bin_candidates, use_path=use_path)
    logs = assess_zeek_logs(log_dirs)
    return {
        "installed": binary is not None,
        "binary": str(binary or ""),
        "log_state": logs["state"],
        "log_dir": logs["dir"],
        "logs": logs["logs"],
        "considered": logs["considered"],
        "usable": logs["state"] == "ok",
    }


def zeek_state_message(zeek: dict) -> tuple[str, str]:
    """(severity, message) describing the current Zeek state. Never silent.

    Absence is a NOTICE, not a critical: Zeek missing is a capability the deck
    does not have, and it says so while naming the remedy. That is a different
    thing from Suricata claiming coverage it does not have, which is a lie and
    is reported as critical (no_rules_message). Unreadable logs ARE a warning,
    because that is detection happening where we cannot see it.
    """
    if zeek["usable"]:
        return ("notice",
                f"Zeek ingest ACTIVE — reading {', '.join(zeek['logs'])} from "
                f"{zeek['log_dir']}. Notices reach the R.A.I.N. bus with ATT&CK "
                "context; scans already reported by the firewall or Suricata "
                "are not repeated.")
    if zeek["log_state"] == "unreadable":
        return ("warning",
                f"Zeek log directory {zeek['log_dir']} EXISTS BUT IS NOT "
                "READABLE by orionx-postured. Zeek may be detecting and this "
                "deck cannot see any of it — that is silent non-detection, not "
                "a quiet network. Fix with: sudo chmod o+rx "
                f"{zeek['log_dir']}")
    if not zeek["installed"]:
        return ("notice",
                "Zeek is NOT installed on this deck, so there is no protocol "
                "analysis or connection record layer. Suricata and "
                "orionx-scanwatch are unaffected. Install it with: sudo "
                "/opt/orionx/optional/install-zeek.sh — no rebuild or restart "
                "is needed, this daemon picks it up on its next cycle.")
    if zeek["log_state"] == "empty":
        return ("notice",
                f"Zeek is installed ({zeek['binary']}) but {zeek['log_dir']} "
                "holds no logs yet, so there is nothing to ingest. Give it "
                "traffic with: sudo zeek -i <iface>  (or capture first with "
                "sudo orionx-capture start <iface>, then zeek -r the pcap).")
    return ("notice",
            f"Zeek is installed ({zeek['binary']}) but no log directory was "
            f"found. Searched: {', '.join(zeek['considered'])}. Nothing to "
            "ingest until Zeek writes somewhere this daemon looks.")


# --- Zeek log formats: TSV (default) and JSON (LogAscii::use_json) ---------

def zeek_fields_from_header(line: str) -> list[str] | None:
    """Column names from a Zeek TSV `#fields` header line, else None."""
    if not line.startswith("#fields"):
        return None
    parts = line.rstrip("\n").split("\t")
    return [p for p in parts[1:] if p] or None


def zeek_fields_from_file(path, max_header_lines: int = 12) -> list[str] | None:
    """Prime the column list by reading a Zeek log's header.

    Needed because the tailer starts at EOF: without this, a TSV log that was
    already open when we attached has no column names and every row is
    unparseable. Re-read on every (re)open, so log rotation cannot leave us
    decoding new rows with a stale header.
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for _ in range(max_header_lines):
                line = fh.readline()
                if not line:
                    break
                fields = zeek_fields_from_header(line)
                if fields:
                    return fields
                if not line.startswith("#"):
                    break
    except OSError:
        return None
    return None


def zeek_record(line: str, fields: list[str] | None) -> dict | None:
    """One Zeek log line -> dict, for both the TSV and JSON log formats.

    Zeek writes TSV by default and JSON when LogAscii::use_json is set, and
    which one a given deck produces depends on local policy this daemon does
    not control. Handling only TSV would mean a JSON-configured Zeek is
    ingested as zero events — silent non-detection again, this time caused by
    a config file nobody remembered.

    Zeek's unset marker "-" and empty marker "(empty)" become None, so callers
    test for a value rather than for a sentinel string.
    """
    line = (line or "").strip()
    if not line or line.startswith("#"):
        return None
    if line.startswith("{"):
        try:
            rec = json.loads(line)
        except ValueError:
            return None
        if not isinstance(rec, dict):
            return None
        return {k: (None if v in ("-", "(empty)") else v)
                for k, v in rec.items()}
    if not fields:
        return None
    parts = line.split("\t")
    if len(parts) < len(fields):
        parts += [None] * (len(fields) - len(parts))
    out: dict = {}
    for name, value in zip(fields, parts):
        out[name] = None if value in ("-", "(empty)", "", None) else value
    return out


# --- What a Zeek notice means ----------------------------------------------

