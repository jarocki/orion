# EFFECTS: log tailing (Suricata eve.json, Zeek logs)
# ===========================================================================

class LogTailer:
    """Follow a log file from the end, surviving rotation and absence.

    Starts at EOF: on entering Tier 1 the operator wants what happens next,
    not a replay of a log that may be hours old. Rotation is detected by inode
    change, and a missing file is a normal state (Suricata may not have
    written one yet), retried quietly rather than treated as an error.

    Used for BOTH Suricata's eve.json and Zeek's logs (DEC-PHASE12-028). This
    class was already generic when it served only Suricata; giving Zeek a
    second copy would have meant two rotation implementations to keep
    correct, so it was renamed and reused rather than duplicated.

    `on_open(path)` fires after each (re)open, before the seek to EOF. Zeek's
    TSV format needs it: the column names live in a `#fields` header at the
    top of the file, so a tailer that only ever sees the tail cannot decode a
    single row. Re-firing on rotation is the point — a rotated log has a new
    header, and decoding new rows with stale columns would silently mangle
    every field.
    """

    def __init__(self, path: Path = EVE_JSON, on_line=None,
                 poll: float = 1.0, on_open=None):
        self.path = Path(path)
        self.on_line = on_line
        self.on_open = on_open
        self.poll = poll
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self.lines_read = 0

    def start(self) -> None:
        if self._thread is not None:
            return
        self._stop.clear()
        self._thread = threading.Thread(target=self._run,
                                        name=f"tail-{self.path.name}",
                                        daemon=True)
        self._thread.start()

    def stop(self) -> None:
        self._stop.set()
        self._thread = None

    def _run(self) -> None:
        fh = None
        inode = None
        try:
            while not self._stop.is_set():
                if fh is None:
                    try:
                        if self.on_open is not None:
                            try:
                                self.on_open(self.path)
                            except Exception:  # noqa: BLE001 - never kill tail
                                pass
                        fh = open(self.path, "r", encoding="utf-8",
                                  errors="replace")
                        fh.seek(0, os.SEEK_END)
                        inode = os.fstat(fh.fileno()).st_ino
                    except OSError:
                        fh = None
                        self._stop.wait(self.poll)
                        continue
                line = fh.readline()
                if line:
                    self.lines_read += 1
                    if self.on_line is not None:
                        try:
                            self.on_line(line)
                        except Exception:  # noqa: BLE001 - never kill the tail
                            pass
                    continue
                try:
                    if os.stat(self.path).st_ino != inode:
                        fh.close()
                        fh = None
                        continue
                except OSError:
                    fh.close()
                    fh = None
                    continue
                self._stop.wait(self.poll)
        finally:
            if fh is not None:
                try:
                    fh.close()
                except OSError:
                    pass


