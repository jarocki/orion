def attack_technique(classtype: str | None,
                     signature: str | None) -> tuple[str, str]:
    """Map an alert to (technique_id, technique_name); ('','') if unmapped.

    Classtype first (it is the rule author's own taxonomy), signature prefix
    second (covers ET rules whose classtype is generic or absent).
    """
    ct = (classtype or "").strip().lower()
    hit = ATTACK_BY_CLASSTYPE.get(ct)
    if hit and hit[0]:
        return hit
    sig = (signature or "").strip()
    best: tuple[str, str] = ("", "")
    best_len = 0
    for prefix, tech in ATTACK_BY_SIGNATURE_PREFIX.items():
        if sig.upper().startswith(prefix) and len(prefix) > best_len:
            best, best_len = tech, len(prefix)
    return best


def is_scan_alert(alert: dict) -> bool:
    ct = (alert.get("classtype") or "").strip().lower()
    if ct in SCAN_CLASSTYPES:
        return True
    sig = (alert.get("signature") or "").upper()
    return any(sig.startswith(p) for p in SCAN_SIGNATURE_PREFIXES)


# ===========================================================================
# PURE: eve.json alert parsing
# ===========================================================================

def parse_eve_line(line: str) -> dict | None:
    """Extract one Suricata alert from a line of eve.json.

    eve.json is newline-delimited JSON carrying many event_types (flow, dns,
    http, stats, ...). Only `alert` records are detections; everything else is
    telemetry and is ignored here. Returns None for anything unparseable, so a
    truncated final line during log rotation is a skip, not a crash.
    """
    line = (line or "").strip()
    if not line or line[0] != "{":
        return None
    try:
        rec = json.loads(line)
    except ValueError:
        return None
    if not isinstance(rec, dict) or rec.get("event_type") != "alert":
        return None
    alert = rec.get("alert")
    if not isinstance(alert, dict):
        return None
    try:
        sev = int(alert.get("severity", 3))
    except (TypeError, ValueError):
        sev = 3
    try:
        sid = int(alert.get("signature_id", 0))
    except (TypeError, ValueError):
        sid = 0
    return {
        "timestamp": str(rec.get("timestamp", "")),
        "signature": str(alert.get("signature", "")).strip(),
        "signature_id": sid,
        "classtype": str(alert.get("category", "")).strip(),
        "eve_severity": sev,
        "src_ip": str(rec.get("src_ip", "")),
        "src_port": rec.get("src_port"),
        "dest_ip": str(rec.get("dest_ip", "")),
        "dest_port": rec.get("dest_port"),
        "proto": str(rec.get("proto", "")).lower(),
    }


def bus_severity(alert: dict) -> str:
    """Suricata severity -> Orion-X bus severity (1 critical .. 4+ info)."""
    return EVE_SEVERITY.get(int(alert.get("eve_severity", 3) or 3), "info")


def dedup_key(alert: dict) -> tuple:
    """One ongoing attack is one story. Key on what makes it distinct."""
    return (alert.get("signature_id", 0), alert.get("src_ip", ""),
            alert.get("dest_port"))


def format_alert_message(alert: dict, technique: tuple[str, str]) -> str:
    sig = alert.get("signature") or "unnamed signature"
    src = alert.get("src_ip") or "?"
    dst = alert.get("dest_ip") or "?"
    sport = alert.get("src_port")
    dport = alert.get("dest_port")
    src_s = f"{src}:{sport}" if sport else src
    dst_s = f"{dst}:{dport}" if dport else dst
    tech = f" [{technique[0]} {technique[1]}]" if technique[0] else ""
    proto = alert.get("proto") or "ip"
    return f"{sig}{tech} — {src_s} → {dst_s} ({proto}) sid:{alert.get('signature_id', 0)}"


class AlertDeduper:
    """Bounded re-announce throttle keyed by dedup_key().

    Bounded because a spoofed-source flood must not turn the detector into a
    memory exhaustion attack against the deck it protects (same reasoning as
    orionx-scanwatch's MAX_SOURCES).
    """

    def __init__(self, reannounce: float = ALERT_REANNOUNCE,
                 max_keys: int = MAX_ALERT_KEYS):
        self.reannounce = reannounce
        self.max_keys = max_keys
        self._seen: OrderedDict[tuple, float] = OrderedDict()

    def should_publish(self, key: tuple, now: float) -> bool:
        last = self._seen.get(key)
        if last is not None and (now - last) < self.reannounce:
            self._seen.move_to_end(key)
            return False
        if key not in self._seen and len(self._seen) >= self.max_keys:
            self._seen.popitem(last=False)
        self._seen[key] = now
        self._seen.move_to_end(key)
        return True

    def tracked(self) -> int:
        return len(self._seen)


# --- Not reporting the same scan twice --------------------------------------

_BUS_SCAN_SRC = re.compile(r"\bfrom\s+(\d{1,3}(?:\.\d{1,3}){3}|[0-9a-fA-F:]{3,})")


def scan_sources_from_bus(lines, now: float,
                          window: float = SCAN_DEDUP_WINDOW) -> set[str]:
    """Sources orionx-scanwatch has already reported as scanning us, recently.

    Reads the shared bus rather than duplicating scanwatch's state: the bus is
    the existing single authority for what has been reported, so there is no
    second place for the two detectors to disagree.
    """
    out: set[str] = set()
    for line in lines:
        line = (line or "").strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if not isinstance(rec, dict):
            continue
        if rec.get("category") != "scan" or rec.get("source") != "firewall":
            continue
        try:
            ts = float(rec.get("ts", 0.0))
        except (TypeError, ValueError):
            continue
        if ts and (now - ts) > window:
            continue
        m = _BUS_SCAN_SRC.search(str(rec.get("message", "")))
        if m:
            out.add(m.group(1))
    return out


def should_suppress(alert: dict, scan_sources: set[str]) -> bool:
    """True if scanwatch already told this story for this source."""
    return is_scan_alert(alert) and alert.get("src_ip", "") in scan_sources


# ===========================================================================
# PURE: what each tier actually means
# ===========================================================================

def tier_plan(tier: str, rules_usable: bool) -> dict:
    """The desired system state for a tier. No side effects, fully testable.

    Tier 0 — passive. Nothing is started, no gate file, no packets, no
      listeners, no canaries. The deck observes only what it is already being
      handed: orionx-scanwatch keeps reading the firewall's own drop log
      (DEC-PHASE12-022), which costs nothing and sends nothing.

    Tier 1 — active monitoring. Create the DEC-PHASE11-008 gate file, start
      Suricata, ingest eve.json, publish alerts with ATT&CK context.

    Tier 2 — everything in Tier 1, plus local deception: listening decoys and
      canary files on this host, and only this host (DEC-PHASE9-008 opt-in).

    Note Suricata is started at Tier 1/2 even with no threat rules. Refusing
    to start would trade one silence for another; the protocol-anomaly rules
    and flow records still have value. What must never happen is starting it
    quietly — hence warn_no_rules, which the caller is required to announce.
    """
    tier = tier if tier in TIERS else "0"
    ids = tier in ("1", "2")
    return {
        "tier": tier,
        "label": TIER_LABEL[tier],
        "gate_file": ids,
        "suricata": ids,
        "eve_ingest": ids,
        "nebula_context": ids,
        "deception": tier == "2",
        "warn_no_rules": ids and not rules_usable,
    }


def plan_actions(prev: dict | None, new: dict) -> list[tuple]:
    """Ordered actions to move from `prev` state to `new`.

    Ordering is load-bearing in both directions: on the way up the gate file
    must exist before systemd is asked to start the unit (ConditionPathExists
    is evaluated at start, and a start attempted first is a silent no-op — the
    exact trap that made Tier 2 do nothing). On the way down the unit is
    stopped before the gate is removed, so the gate never disappears from
    under a running service.
    """
    prev = prev or {"gate_file": False, "suricata": False, "eve_ingest": False,
                    "deception": False, "warn_no_rules": False, "tier": None}
    up: list[tuple] = []
    down: list[tuple] = []

    if new["gate_file"] and not prev.get("gate_file"):
        up.append(("gate", "create"))
    if new["suricata"] and not prev.get("suricata"):
        up.append(("service", "start", SURICATA_UNIT))
    if new["eve_ingest"] and not prev.get("eve_ingest"):
        up.append(("eve", "start"))
    if new["deception"] and not prev.get("deception"):
        up.append(("deception", "arm"))

    if prev.get("deception") and not new["deception"]:
        down.append(("deception", "disarm"))
    if prev.get("eve_ingest") and not new["eve_ingest"]:
        down.append(("eve", "stop"))
    if prev.get("suricata") and not new["suricata"]:
        down.append(("service", "stop", SURICATA_UNIT))
    if prev.get("gate_file") and not new["gate_file"]:
        down.append(("gate", "remove"))

    actions = down + up
    if new["warn_no_rules"]:
        actions.append(("warn", "no-rules"))
    return actions


