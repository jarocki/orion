def publish(severity: str, source: str, category: str, message: str,
            dry_run: bool = False, detail: dict | None = None) -> None:
    """Fire-and-forget onto the bus via the orionx-event CLI.

    Same mechanism as orionx-scanwatch and the Control Center: subprocess to
    the CLI rather than importing rain_lib, so there is one writer contract
    and no import coupling between detectors and the bus implementation.

    `detail` is structured evidence for the Cockpit drill-down: the
    interfaces involved, the measured packet rates, the config path, the
    exact thing that failed. A message tells the operator what happened; the
    detail is what they need to act without reconstructing it by hand. An
    unserialisable detail is dropped rather than losing the event with it.
    """
    if dry_run:
        extra = f" {json.dumps(detail, sort_keys=True)}" if detail else ""
        print(f"[{severity}] {source}/{category}: {message}{extra}",
              flush=True)
        return
    argv = ["orionx-event", "--severity", severity, "--source", source,
            "--category", category]
    if detail:
        try:
            argv += ["--detail", json.dumps(detail, sort_keys=True,
                                            default=str)]
        except (TypeError, ValueError):
            pass
    argv.append(message)
    try:
        subprocess.Popen(argv, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError:
        pass


def tail_bus_lines(path: Path = BUS, max_lines: int = 400) -> list[str]:
    """Last N lines of the bus, for scan-source de-duplication. Never raises."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.readlines()[-max_lines:]
    except OSError:
        return []


