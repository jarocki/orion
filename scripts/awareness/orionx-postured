# EFFECTS: Nebula contextualizer (best-effort, never gates an alert)
# ===========================================================================

def ollama_generate(prompt: str, base_url: str = NEBULA_URL,
                    timeout: float = NEBULA_TIMEOUT) -> str | None:
    """One non-streaming completion from the on-box model. None on any failure.

    Imported lazily so that a deck without urllib quirks, or a unit test with
    no network stack, never pays for it. DEC-006: 127.0.0.1 only, always.
    """
    import urllib.error  # noqa: PLC0415
    import urllib.request  # noqa: PLC0415
    try:
        with urllib.request.urlopen(  # noqa: S310 - fixed localhost URL
            urllib.request.Request(f"{base_url}/api/tags", method="GET"),
            timeout=3,
        ) as resp:
            tags = json.loads(resp.read().decode("utf-8"))
        models = tags.get("models") or []
        if not models:
            return None
        model = str(models[0].get("name", ""))
        if not model:
            return None
        payload = json.dumps({
            "model": model,
            "prompt": prompt,
            "system": NEBULA_SYSTEM,
            "stream": False,
            "options": {"temperature": 0.2, "num_predict": 120},
        }).encode("utf-8")
        req = urllib.request.Request(
            f"{base_url}/api/generate", data=payload, method="POST",
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310
            return parse_nebula_response(resp.read())
    except (urllib.error.URLError, urllib.error.HTTPError, OSError,
            ValueError, TypeError):
        return None


class Contextualizer:
    """Asks the local model to explain an alert, on a worker thread.

    Everything about this class is subordinate to one rule: THE MODEL NEVER
    GATES AN ALERT. The caller publishes the detection first and offers it
    here afterwards. The queue is small and non-blocking, so when the model is
    slow the requests are dropped rather than allowed to back-pressure the
    ingest loop. When it is absent, one notice is emitted and the rest are
    silent — an operator should be told once that explanations are off, not
    once per alert.
    """

    def __init__(self, transport=ollama_generate, dry_run: bool = False,
                 maxsize: int = NEBULA_QUEUE_MAX):
        self.transport = transport
        self.dry_run = dry_run
        self._q: queue.Queue = queue.Queue(maxsize=maxsize)
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._unavailable_announced = False
        self.dropped = 0
        self.contextualised = 0

    def start(self) -> None:
        if self._thread is not None:
            return
        self._stop.clear()
        self._thread = threading.Thread(target=self._run, name="nebula-ctx",
                                        daemon=True)
        self._thread.start()

    def stop(self) -> None:
        self._stop.set()
        try:
            self._q.put_nowait(None)
        except queue.Full:
            pass
        self._thread = None

    def offer(self, alert: dict, technique: tuple[str, str]) -> bool:
        """Queue an alert for explanation. Never blocks; False if dropped."""
        try:
            self._q.put_nowait((alert, technique))
            return True
        except queue.Full:
            self.dropped += 1
            return False

    def explain(self, alert: dict, technique: tuple[str, str]) -> str | None:
        """Synchronous single explanation. Degrades to None, never raises."""
        try:
            return condense(self.transport(build_context_prompt(alert, technique)))
        except Exception:  # noqa: BLE001 - a broken model must not kill detection
            return None

    def _run(self) -> None:
        while not self._stop.is_set():
            try:
                item = self._q.get(timeout=0.5)
            except queue.Empty:
                continue
            if item is None:
                break
            alert, technique = item
            text = self.explain(alert, technique)
            if text is None:
                if not self._unavailable_announced:
                    self._unavailable_announced = True
                    # `tooling`, not `ids`: the message itself says detection
                    # is unaffected, so it must not move the threat gauge.
                    publish("notice", "nebula", "tooling",
                            "Nebula contextualizer unavailable — IDS alerts are "
                            "publishing WITHOUT plain-language explanations. "
                            "Detection is unaffected.", dry_run=self.dry_run)
                continue
            self.contextualised += 1
            # `tooling`, not `ids`. This is an annotation of an alert that was
            # already published under `ids`; emitting it as `ids` too counted
            # every real detection twice in the panel's scan widget and in
            # pressure() — about 2x whenever Ollama was up, 1x when it was not,
            # so the gauge moved according to model availability.
            publish("info", "nebula", "tooling",
                    f"Context for sid:{alert.get('signature_id', 0)} — {text}",
                    dry_run=self.dry_run)


# ===========================================================================
# EFFECTS: Tier 2 deception — local, non-destructive, reversible
# ===========================================================================
#
# Two kinds of bait, both entirely on this host:
#
#   1. Listening decoys. Plain TCP accept-and-stall sockets on ports an
#      intruder tries early. They answer with a fake banner, then hold the
#      connection open (a tarpit) up to a cap, costing the scanner time and
#      costing us one idle socket. They never connect out, never probe back,
#      never scan. The whole reply surface is a hard-coded banner string.
#
#   2. Canary files. Obviously-fake credentials in a known directory whose
#      access time is watched. Reading one is a detection; the file is then
#      rewritten to re-arm it. Nothing in them is a real secret — each token
#      is generated at arm time and is inert.
#
# The base firewall DROPs everything not explicitly permitted, so a decoy
# socket alone would never see a packet. The opening is therefore made at
# runtime, as a single rule inserted into the RUNNING inet orionx_firewall
# input chain and deleted by handle at disarm. /etc/nftables.conf is never
# edited: it stays the single authority for base policy, and a reboot returns
# the deck to it with no residue.

NFT_TABLE = "inet orionx_firewall"
NFT_CHAIN = "input"
NFT_COMMENT = "orionx-deception"

# Chosen as classic early-probe bait that does not collide with anything
# Orion-X runs (ollama 11434, WireGuard 51820, Matrix 8008/8448, sshd 22).
DECOY_PORTS = (23, 2121, 2222, 4444)
DECOY_BANNERS = {
    23: "\r\nDebian GNU/Linux 11\r\nlogin: ",
    2121: "220 ProFTPD 1.3.6 Server (backup) [10.0.0.1]\r\n",
    2222: "SSH-2.0-OpenSSH_7.9p1 Debian-10+deb10u2\r\n",
    4444: "\r\nMicrosoft Windows [Version 10.0.19044.1288]\r\n\r\nC:\\> ",
}
DECOY_MAX_CONNECTIONS = 32     # bounded: a decoy must not exhaust the deck
DECOY_HOLD_SECONDS = 120.0     # tarpit dwell cap, then close politely

CANARY_MARKER = "ORIONX-CANARY-DO-NOT-USE"
CANARY_FILES = ("credentials.txt", "wallet.dat", "id_rsa_backup",
                ".git-credentials")


def honeytoken(rng=None) -> str:
    """A unique, inert, obviously-fake credential string.

    Generated at arm time rather than stored as a literal for two reasons:
    every deck's token is distinct, so a leaked one identifies which deck it
    came from; and no credential-shaped literal ever lives in the repo where
    a secret scanner would have to decide whether it is real.
    """
    rng = rng or random.SystemRandom()
    body = "".join(rng.choice(string.ascii_uppercase + string.digits)
                   for _ in range(16))
    return f"AKIA{body}"


def canary_content(name: str, token: str) -> str:
    """Bait that is convincing to a grep and useless to an attacker."""
    header = f"# {CANARY_MARKER} — Orion-X deception canary (DEC-PHASE12-024)\n"
    if name == ".git-credentials":
        return f"{header}https://svc-deploy:{token}@git.internal.example\n"
    if name == "id_rsa_backup":
        return (f"{header}-----BEGIN OPENSSH PRIVATE KEY-----\n{token}\n"
                "-----END OPENSSH PRIVATE KEY-----\n")
    if name == "wallet.dat":
        return f"{header}wallet_seed={token}\nbalance=14.20183\n"
    return (f"{header}aws_access_key_id={token}\n"
            f"aws_secret_access_key={token}{token}\n"
            "vpn_psk=orionx-lab-shared-secret\n")


def canary_tripped(baseline_atime: float, current_atime: float) -> bool:
    """True if the file has been read since it was armed.

    Uses atime, which on a `relatime` mount (Debian's default) is updated when
    the existing atime is not newer than mtime — true immediately after we
    write the file, so the FIRST read is always caught. Later reads inside the
    24h relatime window would not be, which is why a trip rewrites the file:
    re-arming restores the atime == mtime condition that makes the next read
    visible again.
    """
    return current_atime > baseline_atime


def decoy_alert_message(port: int, peer: str) -> str:
    tech = ATTACK_DECOY
    return (f"DECEPTION TRIPPED — decoy service on tcp/{port} was contacted by "
            f"{peer} [{tech[0]} {tech[1]}]. Nothing on this deck legitimately "
            f"listens on tcp/{port}; this connection is unsolicited.")


def canary_alert_message(path: str) -> str:
    tech = ATTACK_CANARY
    return (f"CANARY READ — honeytoken file {path} was opened "
            f"[{tech[0]} {tech[1]}]. No Orion-X process reads this file; "
            "something enumerated the filesystem for credentials.")


class DecoyListener:
    """One accept-and-stall TCP socket. Bounded, local, reply-only."""

    def __init__(self, port: int, on_hit, bind: str = "0.0.0.0",
                 hold: float = DECOY_HOLD_SECONDS,
                 max_conns: int = DECOY_MAX_CONNECTIONS):
        self.port = port
        self.on_hit = on_hit
        self.bind = bind
        self.hold = hold
        self._sem = threading.Semaphore(max_conns)
        self._sock: socket.socket | None = None
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self.hits = 0

    def start(self) -> bool:
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind((self.bind, self.port))
            sock.listen(16)
            sock.settimeout(0.5)
        except OSError:
            return False
        self._sock = sock
        self._stop.clear()
        self._thread = threading.Thread(target=self._serve,
                                        name=f"decoy-{self.port}", daemon=True)
        self._thread.start()
        return True

    def stop(self) -> None:
        self._stop.set()
        if self._sock is not None:
            try:
                self._sock.close()
            except OSError:
                pass
            self._sock = None
        self._thread = None

    def _serve(self) -> None:
        while not self._stop.is_set() and self._sock is not None:
            try:
                conn, addr = self._sock.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            self.hits += 1
            try:
                self.on_hit(self.port, addr[0])
            except Exception:  # noqa: BLE001 - a decoy must never kill the daemon
                pass
            if not self._sem.acquire(blocking=False):
                # At the connection cap: report the hit, then close. Detection
                # is the point; the tarpit is a bonus we decline to pay for.
                try:
                    conn.close()
                except OSError:
                    pass
                continue
            threading.Thread(target=self._hold, args=(conn,),
                             name=f"decoy-{self.port}-conn", daemon=True).start()

    def _hold(self, conn: socket.socket) -> None:
        """Send the banner, then stall. Never reads attacker data into logic."""
        try:
            conn.settimeout(1.0)
            banner = DECOY_BANNERS.get(self.port, "\r\n")
            try:
                conn.sendall(banner.encode("utf-8", errors="replace"))
            except OSError:
                return
            deadline = time.time() + self.hold
            while time.time() < deadline and not self._stop.is_set():
                time.sleep(1.0)
                try:
                    conn.sendall(b"\0")   # keep it warm, reveal nothing
                except OSError:
                    return
        finally:
            try:
                conn.close()
            except OSError:
                pass
            self._sem.release()


class DeceptionField:
    """Tier 2's whole footprint: decoys, canaries, and the runtime nft opening."""

    def __init__(self, canary_dir: Path = CANARY_DIR,
                 ports=DECOY_PORTS, dry_run: bool = False,
                 runner=subprocess.run):
        self.canary_dir = Path(canary_dir)
        self.ports = tuple(ports)
        self.dry_run = dry_run
        self.runner = runner
        self.listeners: list[DecoyListener] = []
        self.baselines: dict[str, float] = {}
        self.armed = False
        self.firewall_open = False

    # --- firewall opening (runtime only, reversible) ---
    def _nft(self, args: list[str]) -> bool:
        if self.dry_run:
            print(f"[dry-run] nft {' '.join(args)}", flush=True)
            return True
        try:
            res = self.runner(["nft", *args], capture_output=True, text=True,
                              timeout=10, check=False)
            return res.returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False

    def open_firewall(self) -> bool:
        ports = ", ".join(str(p) for p in self.ports)
        return self._nft(["insert", "rule", *NFT_TABLE.split(), NFT_CHAIN,
                          "tcp", "dport", "{", ports, "}", "accept",
                          "comment", f'"{NFT_COMMENT}"'])

    def close_firewall(self) -> bool:
        """Delete our rule by handle. Leaves every other rule untouched."""
        if self.dry_run:
            print("[dry-run] nft delete deception rule", flush=True)
            return True
        try:
            res = self.runner(["nft", "-a", "list", "chain", *NFT_TABLE.split(),
                               NFT_CHAIN], capture_output=True, text=True,
                              timeout=10, check=False)
        except (OSError, subprocess.SubprocessError):
            return False
        ok = True
        for line in (res.stdout or "").splitlines():
            if NFT_COMMENT not in line:
                continue
            m = re.search(r"#\s*handle\s+(\d+)", line)
            if m:
                ok = self._nft(["delete", "rule", *NFT_TABLE.split(), NFT_CHAIN,
                                "handle", m.group(1)]) and ok
        return ok

    # --- canaries ---
    def plant_canaries(self) -> list[Path]:
        planted: list[Path] = []
        if self.dry_run:
            return [self.canary_dir / n for n in CANARY_FILES]
        try:
            self.canary_dir.mkdir(parents=True, exist_ok=True)
        except OSError:
            return planted
        for name in CANARY_FILES:
            path = self.canary_dir / name
            try:
                path.write_text(canary_content(name, honeytoken()),
                                encoding="utf-8")
                os.chmod(path, 0o644)
                self.baselines[str(path)] = path.stat().st_atime
                planted.append(path)
            except OSError:
                continue
        return planted

    def remove_canaries(self) -> None:
        if self.dry_run:
            return
        for key in list(self.baselines):
            try:
                Path(key).unlink()
            except OSError:
                pass
            self.baselines.pop(key, None)

    def check_canaries(self) -> list[str]:
        """Return the canaries read since arming, and re-arm each one."""
        tripped: list[str] = []
        for key, baseline in list(self.baselines.items()):
            path = Path(key)
            try:
                atime = path.stat().st_atime
            except OSError:
                continue
            if not canary_tripped(baseline, atime):
                continue
            tripped.append(key)
            try:
                name = path.name
                path.write_text(canary_content(name, honeytoken()),
                                encoding="utf-8")
                self.baselines[key] = path.stat().st_atime
            except OSError:
                self.baselines.pop(key, None)
        return tripped

    # --- lifecycle ---
    def arm(self, on_decoy_hit) -> dict:
        self.firewall_open = self.open_firewall()
        planted = self.plant_canaries()
        bound: list[int] = []
        if not self.dry_run:
            for port in self.ports:
                listener = DecoyListener(port, on_decoy_hit)
                if listener.start():
                    self.listeners.append(listener)
                    bound.append(port)
        else:
            bound = list(self.ports)
        self.armed = True
        return {"ports": bound, "canaries": [str(p) for p in planted],
                "firewall_open": self.firewall_open}

    def disarm(self) -> None:
        for listener in self.listeners:
            listener.stop()
        self.listeners = []
        self.remove_canaries()
        self.close_firewall()
        self.firewall_open = False
        self.armed = False


