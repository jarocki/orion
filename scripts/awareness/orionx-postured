def parse_tier(text: str | None) -> str:
    """Coerce the contents of a threat-posture file to a tier id.

    Default-safe in the paranoid direction that matters here: an unreadable,
    empty, or corrupt file means Tier 0 — never silently arm deception or
    start services because a byte got mangled. Tier 0 is also the tier that
    changes nothing, so a broken file leaves the deck exactly as it booted.
    """
    if text is None:
        return "0"
    val = str(text).strip().splitlines()[0].strip() if str(text).strip() else ""
    return val if val in TIERS else "0"


def posture_candidates(explicit: str | os.PathLike | None = None,
                       home_root: Path = HOME_ROOT,
                       desktop_user: str = DESKTOP_USER,
                       env: dict | None = None) -> list[Path]:
    """Ordered list of places the posture file may live.

    The Control Center writes it as the desktop user; systemd runs this as
    root. Reading root's ~/.config would find nothing forever, so the real
    home directories are searched too.
    """
    env = os.environ if env is None else env
    out: list[Path] = []

    def add(p: Path) -> None:
        if p not in out:
            out.append(p)

    if explicit:
        add(Path(explicit))
    from_env = env.get("ORIONX_POSTURE_FILE")
    if from_env:
        add(Path(from_env))
    add(home_root / desktop_user / POSTURE_RELPATH)
    try:
        for home in sorted(Path(home_root).iterdir()):
            if home.is_dir():
                add(home / POSTURE_RELPATH)
    except OSError:
        pass
    add(Path.home() / POSTURE_RELPATH)
    return out


def pick_posture_file(candidates: list[Path]) -> Path | None:
    """The newest existing candidate, or None.

    Newest wins so that a second operator account cannot pin the deck to a
    stale tier: the most recent deliberate selection is the live one.
    """
    best: Path | None = None
    best_mtime = -1.0
    for path in candidates:
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if mtime > best_mtime:
            best, best_mtime = path, mtime
    return best


def read_tier(path: Path | None) -> str:
    if path is None:
        return "0"
    try:
        return parse_tier(Path(path).read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return "0"


# ===========================================================================
# PURE: does Suricata actually have threat signatures?
# ===========================================================================

# Debian's suricata package ships these in /etc/suricata/rules. They fire on
# malformed packets and protocol violations — useful, but they are not threat
# signatures. A deck carrying only these detects no exploit, no malware, no
# C2 and no scan, which is exactly the blindness this daemon must announce.
STOCK_ANOMALY_RULES = frozenset({
    "app-layer-events.rules", "decoder-events.rules", "dhcp-events.rules",
    "dnp3-events.rules", "dns-events.rules", "files.rules", "ftp-events.rules",
    "http-events.rules", "http2-events.rules", "ike-events.rules",
    "ipsec-events.rules", "kerberos-events.rules", "modbus-events.rules",
    "mqtt-events.rules", "nfs-events.rules", "ntp-events.rules",
    "quic-events.rules", "rfb-events.rules", "smb-events.rules",
    "smtp-events.rules", "ssh-events.rules", "stream-events.rules",
    "tls-events.rules", "tftp-events.rules",
})


def is_threat_rule_file(name: str) -> bool:
    """True if a .rules filename plausibly carries threat signatures.

    Name-based, deliberately: the check must be cheap enough to run on every
    reassert tick, and the distinction being drawn (stock anomaly set vs.
    everything else) is exactly a naming convention in both Debian's package
    and the ET-Open tarball.
    """
    base = os.path.basename(str(name))
    if not base.endswith(".rules"):
        return False
    if base in STOCK_ANOMALY_RULES:
        return False
    return not base.endswith("-events.rules")


def assess_rules(entries: list[tuple[str, int]]) -> dict:
    """Classify a list of (path, size_bytes) rule files.

    Returns {"threat_files", "threat_bytes", "anomaly_files", "usable"}.
    `usable` means at least one non-empty threat-signature file — the only
    condition under which Tier 1 or Tier 2 can honestly claim IDS coverage.
    """
    threat = [(p, n) for p, n in entries if is_threat_rule_file(p)]
    anomaly = [(p, n) for p, n in entries if not is_threat_rule_file(p)]
    threat_bytes = sum(n for _p, n in threat)
    return {
        "threat_files": len(threat),
        "threat_bytes": threat_bytes,
        "anomaly_files": len(anomaly),
        "usable": any(n > 0 for _p, n in threat),
    }


def scan_rule_dirs(dirs=RULES_DIRS) -> list[tuple[str, int]]:
    """Side-effecting companion to assess_rules(): stat the real rule dirs."""
    entries: list[tuple[str, int]] = []
    for d in dirs:
        try:
            for f in sorted(Path(d).iterdir()):
                if f.name.endswith(".rules"):
                    try:
                        entries.append((f.name, f.stat().st_size))
                    except OSError:
                        entries.append((f.name, 0))
        except OSError:
            continue
    return entries


def no_rules_message(tier: str, status: dict) -> str:
    """The loud one. Names the blindness, its consequence, and the remedy."""
    return (
        f"IDS COVERAGE GAP — {TIER_LABEL.get(tier, 'Tier ' + tier)} is active but "
        f"Suricata has NO threat rules "
        f"({status['threat_files']} signature file(s), "
        f"{status['anomaly_files']} stock protocol-anomaly file(s)). "
        "Exploits, malware, C2 and scans will NOT be detected — this deck is "
        "not watching, it is only listening to itself. "
        "Remedy: sudo orionx-freshen-suricata (requires network access). "
        "Port-scan detection via orionx-scanwatch is unaffected and still works."
