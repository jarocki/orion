def zeek_attack_technique(note: str | None) -> tuple[str, str]:
    """ATT&CK technique for a Zeek notice type, or ("", "") when unmapped."""
    return ATTACK_BY_ZEEK_NOTE.get(str(note or ""), ("", ""))


def is_zeek_scan_notice(note: str | None) -> bool:
    """True for the Zeek notices that describe a scan of this deck.

    Prefix match on the Scan:: namespace rather than an exact list, so a
    site-local Scan::Something policy is deduplicated too.
    """
    return str(note or "").startswith("Scan::")


def parse_zeek_notice(rec: dict | None) -> dict | None:
    """Normalise a notice.log record into this daemon's alert shape."""
    if not isinstance(rec, dict):
        return None
    note = rec.get("note")
    if not note:
        return None
    actions = rec.get("actions") or ""
    if isinstance(actions, list):
        actions = ",".join(str(a) for a in actions)
    return {
        "note": str(note),
        "msg": str(rec.get("msg") or ""),
        "sub": str(rec.get("sub") or ""),
        "src_ip": str(rec.get("src") or rec.get("id.orig_h") or ""),
        "dest_ip": str(rec.get("dst") or rec.get("id.resp_h") or ""),
        "dest_port": rec.get("p") or rec.get("id.resp_p"),
        "proto": str(rec.get("proto") or ""),
        "actions": str(actions),
    }


def zeek_notice_severity(alert: dict) -> str:
    """Bus severity for a Zeek notice, honouring Zeek's own escalation.

    A site that attached Notice::ACTION_ALARM to a type has said explicitly
    that this one matters here. Respecting that is how local policy reaches
    the operator without this table having to know about it.
    """
    sev = ZEEK_NOTE_SEVERITY.get(alert.get("note", ""), "notice")
    if "ACTION_ALARM" in alert.get("actions", "") and sev == "notice":
        return "warning"
    return sev


def zeek_dedup_key(alert: dict) -> tuple:
    return ("zeek", alert.get("note", ""), alert.get("src_ip", ""),
            alert.get("dest_port"))


def format_zeek_message(alert: dict, technique: tuple[str, str]) -> str:
    note = alert.get("note") or "Zeek notice"
    src = alert.get("src_ip") or "?"
    dst = alert.get("dest_ip") or "?"
    dport = alert.get("dest_port")
    dst_s = f"{dst}:{dport}" if dport else dst
    tech = f" [{technique[0]} {technique[1]}]" if technique[0] else ""
    msg = alert.get("msg") or ""
    detail = f" — {msg}" if msg else ""
    blind = ""
    if note in ZEEK_BLINDNESS_NOTES:
        blind = (" — THIS IS A SENSOR PROBLEM, NOT A QUIET NETWORK: Zeek is "
                 "reporting it is missing traffic.")
    return f"Zeek {note}{tech}: {src} → {dst_s}{detail}{blind}"


class WeirdAggregator:
    """weird.log is a firehose; this turns a burst into one honest event.

    Zeek's weird.log records every protocol oddity it sees, and on a real
    network that is thousands of lines an hour of things nobody should be
    paged about. Forwarding them one-for-one would drown notice.log's actual
    detections on the shared bus, which would make the bus less useful than
    before Zeek was ingested at all.

    So a weird type is only published once it BURSTS: `burst` occurrences of
    the same (name, source) inside `window`. That keeps the ordinary drip
    silent while a protocol being actively abused or mangled still surfaces.
    Bounded, like every other table in this daemon.
    """

    def __init__(self, window: float = ZEEK_WEIRD_WINDOW,
                 burst: int = ZEEK_WEIRD_BURST,
                 reannounce: float = ZEEK_WEIRD_REANNOUNCE,
                 max_keys: int = ZEEK_MAX_WEIRD_KEYS):
        self.window = window
        self.burst = burst
        self.reannounce = reannounce
        self.max_keys = max_keys
        # (name, src) -> {"hits": [ts...], "last_alert": ts}
        self._keys: OrderedDict[tuple[str, str], dict] = OrderedDict()

    def observe(self, name: str, src: str, now: float) -> dict | None:
        if not name:
            return None
        key = (name, src or "")
        st = self._keys.get(key)
        if st is None:
            if len(self._keys) >= self.max_keys:
                self._keys.popitem(last=False)
            st = {"hits": [], "last_alert": 0.0}
            self._keys[key] = st
        self._keys.move_to_end(key)
        st["hits"].append(now)
        cutoff = now - self.window
        while st["hits"] and st["hits"][0] < cutoff:
            st["hits"].pop(0)
        if len(st["hits"]) < self.burst:
            return None
        if (now - st["last_alert"]) < self.reannounce:
            return None
        st["last_alert"] = now
        count = len(st["hits"])
        st["hits"].clear()
        return {"name": name, "src": src or "?", "count": count,
                "window": self.window}

    def tracked(self) -> int:
        return len(self._keys)


def format_weird_message(burst: dict) -> str:
    return (f"Zeek protocol anomaly burst: {burst['count']}x "
            f"{burst['name']} from {burst['src']} in "
            f"{burst['window']:.0f}s (weird.log)")


def zeek_blind(conn_records: int, watch_started: float, now: float,
               threshold: float = ZEEK_LIVENESS_SECONDS) -> bool:
    """True when Zeek has been watched long enough to expect SOMETHING.

    Zeek tailing a live log directory that produces zero connection records
    for ten minutes is the Suricata-with-no-rules failure wearing a different
    hat: it looks exactly like a calm network from the operator's chair. The
    conn.log count is the cheapest honest liveness signal available, which is
    the only thing conn.log is used for here.
    """
    if watch_started <= 0:
        return False
    return conn_records == 0 and (now - watch_started) >= threshold


