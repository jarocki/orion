class PostureDaemon:
    def __init__(self, args):
        self.args = args
        self.dry_run = bool(args.dry_run)
        self.posture_path = pick_posture_file(
            posture_candidates(args.posture_file))
        self.rules_dirs = [Path(d) for d in (args.rules_dir or RULES_DIRS)]
        self.eve_path = Path(args.eve)
        self.state: dict | None = None
        self.rules = assess_rules(scan_rule_dirs(self.rules_dirs))
        self.deduper = AlertDeduper()
        self.scan_sources: set[str] = set()
        self._scan_refreshed = 0.0
        self.last_no_rules_warn = 0.0
        self.no_rules_announced = False
        self.tailer = EveTailer(self.eve_path, on_line=self._on_eve_line)
        self.deception = DeceptionField(Path(args.canary_dir),
                                        dry_run=self.dry_run)
        self.nebula = Contextualizer(dry_run=self.dry_run)
        if args.no_nebula:
            self.nebula = None
        self.alerts_published = 0
        self.alerts_suppressed = 0

    # --- bus helper ---
    def emit(self, severity: str, category: str, message: str,
             source: str = "postured") -> None:
        publish(severity, source, category, message, dry_run=self.dry_run)

    # --- rules ---
    def refresh_rules(self) -> None:
        self.rules = assess_rules(scan_rule_dirs(self.rules_dirs))

    def warn_no_rules(self, tier: str, now: float) -> None:
        """Say it loudly, say it first, and keep saying it.

        Escalation is inverted on purpose: the FIRST announcement is critical
        because the operator has just armed a tier believing they gained
        coverage they do not have — that is the moment the truth matters most.
        Repeats drop to warning so a permanently air-gapped deck nags rather
        than screams, but it never stops nagging and never goes silent.
        """
        first = not self.no_rules_announced
        if not first and (now - self.last_no_rules_warn) < NO_RULES_REANNOUNCE:
            return
        self.no_rules_announced = True
        self.last_no_rules_warn = now
        self.emit(NO_RULES_FIRST if first else NO_RULES_REPEAT, "ids",
                  no_rules_message(tier, self.rules))

    # --- eve ingest ---
    def _refresh_scan_sources(self, now: float) -> None:
        if (now - self._scan_refreshed) < 10.0:
            return
        self._scan_refreshed = now
        self.scan_sources = scan_sources_from_bus(tail_bus_lines(), now)

    def _on_eve_line(self, line: str) -> None:
        alert = parse_eve_line(line)
        if alert is None:
            return
        now = time.time()
        self._refresh_scan_sources(now)
        if should_suppress(alert, self.scan_sources):
            # orionx-scanwatch already reported this source from the firewall
            # drop log. One scan is one story.
            self.alerts_suppressed += 1
            return
        if not self.deduper.should_publish(dedup_key(alert), now):
            return
        technique = attack_technique(alert.get("classtype"),
                                     alert.get("signature"))
        # Publish FIRST. The model is never in the path of a detection.
        self.emit(bus_severity(alert), "ids",
                  format_alert_message(alert, technique), source="suricata")
        self.alerts_published += 1
        if self.nebula is not None and bus_severity(alert) in ("warning",
                                                               "critical"):
            self.nebula.offer(alert, technique)

    # --- deception callbacks ---
    def _on_decoy_hit(self, port: int, peer: str) -> None:
        self.emit("critical", "deception", decoy_alert_message(port, peer))

    def _check_canaries(self) -> None:
        if not self.deception.armed:
            return
        for path in self.deception.check_canaries():
            self.emit("critical", "deception", canary_alert_message(path))

    # --- apply ---
    def execute(self, actions: list[tuple], tier: str) -> list[str]:
        done: list[str] = []
        now = time.time()
        for action in actions:
            kind = action[0]
            if kind == "gate":
                set_gate(action[1] == "create", dry_run=self.dry_run)
            elif kind == "service":
                systemctl(action[1], action[2], dry_run=self.dry_run)
            elif kind == "eve":
                if action[1] == "start":
                    self.tailer.start()
                    if self.nebula is not None:
                        self.nebula.start()
                else:
                    self.tailer.stop()
                    if self.nebula is not None:
                        self.nebula.stop()
            elif kind == "deception":
                if action[1] == "arm":
                    info = self.deception.arm(self._on_decoy_hit)
                    ports = ", ".join(f"tcp/{p}" for p in info["ports"])
                    self.emit("warning", "deception",
                              f"Tier 2 deception ARMED — decoys on {ports or 'none'}, "
                              f"{len(info['canaries'])} canary file(s) in "
                              f"{self.deception.canary_dir}. Local and "
                              "non-destructive: nothing is sent to any other host.")
                    if not info["firewall_open"]:
                        self.emit("warning", "deception",
                                  "Deception decoys are listening but the firewall "
                                  "opening FAILED — the base DROP policy will absorb "
                                  "probes before they reach a decoy. Canary files "
                                  "are unaffected. Check `nft list ruleset`.")
                else:
                    self.deception.disarm()
                    self.emit("notice", "deception",
                              "Tier 2 deception disarmed — decoys closed, canaries "
                              "removed, runtime firewall opening deleted.")
            elif kind == "warn":
                self.warn_no_rules(tier, now)
            done.append(":".join(str(a) for a in action))
        return done

    def write_status(self) -> None:
        """Runtime truth for the Cockpit: what is actually enforced, right now."""
        if self.dry_run or self.state is None:
            return
        payload = {
            "ts": time.time(),
            "tier": self.state["tier"],
            "label": self.state["label"],
            "ids_expected": self.state["suricata"],
            "ids_active": (service_active(SURICATA_UNIT)
                           if self.state["suricata"] else False),
            "rules_usable": self.rules["usable"],
            "threat_rule_files": self.rules["threat_files"],
            "anomaly_rule_files": self.rules["anomaly_files"],
            "deception_armed": self.deception.armed,
            "alerts_published": self.alerts_published,
            "alerts_suppressed": self.alerts_suppressed,
            "posture_file": str(self.posture_path or ""),
        }
        try:
            STATUS_FILE.parent.mkdir(parents=True, exist_ok=True)
            tmp = STATUS_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(payload), encoding="utf-8")
            os.replace(tmp, STATUS_FILE)
        except OSError:
            pass

    def apply_tier(self, tier: str) -> list[str]:
        self.refresh_rules()
        plan = tier_plan(tier, self.rules["usable"])
        actions = plan_actions(self.state, plan)
        if self.state is None or self.state["tier"] != plan["tier"]:
            self.emit("notice", "posture",
                      f"Posture enforcement: {plan['label']} — "
                      f"suricata={'on' if plan['suricata'] else 'off'}, "
                      f"eve-ingest={'on' if plan['eve_ingest'] else 'off'}, "
                      f"deception={'armed' if plan['deception'] else 'off'}")
        done = self.execute(actions, plan["tier"])
        self.state = plan
        self.write_status()
        return done

    def run(self) -> int:
        last_reassert = 0.0
        last_canary = 0.0
        tier = "0"
        try:
            while True:
                self.posture_path = pick_posture_file(
                    posture_candidates(self.args.posture_file))
                new_tier = read_tier(self.posture_path)
                now = time.time()
                if self.state is None or new_tier != self.state["tier"]:
                    tier = new_tier
                    self.apply_tier(tier)
                    last_reassert = now
                elif (now - last_reassert) >= REASSERT_SECONDS:
                    last_reassert = now
                    # Drift check: enforcement is continuous, not one-shot. If
                    # something stopped Suricata behind our back, the tier is a
                    # lie until we put it back — and we say so.
                    self.refresh_rules()
                    if self.state["suricata"] and not service_active(SURICATA_UNIT):
                        self.emit("warning", "ids",
                                  f"Suricata is not running while {self.state['label']} "
                                  "is selected — restarting it.")
                        set_gate(True, dry_run=self.dry_run)
                        systemctl("start", SURICATA_UNIT, dry_run=self.dry_run)
                    if self.state["suricata"] and not self.rules["usable"]:
                        self.warn_no_rules(self.state["tier"], now)
                    self.write_status()
                if (now - last_canary) >= CANARY_POLL_SECONDS:
                    last_canary = now
                    self._check_canaries()
                time.sleep(self.args.poll)
        except KeyboardInterrupt:
            pass
        finally:
            if self.deception.armed:
                self.deception.disarm()
            self.tailer.stop()
            if self.nebula is not None:
                self.nebula.stop()
        return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="orionx-postured",
        description="Enforce the Orion-X threat-posture tier and publish "
                    "AI-contextualised IDS detections onto the R.A.I.N. bus.",
    )
    ap.add_argument("--posture-file", default=None,
                    help="explicit threat-posture file (default: auto-discover)")
    ap.add_argument("--eve", default=str(EVE_JSON),
                    help="Suricata eve.json path (default: %(default)s)")
    ap.add_argument("--rules-dir", action="append", default=None,
                    help="rules directory to assess (repeatable)")
    ap.add_argument("--canary-dir", default=str(CANARY_DIR),
                    help="Tier 2 canary directory (default: %(default)s)")
    ap.add_argument("--poll", type=float, default=POLL_SECONDS,
                    help="posture poll interval in seconds (default: %(default)s)")
    ap.add_argument("--no-nebula", action="store_true",
                    help="disable the Nebula contextualizer entirely")
    ap.add_argument("--dry-run", action="store_true",
                    help="print actions and events instead of performing them")
    ap.add_argument("--once", action="store_true",
                    help="apply the current tier once and exit")
    ap.add_argument("--print-plan", action="store_true",
                    help="print the JSON plan for the current tier and exit")
    args = ap.parse_args(argv)

    daemon = PostureDaemon(args)
    tier = read_tier(daemon.posture_path)

    if args.print_plan:
        plan = tier_plan(tier, daemon.rules["usable"])
        print(json.dumps({"posture_file": str(daemon.posture_path or ""),
                          "rules": daemon.rules, "plan": plan}, indent=2))
        return 0

    if args.once:
        done = daemon.apply_tier(tier)
        print(f"tier={tier} actions={done or ['none']}", flush=True)
        return 0

    return daemon.run()


if __name__ == "__main__":
    sys.exit(main())
