#!/usr/bin/env python3
"""
Nebula AI — CLI dispatcher.

Usage:
    nebula --version
    nebula --help
    nebula status [--json]
    nebula warmup

Subcommands landing in later slices (W10-2+):
    nebula chat [--pcap <file>]
    nebula tools
    nebula audit verify

The dispatcher is designed to boot fast and print --version / --help
WITHOUT importing ollama or any heavy runtime dep.  Only the subcommand
implementations import their deps lazily.

@decision DEC-PHASE10-008
@title nebula CLI dispatcher: stdlib-only bootstrap, lazy subcommand import
@status accepted
@rationale The CLI must not fail with ImportError when ollama-python is absent
  (it is optional in W10-1; mandatory only from W10-2 onward).  Lazy import
  inside each subcommand function keeps the top-level boot path clean.
  References: DEC-PHASE10-008, DEC-PHASE10-010, DEC-PHASE9-019.

@decision DEC-PHASE9-019
@title from __future__ import annotations required in all Phase 10 Python modules
@status accepted
"""
from __future__ import annotations

import argparse
import os
import sys

# ---------------------------------------------------------------------------
# Version — single constant; no import needed at version-print time.
# ---------------------------------------------------------------------------
_VERSION = "0.1.0"
_NEBULA_BANNER = "nebula (Orion-X Nebula AI CLI) v" + _VERSION

# Transport for the confined MCP tool server (DEC-PHASE12-025). Kept as a
# literal so --help works without importing mcp_server; mcp_server.DEFAULT_SOCKET
# is the authority and test_mcp_confinement.sh asserts the two agree.
_MCP_SOCKET = "/run/nebula-mcp/nebula-mcp.sock"


def _ensure_package_on_path() -> None:
    """Add scripts/ parent to sys.path so ``import nebula`` works when the
    CLI is invoked via the /usr/bin/nebula symlink pointing to the file at
    /opt/orionx/scripts/nebula/nebula (i.e. not installed as a proper package).
    """
    # __file__ is  .../scripts/nebula/nebula
    # parent      is  .../scripts/nebula/
    # parent.parent is .../scripts/
    this_dir = os.path.dirname(os.path.realpath(__file__))
    scripts_dir = os.path.dirname(this_dir)
    if scripts_dir not in sys.path:
        sys.path.insert(0, scripts_dir)


# ---------------------------------------------------------------------------
# Subcommand handlers
# ---------------------------------------------------------------------------

def cmd_version(_args: argparse.Namespace) -> int:
    """Print version and exit 0 — no imports needed."""
    print(_NEBULA_BANNER)
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    """Print runtime status.  Imports status.py lazily."""
    _ensure_package_on_path()
    try:
        from nebula.status import collect_status  # noqa: PLC0415
    except ImportError as exc:
        print(f"ERROR: cannot import nebula.status: {exc}", file=sys.stderr)
        return 1

    import json  # noqa: PLC0415
    data = collect_status(probe_daemon=not getattr(args, "offline", False))
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
    else:
        print(data["status_summary"])
        if data["integrity_state"] not in ("OK", "UNKNOWN"):
            print(f"  Integrity detail: {data['integrity_detail']}")
        if data["ollama_version"]:
            print(f"  ollama version:   {data['ollama_version']}")
    return 0


def cmd_warmup(_args: argparse.Namespace) -> int:
    """Trigger a 1-token inference warm-up.  Imports warmup.py lazily."""
    _ensure_package_on_path()
    try:
        from nebula.warmup import run_warmup  # noqa: PLC0415
    except ImportError as exc:
        print(f"ERROR: cannot import nebula.warmup: {exc}", file=sys.stderr)
        return 1

    success = run_warmup()
    if success:
        print("Warm-up complete.")
        return 0
    print("Warm-up failed — check logs at /var/log/orionx/nebula-warmup.log", file=sys.stderr)
    return 1


def cmd_chat(args: argparse.Namespace) -> int:
    """Chat with the local model (W10-2).  Imports chat.py lazily."""
    _ensure_package_on_path()
    try:
        from nebula.chat import run_cli  # noqa: PLC0415
    except ImportError as exc:
        print(f"ERROR: cannot import nebula.chat: {exc}", file=sys.stderr)
        return 1

    prompt = " ".join(args.prompt) if args.prompt else None
    return run_cli(prompt=prompt, pcap=args.pcap, session_id=args.session)


def cmd_tools(args: argparse.Namespace) -> int:
    """List local MCP tools, or run the MCP server (W10-3). Lazy import."""
    _ensure_package_on_path()
    if getattr(args, "serve", False):
        try:
            from nebula.mcp_server import serve_stdio, serve_unix  # noqa: PLC0415
        except ImportError as exc:
            print(f"ERROR: cannot import nebula.mcp_server: {exc}", file=sys.stderr)
            return 1
        # DEC-PHASE12-025: the unix socket is the transport used under
        # confinement (PrivateNetwork=yes makes a port impossible and stdio
        # requires the client to be the parent). stdio stays for direct use.
        sock = getattr(args, "socket", None)
        if sock:
            return serve_unix(sock)
        return serve_stdio()

    try:
        from nebula.mcp_server import list_tools  # noqa: PLC0415
    except ImportError as exc:
        print(f"ERROR: cannot import nebula.mcp_server: {exc}", file=sys.stderr)
        return 1

    import json  # noqa: PLC0415
    tools = list_tools()
    if getattr(args, "json", False):
        print(json.dumps(tools, indent=2))
        return 0
    print("Nebula MCP tools (local, sandboxed):")
    for t in tools:
        flag = " (active)" if t["active"] else ""
        avail = "" if t["available"] else "  [not installed]"
        print(f"  {t['name']}{flag} — {t['description']}{avail}")
    return 0


def cmd_ask(args: argparse.Namespace) -> int:
    """Ask the model a question it may answer by running a local tool.

    DEC-PHASE12-025: the model chooses; the confined server's static registry
    decides what is choosable. --tool bypasses the model entirely and is the
    only path that may confirm an "active" tool.
    """
    _ensure_package_on_path()
    try:
        from nebula.toolchat import run_cli  # noqa: PLC0415
    except ImportError as exc:
        print(f"ERROR: cannot import nebula.toolchat: {exc}", file=sys.stderr)
        return 1

    tool_args: dict[str, str] = {}
    for pair in (args.arg or []):
        key, sep, value = pair.partition("=")
        if not sep:
            print(f"ERROR: --arg expects key=value, got {pair!r}", file=sys.stderr)
            return 2
        tool_args[key] = value

    prompt = " ".join(args.prompt) if args.prompt else ""
    if not prompt and not args.tool:
        print("ERROR: give a question, or --tool <name>", file=sys.stderr)
        return 2

    return run_cli(
        prompt=prompt,
        socket_path=args.socket,
        max_steps=args.max_steps,
        tool=args.tool,
        tool_args=tool_args,
        allow_active=args.allow_active,
    )


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="nebula",
        description="Nebula AI — Orion-X autonomous forensic intelligence CLI.",
        epilog=(
            "Additional subcommands (chat, tools, audit) land in W10-2+.\n"
            "Docs: /usr/share/doc/orionx/User_Guide.md"
        ),
    )
    parser.add_argument(
        "--version",
        action="store_true",
        help="Print version and exit.",
    )

    subparsers = parser.add_subparsers(dest="subcommand", metavar="<subcommand>")

    # nebula status
    sp_status = subparsers.add_parser(
        "status",
        help="Show Nebula runtime status (ollama daemon, integrity, model).",
    )
    sp_status.add_argument(
        "--json",
        action="store_true",
        help="Output full status as JSON.",
    )
    sp_status.add_argument(
        "--offline",
        action="store_true",
        help=(
            "Skip the ollama loopback probe and report only file-derived facts. "
            "Used by the confined MCP tool server, which has no loopback."
        ),
    )

    # nebula warmup
    subparsers.add_parser(
        "warmup",
        help="Run a 1-token inference to warm the model into RAM (opt-in).",
    )

    # nebula chat (W10-2)
    sp_chat = subparsers.add_parser(
        "chat",
        help="Chat with the local Nebula model (private, on-device).",
    )
    sp_chat.add_argument(
        "prompt",
        nargs="*",
        help="One-shot prompt; omit for an interactive session.",
    )
    sp_chat.add_argument(
        "--pcap",
        metavar="FILE",
        help="Attach a packet capture as context for the conversation.",
    )
    sp_chat.add_argument(
        "--session",
        metavar="ID",
        help="Resume or continue a named session id (default: new timestamped session).",
    )

    # nebula tools (W10-3)
    sp_tools = subparsers.add_parser(
        "tools",
        help="List the local MCP tools Nebula can use (or --serve the MCP server).",
    )
    sp_tools.add_argument("--json", action="store_true", help="Output the tool list as JSON.")
    sp_tools.add_argument(
        "--serve",
        action="store_true",
        help="Run the MCP tool server over stdio (JSON-RPC 2.0).",
    )
    sp_tools.add_argument(
        "--socket",
        metavar="PATH",
        nargs="?",
        const=_MCP_SOCKET,
        default=None,
        help=f"With --serve: listen on a unix socket instead of stdio (default: {_MCP_SOCKET}).",
    )

    # nebula ask (W10-3 model-in-the-loop, DEC-PHASE12-025)
    sp_ask = subparsers.add_parser(
        "ask",
        help="Ask the local model a question it may answer by running a local tool.",
    )
    sp_ask.add_argument("prompt", nargs="*", help="The question to ask.")
    sp_ask.add_argument(
        "--socket", metavar="PATH", default=_MCP_SOCKET,
        help="Unix socket of the confined MCP tool server (default: %(default)s).",
    )
    sp_ask.add_argument(
        "--max-steps", type=int, default=4, metavar="N",
        help="Maximum tool calls the model may make for one question (default: %(default)s).",
    )
    sp_ask.add_argument(
        "--tool", metavar="NAME",
        help="Run one tool directly, bypassing the model (operator invocation).",
    )
    sp_ask.add_argument(
        "--arg", action="append", metavar="KEY=VALUE",
        help="Argument for --tool; repeatable.",
    )
    sp_ask.add_argument(
        "--allow-active", action="store_true",
        help=(
            "Confirm an ACTIVE tool. Only valid with --tool: the model can never "
            "invoke an active tool on its own initiative."
        ),
    )

    # nebula version (as a subcommand, mirrors --version)
    subparsers.add_parser(
        "version",
        help="Print version and exit.",
    )

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)

    if args.version or args.subcommand == "version":
        return cmd_version(args)

    if args.subcommand == "status":
        return cmd_status(args)

    if args.subcommand == "warmup":
        return cmd_warmup(args)

    if args.subcommand == "chat":
        return cmd_chat(args)

    if args.subcommand == "tools":
        return cmd_tools(args)

    if args.subcommand == "ask":
        return cmd_ask(args)

    # No subcommand given — print help and exit 0
    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
