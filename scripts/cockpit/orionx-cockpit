    sys.exit(1)

FPS_MS = 160          # ~6 fps redraw
POLL_EVENTS_MS = 500
POLL_NET_MS = 1000
POLL_SYS_MS = 5000
POLL_VITALS_MS = 2000      # deck vitals (DEC-PHASE12-049): two /proc/stat samples apart
ICON = "/usr/share/pixmaps/orionx.png"
FONT = "Hack"         # fonts-hack-otf is in the image; cairo falls back if absent

_DEMO_MSGS = [
    ("info", "health", "service", "Nebula AI recovered: running"),
    ("notice", "posture", "posture", "Threat posture changed to Tier 1 · Active"),
    ("warning", "suricata", "ids", "ET SCAN Nmap SYN scan 10.0.0.5 -> 10.0.0.12"),
    ("critical", "suricata", "ids", "ET MALWARE Cobalt Strike beacon 10.0.0.12 -> 45.13.7.9"),
    ("notice", "mesh", "peer", "peer orionx-3 handshake 12s ago"),
    ("warning", "auth", "ssh", "3 failed logins for root from 192.168.4.77"),
    ("info", "rain", "audio", "cue played: warning"),
    ("critical", "health", "service", "Firewall degraded: inactive"),
]


class Cockpit(Gtk.Window):
    def __init__(self, fullscreen: bool = False, demo: bool = False, tab: str = "live") -> None:
        super().__init__(title="Orion Cockpit")
        # UX-17: 760 px was taller than a 1366x768 deck minus panel and title
        # bar (~701 px). Open maximised; the default only applies when the
        # operator un-maximises.
        self.set_default_size(1280, 680)
        if not fullscreen:
            self.maximize()
        try:
            self.set_icon_from_file(ICON)
        except Exception:
            pass
        self._fs = False
        self.demo = demo

        self.da = Gtk.DrawingArea()
        # DEC-PHASE12-053: one tabbed window. LIVE is the Cairo dashboard; the
        # other tabs are the Control Center's sections, built from CC.SECTIONS.
        CC.install_css()
        self.nb = Gtk.Notebook()
        self.nb.set_tab_pos(Gtk.PositionType.LEFT)
        self.nb.append_page(self.da, CC.tab_label("LIVE", "utilities-system-monitor-symbolic"))
        self._pages = {"live": 0}
        self._pages.update(CC.append_sections(self.nb))
        self.toast_bar = CC.ToastBar()
        CCUX.set_notifier(self.toast_bar.notify)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.pack_start(self.nb, True, True, 0)
        root.pack_start(self.toast_bar, False, False, 0)
        self.add(root)
        self.da.connect("draw", self._draw)
        self.connect("key-press-event", self._on_key)
        self.da.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.SCROLL_MASK)
        self.da.connect("scroll-event", self._on_scroll)
        self.da.connect("button-press-event", self._on_click)
        self.connect("destroy", Gtk.main_quit)

        # --- live state ---
        self.tail = L.EventTail()
        self.rates = L.RateTracker()
        self.pressure_target = 0.0
        self.pressure_shown = 0.0
        self.flash = 0.0                    # 1.0 on a new warning/critical, decays
        self.systems = {"NEBULA": False, "FIREWALL": False, "MESH": False, "R.A.I.N.": False}
        self.vitals: dict = {}
        self._cpu_prev = None
        self.posture = "0"
        self.posture_status: dict = {}
        # Drill-down + approval state (DEC-PHASE12-029).
        self.sel = -1                  # index into the displayed event list; -1 = none
        self.scroll = 0                # rows scrolled back from newest (0 = live)
        self.drill = False             # detail overlay open
        self.heal: dict = {"readable": False, "pending": [], "active": [], "reason": ""}
        self.heal_sel = 0
        self.drill_scroll = 0          # first drill-down row shown
        self._approve_rect: tuple[float, float, float, float] | None = None
        self._close_rect: tuple[float, float, float, float] | None = None
        self._shown: list = []         # events as last drawn, so keys and clicks agree
        self.t0 = time.time()

        GLib.timeout_add(FPS_MS, self._tick)
        GLib.timeout_add(POLL_EVENTS_MS, self._poll_events)
        GLib.timeout_add(POLL_NET_MS, self._poll_net)
        self._sys_poller = Poller(self.da, POLL_SYS_MS, self._collect_sys, self._apply_sys)
        self._vitals_poller = Poller(self.da, POLL_VITALS_MS, self._collect_vitals, self._apply_vitals)
        if demo:
            GLib.timeout_add(1400, self._demo_event)
        self._poll_events()
        self._poll_net()
        if fullscreen:
            self.fullscreen()
            self._fs = True
        # GtkNotebook refuses to switch to a page whose child is not visible yet,
        # and nothing is visible until main() calls show_all(); selecting here
        # silently left every --tab launch (and the menu's "Network tab" entry)
        # on LIVE. show_all() then select_tab() (QA round 1, lead).
        self._initial_tab = tab

    def select_tab(self, tab: str) -> bool:
        """Switch to a tab by key; True when the notebook is now on it."""
        if tab not in self._pages:
            return False
        self.nb.set_current_page(self._pages[tab])
        return self.nb.get_current_page() == self._pages[tab]

    # ------------------------------------------------------------------ polling
    def _poll_events(self) -> bool:
        for ev in self.tail.poll():
            if ev["severity"] in ("warning", "critical"):
                self.flash = 1.0
        self.pressure_target = L.pressure(self.tail.events, time.time())
        return True

    def _demo_event(self) -> bool:
        sev, src, cat, msg = random.choice(_DEMO_MSGS)
        ev = {"ts": time.time(), "severity": sev, "source": src, "category": cat, "message": msg}
        self.tail.events.append(ev)
        if sev in ("warning", "critical"):
            self.flash = 1.0
        self.pressure_target = L.pressure(self.tail.events, time.time())
        return True

    def _poll_net(self) -> bool:
        rx, tx = L.read_net_bytes()
        if self.demo:  # synthesize a lively but plausible waveform
            t = time.time() - self.t0
            rx += int((math.sin(t / 3.0) + 1.3) * 40_000 * t)
            tx += int((math.cos(t / 5.0) + 1.1) * 12_000 * t)
        self.rates.push(rx, tx, time.time())
        return True

    def _collect_sys(self, _visible: bool) -> dict:
        """Worker thread: every probe that forks or reads root-published state."""
        systems = {}
        systems["NEBULA"] = L.service_active("nebula-runtime.service")
        systems["FIREWALL"] = L.service_active("orionx-firewall.service")
        # DEC-PHASE12-067: the snapshot verdict, as on every other surface.
        # None = unknown (stale / no snapshot), drawn amber, never as ONLINE.
        _now = time.time()
        _ms = MD.mesh_summary(MD.load_snapshot(now=_now), _now)["state"]
        systems["MESH"] = {"active": True, "down": False}.get(_ms)
        systems["R.A.I.N."] = L.process_running("orionx-rain")
        if self.demo:
            systems = {"NEBULA": True, "FIREWALL": True, "MESH": True, "R.A.I.N.": True}
        # DEC-PHASE12-024: what the tier is ENFORCING, not just what it is set
        # to. Empty dict when orionx-postured is not running.
        return {"systems": systems, "posture": L.posture_tier(),
                "posture_status": L.posture_status(), "heal": L.healing_actions()}

    def _apply_sys(self, d: dict | None, err) -> None:
        if err is not None:
            self._say(f"\u2717 status probes failed: {err}", "error")
            return
        self.systems.update(d["systems"])
        self.posture, self.posture_status, self.heal = d["posture"], d["posture_status"], d["heal"]

    def _collect_vitals(self, _visible: bool) -> dict:
        return V.collect(self._cpu_prev)

    def _apply_vitals(self, v: dict | None, err) -> None:
        if err is None and v:
            self._cpu_prev = v.get("cpu_sample")
            self.vitals = v

    def _tick(self) -> bool:
        self.pressure_shown = L.lerp(self.pressure_shown, self.pressure_target, 0.15)
        self.flash = max(0.0, self.flash - 0.07)
        if self.da.get_mapped():
            self.da.queue_draw()
        return True

    def _on_key(self, _w, ev) -> bool:
        name = Gdk.keyval_name(ev.keyval) or ""
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        alt = bool(ev.state & Gdk.ModifierType.MOD1_MASK)
        if ctrl and name in ("q", "Q"):
            Gtk.main_quit()
            return True
        if alt and name.isdigit() and 1 <= int(name) <= self.nb.get_n_pages():
            self.nb.set_current_page(int(name) - 1)      # UX-20: a key route to every tab
            return True
        if ctrl:
            return False   # Ctrl+PgUp/PgDn etc. belong to GTK (tab switching)
        on_live = self.nb.get_current_page() == self._pages.get("live", 0)
        if name == "F11" or (name == "Escape" and self._fs and not (on_live and self.drill)):
            if self._fs:
                self.unfullscreen()
            else:
                self.fullscreen()
            self._fs = not self._fs
            return True
        if not on_live:
            return False   # GTK tabs own their keys; 's'/'t' must not fire inside a text field
        if name == "Escape":
            if self.drill:
                self.drill = False
                self.da.queue_draw()
            return True
        if self.drill:
            if name in ("s", "t"):
                self._tune_selected("squelch" if name == "s" else "tune")
            elif name in ("Page_Down", "Next", "Down", "j"):
                self.drill_scroll += 8 if name in ("Page_Down", "Next") else 1
            elif name in ("Page_Up", "Prior", "Up", "k"):
                self.drill_scroll = max(0, self.drill_scroll - (8 if name in ("Page_Up", "Prior") else 1))
            elif name in ("Return", "KP_Enter"):
                self.drill = False
            self.da.queue_draw()
            return True

        if name in ("Page_Up", "Prior"):
            self.scroll += 10
            self.da.queue_draw()
            return True
        if name in ("Page_Down", "Next"):
            self.scroll = max(0, self.scroll - 10)
            self.da.queue_draw()
            return True
        if name == "Home":
            self.scroll = 0          # back to live
            self.da.queue_draw()
            return True

        n = len(self._shown)
        if name in ("Up", "k") and n:
            self.sel = (self.sel - 1) % n if self.sel >= 0 else 0
            self.da.queue_draw()
            return True
        if name in ("Down", "j") and n:
            self.sel = (self.sel + 1) % n if self.sel >= 0 else 0
            self.da.queue_draw()
            return True
        if name in ("Return", "KP_Enter") and 0 <= self.sel < n:
            self.drill, self.drill_scroll = True, 0
            self.da.queue_draw()
            return True
        if name in ("Tab", "Right", "Left") and self.heal["pending"]:
            self.heal_sel = (self.heal_sel + 1) % len(self.heal["pending"])
            self.da.queue_draw()
            return True
        if name in ("a", "A"):
            self._approve_selected()
            return True
        return False

    def _on_scroll(self, _w, ev) -> bool:
        d = getattr(ev, "direction", None)
        if d == Gdk.ScrollDirection.UP:
            self.scroll += 3
        elif d == Gdk.ScrollDirection.DOWN:
            self.scroll = max(0, self.scroll - 3)
        else:
            return False
        self.da.queue_draw()
        return True

    # ------------------------------------------------------------- approval
    def _approve_selected(self) -> None:
        pend = self.heal["pending"]
        if not pend:
            self._say("nothing awaiting approval")
            return
        rec = pend[self.heal_sel % len(pend)]
        aid = str(rec.get("id", ""))
        self._say(f"approving {aid}\u2026", "info")

        def _done(res, err) -> None:
            ok, msg = res if err is None else (False, f"approval failed: {err}")
            self._say(msg, "ok" if ok else "error")
            # Re-read rather than assume it worked: heald's next snapshot is
            # the authority on whether the action left pending.
            self._sys_poller.kick()
        run_async(lambda: L.approve_action(aid), _done)

    def _tune_selected(self, mode: str) -> None:
        """[s]quelch for an hour / [t]une for good, via orionx-tune (DEC-PHASE12-050)."""
        if not (0 <= self.sel < len(self._shown)):
            self._say("no event selected")
            return
        ev = self._shown[self.sel]

        def _done(res, err) -> None:
            ok, msg = res if err is None else (False, str(err))
            self._say(msg if ok else f"NOT tuned: {msg}", "ok" if ok else "error")
        run_async(lambda: L.tune_event(ev, mode), _done)

    def _say(self, msg: str, level: str = "info") -> None:
        """UX-37: one toast system. LIVE outcomes go to the same ToastBar as the
        tabs (wraps, selectable, errors stay until dismissed, logged)."""
        self.toast_bar.notify(msg, level)

    def _on_click(self, _w, ev) -> bool:
        if self.drill:
            c = self._close_rect
            if c and c[0] <= ev.x <= c[0] + c[2] and c[1] <= ev.y <= c[1] + c[3]:
                self.drill = False
                self.da.queue_draw()
                return True
            return True          # modal: swallow clicks behind the overlay
        r = self._approve_rect
        if r and r[0] <= ev.x <= r[0] + r[2] and r[1] <= ev.y <= r[1] + r[3]:
            self._approve_selected()
            return True
        # Click an event row to select it; double-click opens the drill-down.
        for i, (ry, rh) in enumerate(getattr(self, "_row_rects", [])):
            if ry <= ev.y <= ry + rh:
                self.sel = i
                if getattr(ev, "type", None) is not None and int(ev.type) == int(Gdk.EventType._2BUTTON_PRESS):
                    self.drill, self.drill_scroll = True, 0
                self.da.queue_draw()
                return True
        return False

    # ------------------------------------------------------------------ drawing
    def _draw(self, da, cr) -> bool:
        W = da.get_allocated_width()
        H = da.get_allocated_height()
        self._background(cr, W, H)
        lay = L.live_layout(W, H)
        self._header(cr, W, lay["header"][3])
        # Every panel is clipped to its own rectangle (UX-17): nothing a panel
        # draws can land on its neighbour or below the window.
        for name, fn in (("events", self._events_panel), ("deck", self._deck_panel),
                         ("actions", self._actions_panel), ("gauge", self._gauge_panel),
                         ("net", self._net_panel), ("systems", self._systems_panel)):
            x, y, w, h = lay[name]
            if w <= 0 or h <= 0:
                continue
            cr.save()
            cr.rectangle(x - 2, y - 2, w + 4, h + 4)
            cr.clip()
            fn(cr, x, y, w, h)
            cr.restore()

        if self.flash > 0.0:  # visual twin of the R.A.I.N. cue
            cr.set_source_rgba(*L.RED, 0.16 * self.flash)
            cr.rectangle(0, 0, W, H)
            cr.fill()

        # Overlay last so it sits above every panel.
        if self.drill:
            self._drill_overlay(cr, W, H)
        return False

    # --- primitives ---
    def _font(self, cr, size, bold=False):
        cr.select_font_face(FONT, cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(max(L.MIN_FONT, size))     # UX-22: nothing below 11 px

    def _fit(self, cr, s, size, max_w, bold=False) -> str:
        """`s` ellipsised to fit `max_w` px in this font, measured by cairo."""
        self._font(cr, size, bold)
        return L.ellipsize(str(s).translate(self._NO_GLYPH), max_w, lambda t: cr.text_extents(t).x_advance)

    # Hack (the panel font) has no glyph for these; cairo's toy text API does
    # not fall back, so they rendered as empty boxes (headless render, QA r1).
    _NO_GLYPH = str.maketrans({"\u26a0": "!", "\u2715": "X", "\u2717": "x", "\u2713": "+"})

    def _text(self, cr, x, y, s, size=12.0, color=L.DIM, bold=False, align="left", glow=0.0, max_w=None):
        s = str(s).translate(self._NO_GLYPH)
        if max_w is not None:
            s = self._fit(cr, s, size, max_w, bold)
        self._font(cr, size, bold)
        ext = cr.text_extents(s)
        if align == "right":
            x -= ext.x_advance
        elif align == "center":
            x -= ext.x_advance / 2
        if glow > 0:
            cr.move_to(x, y)
            cr.text_path(s)
            cr.set_source_rgba(*color, 0.35 * glow)
            cr.set_line_width(3.0)
            cr.stroke()
        cr.move_to(x, y)
        cr.set_source_rgb(*color)
        cr.show_text(s)
        # show_text leaves a current point; without this the next cr.arc()
        # drew a stray line from the end of the text (the gauge's diagonal
        # streak in the headless render).
        cr.new_path()
        return ext.x_advance

    @staticmethod
    def _rrect(cr, x, y, w, h, r=8.0):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def _panel(self, cr, x, y, w, h, title):
        self._rrect(cr, x, y, w, h)
        cr.set_source_rgba(0.04, 0.05, 0.07, 0.82)
        cr.fill_preserve()
        cr.set_source_rgba(*L.EMBER, 0.35)
        cr.set_line_width(1.0)
        cr.stroke()
        # corner accents
        cr.set_source_rgba(*L.EMBER, 0.9)
        cr.set_line_width(2.0)
        for (cx, cy, dx, dy) in ((x, y, 1, 1), (x + w, y, -1, 1), (x, y + h, 1, -1), (x + w, y + h, -1, -1)):
            cr.move_to(cx + dx * 14, cy)
            cr.line_to(cx, cy)
            cr.line_to(cx, cy + dy * 14)
            cr.stroke()
        self._text(cr, x + 14, y + 20, title, 11, L.EMBER, bold=True, glow=0.6)
        return (x + 14, y + 34, w - 28, h - 46)   # content box

    # --- background: gradient + grid + scanline sweep ---
    def _background(self, cr, W, H):
        g = cairo.LinearGradient(0, 0, 0, H)
        g.add_color_stop_rgb(0, *L.BG_TOP)
        g.add_color_stop_rgb(1, *L.BG_BOTTOM)
        cr.set_source(g)
        cr.rectangle(0, 0, W, H)
        cr.fill()
        cr.set_source_rgba(*L.GRID, 0.22)
        cr.set_line_width(1.0)
        for gx in range(0, W, 40):
            cr.move_to(gx + 0.5, 0)
            cr.line_to(gx + 0.5, H)
        for gy in range(0, H, 40):
            cr.move_to(0, gy + 0.5)
            cr.line_to(W, gy + 0.5)
        cr.stroke()
        # scanline sweep
        t = time.time() - self.t0
        sy = (t * 60.0) % (H + 80) - 40
        band = cairo.LinearGradient(0, sy - 40, 0, sy + 40)
        band.add_color_stop_rgba(0, *L.EMBER, 0.0)
        band.add_color_stop_rgba(0.5, *L.EMBER, 0.07)
        band.add_color_stop_rgba(1, *L.EMBER, 0.0)
        cr.set_source(band)
        cr.rectangle(0, sy - 40, W, 80)
        cr.fill()

    # --- header ---
    def _header(self, cr, W, h):
        cr.set_source_rgba(*L.EMBER, 0.5)
        cr.set_line_width(1.0)
        cr.move_to(16, h + 0.5)
        cr.line_to(W - 16, h + 0.5)
        cr.stroke()
        self._text(cr, 22, 38, "ORION-X", 22, L.EMBER, bold=True, glow=1.0)
        self._text(cr, 22 + 118, 38, "//  COCKPIT", 16, L.DIM)
        v = self.vitals or {}
        who = " \u00b7 ".join(s for s in (v.get("hostname"), v.get("primary_ipv4")) if s)
        # posture badge — DEC-PHASE12-024: a tier that cannot detect says so.
        label, badge_state = L.posture_badge(self.posture, self.posture_status)
        col = {"0": L.GREEN, "1": L.AMBER, "2": L.RED}.get(self.posture, L.GREEN)
        if badge_state in ("warn", "blind"):
            col = L.RED
        bw = 300 if badge_state != "ok" else 220
        bx = W - 16 - 180 - bw - 16
        if who:
            # UX-18: measured and ellipsised so it can never overdraw the badge.
            self._text(cr, 22 + 118 + 150, 38, who, 13, L.DIM, max_w=bx - 8 - (22 + 118 + 150))
        self._rrect(cr, bx, 14, bw, 30, 6)
        cr.set_source_rgba(*col, 0.12)
        cr.fill_preserve()
        cr.set_source_rgba(*col, 0.8)
        cr.set_line_width(1.0)
        cr.stroke()
        self._text(cr, bx + bw / 2, 34, label, 12, col, bold=True, align="center", glow=0.8)
        # clock
        self._text(cr, W - 22, 38, time.strftime("%a %d %b  %H:%M:%S"), 15, L.DIM, align="right")

    # --- event stream ---
    def _events_panel(self, cr, x, y, w, h):
        cx, cy, cw, ch = self._panel(cr, x, y, w, h, "EVENT STREAM  \u00b7  /run/orionx/events.jsonl")
        cr.save()
        cr.rectangle(cx, cy, cw, ch)
        cr.clip()
        row_h = 22
        rows = max(0, int(ch // row_h))
        # Scrollback. self.scroll counts rows back from the newest event; 0
        # keeps the panel live. Clamped here rather than in the key handler so
        # it can never point past the buffer after events age out.
        allev = list(self.tail.events)[::-1]            # newest first
        maxoff = max(0, len(allev) - rows)
        if self.scroll > maxoff:
            self.scroll = maxoff
        events = allev[self.scroll:self.scroll + rows]
        # The selection is an index into exactly what is on screen. Keeping the
        # drawn list and the row geometry means keyboard and mouse can never
        # disagree about which event the operator means.
        self._shown = events
        self._row_rects = []
        now = time.time()
        if not events:
            # UX-43: an info event, so the hint does not sound R.A.I.N.
            self._text(cr, cx + cw / 2, cy + ch / 2, "\u2014 no events yet \u2014 publish one with: orionx-event -s info 'hello' \u2014",
                       12, L.DIM, align="center", max_w=cw - 8)
        # Columns: dot | age | SEV word (UX-23) | source/category | message.
        x_age, x_sev, x_src, x_msg = cx + 20, cx + 54, cx + 98, cx + 250
        for i, ev in enumerate(events):
            ry = cy + i * row_h + 16
            self._row_rects.append((ry - 16, row_h))
            hint_w = 0.0
            if i == self.sel:
                cr.set_source_rgba(*L.AMBER, 0.14)
                cr.rectangle(cx, ry - 16, cw, row_h)
                cr.fill()
                if ev.get("detail"):
                    hint_w = self._text(cr, cx + cw - 6, ry, "\u21b5 detail", 11, L.AMBER, align="right") + 12
            age = now - ev["ts"] if ev["ts"] else 0
            fade = L.fade_for(age)                       # UX-21: floor 0.6
            col = L.SEVERITY_COLOR.get(ev["severity"], L.DIM)
            cr.set_source_rgba(*col, 0.25 * fade)
            cr.arc(cx + 8, ry - 4, 6, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgba(*col, fade)
            cr.arc(cx + 8, ry - 4, 3.2, 0, 2 * math.pi)
            cr.fill()
            self._text(cr, x_age, ry, f"{L.fmt_age(age):>3}", 11, tuple(c * fade for c in L.DIM))
            self._text(cr, x_sev, ry, L.SEVERITY_TAG.get(ev["severity"], "NOTE"), 11, tuple(c * fade for c in col), bold=True)
            tag = "SELF " if (ev.get("detail") or {}).get("origin") == "self" else ""
            self._text(cr, x_src, ry, f"{tag}{ev['source']}/{ev['category']}", 11, tuple(c * fade for c in col),
                       bold=True, max_w=x_msg - x_src - 8)
            # UX-16: fitted to the room actually left, with an ellipsis; the
            # drill-down shows it whole.
            self._text(cr, x_msg, ry, ev["message"], 11.5, tuple(c * fade for c in (0.9, 0.9, 0.9)),
                       max_w=max(0.0, cx + cw - x_msg - hint_w - 6))
        cr.restore()

    # --- defensive / deceptive actions + APPROVE (DEC-PHASE12-029) ---
    def _actions_panel(self, cr, x, y, w, h):
        """What the deck has done, and what it is waiting to be allowed to do.

        The auto-healing engine parks an action as `pending` whenever the
        operator set that class to `confirm`. Before this panel, that decision
        was visible only to `orionx-heal pending` on a terminal — so the deck
        could be holding a block-this-host decision while the dashboard the
        operator was actually watching said nothing.
        """
        cx, cy, cw, ch = self._panel(cr, x, y, w, h, "DEFENSIVE ACTIONS")
        cr.save()
        cr.rectangle(cx, cy, cw, ch)
        cr.clip()
        self._approve_rect = None
        pend = self.heal.get("pending", [])
        act = self.heal.get("active", [])

        if not self.heal.get("readable", False):
            # Never render an empty list here: "no pending actions" and "I
            # could not look" must not look the same on a defensive dashboard.
            self._text(cr, cx + 8, cy + 20, "state unknown \u2014 " + (self.heal.get("reason") or "no snapshot"),
                       11, L.AMBER)
            self._text(cr, cx + 8, cy + 38, "check: systemctl status orionx-heald  \u00b7  sudo orionx-heal status", 11, L.DIM)
            cr.restore()
            return

        ry = cy + 18
        if self.heal.get("chain_ok") is False:
            self._text(cr, cx + 8, ry, "\u26a0 audit chain does not verify \u2014 sudo orionx-heal verify", 11, L.RED, bold=True)
            ry += 18
        if pend:
            rec = pend[self.heal_sel % len(pend)]
            self._text(cr, cx + 8, ry, f"AWAITING APPROVAL  ({len(pend)})", 11, L.RED, bold=True)
            ry += 20
            self._text(cr, cx + 8, ry,
                       f"{rec.get('action','?')} \u2192 {rec.get('target','?')}", 12,
                       (0.95, 0.95, 0.95), max_w=cw - 16)
            ry += 12
            bw, bh = 104.0, 26.0
            bx, by = cx + 8, ry
            cr.set_source_rgba(*L.RED, 0.22)
            self._rrect(cr, bx, by, bw, bh, 6.0)
            cr.fill()
            cr.set_source_rgba(*L.RED, 0.95)
            cr.set_line_width(1.2)
            self._rrect(cr, bx, by, bw, bh, 6.0)
            cr.stroke()
            self._text(cr, bx + bw / 2, by + 17, "APPROVE?", 11.5, L.RED, bold=True, align="center")
            self._approve_rect = (bx, by, bw, bh)
            self._text(cr, bx + bw + 10, by + 17, f"[a]  Tab: next  \u00b7  id {rec.get('id','')}", 11, L.DIM,
                       max_w=cw - bw - 26)
            ry += bh + 20
        else:
            self._text(cr, cx + 8, ry, "nothing awaiting approval", 11, L.DIM)
            ry += 20

        if act:
            # The first action shares the header line, so IN FORCE is never
            # pushed off the panel by a pending approval; the rest fill the
            # remaining rows, and what does not fit is counted, not dropped.
            now = time.time()

            def _line(rec):
                exp = rec.get("expires_ts")
                left = f"  (reverts in {L.fmt_age(exp - now)})" if exp and exp > now else ""
                return f"{rec.get('action','?')} \u2192 {rec.get('target','?')}{left}"
            hw = self._text(cr, cx + 8, ry, f"IN FORCE ({len(act)}): ", 11, L.AMBER, bold=True)
            self._text(cr, cx + 8 + hw, ry, _line(act[0]), 11, (0.85, 0.85, 0.85), max_w=cw - 16 - hw)
            ry += 15
            rest = act[1:]
            fit = max(0, int((cy + ch - ry + 4) // 15))
            for i, rec in enumerate(rest[:fit]):
                more = len(rest) - fit
                txt = (f"+{more + 1} more \u2014 sudo orionx-heal status" if i == fit - 1 and more > 0
                       else "\u2022 " + _line(rec))
                self._text(cr, cx + 8, ry, txt, 11, (0.85, 0.85, 0.85), max_w=cw - 16)
                ry += 15
        cr.restore()

    # --- drill-down overlay ---
    def _drill_overlay(self, cr, W, H):
        """The answer to "why did that fire?" — source, signature, evidence.

        Everything comes from the event's structured detail (DEC-PHASE12-029),
        wrapped to the overlay width and paged with PgUp/PgDn (UX-19): nothing
        is cut. An event without detail says so plainly.
        """
        if not (0 <= self.sel < len(self._shown)):
            return
        ev = self._shown[self.sel]
        pad = 40.0
        w = min(820.0, W - pad * 2)
        h = min(470.0, H - pad * 2)
        x = (W - w) / 2
        y = (H - h) / 2
        cr.set_source_rgba(0, 0, 0, 0.72)
        cr.rectangle(0, 0, W, H)
        cr.fill()
        cr.set_source_rgba(0.05, 0.06, 0.07, 0.98)
        self._rrect(cr, x, y, w, h, 10.0)
        cr.fill()
        col = L.SEVERITY_COLOR.get(ev["severity"], L.DIM)
        cr.set_source_rgba(*col, 0.9)
        cr.set_line_width(1.4)
        self._rrect(cr, x, y, w, h, 10.0)
        cr.stroke()
        cr.save()
        cr.rectangle(x, y, w, h)
        cr.clip()

        self._text(cr, x + 18, y + 28, "EVENT DETAIL", 12, col, bold=True)
        # A clickable [X]; "Esc" alone is not discoverable with a mouse.
        bx, by, bs = x + w - 34.0, y + 14.0, 22.0
        cr.set_source_rgba(*col, 0.18)
        self._rrect(cr, bx, by, bs, bs, 4.0)
        cr.fill()
        cr.set_source_rgba(*col, 0.9)
        cr.set_line_width(1.1)
        self._rrect(cr, bx, by, bs, bs, 4.0)
        cr.stroke()
        self._text(cr, bx + bs / 2, by + 16, "\u2715", 12, col, bold=True, align="center")
        self._close_rect = (bx, by, bs, bs)
        self._text(cr, x + w - 44, y + 28, "Esc", 11, L.DIM, align="right")
        self._text(cr, x + 18, y + 50,
                   f"{ev['severity'].upper()}  {ev['source']}/{ev['category']}",
                   11, col, max_w=w - 36)

        # Rows: the whole message, then every detail field, wrapped.
        self._font(cr, 11.5)
        cwid = max(1.0, cr.text_extents("0123456789").x_advance / 10.0)
        val_x = x + 190
        rows = L.drill_rows(ev, int((x + w - 18 - val_x) / cwid))
        line_h = 16
        top, bottom = y + 72, y + h - 34
        per_page = max(1, int((bottom - top) // line_h))
        self.drill_scroll = max(0, min(self.drill_scroll, max(0, len(rows) - per_page)))
        for n, (label, text) in enumerate(rows[self.drill_scroll:self.drill_scroll + per_page]):
            ry = top + n * line_h
            if label == "message" or (not label and n + self.drill_scroll < len(rows) and
                                      all(lb in ("message", "") for lb, _t in rows[:n + self.drill_scroll + 1])):
                self._text(cr, x + 18, ry, text, 11.5, (0.93, 0.93, 0.93), max_w=w - 36)
            else:
                if label:
                    self._text(cr, x + 18, ry, label, 11, L.DIM, max_w=val_x - x - 26)
                self._text(cr, val_x, ry, text, 11, (0.9, 0.9, 0.9), max_w=x + w - 18 - val_x)
        if not (ev.get("detail") or {}):
            ry = top + min(len(rows), per_page) * line_h + 8
            self._text(cr, x + 18, ry, "This event carries no structured detail.", 11, L.AMBER)
            self._text(cr, x + 18, ry + 18, "Its emitter has not been updated to publish evidence yet.", 11, L.DIM)
        foot = []
        if len(rows) > per_page:
            last = min(len(rows), self.drill_scroll + per_page)
            foot.append(f"rows {self.drill_scroll + 1}\u2013{last} of {len(rows)}  PgUp/PgDn")
        if L.tune_args(ev, "squelch") is not None:
            foot.append("[s] squelch this signature 1 h  [t] tune it off for good \u2014 the outcome says whether it survives a reboot")
        elif (ev.get("detail") or {}).get("origin") == "self":
            foot.append("SELF: this deck's own traffic")
        if foot:
            self._text(cr, x + 18, y + h - 14, "    ".join(foot), 11, L.AMBER, max_w=w - 36)
        cr.restore()

    # --- deck identity + vitals (DEC-PHASE12-049) ---
    def _deck_panel(self, cr, x, y, w, h):
        cx, cy, cw, ch = self._panel(cr, x, y, w, h, "DECK")
        v = self.vitals or {}
        if not v:
            self._text(cr, cx, cy + 20, "reading\u2026", 11, L.DIM)
            return
        parts = []
        if v.get("hostname"):
            parts.append(v["hostname"])
        for it in v.get("interfaces") or []:
            if it["ipv4"]:
                parts.append(f"{it['iface']} {it['ipv4'][0].split('/')[0]}")
        if v.get("gateway"):
            parts.append(f"gw {v['gateway']}" + (f" ({v['gateway_dev']})" if v.get("gateway_dev") else ""))
        elif v.get("interfaces") is not None:
            parts.append("no default route")
        parts.append("up " + V.fmt_uptime(v.get("uptime_s")))
        line = "  \u00b7  ".join(parts)
        self._text(cr, cx, cy + 16, line, 11.5, (0.9, 0.9, 0.9), max_w=cw)
        # three bars: CPU, MEM, DISK — each labelled with the number, not just a colour
        mem = v.get("mem") or {}
        dsk = v.get("disk") or {}
        load = v.get("load")
        bars = [
            ("CPU", v.get("cpu_pct"),
             (f"{v['cpu_pct']:.0f}%" if v.get("cpu_pct") is not None else "\u2014")
             + (f"  load {load[0]:.2f}" if load else "")
             + (f"  {v['cpu_count']} cpu" if v.get("cpu_count") else "")),
            ("MEM", mem.get("used_pct"),
             (f"{mem['used_pct']:.0f}%  {V.fmt_bytes((mem['total_kib'] - mem['available_kib']) * 1024)} of {V.fmt_bytes(mem['total_kib'] * 1024)}"
              if mem.get("used_pct") is not None else "\u2014")),
            ("DISK", dsk.get("used_pct"),
             (f"{dsk['used_pct']:.0f}%  {V.fmt_bytes(dsk['free_bytes'])} free on {dsk['path']}"
              if dsk.get("used_pct") is not None else "\u2014")),
        ]
        bw = (cw - 24) / 3.0
        by = cy + 46
        for i, (name, pct, label) in enumerate(bars):
            bx = cx + i * (bw + 12)
            col = L.DIM if pct is None else (L.RED if pct >= 90 else L.AMBER if pct >= 75 else L.GREEN)
            self._text(cr, bx, by, name, 11, L.DIM, bold=True)
            self._text(cr, bx + 40, by, label, 11, (0.85, 0.85, 0.85), max_w=bw - 40)
            self._rrect(cr, bx, by + 8, bw, 8, 3)
            cr.set_source_rgba(*L.DIM, 0.25)
            cr.fill()
            if pct is not None:
                self._rrect(cr, bx, by + 8, max(2.0, bw * min(100.0, pct) / 100.0), 8, 3)
                cr.set_source_rgba(*col, 0.85)
                cr.fill()

    # --- threat gauge ---
    def _gauge_panel(self, cr, x, y, w, h):
        cx0, cy0, cw, ch = self._panel(cr, x, y, w, h, "THREAT PRESSURE")
        p = self.pressure_shown
        col = L.pressure_color(p)
        cxm = cx0 + cw / 2
        # The arc spans r above the centre and r*sin(45 deg) below it; size it
        # to the box minus the caption row so nothing overlaps (UX-17).
        r = max(12.0, min(cw * 0.42, (ch - 20) / 1.72))
        cym = cy0 + r + 2
        a0 = math.radians(135)
        a1 = math.radians(405)
        # track
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(12)
        cr.set_source_rgba(1, 1, 1, 0.06)
        cr.arc(cxm, cym, r, a0, a1)
        cr.stroke()
        # value arc: glow + core
        a_val = a0 + (a1 - a0) * (p / 100.0)
        cr.set_line_width(18)
        cr.set_source_rgba(*col, 0.22)
        cr.arc(cxm, cym, r, a0, a_val)
        cr.stroke()
        cr.set_line_width(8)
        cr.set_source_rgb(*col)
        cr.arc(cxm, cym, r, a0, a_val)
        cr.stroke()
        # ticks
        cr.set_line_width(1.5)
        for i in range(0, 11):
            a = a0 + (a1 - a0) * i / 10
            cr.set_source_rgba(*L.DIM, 0.6)
            cr.move_to(cxm + math.cos(a) * (r - 18), cym + math.sin(a) * (r - 18))
            cr.line_to(cxm + math.cos(a) * (r - 24), cym + math.sin(a) * (r - 24))
            cr.stroke()
        # needle
        cr.set_source_rgba(*col, 0.9)
        cr.set_line_width(2.5)
        cr.move_to(cxm, cym)
        cr.line_to(cxm + math.cos(a_val) * (r - 30), cym + math.sin(a_val) * (r - 30))
        cr.stroke()
        cr.arc(cxm, cym, 5, 0, 2 * math.pi)
        cr.fill()
        # readout
        self._text(cr, cxm, cym - 10, f"{int(round(p))}", 34, col, bold=True, align="center", glow=1.0)
        band = "CALM" if p < 25 else "ELEVATED" if p < 60 else "HOSTILE"
        self._text(cr, cxm, cym + 14, band, 12, col, bold=True, align="center")
        self._text(cr, cxm, cy0 + ch - 4, "severity-weighted · 60s half-life", 11, L.DIM, align="center", max_w=cw)

    # --- network sparkline ---
    def _net_panel(self, cr, x, y, w, h):
        cx, cy, cw, ch = self._panel(cr, x, y, w, h, "NETWORK")
        graph_h = ch - 22
        vmax = max(max(self.rates.rx_hist), max(self.rates.tx_hist), 1024.0)
        for hist, col in ((self.rates.rx_hist, L.CYAN), (self.rates.tx_hist, L.EMBER)):
            pts = L.sparkline_points(hist, cx, cy, cw, graph_h, vmax)
            if len(pts) < 2:
                continue
            # area
            cr.move_to(pts[0][0], cy + graph_h)
            for px, py in pts:
                cr.line_to(px, py)
            cr.line_to(pts[-1][0], cy + graph_h)
            cr.close_path()
            cr.set_source_rgba(*col, 0.12)
            cr.fill()
            # line
            cr.move_to(*pts[0])
            for px, py in pts[1:]:
                cr.line_to(px, py)
            cr.set_source_rgba(*col, 0.95)
            cr.set_line_width(1.8)
            cr.stroke()
        self._text(cr, cx, cy + ch - 4, f"↓ {L.fmt_rate(self.rates.rx_rate)}", 12, L.CYAN, bold=True)
        self._text(cr, cx + cw, cy + ch - 4, f"↑ {L.fmt_rate(self.rates.tx_rate)}", 12, L.EMBER, bold=True, align="right")

    # --- systems LEDs ---
    def _systems_panel(self, cr, x, y, w, h):
        cx, cy, cw, ch = self._panel(cr, x, y, w, h, "SYSTEMS")
        items = list(self.systems.items())
        col_w = cw / max(1, len(items))
        pulse = 0.75 + 0.25 * math.sin((time.time() - self.t0) * 2.0)
        # UX-17: LED and its two words on ONE row, inside the panel at the
        # SYSTEMS_MIN_H floor (they used to sit 13 px below its bottom edge).
        ly = cy + max(14.0, ch / 2)
        for i, (name, ok) in enumerate(items):
            lx = cx + col_w * i + 14
            col = L.GREEN if ok else L.AMBER if ok is None else L.RED
            cr.set_source_rgba(*col, (0.35 if ok else 0.2) * pulse)
            cr.arc(lx, ly, 12, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(*col)
            cr.arc(lx, ly, 5, 0, 2 * math.pi)
            cr.fill()
            room = col_w - 34
            self._text(cr, lx + 18, ly - 2, name, 11, L.DIM if ok else col, bold=True, max_w=room)
            self._text(cr, lx + 18, ly + 13, "ONLINE" if ok else "UNKNOWN" if ok is None else "DOWN", 11, col, max_w=room)

def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="orionx-cockpit",
                                 description="Orion-X live cockpit — see the cyber activity around you.")
    ap.add_argument("--fullscreen", action="store_true", help="start fullscreen (F11 toggles)")
    ap.add_argument("--demo", action="store_true", help="synthesize events/traffic for a live demo")
    ap.add_argument("--tab", default="live", choices=CC.TAB_KEYS,
                    help="open on this tab (DEC-PHASE12-053): " + ", ".join(CC.TAB_KEYS))
    args = ap.parse_args(argv)
    try:
        win = Cockpit(fullscreen=args.fullscreen, demo=args.demo, tab=args.tab)
    except Exception as exc:  # no display, etc.
        print(f"orionx-cockpit: cannot open a window ({exc}). Is DISPLAY set?", file=sys.stderr)
        return 1
    win.show_all()
    if not win.select_tab(win._initial_tab):
        print(f"orionx-cockpit: could not open on tab {win._initial_tab!r}", file=sys.stderr)
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
