#!/usr/bin/env python3
"""
orionx-control-center — a launcher that says where each control went.

Usage:
  orionx-control-center [--help] [--version] [--where] [--tab KEY]

Symlinked to /usr/bin/orionx-control-center by 0700-orionx-setup.hook.chroot.
The separate window it used to open is gone (DEC-PHASE12-053), and so are its
controls (#95, DEC-PHASE13-049, control_center/moved.py): KEY is a Cockpit
tab, or a moved control (posture, rain, theme, dj -> the Cockpit settings
drawer; healing, warmup, installers -> the Workbench), whose new home it
opens after saying where it went. It stays one release so old habits land
somewhere true, then goes.
--version reports the image's own /etc/orionx-version (UX-40 / P3-1: it
printed a hard-coded "2.0.0-rc5-w9-2" on 2.2.0).

@decision DEC-PHASE10-005
@title Control Center ships ahead of Phase 10 Nebula AI
@status accepted
@rationale Phase 9 W9-2 locks the UI surface.  Nebula AI and Auto-Healing
  sections are discoverable placeholders in this slice; Phase 10 slices
  plug their runtime in without inventing new windows.

@decision DEC-PHASE9-019
@title Bullseye Python 3.9 + PEP-563 (from __future__ import annotations)
@status accepted
@rationale All shipped Python in Phase 9 / Phase 10 must start with
  `from __future__ import annotations` as the first import to guarantee
  forward-compatible annotation evaluation under Python 3.9 (Debian
  Bullseye default) and enable ruff PEP-563 enforcement (DEC-PHASE9-020).
"""
from __future__ import annotations

import argparse
import os
import sys

VERSION_FILE = os.environ.get("ORIONX_VERSION_FILE", "/etc/orionx-version")


def image_version(path: str = VERSION_FILE) -> str:
    """ISO_VERSION from the image manifest (0700 hook is its only writer)."""
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("ISO_VERSION="):
                    return line.split("=", 1)[1].strip() or "unknown"
    except OSError as exc:
        return f"unknown ({path}: {exc.strerror or exc} — not running from an Orion-X image?)"
    return f"unknown (no ISO_VERSION in {path})"


def _scripts_dir() -> str:
    # MUST use os.path.realpath (not os.path.abspath): abspath does NOT
    # resolve symlinks — it returns the symlink path itself. When invoked
    # as /usr/bin/orionx-control-center (symlink → /opt/orionx/scripts/
    # control_center/orionx-control-center), abspath gives script_dir=/usr/bin
    # and scripts_dir=/, putting the wrong directory on sys.path and causing
    # ModuleNotFoundError: No module named 'control_center' (#66). realpath
    # resolves the symlink chain to the actual file. (rc8 fix, DEC-PHASE10-017)
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


if _scripts_dir() not in sys.path:
    sys.path.insert(0, _scripts_dir())
from control_center import moved  # noqa: E402  (no GTK: --help and --where need no display)


def _parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="orionx-control-center",
        description=(
            "A launcher. Opens the Orion Cockpit on a tab (network, mesh, comms, "
            "awareness, tools, nebula), or the new home of a control that moved (#95)."
        ),
        epilog=moved.where_text(),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {image_version()}",
    )
    # DEC-PHASE12-053: the tabs live in the Orion Cockpit; this is a launcher.
    parser.add_argument("--tab", default=None,
                        help="a Cockpit tab (network, mesh, comms, awareness, tools, nebula) "
                             "or a moved control from the list below")
    parser.add_argument("--where", action="store_true", help="print where every moved control lives, then exit")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    """Parse args, then launch the GTK application.

    Returns
    -------
    int
        Exit code (0 on success).
    """
    args_list = argv if argv is not None else sys.argv[1:]
    args = _parse_args(args_list)
    if args.where:
        print(moved.where_text())
        return 0

    from control_center.app import run_app  # noqa: PLC0415  (imports GTK)

    return run_app(["orionx-control-center"] + list(args_list))


if __name__ == "__main__":
    sys.exit(main())
