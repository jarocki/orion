#!/usr/bin/env python3
"""orionx-dj — a small GTK3 DJ deck for the Orion-X generative techno bed.

@decision DEC-PHASE12-044

Six faders, four patterns, a transport, and one lamp that matters more than
the rest of it put together: ALERT GATE. It is green while the music is
allowed to be heard, and red the instant R.A.I.N. wants the room. The faders
are built by iterating orionx_synth.CONTROLS, so a knob cannot exist on this
deck without being a real synthesis parameter.

This is a cyberdeck accessory, not a DAW. It fits in a 420x560 window, it
starts stopped, and closing it stops the music and releases the sound card.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import orionx_synth as synth     # noqa: E402

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk, Pango
except (ImportError, ValueError) as exc:   # pragma: no cover - needs no GTK to test
    sys.stderr.write(
        "orionx-dj: GTK 3 bindings are unavailable (%s)\n"
        "  consequence: the graphical deck cannot open; the music itself is fine\n"
        "  remedy     : sudo apt-get install --no-install-recommends "
        "python3-gi gir1.2-gtk-3.0\n"
        "               or run it headless: orionx-music play\n" % exc)
    raise SystemExit(1)

CSS = b"""
window, #deck { background-color: #0b0f14; }
label { color: #c7d4e1; font-family: "DejaVu Sans Mono", monospace; }
#title { color: #39ff88; font-size: 15px; font-weight: bold; letter-spacing: 2px; }
#value { color: #39ff88; font-size: 12px; }
#knob { color: #7f93a8; font-size: 10px; letter-spacing: 1px; }
#status { color: #7f93a8; font-size: 10px; }
#degraded { color: #ff6b4a; font-size: 10px; }
#gate_ok { color: #0b0f14; background-color: #39ff88; font-weight: bold;
           padding: 4px 10px; border-radius: 3px; }
#gate_ducked { color: #0b0f14; background-color: #ff4a4a; font-weight: bold;
               padding: 4px 10px; border-radius: 3px; }
scale trough { background-color: #182230; min-height: 5px; }
scale highlight { background-color: #2f7fa8; }
button { background-image: none; background-color: #182230; color: #c7d4e1;
         border: 1px solid #27374a; padding: 5px 12px; }
button:checked { background-color: #39ff88; color: #0b0f14; font-weight: bold; }
"""


class DJDeck(Gtk.Window):
    """The deck. Owns one SynthEngine and one MusicPlayer, nothing else."""

    REFRESH_MS = 100

    def __init__(self) -> None:
        super().__init__(title="Orion-X DJ Deck")
        self.set_name("deck")
        self.set_default_size(420, 560)
        self.set_resizable(False)

        self.state = synth.load_config()
        self.guard = synth.AlertGuard()
        self.guard.poll()
        self.engine = synth.SynthEngine(self.state, self.guard)
        self.player: synth.MusicPlayer | None = None
        self._scales: dict[str, Gtk.Scale] = {}
        self._values: dict[str, Gtk.Label] = {}

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.add(self._build())
        self.connect("destroy", self._on_destroy)
        GLib.timeout_add(self.REFRESH_MS, self._tick)

    # -- layout ------------------------------------------------------------
    def _build(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(14)

        title = Gtk.Label(label="ORION-X  ///  DJ DECK")
        title.set_name("title")
        title.set_xalign(0.0)
        box.pack_start(title, False, False, 0)

        # The alert gate lamp — the most important widget on the deck.
        gate_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.gate_lamp = Gtk.Label(label="ALERT GATE: OPEN")
        self.gate_lamp.set_name("gate_ok")
        gate_row.pack_start(self.gate_lamp, False, False, 0)
        self.gain_label = Gtk.Label(label="gain 1.00")
        self.gain_label.set_name("status")
        gate_row.pack_start(self.gain_label, False, False, 0)
        box.pack_start(gate_row, False, False, 0)

        explain = Gtk.Label(
            label="R.A.I.N. outranks the music. A cue mutes the deck and hands\n"
                  "back the sound card until the alert has finished.")
        explain.set_name("status")
        explain.set_xalign(0.0)
        explain.set_line_wrap(True)
        box.pack_start(explain, False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 4)

        # Faders, built from the one authority.
        for control in synth.CONTROLS:
            box.pack_start(self._fader(control), False, False, 0)

        # Pattern selector.
        pat_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        plabel = Gtk.Label(label="PATTERN")
        plabel.set_name("knob")
        plabel.set_size_request(92, -1)
        plabel.set_xalign(0.0)
        pat_row.pack_start(plabel, False, False, 0)
        first: Gtk.RadioButton | None = None
        for name in synth.PATTERNS:
            btn = Gtk.RadioButton.new_with_label_from_widget(first, name.upper())
            btn.set_mode(False)
            if first is None:
                first = btn
            btn.set_active(name == self.state.pattern)
            btn.connect("toggled", self._on_pattern, name)
            pat_row.pack_start(btn, True, True, 0)
        box.pack_start(pat_row, False, False, 0)

        # Optional: let the deck's threat posture drive intensity.
        self.follow = Gtk.CheckButton(label="Intensity follows threat posture")
        self.follow.set_active(self.state.follow_posture)
        self.follow.connect("toggled", self._on_follow)
        box.pack_start(self.follow, False, False, 0)

        box.pack_start(Gtk.Separator(), False, False, 4)

        # Transport.
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.play_btn = Gtk.ToggleButton(label="PLAY")
        self.play_btn.connect("toggled", self._on_play)
        row.pack_start(self.play_btn, True, True, 0)
        duck_btn = Gtk.Button(label="TEST DUCK")
        duck_btn.set_tooltip_text(
            "Fire the same gate R.A.I.N. uses, so you can hear the deck "
            "get out of the way without waiting for a real intrusion.")
        duck_btn.connect("clicked", self._on_test_duck)
        row.pack_start(duck_btn, True, True, 0)
        box.pack_start(row, False, False, 0)

        self.status = Gtk.Label(label="stopped")
        self.status.set_name("status")
        self.status.set_xalign(0.0)
        self.status.set_line_wrap(True)
        box.pack_start(self.status, False, False, 0)

        self.degraded = Gtk.Label(label="")
        self.degraded.set_name("degraded")
        self.degraded.set_xalign(0.0)
        self.degraded.set_line_wrap(True)
        self.degraded.set_ellipsize(Pango.EllipsizeMode.END)
        box.pack_start(self.degraded, False, False, 0)
        return box

    def _fader(self, control: synth.Control) -> Gtk.Widget:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        name = Gtk.Label(label=control.label)
        name.set_name("knob")
        name.set_size_request(92, -1)
        name.set_xalign(0.0)
        row.pack_start(name, False, False, 0)

        scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, control.low, control.high, control.step)
        scale.set_draw_value(False)
        scale.set_value(float(getattr(self.state, control.key)))
        scale.set_tooltip_text(control.tip)
        scale.connect("value-changed", self._on_control, control)
        row.pack_start(scale, True, True, 0)
        self._scales[control.key] = scale

        value = Gtk.Label(label=control.format(float(getattr(self.state, control.key))))
        value.set_name("value")
        value.set_size_request(74, -1)
        value.set_xalign(1.0)
        row.pack_start(value, False, False, 0)
        self._values[control.key] = value
        return row

    # -- handlers ----------------------------------------------------------
    def _on_control(self, scale: Gtk.Scale, control: synth.Control) -> None:
        """A fader moved: push it straight into the live engine state.

        No restart and no reload — the next rendered block (~46 ms away) is
        already built from the new value, which is the whole reason the synth
        streams instead of looping a file.
        """
        synth.apply_control(self.state, control.key, scale.get_value())
        self._values[control.key].set_text(
            control.format(float(getattr(self.state, control.key))))
        synth.save_config(self.state)

    def _on_pattern(self, button: Gtk.RadioButton, name: str) -> None:
        if button.get_active():
            self.state.pattern = name
            self.state.clamp()
            synth.save_config(self.state)

    def _on_follow(self, button: Gtk.CheckButton) -> None:
        self.state.follow_posture = button.get_active()
        synth.save_config(self.state)

    def _on_test_duck(self, _button: Gtk.Button) -> None:
        if not synth.request_duck(2.5):
            # Could not write /run/orionx — duck the local guard directly so
            # the button still demonstrates the behaviour it claims to.
            self.guard.duck.duck(self.guard.clock(), 2.5)

    def _on_play(self, button: Gtk.ToggleButton) -> None:
        if button.get_active():
            self._start()
        else:
            self._stop()

    def _start(self) -> None:
        audio = synth.audio_report()
        if not audio["available"]:
            self.play_btn.set_active(False)
            self.status.set_text("cannot play — " + audio["what"])
            self.degraded.set_text("consequence: " + audio["consequence"]
                                   + "\nremedy: " + audio["remedy"])
            return
        self.state.enabled = True
        synth.save_config(self.state)
        self.engine.ensure_bank()
        self.player = synth.MusicPlayer(self.engine)
        result = self.player.start()
        if not result.ok:
            self.state.enabled = False
            self.play_btn.set_active(False)
            self.status.set_text("cannot play — " + result.what)
            self.degraded.set_text("consequence: " + result.consequence
                                   + "\nremedy: " + result.remedy)
            self.player = None
            return
        self.play_btn.set_label("STOP")
        self.status.set_text(f"playing via {audio['player']}")

    def _stop(self) -> None:
        self.state.enabled = False
        synth.save_config(self.state)
        if self.player is not None:
            self.player.stop()
            self.player = None
        self.play_btn.set_label("PLAY")
        self.status.set_text("stopped")

    def _on_destroy(self, *_args: object) -> None:
        self._stop()
        Gtk.main_quit()

    # -- the 10 Hz refresh -------------------------------------------------
    def _tick(self) -> bool:
        if self.player is None:
            # Nothing is polling the guard while stopped; keep it honest so
            # the lamp shows the real state rather than a stale one.
            self.guard.poll()

        gain = self.guard.music_gain()
        # Anything below unity means the music is being held back — the ramp
        # down, the hold, the ramp back up, or a guard that cannot prove it is
        # watching. The lamp lights at the FIRST of those, not the loudest.
        ducked = gain < 0.999
        self.gate_lamp.set_text("ALERT GATE: HELD" if ducked else "ALERT GATE: OPEN")
        self.gate_lamp.set_name("gate_ducked" if ducked else "gate_ok")
        self.gain_label.set_text(f"gain {gain:.2f}   cues seen {self.guard.cues_seen()}")

        if self.state.follow_posture:
            level = synth.posture_intensity()
            if level is not None and abs(level - self.state.intensity) > 1e-6:
                self.state.intensity = level
                self._scales["intensity"].set_value(level)

        if self.player is not None and not self.player.result.ok:
            self.status.set_text("stopped — " + self.player.result.what)
            self.degraded.set_text("consequence: " + self.player.result.consequence
                                   + "\nremedy: " + self.player.result.remedy)
            self.player = None
            self.state.enabled = False
            self.play_btn.set_active(False)
            return True

        problems = self.guard.degradations()
        self.degraded.set_text(
            "" if not problems else
            "\n".join(f"! {p['what']} — remedy: {p['remedy']}" for p in problems))
        return True


def main() -> int:
    deck = DJDeck()
    deck.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
