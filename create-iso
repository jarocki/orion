#!/usr/bin/env bash

cd /Users/jarocki/src/orion

# Download the ISO artifact from the successful run
gh run download 29107817672 -n "*iso*" -D output/ci-e09efbf/
# (or from web: https://github.com/jarocki/orion/actions/runs/29107817672)

# Locate it
ISO=$(ls output/*/*.iso 2>/dev/null | head -1)
echo "ISO: $ISO"
ls -lh "$ISO"    # should be ~1.9 GB
sha256sum "$ISO" # optional — record for provenance

# CAUTION: identify your USB target first
diskutil list
# Assume USB is /dev/disk4 — VERIFY on your machine
USB=/dev/disk4

diskutil unmountDisk $USB
sudo dd if="$ISO" of="${USB/disk/rdisk}" bs=4m status=progress
diskutil eject $USB
