# @decision DEC-MATRIX-002
# @title Layered Docker — matrix node extends mesh capabilities
# @status accepted
# @rationale Tests Matrix-over-WireGuard mesh (actual acceptance criteria).
#   Builds on the mesh node pattern (DEC-MESH-003) adding Synapse homeserver.
#   Bullseye-slim base for consistency with Dockerfile.mesh-node. Synapse
#   installed via pip3 (PyPI) on the system python3 path — NOT via the
#   matrix-org Debian package (matrix-synapse-py3) which ships Synapse in a
#   private venv at /opt/venvs/matrix-synapse/ incompatible with the frozen
#   Phase 4 entrypoint's `python3 -m synapse.app.homeserver` invocation.
#   matrix-commander is optional — curl-based API testing works as fallback.
#
# @decision DEC-PHASE7-014
# @title pip-only Synapse install retains Phase 4 entrypoint contract
# @status accepted
# @rationale The matrix-org Debian package (matrix-synapse-py3) installs
#   Synapse in a private virtualenv (/opt/venvs/matrix-synapse/) that is NOT
#   on the system python3 import path. matrix-entrypoint.sh (frozen, Phase 4
#   / DEC-MATRIX-005) invokes `python3 -m synapse.app.homeserver`, which
#   requires Synapse to be importable from system python3. pip3 install
#   (PyPI: matrix-synapse) lands in /usr/local/lib/python3.x/site-packages/
#   and satisfies that contract. The matrix-org Debian repo is therefore
#   removed entirely from this Dockerfile.

FROM debian:bullseye-slim

LABEL maintainer="Orion-X Project"
LABEL description="Orion-X Matrix node — Synapse homeserver over WireGuard mesh"

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system deps + WireGuard tools + build prerequisites for pip native extensions.
# Build deps (build-essential, python3-dev, libffi-dev, etc.) are required so pip3
# can compile matrix-synapse's native dependencies (cryptography, bcrypt, Pillow,
# frozendict, etc.) on bullseye. lsb-release retained for runtime use.
# wget, apt-transport-https, gnupg removed — matrix-org Debian repo no longer used.
# @decision DEC-MATRIX-002 — Bullseye base retained per DEC-009.
RUN apt-get update && apt-get install -y --no-install-recommends \
    wireguard-tools \
    socat \
    jq \
    iputils-ping \
    iproute2 \
    procps \
    curl \
    python3 \
    python3-pip \
    lsb-release \
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Synapse via pip3 — installs to system python3 site-packages so that
# `python3 -m synapse.app.homeserver` (matrix-entrypoint.sh, frozen Phase 4)
# can import it without modification.
# The matrix-org Debian package (matrix-synapse-py3) is NOT used: it places
# Synapse in a private venv (/opt/venvs/matrix-synapse/) incompatible with the
# system-python invocation in matrix-entrypoint.sh (DEC-PHASE7-014).
RUN pip3 install --no-cache-dir matrix-synapse

# Verify Synapse is importable from system python3 — fails the build loudly if
# pip install did not actually land on the system import path.
# This is the single source of truth for install success (synapse_install_authority).
RUN python3 -c "import synapse; print('synapse', synapse.__version__, 'imported from', synapse.__file__)"

# Install matrix-commander for E2E testing (optional — curl-based fallback if unavailable)
RUN pip3 install --no-cache-dir matrix-commander 2>/dev/null \
    || echo "matrix-commander install failed, will use curl-based testing"

# Create required directories
RUN mkdir -p /opt/orionx/scripts/mesh /var/log/orionx /etc/wireguard /var/run /data

# Copy mesh scripts
COPY scripts/mesh/ /opt/orionx/scripts/mesh/
RUN chmod +x /opt/orionx/scripts/mesh/orionx-mesh \
    /opt/orionx/scripts/mesh/mesh-discover.sh \
    /opt/orionx/scripts/mesh/mesh-join.sh \
    /opt/orionx/scripts/mesh/mesh-leave.sh \
    /opt/orionx/scripts/mesh/mesh-health.sh

# Symlink CLI to PATH
RUN ln -sf /opt/orionx/scripts/mesh/orionx-mesh /usr/local/bin/orionx-mesh

# Copy Matrix config templates
COPY docker/matrix/homeserver.yaml /data/homeserver.yaml.template
COPY docker/matrix/log.config /data/log.config

# Copy entrypoint
COPY docker/matrix-entrypoint.sh /usr/local/bin/matrix-entrypoint.sh
RUN chmod +x /usr/local/bin/matrix-entrypoint.sh

EXPOSE 8008 8448
VOLUME /data

ENTRYPOINT ["/usr/local/bin/matrix-entrypoint.sh"]
