# Build artifacts
iso/cache/
iso/build/
# live-build writes chroot listings (chroot.files, chroot.packages.*) next to
# the config; a 12.9 MB iso/chroot.files was once committed by accident.
iso/chroot.*
output/
*.iso
*.img

# Temporary files
tmp/
*.tmp
*~
.*.swp
.DS_Store

# Log files
*.log
/logs/
# Exception: synthetic sample logs needed for Phase 5 parser testing
!data/samples/logs/synthetic-syslog.log

# Keys and sensitive data
*.key
*.pem
*.crt
*.pfx
vault_config.conf

# User-specific files
.orionx_theme

# Compressed files
*.zip
*.tar
*.tar.gz
*.tgz

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.venv/
.pytest_cache/

# Analysis results
analysis_results/

# Package files
*.deb
*.rpm

# Archive (legacy artifacts, not tracked — INVENTORY.md is the sole exception)
# Use archive/* (not archive/) so git enters the directory and the negation works
archive/*
!archive/INVENTORY.md
!archive/README.md

# Build-time-staged application content (single-authority: source is repo root)
# stage_application_content() rsyncs these from repo root at ISO build time.
# Do NOT commit staged content — the repo root dirs are the source of truth.
#
# The trailing /* (rather than /) matters: git will not descend into an
# excluded DIRECTORY, so a `!` negation inside one can never take effect.
# Two subtrees below are not staged from anywhere — they are written here
# directly and this IS their source of truth — so they must stay trackable:
#   optional/   the post-boot installers (DEC-PHASE11-011). Already tracked,
#               but a NEW installer would have been silently ignored.
#   osint/      the OSINT surface: launcher page, vendored CyberChef, the
#               attack map (DEC-PHASE12-043). stage_application_content()
#               owns scripts/ theme/ data/ docs/ and never touches this.
iso/config/includes.chroot/opt/orionx/*
!iso/config/includes.chroot/opt/orionx/optional/
!iso/config/includes.chroot/opt/orionx/osint/
# Placeholder READMEs + the YARA lockfile are written here directly (no staging
# step owns comms/ re/ yara/ nebula/mcp-servers/), so they are their own
# source of truth and stay trackable. nebula/models/ is staged by
# stage_nebula_model() and stays ignored. (release-tests F-28)
!iso/config/includes.chroot/opt/orionx/comms/
!iso/config/includes.chroot/opt/orionx/re/
!iso/config/includes.chroot/opt/orionx/yara/
!iso/config/includes.chroot/opt/orionx/nebula/
iso/config/includes.chroot/opt/orionx/nebula/*
!iso/config/includes.chroot/opt/orionx/nebula/mcp-servers/
iso/config/includes.chroot/usr/share/doc/orionx/

# Session-local scratch (never committed; appeared as "7 uncommitted" noise
# in SessionStart hooks across many sessions — see hook context-lib.sh:62)
.claude/
.worktrees/
reckonings/
DECISIONS.md
decision-config-configurator.html
docker_gordon_ai.html
*.iso.OLD
